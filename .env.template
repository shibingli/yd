# yd 环境变量模板（复制为 .env 后按需修改）
# 优先级：命令行参数 > 环境变量(.env) > 配置文件 > 框架默认值
# 前缀 YD_，下划线自动映射为多级嵌套结构：YD_DB_MAXCONN -> db.maxconn

YD_SERVER_PORT=8080
YD_SERVER_H2C=true
YD_SERVER_HTTP3_ENABLED=false

YD_LOG_LEVEL=info
YD_LOG_FORMAT=json

# 数据库：mysql | postgres | sqlite
YD_DB_DRIVER=sqlite
YD_DB_DSN=data/yd.db
YD_DB_MAXCONN=100
YD_DB_SLOW_THRESHOLD=200ms

# Redis：single | sentinel | cluster
YD_REDIS_MODE=single
YD_REDIS_ADDR=127.0.0.1:6379

# 异步任务队列
YD_ASYNQ_QUEUES="critical:3,default:2,low:1"
YD_ASYNQ_CONCURRENCY=10

# 国密
YD_GUOMI_SM2_PRIVATE_KEY=
