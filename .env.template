# yd 环境变量模板（复制为 .env 后按需修改）
# 优先级：命令行参数 > 环境变量(.env) > 配置文件 > 框架默认值
# 前缀 YD_，下划线自动映射为多级嵌套结构：YD_DB_MAXCONN -> db.maxconn

YD_SERVER_PORT=8080
YD_SERVER_H2C=true
YD_SERVER_HTTP3_ENABLED=false

# 强制 RFC 8441（WebSocket over HTTP/2）；需要 GODEBUG=http2xconnect=1。
# yd dev / yd service / yd docker 会在为 true 时自动配置；
# 裸二进制会在启动时自行重启，Windows 服务需经 yd service 安装。
# Force RFC 8441 (WebSocket over HTTP/2); requires GODEBUG=http2xconnect=1.
# yd dev, yd service and yd docker configure it automatically when true;
# a bare binary re-executes itself at startup, while Windows services must be installed through yd service.
YD_SERVER_HTTP2_EXTENDED_CONNECT=false

YD_LOG_LEVEL=info
YD_LOG_FORMAT=json

# 数据库：mysql | postgres | sqlite
YD_DB_DRIVER=sqlite
YD_DB_DSN=data/yd.db
YD_DB_MAXCONN=100
YD_DB_SLOW_THRESHOLD=200ms

# Redis：single | sentinel | cluster
YD_REDIS_MODE=single
YD_REDIS_ADDR=127.0.0.1:6379

# 异步任务队列
YD_ASYNQ_QUEUES="critical:3,default:2,low:1"
YD_ASYNQ_CONCURRENCY=10

# 国密
YD_GUOMI_SM2_PRIVATE_KEY=
