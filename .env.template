# yd 环境变量模板（复制为 .env 后按需修改）
# 优先级：命令行参数 > 环境变量(.env) > 配置文件 > 框架默认值
# 前缀 YUNGO_，下划线自动映射为多级嵌套结构：YUNGO_DB_MAXCONN -> db.maxconn

YUNGO_SERVER_PORT=8080
YUNGO_SERVER_H2C=true
YUNGO_SERVER_HTTP3_ENABLED=false

YUNGO_LOG_LEVEL=info
YUNGO_LOG_FORMAT=json

# 数据库：mysql | postgres | sqlite
YUNGO_DB_DRIVER=sqlite
YUNGO_DB_DSN=data/yd.db
YUNGO_DB_MAXCONN=100
YUNGO_DB_SLOW_THRESHOLD=200ms

# Redis：single | sentinel | cluster
YUNGO_REDIS_MODE=single
YUNGO_REDIS_ADDR=127.0.0.1:6379

# 异步任务队列
YUNGO_ASYNQ_QUEUES="critical:3,default:2,low:1"
YUNGO_ASYNQ_CONCURRENCY=10

# 国密
YUNGO_GUOMI_SM2_PRIVATE_KEY=
