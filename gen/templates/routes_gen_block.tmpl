//yd:gen:begin
<%/* A blank line must follow the begin marker: go/format treats a //yd:gen:begin
     glued to the declaration as a directive comment and moves it below the doc comment, which
     drifts the block boundary and duplicates the comments on the next run.
     起始标记后必须留一个空行：go/format 会把紧贴在声明前的区块起始标记当成指令注释，
     挪到文档注释末尾，从而让标记区块的边界漂移、重新生成时重复写入注释。 */%>

// Deps 汇总 yd gen 生成的控制器，装配阶段注入后即可启用全部生成模块。
// Deps collects the controllers generated by yd gen; inject it during wiring to enable every generated module.
//
// 本区块由 yd gen 维护，重新生成时整块替换，请勿手工编辑。
// This block is maintained by yd gen and replaced as a whole on every regeneration, so never edit it by hand.
// 区块内引用的 controller 包必须在文件头部 import；若本区块是被追加到已有文件末尾的，请自行补上该 import。
// The controller package referenced below must be imported at the top of the file; when this block was
// appended to an existing file, add that import yourself.
type Deps struct {
<% range .Modules %>	// <%.Name%> is the controller of the <%.Snake%> module. | <%.Name%> 是 <%.Snake%> 模块的控制器。
	<%.Name%> *controller.<%.Name%>Controller
<% end %>}

// RegisterGeneratedRoutes 注册全部生成模块的路由。
// RegisterGeneratedRoutes registers the routes of every generated module.
func RegisterGeneratedRoutes(g *router.Group, deps Deps) {
<% range .Modules %>	Register<%.Name%>Routes(g, deps.<%.Name%>)
<% end %>}
//yd:gen:end
