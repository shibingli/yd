package templatebench

import "strconv"

templ RenderPage(p *Page) {
	<!doctype html>
	<html lang={ p.Lang }>
	<head><title>{ p.Title }</title></head>
	<body>
	<h1>{ p.Title }</h1>
	<p class={ p.User.Class }>{ p.User.Name } &lt;{ p.User.Email }&gt;</p>
	if len(p.Items) > 0 {
		<ul>
		for _, it := range p.Items {
			<li id={ "item-" + strconv.Itoa(it.ID) } class={ it.Class } data-active={ strconv.FormatBool(it.Active) }>
			<a href={ it.URL + "?q=" + p.Query } title={ it.Note }>{ it.Name }</a>
			<span class="email">{ it.Email }</span>
			if it.Active {
				<b>active</b>
			} else {
				<i>inactive</i>
			}
			</li>
		}
		</ul>
	} else {
		<p>no items</p>
	}
	<p>{ strconv.Itoa(p.Total) } items</p>
	</body>
	</html>
}
