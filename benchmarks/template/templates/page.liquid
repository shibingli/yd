<!doctype html>
<html lang="{{ lang }}">
<head><title>{{ title }}</title></head>
<body>
<h1>{{ title }}</h1>
<p class="{{ user.class }}">{{ user.name }} &lt;{{ user.email }}&gt;</p>
{% if items %}
<ul>
{% for item in items %}
<li id="item-{{ item.id }}" class="{{ item.class }}" data-active="{{ item.active }}">
<a href="{{ item.url }}?q={{ query }}" title="{{ item.note }}">{{ item.name }}</a>
<span class="email">{{ item.email }}</span>
{% if item.active %}<b>active</b>{% else %}<i>inactive</i>{% endif %}
</li>
{% endfor %}
</ul>
{% else %}
<p>no items</p>
{% endif %}
<p>{{ total }} items</p>
</body>
</html>
