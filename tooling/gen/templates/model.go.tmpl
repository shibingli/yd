<% .Marker %>

package model

import (
	"fmt"
	"hash/fnv"
<% if .UsesTime %>	"time"
<% end %><% if .UsesGorm %>	"gorm.io/gorm"
<% end %>)

// <%.Name%> is the GORM model mapped to table <%.Table%>. | <%.Name%> 是数据库表 <%.Table%> 对应的 GORM 模型，
// It is generated by yd gen from a struct or a table schema. | 由 yd gen 依据结构体或表结构生成。
//
// 字段注释来自列注释或 yd 标签；修改模型后请重新执行生成命令，不要直接编辑本文件。
// Field comments come from column comments or yd tags; re-run the generator after a schema change instead of editing this file.
type <%.Name%> struct {
<% range .ModelFields %>	// <%.CommentText%>
	<%.GoName%> <%.GoType%> `gorm:"<%.GormTag%>" json:"<%.JSONTag%>"`
<% end %><% if not .HasTenant %>	// TenantID is the owning tenant. Every generated query filters on it, so one tenant can never
	// read or write another tenant's rows. | TenantID 是所属租户。每条生成的查询都按它过滤，
	// 因此一个租户永远无法读写另一个租户的记录。
	TenantID string `gorm:"column:tenant_id;not null;index" json:"tenant_id"`
<% end %>}

// TableName 返回模型对应的表名。
// TableName returns the table name of the model.
func (<%.Name%>) TableName() string { return "<%.Table%>" }

// DOMID returns a stable, CSS-selector-safe identifier derived from the primary key. |
// DOMID 返回由主键派生的、可安全用于 CSS 选择器的稳定标识。
func (m <%.Name%>) DOMID() string {
	h := fnv.New64a()
	_, _ = h.Write([]byte(fmt.Sprint(m.<%.Primary.GoName%>)))
	return fmt.Sprintf("%x", h.Sum64())
}
