<% .Marker %>

package service

import (
	"context"
	"errors"
<% if .ServiceStrings %>	"strings"
<% end %><% if .FormTime %>	"time"
<% end %>
	"github.com/shibingli/yd/data/paging"
	"github.com/shibingli/ydx/errs"
	"github.com/shibingli/ydx/log"

	"<%.PkgModel%>"
	"<%.PkgRepo%>"
)

// 服务层哨兵错误，均在包级声明一次，调用方用 errors.Is 判定。
// Service sentinel errors, declared once at package level and matched with errors.Is.
var (
	// Err<%.Name%>Invalid 表示<%.Module%>入参不满足校验规则。
	// Err<%.Name%>Invalid reports the <%.Snake%> payload violating a validation rule.
	Err<%.Name%>Invalid = errs.New("invalid <%.Snake%> payload | <%.Snake%> 入参不合法")
	// Err<%.Name%>NotFound 表示要操作的<%.Module%>记录不存在。
	// Err<%.Name%>NotFound reports a missing <%.Snake%> record.
	Err<%.Name%>NotFound = errs.New("<%.Snake%> not found | <%.Snake%> 记录不存在")
	// Err<%.Name%>Store 表示<%.Module%>存储层操作失败。
	// Err<%.Name%>Store reports a failed storage operation for <%.Snake%>.
	Err<%.Name%>Store = errs.New("<%.Snake%> storage operation failed | <%.Snake%> 存储操作失败")
)

// <%.Name%>Input 是创建与更新<%.Module%>的入参，只覆盖可写字段。
// <%.Name%>Input is the payload used to create or update the <%.Snake%> record; it covers the writable fields only.
type <%.Name%>Input struct {
<% range .FormFields %>	// <%.CommentText%>
	<%.GoName%> <%.GoType%> `json:"<%.JSONName%>"`
<% end %>}

// Validate 校验入参，返回首个不满足的规则。
// Validate checks the payload and returns the first violated rule.
//
// 校验规则由 yd gen 依据字段约束生成：required 对应非空、max 对应长度上限、min 对应数值下限。
// The rules are generated by yd gen from the field constraints: required means non-empty, max is the length limit, min is the numeric floor.
func (in <%.Name%>Input) Validate() error {
<% range .FormFields %><% if and .IsString .Required (not .IsFile) %>	if strings.TrimSpace(in.<%.GoName%>) == "" {
		return errs.Detail(Err<% $.Name %>Invalid, "<%.SafeName%> is required | <%.SafeLabel%>不能为空")
	}
<% end %><% if and .IsString (gt .MaxLength 0) %>	if n := len(in.<%.GoName%>); n > <%.MaxLength%> {
		return errs.Detail(Err<% $.Name %>Invalid, "<%.SafeName%> is too long: %d > <%.MaxLength%> | <%.SafeLabel%>过长：%d > <%.MaxLength%>", n, n)
	}
<% end %><% if and .IsNumber (ne .MinValue "") %>	if in.<%.GoName%> < <%.MinValue%> {
		return errs.Detail(Err<% $.Name %>Invalid, "<%.SafeName%> must be >= <%.MinValue%> | <%.SafeLabel%>不能小于 <%.MinValue%>")
	}
<% end %><% end %>	return nil
}

// Apply 把入参写入模型，主键与时间戳字段保持不变。
// Apply writes the payload into the model, leaving the primary key and the timestamp fields untouched.
func (in <%.Name%>Input) Apply(item *model.<%.Name%>) {
<% range .FormFields %><% if .IsFile %>	// A file field keeps its previous value when no new upload arrives, | 文件字段未重新上传时保留原值，
	// so an update never blanks the stored file. | 避免更新把已有文件清空。
	if in.<%.GoName%> != "" {
		item.<%.GoName%> = in.<%.GoName%>
	}
<% else %>	item.<%.GoName%> = in.<%.GoName%>
<% end %><% end %>}

// Extract<%.Name%>Input 从模型取回入参，供编辑表单回填。
// Extract<%.Name%>Input reads the payload back from the model so the edit form can be prefilled.
func Extract<%.Name%>Input(item *model.<%.Name%>) <%.Name%>Input {
	if item == nil {
		return <%.Name%>Input{}
	}
	return <%.Name%>Input{
<% range .FormFields %>		<%.GoName%>: item.<%.GoName%>,
<% end %>	}
}

// <%.Name%>Service 实现<%.Module%>模块的业务逻辑。
// <%.Name%>Service implements the business logic of the <%.Snake%> module.
type <%.Name%>Service struct {
	repo *repository.<%.Name%>Repo
}

// New<%.Name%>Service 创建 <%.Name%>Service。
// New<%.Name%>Service creates a <%.Name%>Service.
func New<%.Name%>Service(repo *repository.<%.Name%>Repo) *<%.Name%>Service {
	log.Default().Info("<%.Snake%> service ready | <%.Snake%> 服务已就绪", log.Str("table", model.<%.Name%>{}.TableName()))
	return &<%.Name%>Service{repo: repo}
}

// List 返回一页<%.Module%>记录与分页状态，页码、页长与游标会被归一化。
// List returns one page of <%.Snake%> records with its pagination state; page, size and cursors are normalised.
//
// Offset paging needs the total to draw page numbers, so only a non-cursor request asks for COUNT;
// a cursor request deliberately never counts, which is what keeps deep pages at a constant cost. |
// 常规分页需要总条数才能画页码，因此只有非游标请求才要求 COUNT；游标请求刻意不计数，
// 这正是深页仍保持常量开销的原因。
func (s *<%.Name%>Service) List(ctx context.Context, tenantID string, req paging.Request<% if .HasSearch %>, keyword string<% end %>) (paging.Page[model.<%.Name%>], error) {
	req = req.Normalize()
	if !req.CursorMode() {
		req.WithTotal = true
	}
	page, err := s.repo.List(ctx, tenantID, req<% if .HasSearch %>, keyword<% end %>)
	if err != nil {
		return paging.Page[model.<%.Name%>]{}, errs.WrapDetail(err, Err<%.Name%>Store, "op=list page=%d size=%d cursor=%v", req.Page, req.Size, req.CursorMode())
	}
	return page, nil
}

// Get 读取单条<%.Module%>记录，记录不存在时返回 Err<%.Name%>NotFound。
// Get reads one <%.Snake%> record and returns Err<%.Name%>NotFound when it is absent.
func (s *<%.Name%>Service) Get(ctx context.Context, tenantID string, id <%.Primary.GoType%>) (*model.<%.Name%>, error) {
	item, err := s.repo.Find(ctx, tenantID, id)
	if err != nil {
		if errors.Is(err, repository.Err<%.Name%>NotFound) {
			return nil, errs.Wrap(err, Err<%.Name%>NotFound)
		}
		return nil, errs.WrapDetail(err, Err<%.Name%>Store, "op=get <%.Primary.Column%>=%v", id)
	}
	return item, nil
}

// Create 校验并写入一条新的<%.Module%>记录。
// Create validates the payload and writes a new <%.Snake%> record.
func (s *<%.Name%>Service) Create(ctx context.Context, tenantID string, in <%.Name%>Input) (*model.<%.Name%>, error) {
	if err := in.Validate(); err != nil {
		return nil, err
	}

	item := &model.<%.Name%>{}
	in.Apply(item)
	if err := s.repo.Create(ctx, tenantID, item); err != nil {
		return nil, errs.WrapDetail(err, Err<%.Name%>Store, "op=create")
	}
	log.Default().Info("<%.Snake%> created | <%.Snake%> 已创建", log.Any("<%.Primary.Column%>", item.<%.Primary.GoName%>))
	return item, nil
}

// Update 校验并覆盖写入一条<%.Module%>记录，记录不存在时返回 Err<%.Name%>NotFound。
// Update validates the payload and overwrites the <%.Snake%> record, returning Err<%.Name%>NotFound when it is absent.
func (s *<%.Name%>Service) Update(ctx context.Context, tenantID string, id <%.Primary.GoType%>, in <%.Name%>Input) (*model.<%.Name%>, error) {
	if err := in.Validate(); err != nil {
		return nil, err
	}

	item, err := s.Get(ctx, tenantID, id)
	if err != nil {
		return nil, err
	}
	in.Apply(item)
	if err := s.repo.Update(ctx, tenantID, item); err != nil {
		if errors.Is(err, repository.Err<%.Name%>NotFound) {
			return nil, errs.Wrap(err, Err<%.Name%>NotFound)
		}
		return nil, errs.WrapDetail(err, Err<%.Name%>Store, "op=update <%.Primary.Column%>=%v", id)
	}
	log.Default().Info("<%.Snake%> updated | <%.Snake%> 已更新", log.Any("<%.Primary.Column%>", item.<%.Primary.GoName%>))
	return item, nil
}

// Delete 删除一条<%.Module%>记录，记录不存在时返回 Err<%.Name%>NotFound。
// Delete removes one <%.Snake%> record and returns Err<%.Name%>NotFound when it is absent.
func (s *<%.Name%>Service) Delete(ctx context.Context, tenantID string, id <%.Primary.GoType%>) error {
	if err := s.repo.Delete(ctx, tenantID, id); err != nil {
		if errors.Is(err, repository.Err<%.Name%>NotFound) {
			return errs.Wrap(err, Err<%.Name%>NotFound)
		}
		return errs.WrapDetail(err, Err<%.Name%>Store, "op=delete <%.Primary.Column%>=%v", id)
	}
	log.Default().Info("<%.Snake%> deleted | <%.Snake%> 已删除", log.Any("<%.Primary.Column%>", id))
	return nil
}
