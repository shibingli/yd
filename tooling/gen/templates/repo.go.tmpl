<% .Marker %>

package repository

import (
	"context"
	"errors"
<% if .RepoStrings %>	"strings"

<% end %>	"github.com/shibingli/yd/data/paging"
	"github.com/shibingli/ydx/errs"
	"github.com/shibingli/ydx/log"
	"gorm.io/gorm"

	"<%.PkgModel%>"
)

// 仓储层哨兵错误，均在包级声明一次，调用方用 errors.Is 判定。
// Repository sentinel errors, declared once at package level and matched with errors.Is.
var (
	// Err<%.Name%>NilDB 表示创建仓储时未提供数据库句柄。
	// Err<%.Name%>NilDB reports a missing database handle when the repository is created.
	Err<%.Name%>NilDB = errs.New("<%.Snake%> repository: nil database handle | <%.Snake%> 仓储：数据库句柄为空")
	// Err<%.Name%>NotFound 表示<%.Module%>记录不存在。
	// Err<%.Name%>NotFound reports a missing <%.Snake%> record.
	Err<%.Name%>NotFound = errs.New("<%.Snake%> not found | <%.Snake%> 记录不存在")
	// Err<%.Name%>DB 表示<%.Module%>仓储的数据库操作失败。
	// Err<%.Name%>DB reports a failed database operation in the <%.Snake%> repository.
	Err<%.Name%>DB = errs.New("<%.Snake%> repository operation failed | <%.Snake%> 仓储操作失败")
)

// <%.Name%>Repo 是表 <%.Table%> 的数据访问对象，直接使用注入的 GORM 句柄。
// <%.Name%>Repo is the data access object of table <%.Table%>, using the injected GORM handle directly.
type <%.Name%>Repo struct {
	db *gorm.DB
}

// New<%.Name%>Repo 创建 <%.Name%>Repo；db 为空时返回 Err<%.Name%>NilDB。
// New<%.Name%>Repo creates a <%.Name%>Repo and returns Err<%.Name%>NilDB when db is nil.
func New<%.Name%>Repo(db *gorm.DB) (*<%.Name%>Repo, error) {
	if db == nil {
		return nil, Err<%.Name%>NilDB
	}
	log.Default().Info("<%.Snake%> repository ready | <%.Snake%> 仓储已就绪", log.Str("table", model.<%.Name%>{}.TableName()))
	return &<%.Name%>Repo{db: db}, nil
}

// List 返回一页<%.Module%>记录与分页状态。
// List returns one page of <%.Snake%> records with its pagination state.
//
// req 不带游标时走常规分页（COUNT + LIMIT/OFFSET，可跳页）；带 after/before 时走键集分页，
// 不执行 COUNT，开销只与本页长度相关。主键同时是排序键与决胜键，因此键集窗口是唯一确定的。
// Without a cursor the request uses offset paging (COUNT + LIMIT/OFFSET, arbitrary page jumps); with
// after/before it uses keyset paging without COUNT, so the cost depends only on the page length. The
// primary key is both the sort column and the tie-breaker, making every keyset window deterministic.
func (r *<%.Name%>Repo) List(ctx context.Context, tenantID string, req paging.Request<% if .HasSearch %>, keyword string<% end %>) (paging.Page[model.<%.Name%>], error) {
	query := r.db.WithContext(ctx).Model(&model.<%.Name%>{}).Where("tenant_id = ?", tenantID)
<% if .HasSearch %>	if keyword = strings.TrimSpace(keyword); keyword != "" {
		like := "%" + strings.NewReplacer("!", "!!", "%", "!%", "_", "!_").Replace(keyword) + "%"
		query = query.Where("<%.SearchWhere%>", <%.SearchArgs%>)
	}
<% end %>	if req.CursorMode() {
		page, err := paging.KeysetPage[model.<%.Name%>](ctx, query,
			paging.Keyset{Sort: "<%.Primary.Column%>", ID: "<%.Primary.Column%>"}, req,
			func(item model.<%.Name%>) (paging.Cursor, error) {
				return paging.NewCursor(item.<%.Primary.GoName%>, item.<%.Primary.GoName%>)
			})
		if err != nil {
			return paging.Page[model.<%.Name%>]{}, errs.WrapDetail(err, Err<%.Name%>DB, "table=<%.Table%> op=list cursor")
		}
		return page, nil
	}
	page, err := paging.OffsetPage[model.<%.Name%>](ctx, query.Order("<%.Primary.Column%> ASC"), req)
	if err != nil {
		return paging.Page[model.<%.Name%>]{}, errs.WrapDetail(err, Err<%.Name%>DB, "table=<%.Table%> op=list page=%d size=%d", req.Page, req.Size)
	}
	return page, nil
}

// Find 按主键读取一条<%.Module%>记录；记录不存在时返回 Err<%.Name%>NotFound。
// Find reads one <%.Snake%> record by primary key and returns Err<%.Name%>NotFound when it is absent.
func (r *<%.Name%>Repo) Find(ctx context.Context, tenantID string, id <%.Primary.GoType%>) (*model.<%.Name%>, error) {
	var item model.<%.Name%>
	if err := r.db.WithContext(ctx).Where("tenant_id = ? AND <%.Primary.Column%> = ?", tenantID, id).First(&item).Error; err != nil {
		if errors.Is(err, gorm.ErrRecordNotFound) {
			return nil, errs.Wrap(err, Err<%.Name%>NotFound)
		}
		return nil, errs.WrapDetail(err, Err<%.Name%>DB, "table=<%.Table%> op=find <%.Primary.Column%>=%v", id)
	}
	return &item, nil
}

// Create 写入一条新的<%.Module%>记录，主键由数据库回填到 item。
// Create writes a new <%.Snake%> record; the database fills the primary key back into item.
func (r *<%.Name%>Repo) Create(ctx context.Context, tenantID string, item *model.<%.Name%>) error {
	item.TenantID = tenantID
	if err := r.db.WithContext(ctx).Create(item).Error; err != nil {
		return errs.WrapDetail(err, Err<%.Name%>DB, "table=<%.Table%> op=create")
	}
	return nil
}

// Update 覆盖写入<%.Module%>记录的全部非主键列；记录不存在时返回 Err<%.Name%>NotFound。
// Update overwrites every non-primary column of the <%.Snake%> record and returns Err<%.Name%>NotFound when it is absent.
func (r *<%.Name%>Repo) Update(ctx context.Context, tenantID string, item *model.<%.Name%>) error {
	item.TenantID = tenantID
	result := r.db.WithContext(ctx).Model(item).Where("tenant_id = ?", tenantID).Select("*").Omit("<%.Primary.Column%>", "tenant_id").Updates(item)
	if result.Error != nil {
		return errs.WrapDetail(result.Error, Err<%.Name%>DB, "table=<%.Table%> op=update <%.Primary.Column%>=%v", item.<%.Primary.GoName%>)
	}
	if result.RowsAffected == 0 {
		// MySQL 在写入值与库中完全一致时同样报告 0 行，因此再确认一次记录是否存在。
		// MySQL also reports 0 rows when the written values match the stored ones, so existence is confirmed once more.
		if _, err := r.Find(ctx, tenantID, item.<%.Primary.GoName%>); err != nil {
			return err
		}
	}
	return nil
}

// Delete 按主键删除一条<%.Module%>记录；记录不存在时返回 Err<%.Name%>NotFound。
// Delete removes one <%.Snake%> record by primary key and returns Err<%.Name%>NotFound when it is absent.
func (r *<%.Name%>Repo) Delete(ctx context.Context, tenantID string, id <%.Primary.GoType%>) error {
	result := r.db.WithContext(ctx).Where("tenant_id = ? AND <%.Primary.Column%> = ?", tenantID, id).Delete(&model.<%.Name%>{})
	if result.Error != nil {
		return errs.WrapDetail(result.Error, Err<%.Name%>DB, "table=<%.Table%> op=delete <%.Primary.Column%>=%v", id)
	}
	if result.RowsAffected == 0 {
		return errs.Detail(Err<%.Name%>NotFound, "table=<%.Table%> <%.Primary.Column%>=%v", id)
	}
	return nil
}
