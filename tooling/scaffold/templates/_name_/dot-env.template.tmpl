# {{ .Name }} 环境变量模板（复制为 .env 后按需修改）
# {{ .Name }} environment template (copy it to .env and adjust as needed)
#
# 优先级：命令行参数 > 环境变量(.env) > 配置文件 > 框架默认值
# Precedence: command-line flags > environment variables (.env) > config files > framework defaults
# 前缀 YD_，下划线自动映射为多级嵌套结构：YD_DB_MAXCONN -> db.maxconn
# The YD_ prefix is mandatory; underscores map onto nested keys: YD_DB_MAXCONN -> db.maxconn

YD_SERVER_PORT=8080
YD_SERVER_H2C=true
YD_SERVER_HTTP3_ENABLED=false

# 强制 RFC 8441（WebSocket over HTTP/2）；需要 GODEBUG=http2xconnect=1。
# yd dev / yd service / yd docker 会在为 true 时自动配置；
# 裸二进制会在启动时自行重启，Windows 服务需经 yd service 安装。
# Force RFC 8441 (WebSocket over HTTP/2); requires GODEBUG=http2xconnect=1.
# yd dev, yd service and yd docker configure it automatically when true;
# a bare binary re-executes itself at startup, while Windows services must be installed through yd service.
YD_SERVER_HTTP2_EXTENDED_CONNECT=false

YD_LOG_LEVEL=info
YD_LOG_FORMAT=json
{{- if ne .DB "none" }}

# 数据库：mysql | postgres | sqlite
# Database: mysql | postgres | sqlite
# The DSN is quoted: the SQLite sample carries an &, which `source .env` would read as a background operator.
# DSN 带引号：SQLite 的示例串里有 &，不加引号时 `source .env` 会把它当后台执行符。
# In production use an absolute path (a relative one resolves against the process working directory) and make sure the
# directory holding the database file exists.
# 生产环境请改成绝对路径（相对路径按进程工作目录解析），并确保库文件所在目录已存在。
YD_DB_DRIVER={{ .DB }}
YD_DB_DSN="{{ .DBDSN }}"
YD_DB_MAXCONN=100
YD_DB_MAXIDLE=10
YD_DB_SLOW_THRESHOLD=200ms
{{- end }}
{{- if .Redis }}

# Redis：single | sentinel | cluster
# Redis: single | sentinel | cluster
YD_REDIS_MODE=single
YD_REDIS_ADDR=127.0.0.1:6379
{{- end }}
{{- if .Asynq }}

# 异步任务队列
# Asynchronous task queue
YD_ASYNQ_QUEUES="critical:3,default:2,low:1"
YD_ASYNQ_CONCURRENCY=10
{{- end }}
{{- if .GRPC }}

# gRPC 双通道
# gRPC dual channel
YD_GRPC_ENABLED=true
YD_GRPC_PORT=9090
{{- end }}
{{- if .I18n }}

# 国际化
# Internationalisation
YD_I18N_DEFAULT=zh-CN
YD_I18N_FALLBACK=en
{{- end }}

# 国密（仅开发环境使用测试向量，生产环境必须走密钥管理服务）
# Guomi crypto (development uses test vectors only; production must use a key management service)
YD_GUOMI_SM2_PRIVATE_KEY=

# 鉴权与会话：主密钥封装每个用户的 sec_key，令牌有效期决定登录会话的时长。
# Authentication and sessions: the master key seals every user's sec_key and the token lifetime bounds the session.
# 留空时仅 development 使用脚手架内置的开发密钥并告警；其它环境留空会拒绝启动，生产环境必须注入密钥管理服务下发的取值。
# Empty selects the scaffold's built-in development key in development only; outside development an empty key refuses to start.
YD_AUTH_MASTER_KEY=
YD_AUTH_TOKEN_TTL=2h

# 可选：覆盖 seed.tenant / seed.username；留空则使用 internal/meta 的 default / admin。
# Optional: override seed.tenant / seed.username; empty falls back to default / admin in internal/meta.
# YD_SEED_TENANT=default
# YD_SEED_USERNAME=admin

# 默认数据（种子）管理员的口令：只在租户表为空时用一次，之后改口令请在账号页操作。
# The seed administrator's password: used once, while the tenant table is empty; change it later from the account page.
# 留空时：development 回退到 internal/meta 的文档化开发口令并每次启动告警；其它环境**不写入任何种子数据**并告警。
# When left empty: development falls back to the documented password in internal/meta and warns on every start, while any other
# environment writes no seed data at all and warns. The clear text never reaches a log.
YD_SEED_ADMIN_PASSWORD=
