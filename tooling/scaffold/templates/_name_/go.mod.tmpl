module {{ .Module }}

go {{ .GoVersion }}
{{- if .LocalReplace }}

require (
	{{ .YdModule }} v0.0.0-00010101000000-000000000000
{{- range .YdxModules }}
	{{ . }} v0.0.0-00010101000000-000000000000
{{- end }}
{{- if .WAF }}
	{{ .WafModule }} v0.0.0-00010101000000-000000000000
	{{ .WafCRSModule }} {{ .CRSRulesetVersion }}
{{- end }}
)

replace {{ .YdModule }} => {{ .LocalReplaceQuoted }}
{{- range .YdxReplaces }}
replace {{ .Module }} => {{ .PathQuoted }}
{{- end }}
{{- else if .YdVersion }}

// Pinned to the versions that generated this project, so every framework package this project
// imports always exists. Each ydx component is released under its own tag, and every module in
// this block carries its version; a missing version would make `go build` fall back to the
// framework root module, which does not contain these packages. Upgrade with `yd versions upgrade`.
// | 锁定到生成本项目的版本，确保项目导入的每个框架包一定存在；ydx 各组件按自己的标签发布，
// 本块中的每个模块都带版本；缺少版本会让 `go build` 回退到框架根模块，而根模块并不包含这些包。
// 升级请用 `yd versions upgrade`。
require (
	{{ .YdModule }} {{ .YdVersion }}
{{- range .YdxModules }}
{{- $version := index $.YdxVersions . }}
{{- if $version }}
	{{ . }} {{ $version }}
{{- end }}
{{- end }}
{{- if .WAF }}
	{{ .WafModule }} {{ .WafModuleVersion }}
	{{ .WafCRSModule }} {{ .CRSRulesetVersion }}
{{- end }}
)
{{- else }}

// The framework dependencies github.com/shibingli/yd and github.com/shibingli/ydx are pulled in
// by go mod tidy once the modules are published. | 框架依赖 github.com/shibingli/yd 与
// github.com/shibingli/ydx 在模块发布后由 go mod tidy 引入。
// During development, point yd new at a local framework checkout with its --local-replace argument. | 开发期可用 yd new 的 --local-replace 参数指向本地框架仓库。
{{- if .WAF }}

require (
	{{ .WafModule }} {{ .WafModuleVersion }}
	{{ .WafCRSModule }} {{ .CRSRulesetVersion }}
)
{{- end }}
{{- end }}
