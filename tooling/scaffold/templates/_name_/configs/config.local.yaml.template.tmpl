# {{ .Name }} 本地覆盖配置模板（复制为 configs/config.local.yaml；该文件不入库）
# {{ .Name }} local override template (copy it to configs/config.local.yaml; that file is never committed)
#
# 本地文件优先级高于 configs/config.yaml，低于环境变量与命令行参数。
# The local file overrides configs/config.yaml, but stays below environment variables and flags.

server:
  port: 8080

log:
  level: debug       # 本地开发用 debug | debug for local development
  format: console    # 本地开发用人类可读格式 | human-readable format for local development

# 本文件不入库，因此真实主密钥写在这里是安全的；留空时仅 development 回退到内置开发密钥，其它环境拒绝启动。
# This file is never committed, so a real master key belongs here; when empty only development falls back to the development key — other environments refuse to start.
auth:
  master_key: ""
  token_ttl: 12h     # 本地开发把会话放长，免得反复登录 | a longer session locally, so sign-in is not repeated constantly
{{- if ne .DB "none" }}

db:
  driver: {{ .DB }}
  dsn: "{{ .DBDSN }}"
{{- end }}
{{- if .Redis }}

redis:
  addr: 127.0.0.1:6379
{{- end }}
{{- if .Asynq }}

asynq:
  concurrency: 4
{{- end }}
{{- if .GRPC }}

grpc:
  enabled: true
{{- end }}
{{- if .I18n }}

i18n:
  default: zh-CN
{{- end }}
