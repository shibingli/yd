# {{ .Name }} 配置基线（分层配置的最低优先级：框架默认值之上、本地文件之下）
# {{ .Name }} baseline configuration (lowest precedence: above framework defaults, below the local file)
#
# 优先级：命令行参数 > 环境变量(.env) > 配置文件 > 框架默认值
# Precedence: command-line flags > environment variables (.env) > config files > framework defaults
# 环境变量前缀 YD_，下划线映射多级嵌套：YD_SERVER_PORT -> server.port
# Environment variables use the YD_ prefix, underscores map onto nested keys: YD_SERVER_PORT -> server.port

# 节点身份：跨重启、硬件更换、虚机/容器迁移保持稳定的唯一标识。
# Node identity: a stable unique identifier across restarts, hardware replacement and VM/container migration.
#
# 优先级：node.id（显式）> node.id_file（持久文件）> 平台种子（首次创建时写入文件）。
# 多副本生产环境应显式设置 node.id，或把 node.id_file 放到每实例独立的持久卷上；
# 容器重建会丢失临时文件系统上的身份。require_persistent 为 true 时，无法持久化会拒绝启动。
# Precedence: node.id (explicit) > node.id_file (persistent file) > platform seed (written to the file on first use).
# Multi-replica production should set node.id explicitly or put node.id_file on a per-instance durable volume;
# a recreated container loses an identity on its temporary filesystem. With require_persistent=true, an
# identity that cannot be persisted fails startup instead of silently changing.
node:
  id: ""                     # 显式身份；留空自动解析 | explicit identity; empty resolves automatically
  id_file: "data/node-id"    # 相对进程工作目录；每实例独立 | relative to the working directory; per instance
  require_persistent: false  # true：拒绝临时身份/存储 | true rejects an ephemeral identity or storage
  allow_shared_seed: false   # true：容器可用宿主种子（仅单容器主机） | allow host seeds in containers (single-container hosts only)
  salt: ""                   # 推导盐；不是密钥，不要写入日志 | derivation salt; not a secret, never log it

server:
  port: 8080          # 监听端口 | listening port
  h2c: true           # 开启 HTTP/2 Cleartext | enable HTTP/2 Cleartext
  http2:
    # 强制 RFC 8441（WebSocket over HTTP/2）：Chrome/Edge 与 Firefox 会在服务端通告后
    # 走 HTTP/2；Safari 自动回退 HTTP/1.1。为 true 时 yd dev / yd service install /
    # yd docker 自动注入 GODEBUG=http2xconnect=1，裸二进制由 app.Run 重启进程注入。
    # Force RFC 8441 (WebSocket over HTTP/2): Chrome/Edge and Firefox use it once the
    # server advertises it; Safari falls back to HTTP/1.1. When true, yd dev,
    # yd service install and yd docker inject GODEBUG=http2xconnect=1; a bare binary
    # re-execs itself from app.Run.
    extended_connect: true
  http3:
    enabled: false      # 开启 HTTP/3 (QUIC) | enable HTTP/3 (QUIC)
    port: 0             # UDP 端口，0 表示与 TCP 端口相同 | UDP port, 0 reuses the TCP port
    # WebTransport 与 HTTP/3 共用同一条 QUIC 监听（需要 TLS）；浏览器侧 Chrome/Edge/
    # Firefox/Safari 26.4+ 已进入 Baseline，是 HTTP/3 上双向实时通道的推荐方案。
    # WebTransport shares the HTTP/3 QUIC listener (TLS required); it is the recommended
    # bidirectional channel over HTTP/3 and is Baseline in Chrome/Edge, Firefox and
    # Safari 26.4+.
    webtransport: false
  read_timeout: 15s   # 读超时 | read timeout
  write_timeout: 30s  # 写超时 | write timeout

# 实时通道（WebSocket / WebTransport / SSE）的共享中枢。
# Shared hub of the realtime transports (WebSocket / WebTransport / SSE).
realtime:
  node_id: ""                # 留空回退 node.id 与身份文件 | empty falls back to node.id, then the identity file
  queue_size: 256            # 每个订阅者的有界队列 | bounded queue per subscriber
  max_message_bytes: 1048576 # 单条消息上限 | one message limit
  slow_policy: drop          # drop | close：队列满时丢弃或关闭该订阅 | drop or close on a full queue
  channel_prefix: "yd:rt:"   # Redis 频道前缀；同一部署内唯一 | Redis channel namespace, unique per deployment

# Runtime GC scheduling: collects during low-load windows and returns free memory to the OS;
# busy periods are skipped automatically. | 运行时 GC 调度：在低负载窗口触发回收，并把空闲内存
# 归还操作系统；繁忙时自动跳过。
#
# Presets (strategy) | 策略预设：
#   gentle     soft GC every ~30m, strictly idle only | 约 30 分钟一次软回收，只在严格空闲时执行
#   balanced   release GC every ~10m, the default | 约 10 分钟一次释放式回收（默认）
#   aggressive release GC every ~2m, tolerant of load | 约 2 分钟一次释放式回收，对负载更宽容
#   off        no background scheduling; manual RunOnce still works | 关闭后台调度（手动执行 App.RuntimeGC().RunOnce 仍可用）
# Individual keys override the preset; omitted keys keep the preset value. | 单项键覆盖预设；未写出的键继续使用预设值。
gc:
  strategy: balanced
  # enabled: true              # false disables background scheduling | false 关闭后台调度
  # mode: release              # soft = runtime.GC; release = debug.FreeOSMemory | release 归还内存给操作系统
  # interval: 10m
  # max_interval: 1h           # adaptive backoff ceiling | 自适应退避上限
  # sample_interval: 5s        # sampling while waiting for quiet | 等待空闲窗口时的采样间隔
  # quiet_window: 30s          # sustained quiet before collecting | 连续低于阈值的时长
  # load_threshold: 30         # process CPU utilisation percent; 0 disables | 进程 CPU 利用率百分比；0 关闭
  # min_heap: 33554432         # 32 MiB heap floor; 0 disables | 32 MiB 堆下限；0 关闭
  # pressure_ratio: 0.85       # force at this fraction of the memory ceiling; 0 disables | 达到内存上限该比例时强制回收；0 关闭
  # jitter: 0.1                # interval jitter across replicas | 间隔抖动，避免多副本同时回收
  # adaptive: true             # grow the interval when little is reclaimed | 回收量很小时自动增大间隔
  # max_defer: 0               # force after this long busy; 0 = never | 繁忙超过此时长后强制执行；0 = 不强制
  # max_inflight: 0            # treat this many in-flight calls as busy; 0 disables | 在途中间件调用达到此值视为繁忙；0 关闭

log:
  level: info         # debug | info | warn | error
  format: json        # json | console
  caller: true        # 记录调用位置 | record the call site

# yd 自身发起的下载（yd assets、yd versions upgrade、tailwindcss 二进制）使用的 HTTP 代理；
# 留空时遵循标准 HTTP_PROXY / HTTPS_PROXY / NO_PROXY，YD_HTTP_PROXY 同样映射到这里。
# HTTP proxy for downloads performed by yd itself (yd assets, yd versions upgrade, the tailwindcss binary);
# when empty the standard HTTP_PROXY / HTTPS_PROXY / NO_PROXY apply. YD_HTTP_PROXY maps onto this key too.
# http:
#   proxy: http://127.0.0.1:10809

# 默认数据（种子）：只在租户表为空时写入一次，写什么由框架注册表决定（默认租户、四个内置角色及其能力绑定、该租户的所有者账号）。
# Default data (the seed): written exactly once, only while the tenant table is empty, and what it writes comes from the framework
# registry (the default tenant, the four built-in roles with their capability bindings, its owner account).
#
# tenant / username 与 admin_password 一样只在租户表为空时生效；已有数据后修改不会迁移既有租户或账号。
# tenant and username, like admin_password, apply only while the tenant table is empty; changing them later does not
# migrate an existing tenant or account.
#
# admin_password 未配置时的行为按 app.env 分流：development 回退到 internal/meta 里那个文档化口令并每次启动告警；
# 其它任何环境（production / staging 等非 development 取值）**拒绝写入种子数据**并告警——绝不会用默认口令在生产开出管理员账号。
# 注意：app.env 未设置时框架默认值是 development，因此生产部署必须显式设置 YD_APP_ENV=production（或 app.env: production）。
# 运行环境接受完整名与短别名：development|dev、production|prod，忽略大小写与首尾空白。
# The runtime environment accepts full names and short aliases: development|dev and production|prod, case-insensitive
# and ignoring surrounding blanks.
# An unset admin_password is answered differently per app.env: development falls back to the documented password in internal/meta
# and warns on every start, while any other environment (production, staging, anything other than development) refuses the seed
# with a warning — a default password never opens an administrator account in production. Note that app.env defaults to
# development when unset, so a production deployment must set YD_APP_ENV=production (or app.env: production) explicitly.
seed:
  tenant: default      # 默认租户标识；留空回退到 internal/meta.SeedTenantSlug，YD_SEED_TENANT 覆盖本项 | default tenant key; empty falls back to internal/meta.SeedTenantSlug, YD_SEED_TENANT overrides it
  username: admin      # 管理员登录名；留空回退到 internal/meta.SeedAdminUsername，YD_SEED_USERNAME 覆盖本项 | administrator sign-in name; empty falls back to internal/meta.SeedAdminUsername, YD_SEED_USERNAME overrides it
  admin_password: ""   # override with YD_SEED_ADMIN_PASSWORD; production must inject it rather than rely on the development fallback | 由 YD_SEED_ADMIN_PASSWORD 覆盖；生产环境必须注入，不要依赖开发回退

# 鉴权与会话：主密钥封装每个用户的 sec_key，改动它等于让此前签发的全部令牌失效。
# Authentication and sessions: the master key seals every user's sec_key, and changing it invalidates every token issued so far.
auth:
  master_key: ""      # production must inject it through YD_AUTH_MASTER_KEY; empty refuses to start outside development and falls back to the development key with a warning only in development | 生产环境必须通过 YD_AUTH_MASTER_KEY 注入；非 development 留空会拒绝启动，仅开发环境回退到开发密钥并告警
  token_ttl: 2h       # token lifetime, shared with the MaxAge of the sign-in cookie | 令牌有效期，登录 cookie 的 MaxAge 与它同源
{{- if ne .DB "none" }}
  # Ceiling of one auth statement; 0 keeps the framework default (no extra bound). | 单条鉴权语句的上限；0 表示沿用框架默认值（不额外设限）。
  gorm:
    query_timeout: 0
{{- end }}

# 人机验证（验证码）：接线始终随项目生成，这里只决定是否在登录与修改口令时要求验证。
# Human verification (captcha): the wiring always ships with the project; these switches decide
# whether sign-in and password changes require it.
captcha:
  login: {{ if .Captcha }}true{{ else }}false{{ end }}            # 登录时要求验证码 | require verification on sign-in
  password_change: {{ if .Captcha }}true{{ else }}false{{ end }}  # 修改口令时要求验证码 | require verification when changing the password
  # 生产环境必须通过 YD_CAPTCHA_SECRET 注入；development 留空时回退到文档化开发密钥并每次启动告警。
  # 其它环境留空会拒绝启动。| Production must inject it through YD_CAPTCHA_SECRET; in development an empty
  # value falls back to the documented development secret with a warning on every start, while every other
  # environment refuses to start.
  secret: ""
  # auto：优先 Redis，不可用时按 fallback 处理；memory：仅单机；redis：要求 Redis。
  # auto prefers Redis and applies fallback when it is unavailable; memory is single-node only;
  # redis requires Redis and still applies fallback.
  store: auto
  # Redis 不可用时：memory 降级为进程内存储并告警；fail 拒绝启动（严格多机模式）。
  # When Redis is unavailable: memory degrades to the in-process store with a warning; fail refuses
  # to start, which is what a strict multi-replica deployment wants.
  fallback: memory
  # 启用可用键盘完成的视觉题型。click_text / click_icon / semantic / slide 只支持指针，
  # 需要无障碍替代方案时才显式加入；留空表示全部内置题型，会随机出到仅指针题型。
  # Keyboard-operable visual types. click_text / click_icon / semantic / slide are pointer-only; add them explicitly
  # only when an accessible alternative exists. Empty means every built-in type, including the pointer-only ones.
  types: [text, rotate]
  # Redis 键命名空间；同一部署内唯一，多个应用共享同一 Redis 时必须区分。
  # Redis key namespace; unique per deployment and required when several applications share one Redis.
  key_prefix: "yd:captcha:"
  # 反向代理的 CIDR 列表（也可写单个 IP）；为空时只信任直接对端地址。仅在应用确实位于可信代理之后时配置，
  # 否则客户端可以伪造 X-Forwarded-For 绕过按 IP 限流。
  # CIDR list of reverse proxies (a bare IP is accepted too); empty trusts only the direct peer. Configure it only
  # when the application really sits behind a trusted proxy, otherwise clients could forge X-Forwarded-For and
  # bypass the per-IP limits.
  trusted_proxies: []

{{- if ne .DB "none" }}

# Database: tenants, users, roles and permissions live here, so the data survives a restart. | 数据库：租户、用户、角色与权限都存在这里，重启后数据仍在。
db:
  driver: {{ .DB }}   # mysql | postgres | sqlite | dm
  dsn: "{{ .DBDSN }}"
  maxconn: 100        # ceiling of the connection pool | 连接池上限
  maxidle: 10         # idle connections kept in the pool | 池中保留的空闲连接数
  slow_threshold: 200ms   # slow query threshold | 慢查询阈值
{{- end }}

redis:
  mode: single        # single | sentinel | cluster
  addr: 127.0.0.1:6379
  password: ""        # YD_REDIS_PASSWORD | optional Redis AUTH password
  db: 0
  pool_size: 100

# Two-level cache: local L1 ring plus Redis L2; degrades to local-only when Redis is unreachable. | 二级缓存：L1 本地环形缓存 + L2 Redis；Redis 不可达时自动降级为仅本地。
cache:
  prefix: "yd:cache:"     # Redis key prefix | Redis 键前缀
  lease: 30s              # L1 revalidation lease | L1 重新确认租约
  load_timeout: 30s       # shared loader ceiling | 共享加载上限
  event_buffer: 256       # subscriber queue | 订阅队列
  fail_open: true         # keep reads working when Redis is down | Redis 故障时读继续可用
  tombstone_ttl: 1h       # delete marker lifetime | 删除标记存活时间
  max_cost: 67108864      # 64 MiB; 0 = derive from memory | 64 MiB；0 = 由内存推导
  shards: 0               # 0 = derive from GOMAXPROCS | 0 = 由 GOMAXPROCS 推导
  max_entry_size: 0       # 0 = derive from shard size | 0 = 由分片大小推导
  cleanup_interval: 1s    # background TTL sampler | 后台 TTL 采样
  sample_size: 256        # entries per shard per sweep | 每分片每轮检查条目数
  redis:
    prefix: ""            # empty = redis.key_prefix + cache.prefix | 空 = redis.key_prefix + cache.prefix
    channel: ""           # empty = prefix + events | 空 = prefix + events
    subscribe_buffer: 64
    health_interval: 30s
{{- if ne .DB "none" }}
  gorm:
    enabled: true         # cache SELECT queries by default | 默认缓存 SELECT 查询
    namespace: gorm
    ttl: 30s
    tables: []            # empty = every table not listed in ignore_tables | 空 = 未列入 ignore_tables 的所有表
    # 鉴权数据分级：
    # - yd_auth_users 含口令散列、sec_key 密文与状态，永不缓存；令牌校验因此始终读库，
    #   禁用/删除用户与轮换 sec_key 立即生效。
    # - 成员关系、角色、权限与租户进入独立敏感命名空间，短 TTL + 提交后失效。
    # - 消息表属于常规数据，正常缓存；消息存储与鉴权存储都在事务提交后显式失效。
    # - 高安全/涉密接口在路由层用 CacheBypass 整体跳过读取（见 internal/router）。
    # Auth data is classified:
    # - yd_auth_users carries password hashes, sealed sec_key and status and is never cached, so
    #   token verification always reads the database and revocation is immediate.
    # - memberships, roles, permissions and tenants use a separate sensitive namespace with a
    #   short TTL and post-commit invalidation.
    # - message tables are regular data and use the normal cache; both the message store and the
    #   auth store invalidate explicitly after their transactions commit.
    # - high-security/classified routes bypass every cache read via CacheBypass (see internal/router).
    ignore_tables:
      - yd_auth_users
    sensitive_tables:
      - yd_auth_tenants
      - yd_auth_user_tenants
      - yd_auth_roles
      - yd_auth_role_permissions
    sensitive_namespace: "gorm.sensitive"  # 必须与 namespace 不同 | must differ from namespace
    sensitive_ttl: 5s                      # 鉴权成员/角色的陈旧上界 | staleness bound for auth membership/roles
{{- end }}

asynq:
  queues: "critical:3,default:2,low:1"   # 队列与权重 | queues and weights
  concurrency: 10                        # 并发消费者数 | concurrent consumers
{{- if .GRPC }}

grpc:
  enabled: true
  port: 9090
  max_recv_bytes: 4194304   # 单条消息上限 4MiB | per-message ceiling 4MiB
{{- end }}
{{- if .I18n }}

i18n:
  default_lang: zh-CN
  fallback: en
  dir: configs/i18n
{{- end }}
{{- if .Tailwind }}

tailwind:
  input: {{ .AssetRoot }}/static/css/app.css
  output: {{ .AssetRoot }}/static/css/yd.css
  minify: true
{{- end }}

# 生产期共享脚本合并：每个 bundle 文件的上限（字节），默认 128 KiB。
# `YD_BUNDLE_MAX_BYTES` 可覆盖；单个源文件本身超过上限时单独成块并在启动日志中告警。
# Production shared-script bundling: the maximum bytes per bundle file, 128 KiB by default.
# `YD_BUNDLE_MAX_BYTES` overrides it; a single source file larger than the limit becomes its own
# chunk and is reported in the startup log.
bundle:
  max_bytes: 131072

# 站内消息中心：撤回/编辑窗口、附件与群成员上限、以及多节点实时总线。
# In-app message centre: recall/edit windows, attachment and group limits, and the multi-node realtime bus.
#
# Redis 与 asynq 随每个生成项目内建：实时事件经 Redis Pub/Sub 跨节点广播，广播失败的写入进入 asynq
# 持久重试队列。Redis 不可达时会告警并退回进程内总线，单节点开发无需先启动 Redis。
# 多副本部署请为每个副本设置唯一的 node.id（或 YD_NODE_ID）；message.node_id 是兼容别名，留空时使用 node 身份。
# Redis and asynq ship with every generated project: realtime events broadcast across nodes through Redis Pub/Sub, and a
# failed broadcast enters the durable asynq retry queue. An unreachable Redis warns and falls back to the in-process bus,
# so single-node development needs no Redis running. In a multi-replica deployment give each replica a unique node.id
# (or YD_NODE_ID); message.node_id is a compatibility alias that defaults to the node identity.
message:
  recall_window: 5m          # 普通用户撤回窗口 | recall window for a regular author
  edit_window: 5m            # 普通用户编辑窗口 | edit window for a regular author
  max_attachments: 10        # 单条消息附件数上限 | attachments per message
  max_attachment_size: 20971520   # 单文件上限（字节，20 MiB） | per-file ceiling in bytes (20 MiB)
  max_group_members: 50      # 群成员上限 | group member ceiling
  page_size: 20              # 列表默认页长 | default page length
  attachment_dir: data/attachments  # 本地附件目录（相对进程工作目录） | local attachment directory (relative to the process working directory)
  pending_ttl: 24h           # 未挂载上传的保留时长 | how long an unattached upload survives
  node_id: ""                # 兼容别名；留空使用 node.id | compatibility alias; empty uses node.id
  # allowed_types:           # optional attachment MIME allow list; empty uses the framework default | 可选附件 MIME 白名单；留空使用框架默认值
  #   - image/png
  #   - image/jpeg
  #   - application/pdf
  #   - text/plain

# 系统服务：yd service <install|uninstall|start|stop|restart|status> 与入口的 -service <动作> 都读这一段。
# 服务名缺省回退到 app.name，显示名回退到服务名，描述回退到显示名；全部键都可由 YD_SERVICE_* 覆盖。
# 改动这一段之后要重新安装服务（yd service install）才会写进服务管理器。
# System service: both `yd service <install|uninstall|start|stop|restart|status>` and the -service <action> argument
# of the entry point read this section. The service name falls back to app.name, the display name to the service name
# and the description to the display name; every key is overridable through YD_SERVICE_*. A change here only reaches
# the service manager after the service is installed again (yd service install).
service:
  name: {{ .Name }}          # 服务名（建议不含空格） | service name (spaces are best avoided)
  display_name: {{ .Name }}  # 服务管理器展示的显示名 | display name shown by the service manager
  description: 由 yd 脚手架生成的 {{ .Name }} 常驻服务 | the {{ .Name }} daemon generated by the yd scaffold
  arguments:                 # 服务启动参数；-service run 让入口显式进入服务模式 | start arguments; -service run enters service mode explicitly
    - -service
    - run
  working_directory: ""      # 初始工作目录（Windows 忽略）；建议留空，路径经 YD_ 环境变量传入 | initial working directory (ignored on Windows); prefer leaving it empty and passing paths through YD_ variables
  user_name: ""              # 运行账号；留空表示服务管理器缺省账号 | run-as account; empty means the service manager default
  restart_on_exit: true      # 异常退出后自动重启（Windows OnFailure=restart，POSIX Restart=always） | restart after an unexpected exit (Windows OnFailure=restart, POSIX Restart=always)
  env:                       # 服务的额外环境变量；列表形式保留键名大小写，映射形式会被配置引擎转为小写 | extra environment variables; the list form keeps the name case, the mapping form is lower-cased
    - YD_SERVER_PORT=8080

# Image packaging without a Dockerfile | 无 Dockerfile 打包
# `yd ko` builds the image straight from the Go sources by driving the external ko CLI, which is NOT a Go dependency of this project | `yd ko` 驱动 ko 外部 CLI 从 Go 源码直出容器镜像，ko 不是本项目的 Go 依赖
# It stands next to `yd docker` (a multi-stage Dockerfile build), and both paths must yield the same artifact: a CGO_ENABLED=0 statically linked binary | 它与 yd docker（多阶段 Dockerfile 构建）并列，两条路径都必须产出 CGO_ENABLED=0 静态链接的二进制
# Binary resolution order: --binary -> YD_KO_BIN -> <project>/.yd/tools/ko[.exe] -> PATH | 二进制解析顺序：--binary -> YD_KO_BIN -> <项目>/.yd/tools/ko[.exe] -> PATH
# A missing ko only fails `yd ko` with an install hint (go install github.com/google/ko@latest); it never blocks build, dev or test | ko 缺失只让 yd ko 报错并给出安装提示（go install github.com/google/ko@latest），不阻塞 build/dev/test
# Every key below is overridable through the YD_KO_* prefix: YD_KO_REPOSITORY -> ko.repository, and so on | 下面每个键都可由 YD_KO_* 前缀覆盖：YD_KO_REPOSITORY -> ko.repository，其余同理
ko:
  binary: ""            # path to the ko binary; empty follows the resolution order above | ko 可执行文件路径；留空按上面的顺序解析
  repository: ""        # image repository handed to ko as KO_DOCKER_REPO; required only when ko.local=false (the default below builds locally) | 镜像仓库，作为 KO_DOCKER_REPO 传给 ko；仅在 ko.local=false 时需要（下方默认本地构建）
  tags: []              # image tags such as [latest, v1.0.0]; empty keeps ko's default latest | 镜像标签，如 [latest, v1.0.0]；留空沿用 ko 缺省的 latest
  platforms: []         # target platforms such as [linux/amd64, linux/arm64]; empty takes every platform the base image supports | 目标平台，如 [linux/amd64, linux/arm64]；留空取基础镜像支持的全部平台
  base_image: ""        # base image override (KO_DEFAULTBASEIMAGE); on an intranet point it at a locally cached image | 覆盖基础镜像（KO_DEFAULTBASEIMAGE）；内网填本地缓存的基础镜像地址
  packages: []          # Go packages to build such as [./cmd/app]; empty uses the project entry point | 要打包的 Go 包，如 [./cmd/app]；留空用项目入口
  ldflags: ["-s -w"]    # linker flags, repeated as --ldflags; the default strips symbols and DWARF; an empty list keeps them | 链接参数，逐个以 --ldflags 传入；默认去掉符号表与 DWARF；空列表则保留
  local: true           # a fresh project has no registry, so `yd ko` loads into the local docker daemon by default; pass --local=false (or ko.local=false) together with --repo for registry delivery | 新项目没有仓库，`yd ko` 默认载入本地 docker 守护进程；面向仓库交付时传 --local=false（或 ko.local=false）并配 --repo
  push: false           # true equals ko's --push: push to the repository once the build succeeds | true 等价于 ko 的 --push：构建成功后推送到 repository

# Binary compression | 二进制压缩
# `yd docker` and `yd ko` compress binaries smaller than 1 GiB with the embedded UPX 5.2.1 by default;
# --no-upx or upx.enabled=false keeps them uncompressed. | 两条打包路径默认用嵌入的 UPX 5.2.1 压缩小于
# 1 GiB 的产物；--no-upx 或 upx.enabled=false 关闭。
upx:
  enabled: true         # false skips the UPX step in both image commands | false 表示两条镜像命令都跳过 UPX
  bin: ""               # external UPX 5.2.1+; empty uses the embedded payload | 外部 UPX 5.2.1+；留空使用嵌入 payload
