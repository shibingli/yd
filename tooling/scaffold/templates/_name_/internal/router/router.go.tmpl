// Package router 把控制器挂载到路由表，并集中登记本项目的可选特性。
// Package router mounts controllers onto the mux and keeps the project's optional features in one place.
//
// 本包同时是鉴权链路的装配处与 OpenAPI 文档的装配处：注解写在处理器上（见 docs/developer_guidelines.md §9.2），
// 文档在启动时由路由树与注解合并生成，因此新增端点后无需再手工维护任何清单。
// This package assembles both the authentication chain and the OpenAPI document: annotations live on the handlers (see
// docs/developer_guidelines.md §9.2) and the document is merged from the route tree and those annotations at startup, so
// no hand-maintained list has to follow a new endpoint.
package router

import (
	"context"
	"strings"
	"time"

	"{{ .Module }}/internal/controller"
	"{{ .Module }}/internal/meta"
	"{{ .Module }}/internal/middleware"
	"{{ .Module }}/internal/repository"
	"{{ .Module }}/internal/service"
	"{{ .YdModule }}/core/afs"
	"{{ .YdModule }}/runtime/app"
	"{{ .YdModule }}/security/auth"
	"{{ .YdModule }}/security/authz"
	"{{ .YdModule }}/core/errx"
	"{{ .YdModule }}/core/logx"
	"{{ .YdModule }}/http/openapi"
	ydrouter "{{ .YdModule }}/http/router"
	"{{ .YdModule }}/http/sse"
)

// 对外契约常量：路径与静态前缀在这里声明一次，文档、中间件与测试都引用它们。
// Public contract constants: paths and the static prefix are declared once here and referenced by the document, by
// middleware and by tests.
const (
	// OpenAPIPath is the endpoint serving the OpenAPI JSON document, matching the framework default. | OpenAPIPath 是 OpenAPI JSON 文档的端点，与框架默认值一致。
	OpenAPIPath = "/openapi.json"
	// DocsPath is the endpoint serving the built-in documentation viewer, matching the framework default. | DocsPath 是内置文档查看器的端点，与框架默认值一致。
	DocsPath = "/docs"
	// StaticPrefix is the static asset prefix, matching the mount point of app.Default. | StaticPrefix 是静态资源前缀，与 app.Default 的挂载点一致。
	StaticPrefix = "/static"
	// AnnotationDir is the source directory holding the OpenAPI annotations. | AnnotationDir 是存放 OpenAPI 注解的源码目录。
	AnnotationDir = "internal"

	// LoginPath is the sign-in page and the sign-in submission: every anonymous browsing request lands here. | LoginPath 是登录页与登录提交的端点：未登录的浏览请求都被送到这里。
	LoginPath = "/login"
)

// 鉴权配置键：与 configs/config.yaml 的 auth 段一一对应，可用环境变量覆盖（YD_AUTH_MASTER_KEY、YD_AUTH_TOKEN_TTL）。
// Authentication configuration keys: they match the auth section of configs/config.yaml and can be overridden through
// environment variables (YD_AUTH_MASTER_KEY, YD_AUTH_TOKEN_TTL).
const (
	// configMasterKey is the master key sealing every per-user sec_key. | configMasterKey 是封装每用户 sec_key 的主密钥。
	configMasterKey = "auth.master_key"
	// configTokenTTL is the token lifetime, written as "2h" and the like. | configTokenTTL 是令牌有效期，取值形如 "2h"。
	configTokenTTL = "auth.token_ttl"
)

// 装配期哨兵错误：Register 返回的错误都能用 errors.Is 判定到其中某一个。
// Assembly sentinels: every error returned by Register satisfies errors.Is against one of them.
var (
	// ErrNilApp reports a nil facade. | ErrNilApp 表示传入的门面为空。
	ErrNilApp = errx.New("router: nil application facade | router：应用门面为空")
	// ErrAuth reports a failed auth store, master key or token issuer assembly. | ErrAuth 表示鉴权存储、主密钥或令牌签发器装配失败。
	ErrAuth = errx.New("router: authentication service unavailable | router：鉴权服务装配失败")
	// ErrSeed reports a failed default seed write. | ErrSeed 表示默认数据写入失败。
	ErrSeed = errx.New("router: default seed failed | router：默认数据写入失败")
	// ErrTicker reports a failed realtime publisher start. | ErrTicker 表示实时推送器启动失败。
	ErrTicker = errx.New("router: realtime publisher failed to start | router：实时推送启动失败")
)

// Register 把全部端点登记到应用门面上。
// Register mounts every endpoint on the application facade.
//
// 返回值而非直接 panic：装配失败必须由 main 统一记录并决定退出码，库代码不替调用方决定进程命运。
// It returns an error rather than panicking: main records the failure and decides the exit code, and library code never
// decides the process's fate for its caller.
func Register(a *app.App) error {
	if a == nil {
		return ErrNilApp
	}

	// 存储与鉴权服务在整个进程里只有一份：登录签发的令牌与中间件校验的令牌因此必然出自同一个签发器与同一份 sec_key。
	// One store and one auth service per process: the token signed at sign-in and the token verified by the middleware can
	// only ever come from the same issuer and the same sec_key.
	key, err := masterKey(a)
	if err != nil {
		return errx.Wrap(err, ErrAuth)
	}
	store, err := repository.Open(repository.Options{
		Config:    a.Config(),
		Log:       a.Logger(),
		MasterKey: key,
		Issuer:    meta.TokenIssuerName,
		TTL:       tokenTTL(a),
	})
	if err != nil {
		return errx.Wrap(err, ErrAuth)
	}
	a.OnShutdown(func(context.Context) error { return store.Close() })

	// 默认数据只在租户表为空时创建，而且没有配置种子口令时不会创建任何账号；既有租户每次启动只补齐内置角色
	// 缺失的能力绑定（只增不减），因此升级后新增的能力立即可用。
	// The default data is created only while the tenant table is empty, and no account is created without a seed
	// password; an existing tenant only gets its missing built-in capabilities reconciled on each start (add-only), so a
	// capability introduced by an upgrade is usable immediately.
	if err := store.Seed(context.Background()); err != nil {
		return errx.Wrap(err, ErrSeed)
	}

	ctrl, err := controller.New(a, store, a.Logger())
	if err != nil {
		return errx.Wrap(err, ErrAuth)
	}

	// 事件广播器与推送器由路由层持有：它们是端点的基础设施，不是业务状态。
	// The broker and the publisher are owned here: they are endpoint infrastructure, not business state.
	broker := sse.NewBroker(sse.BrokerOptions{})
	ticker := service.NewTicker(broker, service.DefaultTickInterval)

	registerPublic(a, ctrl)
	registerProtected(a, ctrl, store, broker, ticker)

	if err := startTicker(a, ticker, broker); err != nil {
		return err
	}
	startMessageRuntime(a, ctrl)

	registerOpenAPI(a)
	registerFeatures(a)
	return nil
}

// registerPublic 登记匿名可达的端点：登录页、登录提交、登出、健康检查与 SM2 公钥。
// registerPublic mounts the anonymously reachable endpoints: the sign-in page, the sign-in submission, sign-out, the
// health probe and the SM2 public key.
//
// 公开组仍然跑租户中间件（Required 为 false）：匿名请求可以用子域名或 X-Tenant 定位租户，
// 而 Required 为 false 保证了一个什么也没指明的请求照样能渲染出登录表单；登录表单本身不带租户字段。
// The public group still runs the tenant middleware with Required false: the sign-in page has to know which tenant
// acme.example.com names in order to pre-fill the field, while Required false keeps a request that names no tenant
// renderable.
func registerPublic(a *app.App, ctrl *controller.Controller) {
	// 同一个租户中间件也挂在受保护组上：注册表按 Name 合并，因此两个分组共享一份计数。
	// The same tenant middleware is mounted on the protected group too: the registry merges by Name, so both
	// groups share one set of counters.
	g := a.Group("", a.MiddlewareMetrics().Wrap(
		middleware.MetricsDescriptor("tenant"),
		middleware.Tenant(middleware.TenantOptions{
			Resolver:     ctrl.ResolveTenant,
			ErrorHandler: ctrl.Deny,
		}),
	))

	g.GET(LoginPath, ctrl.LoginPage)
	g.POST(LoginPath, ctrl.Login)
	// 登出是幂等的清理动作，刻意公开：cookie 里那枚令牌早已失效时，仍然要能把它扔掉。
	// Sign-out is an idempotent cleanup and is deliberately public: a cookie whose token is long dead must still be droppable.
	g.POST("/logout", ctrl.Logout)
	g.GET("/healthz", ctrl.Health)
	g.GET("/guomi/pubkey", ctrl.Pubkey)
}

// registerProtected 登记需要有效会话的业务端点，并按能力逐条挂上权限守卫。
// registerProtected mounts the business endpoints that need a valid session and hangs one permission guard on each.
//
// The order of the chain is itself the argument and must not be reshuffled: | 链路顺序本身就是一条论证，不能调换：
//  1. Promote lifts the cookie token into Authorization, after which browsers and API clients share one path; | middleware.Promote —— 把 cookie 里的令牌提升为 Authorization，浏览器与 API 客户端从此走同一条路径；
//  2. auth.Middleware verifies the signature, the validity and the per-user sec_key and stores the user in the context; | auth.Middleware —— 校验签名、有效期与每用户 sec_key，并把用户放进上下文；
//  3. authz.Middleware builds the subject of this request from that user, which is what the templates and the front end read; | authz.Middleware —— 用该用户构造本请求的主体，模板与前端读到的就是它；
//  4. middleware.Tenant settles the tenant from the token's tid claim and refuses a header or subdomain naming another tenant with 403. | middleware.Tenant —— 以令牌的 tid 声明为准定租户，请求头或子域名指向别的租户即 403。
//
// 第三层必须排在第二层之后：它读的正是第二层放进上下文的用户，排到前面只会得到一个匿名主体。
// 第四层必须排在第二层之后：它优先信任令牌，而令牌正是第二层校验的产物；顺序颠倒会让任何请求头都变成可信输入。
// The third layer must follow the second: it reads the very user the second layer put into the context, and ahead of it
// would build an anonymous subject. The fourth must follow the second as well: it trusts the token first, and the token is
// the product of the second layer — the other order would turn any request header into trusted input.
//
// 权限守卫只挂在业务端点上：首页、实时演示、账号页与两个占位图只要求「有一个有效会话」，
// 因为它们展示的是「我是谁」，而不是「我能不能动别人的数据」。
// The guards hang on the business endpoints only: the home page, the realtime demo, the account page and the two
// placeholders require nothing beyond a valid session, because what they show is who I am and not whether I may touch
// somebody else's data.
//
// 守卫一律写成 authz.Require(authz.PermXxx)：引用取自注册表而非字面量，写错的名字在装配期就会被点名，
// 而且 authz.Middleware 已在链上，主体因此必然存在（缺装配时 Require 走的是同一条 403 路径）。
// Every guard is written as authz.Require(authz.PermXxx): the reference comes from the registry rather than from a
// literal, a misspelled name is named at wiring time, and the subject is guaranteed to exist because authz.Middleware is
// on the chain (without it the guard takes the very same 403 path).
// generatedMounts is filled by the init functions of files generated by yd gen. Each mount receives
// the fully assembled protected group (auth + authz + tenant) and the store, so a generated module
// is reachable without editing this file by hand. | generatedMounts 由 yd gen 生成文件的 init 填充。
// 每个挂载函数接收装配完成的受保护分组（鉴权 + 授权 + 租户）与存储，使生成模块无需手工编辑本文件
// 即可被访问。
var generatedMounts []func(*ydrouter.Group, *repository.Store)

// registerGeneratedMount appends one generated module's mount function. | registerGeneratedMount
// 追加一个生成模块的挂载函数。
func registerGeneratedMount(fn func(*ydrouter.Group, *repository.Store)) {
	if fn != nil {
		generatedMounts = append(generatedMounts, fn)
	}
}

// mountGenerated runs every generated mount inside the protected group. | mountGenerated 在受保护分组中
// 执行全部生成模块的挂载函数。
func mountGenerated(g *ydrouter.Group, store *repository.Store) {
	for _, fn := range generatedMounts {
		fn(g, store)
	}
}

func registerProtected(a *app.App, ctrl *controller.Controller, store *repository.Store, broker *sse.Broker, ticker *service.Ticker) {
	g := a.Group("",
		a.MiddlewareMetrics().Wrap(
			middleware.MetricsDescriptor("promote"),
			middleware.Promote(middleware.SessionOptions{}),
		),
		a.MiddlewareMetrics().Wrap(
			middleware.MetricsDescriptor("auth"),
			auth.Middleware(auth.MiddlewareOptions{Issuer: ctrl.Issuer(), ErrorHandler: ctrl.Deny}),
		),
		a.MiddlewareMetrics().Wrap(
			middleware.MetricsDescriptor("authz"),
			authz.Middleware(ctrl.Auth()),
		),
		a.MiddlewareMetrics().Wrap(
			middleware.MetricsDescriptor("tenant"),
			middleware.Tenant(middleware.TenantOptions{
				Required:     true,
				Subdomain:    true,
				Resolver:     ctrl.ResolveTenant,
				ErrorHandler: ctrl.Deny,
			}),
		),
	)

	// 会话即可访问：个人落地页、账号自助、租户切换与实时演示。
	// Session-only: the personal landing page, self-service account actions, the tenant switch and the realtime demo.
	g.GET("/", ctrl.Index)
	g.GET("/metrics", ctrl.Metrics)
	g.GET("/metrics/middleware", ctrl.MiddlewareMetrics)
	g.GET("/realtime", ctrl.Page)
	g.GET("/account", ctrl.Account)
	g.POST("/account/password", ctrl.ChangePassword)
	g.POST("/account/sec-key", ctrl.RotateSecKey)
	// 切换租户只要求「是目标租户的成员」，成员关系本身就是授权；默认租户同理。
	// The tenant switch requires only membership of the target tenant, which is itself the
	// authorization; the same holds for the default-tenant choice.
	g.POST("/tenant/switch", ctrl.SwitchTenant)
	g.POST("/account/default-tenant", ctrl.SetOwnDefaultTenant)

	// 占位图端点：既是混合捕获模式的活文档，也是「静态资源必须带会话」的样板。
	// The placeholder endpoints: living documentation of the mixed capture patterns and the template for "even an asset needs a session".
	g.GET("/avatar/:id.jpg", ctrl.Avatar)
	g.GET("/report/:id-xx.png", ctrl.Report)

	// 实时通道：SSE 与 WebSocket 共用同一个推送器。
	// The realtime channels: SSE and WebSocket share one publisher.
	g.GET("/events", ctrl.Stream(broker))
	g.GET("/ws", ctrl.Socket(ticker))
	g.GET("/ws/metrics", ctrl.MetricsSocket())

	// 站内消息中心：读、发、改、撤、置顶、类型目录与审计各自对应注册表里的一条能力。
	// The in-app message centre: reading, sending, editing, recalling, pinning, the type catalogue and the audit trail
	// each map onto one capability of the registry.
	g.GET("/messages", ctrl.Messages, authz.Require(authz.PermMessageRead))
	g.GET("/messages/list", ctrl.MessageList, authz.Require(authz.PermMessageRead))
	g.GET("/messages/conversations", ctrl.MessageConversations, authz.Require(authz.PermMessageRead))
	g.GET("/messages/direct/:id", ctrl.OpenDirectConversation, authz.Require(authz.PermMessageSend))
	g.POST("/messages", ctrl.SendMessage, authz.Require(authz.PermMessageSend))
	g.GET("/messages/system/new", ctrl.NewSystemDrawer, authz.Require(authz.PermMessageSystem))
	g.POST("/messages/system", ctrl.SendSystemMessage, authz.Require(authz.PermMessageSystem))
	g.GET("/messages/admin", ctrl.MessageAdmin, authz.Require(authz.PermMessageManage))
	g.GET("/messages/admin/audit", ctrl.MessageAudit, authz.Require(authz.PermMessageManage))
	g.POST("/messages/attachments", ctrl.UploadMessageAttachment, authz.Require(authz.PermMessageSend))
	g.GET("/messages/attachments/:id", ctrl.DownloadMessageAttachment, authz.Require(authz.PermMessageRead))
	g.GET("/messages/:id", ctrl.MessageThread, authz.Require(authz.PermMessageRead))
	g.GET("/messages/:id/thread", ctrl.MessageThreadFragment, authz.Require(authz.PermMessageRead))
	g.GET("/messages/:id/history", ctrl.MessageThreadHistory, authz.Require(authz.PermMessageRead))
	g.GET("/messages/:id/edit", ctrl.EditMessageDrawer, authz.Require(authz.PermMessageUpdate))
	g.POST("/messages/:id", ctrl.UpdateMessage, authz.Require(authz.PermMessageUpdate))
	g.POST("/messages/:id/recall", ctrl.RecallMessage, authz.Require(authz.PermMessageDelete))
	g.POST("/messages/:id/revoke", ctrl.RevokeSystemMessage, authz.Require(authz.PermMessageSystem))
	g.POST("/messages/:id/read", ctrl.MarkMessageRead, authz.Require(authz.PermMessageRead))
	g.POST("/messages/:id/pin", ctrl.PinMessage, authz.Require(authz.PermMessageManage))
	g.POST("/messages/:id/unpin", ctrl.UnpinMessage, authz.Require(authz.PermMessageManage))
	g.GET("/messages/:id/pin", ctrl.PinMessageDrawer, authz.Require(authz.PermMessageManage))
	g.POST("/messages/groups", ctrl.CreateMessageGroup, authz.Require(authz.PermMessageSend))
	g.GET("/messages/groups/:id/settings", ctrl.MessageGroupDrawer, authz.Require(authz.PermMessageSend))
	g.POST("/messages/groups/:id/members", ctrl.ChangeMessageGroupMember, authz.Require(authz.PermMessageSend))
	g.POST("/messages/groups/:id/rename", ctrl.RenameMessageGroup, authz.Require(authz.PermMessageSend))
	g.POST("/messages/groups/:id/leave", ctrl.LeaveMessageGroup, authz.Require(authz.PermMessageSend))
	g.POST("/messages/groups/:id/dissolve", ctrl.DissolveMessageGroup, authz.Require(authz.PermMessageSend))

	// 好友生命周期：申请、接受/拒绝/取消、删除、拉黑与备注。
	// The friend lifecycle: request, accept/reject/cancel, remove, block and remark.
	g.GET("/friends", ctrl.Friends, authz.Require(authz.PermMessageRead))
	g.GET("/friends/summary", ctrl.FriendSummaryFragment, authz.Require(authz.PermMessageRead))
	g.GET("/friends/search", ctrl.FriendSearch, authz.Require(authz.PermMessageRead))
	g.GET("/friends/new", ctrl.NewFriendRequestDrawer, authz.Require(authz.PermMessageRead))
	g.POST("/friends/requests", ctrl.SendFriendRequest, authz.Require(authz.PermMessageRead))
	g.POST("/friends/requests/:id/accept", ctrl.AcceptFriendRequest, authz.Require(authz.PermMessageRead))
	g.POST("/friends/requests/:id/reject", ctrl.RejectFriendRequest, authz.Require(authz.PermMessageRead))
	g.POST("/friends/requests/:id/cancel", ctrl.CancelFriendRequest, authz.Require(authz.PermMessageRead))
	g.GET("/friends/:id/remark", ctrl.FriendRemarkDrawer, authz.Require(authz.PermMessageRead))
	g.POST("/friends/:id/remark", ctrl.SetFriendRemark, authz.Require(authz.PermMessageRead))
	g.POST("/friends/:id/remove", ctrl.RemoveFriend, authz.Require(authz.PermMessageRead))
	g.POST("/friends/:id/block", ctrl.BlockFriend, authz.Require(authz.PermMessageRead))
	g.POST("/friends/:id/unblock", ctrl.UnblockFriend, authz.Require(authz.PermMessageRead))

	// 消息类型、分组与标签：读目录与生命周期管理分开。
	// Message types, groups and labels: reading the catalogue is separate from its lifecycle.
	g.GET("/message-settings", ctrl.MessageSettings, authz.Require(authz.PermMessageTypeRead))
	g.GET("/message-settings/body", ctrl.MessageSettingsBody, authz.Require(authz.PermMessageTypeRead))
	g.GET("/message-settings/types/new", ctrl.NewMessageTypeDrawer, authz.Require(authz.PermMessageTypeManage))
	g.GET("/message-settings/types/:key/edit", ctrl.EditMessageTypeDrawer, authz.Require(authz.PermMessageTypeManage))
	g.POST("/message-settings/types", ctrl.SaveMessageType, authz.Require(authz.PermMessageTypeManage))
	g.POST("/message-settings/types/:key/archive", ctrl.ArchiveMessageType, authz.Require(authz.PermMessageTypeManage))
	g.POST("/message-settings/types/:key/restore", ctrl.RestoreMessageType, authz.Require(authz.PermMessageTypeManage))
	g.POST("/message-settings/types/:key/delete", ctrl.DeleteMessageType, authz.Require(authz.PermMessageTypeManage))
	g.GET("/message-settings/tags/new", ctrl.NewMessageTagDrawer, authz.Require(authz.PermMessageTypeManage))
	g.GET("/message-settings/tags/:id/edit", ctrl.EditMessageTagDrawer, authz.Require(authz.PermMessageTypeManage))
	g.POST("/message-settings/tags", ctrl.SaveMessageTag, authz.Require(authz.PermMessageTypeManage))
	g.POST("/message-settings/tags/:id/archive", ctrl.ArchiveMessageTag, authz.Require(authz.PermMessageTypeManage))
	g.POST("/message-settings/tags/:id/restore", ctrl.RestoreMessageTag, authz.Require(authz.PermMessageTypeManage))
	g.POST("/message-settings/tags/:id/delete", ctrl.DeleteMessageTag, authz.Require(authz.PermMessageTypeManage))

	// JSON API：与 HTML 共用同一套 service，供离线客户端与脚本读取。
	// The JSON API: it shares the very same service as the HTML pages, for offline clients and scripts.
	g.GET("/api/v1/messages/conversations", ctrl.APIConversations, authz.Require(authz.PermMessageRead))
	g.GET("/api/v1/messages/conversations/:id", ctrl.APIConversation, authz.Require(authz.PermMessageRead))
	g.GET("/api/v1/messages", ctrl.APIMessages, authz.Require(authz.PermMessageRead))
	g.GET("/api/v1/messages/:id", ctrl.APIMessage, authz.Require(authz.PermMessageRead))
	g.POST("/api/v1/messages", ctrl.APISendMessage, authz.Require(authz.PermMessageSend))
	g.POST("/api/v1/messages/system", ctrl.APISendSystem, authz.Require(authz.PermMessageSystem))
	g.POST("/api/v1/messages/:id", ctrl.APIUpdateMessage, authz.Require(authz.PermMessageUpdate))
	g.POST("/api/v1/messages/:id/recall", ctrl.APIRecallMessage, authz.Require(authz.PermMessageDelete))
	g.POST("/api/v1/messages/:id/revoke", ctrl.APIRevokeSystemMessage, authz.Require(authz.PermMessageSystem))
	g.POST("/api/v1/messages/:id/read", ctrl.APIMarkRead, authz.Require(authz.PermMessageRead))
	g.POST("/api/v1/messages/:id/pin", ctrl.APIPinMessage, authz.Require(authz.PermMessageManage))
	g.POST("/api/v1/messages/:id/unpin", ctrl.APIUnpinMessage, authz.Require(authz.PermMessageManage))
	g.POST("/api/v1/messages/attachments", ctrl.APIUploadAttachment, authz.Require(authz.PermMessageSend))
	g.GET("/api/v1/messages/attachments/:id", ctrl.APIDownloadAttachment, authz.Require(authz.PermMessageRead))
	g.GET("/api/v1/friends", ctrl.APIFriends, authz.Require(authz.PermMessageRead))
	g.GET("/api/v1/friends/search", ctrl.APIFriendSearch, authz.Require(authz.PermMessageRead))
	g.POST("/api/v1/friends/requests", ctrl.APISendFriendRequest, authz.Require(authz.PermMessageRead))
	g.POST("/api/v1/friends/requests/:id/accept", ctrl.APIAcceptFriendRequest, authz.Require(authz.PermMessageRead))
	g.POST("/api/v1/friends/requests/:id/reject", ctrl.APIRejectFriendRequest, authz.Require(authz.PermMessageRead))
	g.POST("/api/v1/friends/requests/:id/cancel", ctrl.APICancelFriendRequest, authz.Require(authz.PermMessageRead))
	g.POST("/api/v1/friends/:id/remove", ctrl.APIRemoveFriend, authz.Require(authz.PermMessageRead))
	g.POST("/api/v1/friends/:id/block", ctrl.APIBlockFriend, authz.Require(authz.PermMessageRead))
	g.POST("/api/v1/friends/:id/unblock", ctrl.APIUnblockFriend, authz.Require(authz.PermMessageRead))
	g.POST("/api/v1/friends/:id/remark", ctrl.APISetFriendRemark, authz.Require(authz.PermMessageRead))
	g.GET("/api/v1/message-types", ctrl.APIMessageTypes, authz.Require(authz.PermMessageTypeRead))
	g.POST("/api/v1/message-types", ctrl.APISaveMessageType, authz.Require(authz.PermMessageTypeManage))
	g.POST("/api/v1/message-types/:key/archive", ctrl.APIArchiveMessageType, authz.Require(authz.PermMessageTypeManage))
	g.GET("/api/v1/message-tags", ctrl.APIMessageTags, authz.Require(authz.PermMessageTypeRead))
	g.POST("/api/v1/message-tags", ctrl.APISaveMessageTag, authz.Require(authz.PermMessageTypeManage))
	g.POST("/api/v1/message-tags/:id/archive", ctrl.APIArchiveMessageTag, authz.Require(authz.PermMessageTypeManage))

	// 实时消息通道：WebSocket 推送与单条快捷回复共用同一条连接。
	// The realtime message channel: WebSocket pushes and the quick reply share one connection.
	g.GET("/ws/messages", ctrl.MessageSocket(), authz.Require(authz.PermMessageRead))

	// 租户：读与建分别对应注册表的 tenant:read 与 tenant:create，因为租户是其它一切数据的边界。
	// Tenants: reading and creating map onto the registry's tenant:read and tenant:create, because tenants are the
	// boundary of everything else.
	g.GET("/tenants", ctrl.Tenants, authz.Require(authz.PermTenantRead))
	g.GET("/tenants/new", ctrl.NewTenantForm, authz.Require(authz.PermTenantCreate))
	g.POST("/tenants", ctrl.CreateTenant, authz.Require(authz.PermTenantCreate))

	// 用户：读数与改数分属不同能力，因此「能看」与「能动」在种子数据里就是两件事，且每一次调用都带着上下文里的租户 ID。
	// Users: reading and changing are separate capabilities, so "may look" and "may touch" are two different things in the
	// seeded data as well, and every call carries the tenant id from the context.
	g.GET("/users", ctrl.Users, authz.Require(authz.PermUserRead))
	g.GET("/users/new", ctrl.NewUserForm, authz.Require(authz.PermUserCreate))
	g.POST("/users", ctrl.CreateUser, authz.Require(authz.PermUserCreate))
	g.GET("/users/:id/edit", ctrl.EditUserForm, authz.Require(authz.PermUserUpdate))
	g.POST("/users/:id/tenants", ctrl.SetUserTenants, authz.Require(authz.PermUserUpdate))
	g.POST("/users/:id", ctrl.UpdateUser, authz.Require(authz.PermUserUpdate))
	g.POST("/users/:id/roles", ctrl.SetUserRoles, authz.Require(authz.PermUserUpdate))
	g.POST("/users/:id/status", ctrl.SetUserStatus, authz.Require(authz.PermUserUpdate))
	g.POST("/users/:id/password", ctrl.SetUserPassword, authz.Require(authz.PermUserUpdate))
	g.POST("/users/:id/sec-key", ctrl.RotateUserSecKey, authz.Require(authz.PermUserUpdate))

	// 角色与权限矩阵：矩阵的每一格改的是角色的能力绑定（role:update），因此与「改角色」同门槛，
	// 而建角色（role:manage）与删角色（role:delete）各按寿命周期的能力分开。
	// Roles and the permission matrix: every cell changes a role's capability bindings (role:update) and therefore shares
	// the threshold with "change a role", while creating one (role:manage) and deleting one (role:delete) follow the
	// lifecycle capabilities separately.
	g.GET("/roles", ctrl.Roles, authz.Require(authz.PermRoleRead))
	g.GET("/roles/new", ctrl.NewRoleForm, authz.Require(authz.PermRoleManage))
	g.GET("/roles/:id/edit", ctrl.EditRoleForm, authz.Require(authz.PermRoleManage))
	g.POST("/roles", ctrl.SaveRole, authz.Require(authz.PermRoleManage))
	g.POST("/roles/:id/permissions", ctrl.ToggleRolePermission, authz.Require(authz.PermRoleUpdate))
	g.POST("/roles/:id/delete", ctrl.DeleteRole, authz.Require(authz.PermRoleDelete))
	g.GET("/permissions", ctrl.Permissions, authz.Require(authz.PermPermissionRead))

	// Generated CRUD modules join the same protected chain, so they inherit authentication,
	// authorization and tenant resolution rather than exposing an unguarded route. | 生成的 CRUD 模块
	// 加入同一条受保护链，因此继承鉴权、授权与租户解析，而不是暴露未受保护的路由。
	mountGenerated(g, store)
}

// masterKey 取封装 sec_key 的主密钥：优先配置（生产环境用 YD_AUTH_MASTER_KEY 注入）；非 development 未配置时拒绝启动，
// 仅 development 回退到内置开发密钥并告警。
// masterKey reads the key sealing every sec_key: configuration wins (production injects YD_AUTH_MASTER_KEY);
// outside development an unset key refuses to start, and only development takes the built-in key with a warning.
//
// 开发密钥存在的理由：种子账号必须开箱即可登录。它的代价是进程重启后内存里的 sec_key 仍能解开，
// 因此告警必须显式说出来，而不是让使用者以为默认就是安全的。
// The development key exists so the seeded account works out of the box; the price is that the in-memory sec_keys stay
// readable across restarts, which is exactly what the warning says out loud instead of letting anyone assume safety.
func masterKey(a *app.App) ([]byte, error) {
	if key := a.Config().GetString(configMasterKey); key != "" {
		return []byte(key), nil
	}
	// The development key is public knowledge. Outside development, starting with it would seal
	// every sec_key with a value anyone can read and let a DB dump forge tokens for every user,
	// so the application refuses to start instead of only warning. | 开发密钥是公开知识。在
	// development 之外使用它，等于用人人可读的值封装所有 sec_key，拿到数据库转储即可伪造任意
	// 用户的令牌，因此这里拒绝启动，而不是只打一条告警。
	if !strings.EqualFold(meta.Env(), meta.EnvDevelopment) {
		a.Logger().Error("auth.master_key is unset outside development, refusing to start: inject YD_AUTH_MASTER_KEY | 非开发环境未配置 auth.master_key，拒绝启动：请注入 YD_AUTH_MASTER_KEY",
			logx.Str("env", meta.Env()))
		return nil, errx.Detail(ErrAuth, "auth.master_key is required outside development | 非开发环境必须配置 auth.master_key")
	}
	a.Logger().Warn("auth.master_key is unset, the scaffold's development key is in use: inject YD_AUTH_MASTER_KEY in production | 未配置 auth.master_key，正在使用脚手架内置的开发密钥：生产环境请注入 YD_AUTH_MASTER_KEY")
	return []byte(meta.DevMasterKey), nil
}

// tokenTTL 取令牌有效期：配置缺省或解析不出时长时退回框架默认值。
// tokenTTL reads the token lifetime and falls back to the framework default when nothing parses.
func tokenTTL(a *app.App) time.Duration {
	if ttl := a.Config().Duration(configTokenTTL); ttl > 0 {
		return ttl
	}
	return auth.DefaultTokenTTL
}

// startTicker 启动实时推送，并把停止动作挂到关停钩子上。
// startTicker starts the realtime publisher and hangs its stop action on the shutdown hook.
//
// 推送协程与进程同生命周期：用可取消的 context 派生，再由 OnShutdown 取消并等待退出，
// 因此优雅退出时不会留下仍在写事件的孤儿协程。
// The publisher lives as long as the process: it derives from a cancellable context and OnShutdown cancels it and waits
// for it, so a graceful exit leaves no orphan goroutine still writing events.
func startTicker(a *app.App, ticker *service.Ticker, broker *sse.Broker) error {
	ctx, cancel := context.WithCancel(context.Background())
	if err := ticker.Start(ctx); err != nil {
		cancel()
		return errx.Wrap(err, ErrTicker)
	}

	a.OnShutdown(func(context.Context) error {
		// 先停推送再关广播器：颠倒顺序会让订阅者读到已关闭的通道。
		// Stop the publisher before closing the broker: the other order lets subscribers read a closed channel.
		ticker.Stop()
		broker.Close()
		cancel()
		return nil
	})

	ticker.LogStart(a.Logger(), broker.Clients(service.EventsTopic))
	return nil
}

// startMessageRuntime 启动消息总线订阅与待挂载附件清理，并把停止动作挂到关停钩子上。
// startMessageRuntime starts the bus subscription and the pending-upload cleaner, and hangs their stop action on the
// shutdown hook.
func startMessageRuntime(a *app.App, ctrl *controller.Controller) {
	ctx, cancel := context.WithCancel(context.Background())
	ctrl.StartMessageHub(ctx)
	ctrl.StartMessageJanitor(ctx)
	a.OnShutdown(func(context.Context) error {
		cancel()
		return nil
	})
}

// registerOpenAPI 生成 OpenAPI 文档并挂载 JSON 端点与内置查看器。
// registerOpenAPI builds the OpenAPI document and mounts the JSON endpoint together with the built-in viewer.
//
// 注解解析失败不是致命错误：生产镜像通常不含源码，此时文档退化为路由树自动推导的骨架，
// 端点依旧可用，而告警会指出注解覆盖率下降了。
// A failed annotation parse is not fatal: production images usually ship no source, the document then degrades to the
// skeleton derived from the route tree, the endpoints keep working and the warning reports the lost coverage.
func registerOpenAPI(a *app.App) {
	opts := openapi.Options{Path: OpenAPIPath, DocsPath: DocsPath, Title: meta.Name + " API"}
	report := &openapi.Report{}
	source := parseSource(a)
	// 处理器注解与类型注解来自同一次扫描，避免重复遍历与解析源码目录。
	// Both dialects come from the same scan, so the source tree is walked and parsed only once.
	opts.TypeAnnotations = source.Types

	doc := openapi.FromRouterWithAnnotations(a.Router(), openAPIInfo(), opts, source.Annotations, report)
	// 受保护端点统一标注 @Security BearerAuth，方案本身在这里声明，客户端据此生成 Authorization 头。
	// Protected endpoints are annotated with @Security BearerAuth; the scheme is declared here so clients can build the
	// Authorization header from the document.
	doc.AddSecurityScheme("BearerAuth", openapi.SecurityScheme{
		Type:         "http",
		Scheme:       "bearer",
		BearerFormat: "JWT",
		Description:  "Per-user JWT issued by the framework, sent as Authorization: Bearer <token>. | 框架签发的每用户 JWT，以 Authorization: Bearer <token> 发送。",
	})
	if err := doc.Validate(); err != nil {
		a.Logger().Warn("openapi document is not fully compliant, serving it anyway | OpenAPI 文档未完全符合规范，仍照常提供",
			logx.Err(err),
		)
	}
	handler := openapi.Handler(doc, opts)
	a.GET(opts.Path, handler)
	a.GET(opts.DocsPath, handler)

	a.Logger().Info("openapi document ready | OpenAPI 文档已生成",
		logx.Str("path", opts.Path),
		logx.Str("docs", opts.DocsPath),
		logx.Int("matched", len(report.Matched)),
		logx.Int("missing", len(report.Missing)),
		logx.Int("orphan", len(report.Orphan)),
		logx.Int("incomplete", len(report.Incomplete)),
	)
}

// openAPIInfo 返回文档元信息，取值全部来自 internal/meta，避免文档与代码漂移。
// openAPIInfo returns the document metadata; every value comes from internal/meta so the document cannot drift from the code.
//
// 安全方案说明：全部受保护端点都标注 @Security BearerAuth，即 Authorization: Bearer <token>；
// 方案本身由 registerOpenAPI 写入 components.securitySchemes，文档因此可以直接驱动客户端鉴权。
// Security note: every protected endpoint is annotated with @Security BearerAuth, meaning Authorization: Bearer <token>.
// registerOpenAPI declares the scheme under components.securitySchemes, so the document can drive client authentication
// directly.
func openAPIInfo() openapi.Info {
	return openapi.Info{
		Title:       meta.Name + " API",
		Description: meta.Description,
		Version:     meta.Version,
		License:     openapi.License{Name: "Apache-2.0"},
	}
}

// parseSource 一次扫描同时解析处理器注解与类型注解；源码不可用时返回空结果，由路由树兜底。
// parseSource parses both handler and type annotations in one scan; when the source is unavailable it returns an empty
// result and the route tree takes over.
//
// 根参数必须是空串而不是 "."：afs.NewOS(".") 会退化成 afero.BasePathFs，而它在 filepath.Clean 之后用前缀判断目录边界，
// "." 前缀永远匹配不上 "internal" 这类相对路径，任何读取都会得到 ErrNotExist，注解会静默全部丢失。
// afs.NewOS("") 得到的才是相对于进程工作目录的普通 OS 文件系统。
// The root argument must be the empty string rather than ".": afs.NewOS(".") degrades to afero.BasePathFs, which decides
// the directory boundary by string prefix after filepath.Clean, and the "." prefix never matches a relative path such as
// "internal", so every read returns ErrNotExist and all annotations are silently lost. afs.NewOS("") yields a plain OS
// filesystem rooted at the process working directory instead.
func parseSource(a *app.App) *openapi.Source {
	source, err := openapi.ParseSource(afs.NewOS(""), []string{AnnotationDir})
	if err != nil {
		a.Logger().Warn("openapi annotations unavailable, derived from the route tree instead | OpenAPI 注解不可用，改由路由树推导",
			logx.Err(err),
			logx.Str("dir", AnnotationDir),
		)
		return &openapi.Source{}
	}
	return source
}

