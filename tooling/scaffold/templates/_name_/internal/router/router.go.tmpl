// Package router 把控制器挂载到路由表，并集中登记本项目的可选特性。
// Package router mounts controllers onto the mux and keeps the project's optional features in one place.
//
// 本包同时是鉴权链路的装配处与 OpenAPI 文档的装配处：注解写在处理器上（见 docs/developer_guidelines.md §9.2），
// 文档在启动时由路由树与注解合并生成，因此新增端点后无需再手工维护任何清单。
// This package assembles both the authentication chain and the OpenAPI document: annotations live on the handlers (see
// docs/developer_guidelines.md §9.2) and the document is merged from the route tree and those annotations at startup, so
// no hand-maintained list has to follow a new endpoint.
package router

import (
	"context"
	"net/http"
	pathpkg "path"
	"strings"
	"time"

	"{{ .Module }}/internal/controller"
	"{{ .Module }}/internal/meta"
	"{{ .Module }}/internal/middleware"
	"{{ .Module }}/internal/repository"
	"{{ .Module }}/internal/service"
	"{{ .YdxModule }}/afs"
{{- if ne .DB "none" }}
	"{{ .YdxModule }}/cache/gormcache"
{{- end }}
	"{{ .YdModule }}/runtime/app"
	"{{ .YdModule }}/security/auth"
	"{{ .YdModule }}/security/authz"
	"{{ .YdModule }}/security/captcha"
	"{{ .YdxModule }}/errs"
	"{{ .YdxModule }}/log"
	"{{ .YdxModule }}/openapi"
	"{{ .YdxModule }}/openapi/ydrouter"
	approuter "{{ .YdxModule }}/router"
	"{{ .YdxModule }}/sse"
)

// 对外契约常量：路径与静态前缀在这里声明一次，文档、中间件与测试都引用它们。
// Public contract constants: paths and the static prefix are declared once here and referenced by the document, by
// middleware and by tests.
const (
	// OpenAPIPath is the endpoint serving the OpenAPI JSON document, matching the framework default. | OpenAPIPath 是 OpenAPI JSON 文档的端点，与框架默认值一致。
	OpenAPIPath = "/api/v1/openapi.json"
	// DocsPath is the endpoint serving the built-in documentation viewer, matching the framework default. | DocsPath 是内置文档查看器的端点，与框架默认值一致。
	DocsPath = "/mgr/docs"
	// StaticPrefix is the static asset prefix, matching the mount point of app.Default. | StaticPrefix 是静态资源前缀，与 app.Default 的挂载点一致。
	StaticPrefix = "/static"
	// AnnotationDir is the source directory holding the OpenAPI annotations. | AnnotationDir 是存放 OpenAPI 注解的源码目录。
	AnnotationDir = "internal"

	// LoginPath is the sign-in page and the sign-in submission: every anonymous browsing request lands here. | LoginPath 是登录页与登录提交的端点：未登录的浏览请求都被送到这里。
	LoginPath = "/login"
)

// 鉴权配置键：与 configs/config.yaml 的 auth 段一一对应，可用环境变量覆盖（YD_AUTH_MASTER_KEY、YD_AUTH_TOKEN_TTL）。
// Authentication configuration keys: they match the auth section of configs/config.yaml and can be overridden through
// environment variables (YD_AUTH_MASTER_KEY, YD_AUTH_TOKEN_TTL).
const (
	// configMasterKey is the master key sealing every per-user sec_key. | configMasterKey 是封装每用户 sec_key 的主密钥。
	configMasterKey = "auth.master_key"
	// configTokenTTL is the token lifetime, written as "2h" and the like. | configTokenTTL 是令牌有效期，取值形如 "2h"。
	configTokenTTL = "auth.token_ttl"
)

// 装配期哨兵错误：Register 返回的错误都能用 errors.Is 判定到其中某一个。
// Assembly sentinels: every error returned by Register satisfies errors.Is against one of them.
var (
	// ErrNilApp reports a nil facade. | ErrNilApp 表示传入的门面为空。
	ErrNilApp = errs.New("router: nil application facade | router：应用门面为空")
	// ErrAuth reports a failed auth store, master key or token issuer assembly. | ErrAuth 表示鉴权存储、主密钥或令牌签发器装配失败。
	ErrAuth = errs.New("router: authentication service unavailable | router：鉴权服务装配失败")
	// ErrSeed reports a failed default seed write. | ErrSeed 表示默认数据写入失败。
	ErrSeed = errs.New("router: default seed failed | router：默认数据写入失败")
	// ErrTicker reports a failed realtime publisher start. | ErrTicker 表示实时推送器启动失败。
	ErrTicker = errs.New("router: realtime publisher failed to start | router：实时推送启动失败")
	// ErrCache reports a failed cache assembly. | ErrCache 表示缓存装配失败。
	ErrCache = errs.New("router: cache assembly failed | router：缓存装配失败")
	// ErrCaptcha reports a failed captcha assembly. | ErrCaptcha 表示验证码装配失败。
	ErrCaptcha = errs.New("router: captcha assembly failed | router：验证码装配失败")
)

// Register 把全部端点登记到应用门面上。
// Register mounts every endpoint on the application facade.
//
// 返回值而非直接 panic：装配失败必须由 main 统一记录并决定退出码，库代码不替调用方决定进程命运。
// It returns an error rather than panicking: main records the failure and decides the exit code, and library code never
// decides the process's fate for its caller.
func Register(a *app.App) error {
	if a == nil {
		return ErrNilApp
	}

	// 存储与鉴权服务在整个进程里只有一份：登录签发的令牌与中间件校验的令牌因此必然出自同一个签发器与同一份 sec_key。
	// One store and one auth service per process: the token signed at sign-in and the token verified by the middleware can
	// only ever come from the same issuer and the same sec_key.
	key, err := masterKey(a)
	if err != nil {
		return errs.Wrap(err, ErrAuth)
	}
	store, err := repository.Open(repository.Options{
		Config:    a.Config(),
		Log:       a.Logger(),
		MasterKey: key,
		Issuer:    meta.TokenIssuerName,
		TTL:       tokenTTL(a),
	})
	if err != nil {
		return errs.Wrap(err, ErrAuth)
	}
	a.OnShutdown(func(context.Context) error { return store.Close() })

	// Redis 只在这里打开一次：缓存、消息总线与验证码共用同一个客户端，App 的 io.Closer 钩子负责关停它。
	// Redis is opened exactly once here: the cache, the message bus and captcha share one client, and the App's
	// io.Closer hook closes it during shutdown.
	redisClient := service.NewRedis(a.Config(), a.Logger())
	if redisClient != nil {
		a.Set(app.ServiceRedis, redisClient)
	}

	// 二级缓存与控制器共享同一份配置与同一个 Redis 客户端：可达时启用远端，否则只建本地缓存；缓存故障绝不阻塞启动。
	// The two-level cache reads the same configuration and the same Redis client as the controllers: a reachable
	// server enables the remote, otherwise only the local cache is built; a cache outage never blocks startup.
	cacheMgr, err := service.NewCache(a.Config(), a.Logger(), redisClient)
	if err != nil {
		return errs.Wrap(err, ErrCache)
	}
	// a.Set 已登记 cache.Manager 的 io.Closer 钩子；再登记一个 closeCache 会让关停重复关闭同一个实例。
	// a.Set already registers the cache.Manager io.Closer hook; a second closeCache hook would close the same
	// instance twice during shutdown.
	a.Set(app.ServiceCache, cacheMgr)
{{- if ne .DB "none" }}
	if gormDB := store.GormDB(); gormDB != nil && gormcache.EnabledFromConfig(a.Config()) {
		cachePlugin, pluginErr := gormcache.New(gormcache.OptionsFromConfig(a.Config(), cacheMgr))
		if pluginErr != nil {
			a.Logger().Warn("gorm cache plugin is disabled | GORM 缓存插件已禁用", log.Err(pluginErr))
		} else if useErr := gormDB.Use(cachePlugin); useErr != nil {
			a.Logger().Warn("gorm cache plugin failed to install | GORM 缓存插件安装失败", log.Err(useErr))
			_ = cachePlugin.Close()
		} else {
			store.SetCacheInvalidator(cachePlugin)
			store.SetMessageCacheInvalidator(cachePlugin)
			a.OnShutdown(func(context.Context) error { return cachePlugin.Close() })
		}
	}
{{- end }}

	// The captcha wiring always ships with the project: with both actions off it builds no manager and mounts no
	// route; when enabled it reuses the one Redis client opened above.
	// 验证码接线始终随项目生成：两个动作都关闭时它不建管理器、不挂路由；启用时复用上面唯一的 Redis 客户端。
	captchaSvc, err := captcha.NewWithClient(a.Config(), a.Logger(), redisClient)
	if err != nil {
		return errs.Wrap(err, ErrCaptcha)
	}
	a.OnShutdown(func(context.Context) error { return captchaSvc.Close() })
	captchaSvc.Register(a.Router())

	// 默认数据只在租户表为空时创建，而且没有配置种子口令时不会创建任何账号；既有租户每次启动只补齐内置角色
	// 缺失的能力绑定（只增不减），因此升级后新增的能力立即可用。
	// The default data is created only while the tenant table is empty, and no account is created without a seed
	// password; an existing tenant only gets its missing built-in capabilities reconciled on each start (add-only), so a
	// capability introduced by an upgrade is usable immediately.
	if err := store.Seed(context.Background()); err != nil {
		return errs.Wrap(err, ErrSeed)
	}

	ctrl, err := controller.New(a, store, a.Logger(), captchaSvc, redisClient)
	if err != nil {
		return errs.Wrap(err, ErrAuth)
	}

	// 事件广播器与推送器由路由层持有：它们是端点的基础设施，不是业务状态。
	// The broker and the publisher are owned here: they are endpoint infrastructure, not business state.
	broker := sse.NewBroker(sse.BrokerOptions{})
	ticker := service.NewTicker(broker, service.DefaultTickInterval)

	registerPublic(a, ctrl)
	registerProtected(a, ctrl, store, broker, ticker)

	if err := startTicker(a, ticker, broker); err != nil {
		return err
	}
	startMessageRuntime(a, ctrl)
	startWorkflowRuntime(a, ctrl)

	registerOpenAPI(a)
	registerFeatures(a)
	return nil
}

// registerPublic 登记匿名可达的端点：根路由分流、登录页、登录提交、登出、健康检查与 SM2 公钥。
// registerPublic mounts the anonymously reachable endpoints: the root dispatch, the sign-in page, the sign-in
// submission, sign-out, the health probe and the SM2 public key.
//
// 公开组仍然跑租户中间件（Required 为 false）：匿名请求可以用子域名或 X-Tenant 定位租户，
// 而 Required 为 false 保证了一个什么也没指明的请求照样能渲染出登录表单；登录表单本身不带租户字段。
// The public group still runs the tenant middleware with Required false: the sign-in page has to know which tenant
// acme.example.com names in order to pre-fill the field, while Required false keeps a request that names no tenant
// renderable.
// sensitivePath reports whether path belongs to the high-security or classified
// surface: authentication, account self-service, tenant switching, administration.
// These requests bypass every GORM cache read; ordinary portal traffic stays cached. |
// sensitivePath 报告路径是否属于高安全或涉密面：认证、账号自助、租户切换与管理后台。这些请求
// 跳过全部 GORM 缓存读取；普通门户流量仍走缓存。
func sensitivePath(rawPath string) bool {
	// Clean first: "/x/../mgr/users" must not slip past the prefix checks while the
	// router still dispatches it to /mgr/users. | 先清理路径："/x/../mgr/users" 不能绕过前缀
	// 判定，而路由器仍把它分派到 /mgr/users。
	path := pathpkg.Clean("/" + rawPath)
	switch {
	case path == LoginPath, path == "/logout":
		return true
	case path == "/account", strings.HasPrefix(path, "/account/"):
		return true
	case strings.HasPrefix(path, "/tenant/"):
		return true
	case path == "/mgr", strings.HasPrefix(path, "/mgr/"):
		return true
	case strings.HasPrefix(path, "/api/v1/"):
		return true
	case path == "/api/portal/v1/account", strings.HasPrefix(path, "/api/portal/v1/account/"):
		return true
	default:
		return false
	}
}

func registerPublic(a *app.App, ctrl *controller.Controller) {
	// 同一个租户中间件也挂在受保护组上：注册表按 Name 合并，因此两个分组共享一份计数。
	// The same tenant middleware is mounted on the protected group too: the registry merges by Name, so both
	// groups share one set of counters.
	// The public group resolves an optional session: a missing or invalid token continues anonymously, so the root
	// route can send a signed-in visitor to the message centre without blocking anonymous visitors at the sign-in
	// page. | 公开组只做「可选会话」：没有令牌或令牌失效时以匿名继续，根路由因此可以把已登录用户送到消息中心，
	// 而不会把匿名访客挡在登录页。
	g := a.Group("",
		a.MiddlewareMetrics().Wrap(
			middleware.MetricsDescriptor("cache-bypass"),
			middleware.CacheBypass(func(r *http.Request) bool { return sensitivePath(r.URL.Path) }),
		),
		a.MiddlewareMetrics().Wrap(
			middleware.MetricsDescriptor("promote"),
			middleware.Promote(middleware.SessionOptions{}),
		),
		a.MiddlewareMetrics().Wrap(
			middleware.MetricsDescriptor("auth"),
			auth.Middleware(auth.MiddlewareOptions{Issuer: ctrl.Issuer(), ErrorHandler: ctrl.Deny, Optional: true}),
		),
		a.MiddlewareMetrics().Wrap(
			middleware.MetricsDescriptor("authz"),
			authz.Middleware(ctrl.Auth()),
		),
		a.MiddlewareMetrics().Wrap(
			middleware.MetricsDescriptor("tenant"),
			middleware.Tenant(middleware.TenantOptions{
				Resolver:     ctrl.ResolveTenant,
				ErrorHandler: ctrl.Deny,
				Subdomain:    true,
				IgnoreToken:  true,
			}),
		),
	)

	// 根路由按登录状态分流：匿名访客去登录页，已登录用户去消息中心。 |
	// The root route branches on the session: an anonymous visitor goes to the sign-in page and a signed-in user to the
	// message centre.
	g.GET("/", ctrl.Root)
	g.GET(LoginPath, ctrl.LoginPage)
	g.POST(LoginPath, ctrl.Login)
	// 登出是幂等的清理动作，刻意公开：cookie 里那枚令牌早已失效时，仍然要能把它扔掉。
	// Sign-out is an idempotent cleanup and is deliberately public: a cookie whose token is long dead must still be droppable.
	g.POST("/logout", ctrl.Logout)
	g.GET("/healthz", ctrl.Health)
	g.GET("/guomi/pubkey", ctrl.Pubkey)
}

// registerProtected 登记需要有效会话的业务端点，并按能力逐条挂上权限守卫。
// registerProtected mounts the business endpoints that need a valid session and hangs one permission guard on each.
//
// The order of the chain is itself the argument and must not be reshuffled: | 链路顺序本身就是一条论证，不能调换：
//  1. Promote lifts the cookie token into Authorization, after which browsers and API clients share one path; | middleware.Promote —— 把 cookie 里的令牌提升为 Authorization，浏览器与 API 客户端从此走同一条路径；
//  2. auth.Middleware verifies the signature, the validity and the per-user sec_key and stores the user in the context; | auth.Middleware —— 校验签名、有效期与每用户 sec_key，并把用户放进上下文；
//  3. authz.Middleware builds the subject of this request from that user, which is what the templates and the front end read; | authz.Middleware —— 用该用户构造本请求的主体，模板与前端读到的就是它；
//  4. middleware.Tenant settles the tenant from the token's tid claim and refuses a header or subdomain naming another tenant with 403. | middleware.Tenant —— 以令牌的 tid 声明为准定租户，请求头或子域名指向别的租户即 403。
//
// 第三层必须排在第二层之后：它读的正是第二层放进上下文的用户，排到前面只会得到一个匿名主体。
// 第四层必须排在第二层之后：它优先信任令牌，而令牌正是第二层校验的产物；顺序颠倒会让任何请求头都变成可信输入。
// The third layer must follow the second: it reads the very user the second layer put into the context, and ahead of it
// would build an anonymous subject. The fourth must follow the second as well: it trusts the token first, and the token is
// the product of the second layer — the other order would turn any request header into trusted input.
//
// 权限守卫只挂在业务端点上：实时演示、账号页与两个占位图只要求「有一个有效会话」，
// 因为它们展示的是「我是谁」，而不是「我能不能动别人的数据」。
// The guards hang on the business endpoints only: the realtime demo, the account page and the two placeholders require
// nothing beyond a valid session, because what they show is who I am and not whether I may touch somebody else's data.
//
// 守卫一律写成 authz.Require(authz.PermXxx)：引用取自注册表而非字面量，写错的名字在装配期就会被点名，
// 而且 authz.Middleware 已在链上，主体因此必然存在（缺装配时 Require 走的是同一条 403 路径）。
// Every guard is written as authz.Require(authz.PermXxx): the reference comes from the registry rather than from a
// literal, a misspelled name is named at wiring time, and the subject is guaranteed to exist because authz.Middleware is
// on the chain (without it the guard takes the very same 403 path).
// generatedMounts is filled by the init functions of files generated by yd gen. Each mount receives
// the fully assembled protected group (auth + authz + tenant) and the store, so a generated module
// is reachable without editing this file by hand. | generatedMounts 由 yd gen 生成文件的 init 填充。
// 每个挂载函数接收装配完成的受保护分组（鉴权 + 授权 + 租户）与存储，使生成模块无需手工编辑本文件
// 即可被访问。
var generatedMounts []func(*approuter.Group, *repository.Store)

// registerGeneratedMount appends one generated module's mount function. | registerGeneratedMount
// 追加一个生成模块的挂载函数。
func registerGeneratedMount(fn func(*approuter.Group, *repository.Store)) {
	if fn != nil {
		generatedMounts = append(generatedMounts, fn)
	}
}

// mountGenerated runs every generated mount inside the protected group. | mountGenerated 在受保护分组中
// 执行全部生成模块的挂载函数。
func mountGenerated(g *approuter.Group, store *repository.Store) {
	for _, fn := range generatedMounts {
		fn(g, store)
	}
}

func registerProtected(a *app.App, ctrl *controller.Controller, store *repository.Store, broker *sse.Broker, ticker *service.Ticker) {
	g := a.Group("",
		a.MiddlewareMetrics().Wrap(
			middleware.MetricsDescriptor("cache-bypass"),
			middleware.CacheBypass(func(r *http.Request) bool { return sensitivePath(r.URL.Path) }),
		),
		a.MiddlewareMetrics().Wrap(
			middleware.MetricsDescriptor("promote"),
			middleware.Promote(middleware.SessionOptions{}),
		),
		a.MiddlewareMetrics().Wrap(
			middleware.MetricsDescriptor("auth"),
			auth.Middleware(auth.MiddlewareOptions{Issuer: ctrl.Issuer(), ErrorHandler: ctrl.Deny}),
		),
		a.MiddlewareMetrics().Wrap(
			middleware.MetricsDescriptor("authz"),
			authz.Middleware(ctrl.Auth()),
		),
		a.MiddlewareMetrics().Wrap(
			middleware.MetricsDescriptor("tenant"),
			middleware.Tenant(middleware.TenantOptions{
				Required:     true,
				Subdomain:    true,
				Resolver:     ctrl.ResolveTenant,
				ErrorHandler: ctrl.Deny,
			}),
		),
	)

	// 会话即可访问：个人中心、账号自助、租户切换与实时演示。根路由在公开组按登录状态分流，不在这里登记。 |
	// Session-only: the personal centre, self-service account actions, the tenant switch and the realtime demo. The root
	// route dispatches on the session in the public group and is not registered here.
	g.GET("/mgr", ctrl.ManagementHome, authz.Require(authz.PermUserRead))
	g.GET("/mgr/metrics", ctrl.Metrics, authz.Require(authz.PermUserRead))
	g.GET("/mgr/metrics/middleware", ctrl.MiddlewareMetrics, authz.Require(authz.PermUserRead))
	g.GET("/realtime", ctrl.Page)
	g.GET("/ui-kit", ctrl.UIKit)
	g.GET("/account", ctrl.Account)
	g.POST("/account/profile", ctrl.UpdateProfile)
	g.POST("/account/password", ctrl.ChangePassword)
	g.POST("/account/sec-key", ctrl.RotateSecKey)

	// 切换租户只要求「是目标租户的成员」，成员关系本身就是授权；默认租户同理。
	// The tenant switch requires only membership of the target tenant, which is itself the
	// authorization; the same holds for the default-tenant choice.
	g.POST("/tenant/switch", ctrl.SwitchTenant)
	g.POST("/account/default-tenant", ctrl.SetOwnDefaultTenant)

	// 占位图端点：既是混合捕获模式的活文档，也是「静态资源必须带会话」的样板。
	// The placeholder endpoints: living documentation of the mixed capture patterns and the template for "even an asset needs a session".
	g.GET("/avatar/:id.jpg", ctrl.Avatar)
	g.GET("/report/:id-xx.png", ctrl.Report)

	// 实时通道：SSE 与 WebSocket 共用同一个推送器。
	// The realtime channels: SSE and WebSocket share one publisher.
	g.GET("/events", ctrl.Stream(broker))
	g.GET("/ws", ctrl.Socket(ticker))
	g.GET("/mgr/ws/metrics", ctrl.MetricsSocket(), authz.Require(authz.PermUserRead))

	// 站内消息中心：读、发、改、撤、置顶、类型目录与审计各自对应注册表里的一条能力。
	// The in-app message centre: reading, sending, editing, recalling, pinning, the type catalogue and the audit trail
	// each map onto one capability of the registry.
	g.GET("/messages", ctrl.Messages, authz.Require(authz.PermMessageRead))
	g.GET("/messages/list", ctrl.MessageList, authz.Require(authz.PermMessageRead))
	g.GET("/messages/conversations", ctrl.MessageConversations, authz.Require(authz.PermMessageRead))
	g.GET("/messages/direct/:id", ctrl.OpenDirectConversation, authz.Require(authz.PermMessageSend))
	g.POST("/messages", ctrl.SendMessage, authz.Require(authz.PermMessageSend))
	g.GET("/mgr/messages/system/new", ctrl.NewSystemDrawer, authz.Require(authz.PermMessageSystem))
	g.POST("/mgr/messages/system", ctrl.SendSystemMessage, authz.Require(authz.PermMessageSystem))
	g.GET("/mgr/messages", ctrl.MessageAdmin, authz.Require(authz.PermMessageManage))
	g.GET("/mgr/messages/audit", ctrl.MessageAudit, authz.Require(authz.PermMessageManage))
	g.POST("/messages/attachments", ctrl.UploadMessageAttachment, authz.Require(authz.PermMessageSend))
	g.GET("/messages/attachments/:id", ctrl.DownloadMessageAttachment, authz.Require(authz.PermMessageRead))
	g.GET("/messages/:id", ctrl.MessageThread, authz.Require(authz.PermMessageRead))
	g.GET("/messages/:id/thread", ctrl.MessageThreadFragment, authz.Require(authz.PermMessageRead))
	g.GET("/messages/:id/history", ctrl.MessageThreadHistory, authz.Require(authz.PermMessageRead))
	g.GET("/messages/:id/edit", ctrl.EditMessageDrawer, authz.RequireAny(authz.PermMessageUpdate, authz.PermMessageManage))
