// SaveSystemDictionaryItem creates or updates one system item. The hidden id selects the mode. |
// SaveSystemDictionaryItem 新建或更新一个系统字典项；隐藏的 id 字段决定模式。
//
// @Summary Save system dictionary item | 保存系统字典项
// @Description Creates a system item when the id is absent, otherwise updates it. The value is immutable after creation.
// @Description 没有 id 时新建系统字典项，否则更新；机器值在创建后不可修改。
// @Tags dictionaries
// @Accept html
// @Produce html
// @Param id path string true "type id | 类型 ID"
// @Param item_id formData string false "item id | 字典项 ID"
// @Param value formData string true "immutable value | 不可变机器值"
// @Param label formData string true "Chinese label | 中文标签"
// @Param label_en formData string false "English label | 英文标签"
// @Param extra formData string false "JSON metadata object | JSON 元数据对象"
// @Param remark formData string false "administrative note | 管理备注"
// @Param status formData string false "enabled|disabled | 启停状态"
// @Param default formData bool false "preselect this item | 预选该项"
// @Param sort formData int false "display order | 展示顺序"
// @Success 200 {object} string "refreshed system workbench | 刷新后的系统工作台"
// @Failure 403 {object} string "not the system tenant | 不是系统租户"
// @Failure 409 {object} string "duplicate value | 值重复"
// @Failure 422 {object} string "validation failed | 校验失败"
// @Security BearerAuth
// @Router /mgr/system-dictionaries/{id}/items [post]
func (c *Controller) SaveSystemDictionaryItem(ctx *router.Ctx) {
	c.saveDictionaryItem(ctx, true)
}

