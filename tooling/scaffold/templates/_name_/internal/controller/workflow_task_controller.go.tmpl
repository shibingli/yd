// workflowReassign implements transfer and delegation over the shared task route. |
// workflowReassign 在共享任务路由上实现转办与委派。
func (c *Controller) workflowReassign(ctx *router.Ctx, delegate bool) {
	if !c.workflowServiceOrFail(ctx) {
		return
	}
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return
	}
	actor := c.workflowActor(ctx)
	var err error
	if delegate {
		_, err = c.workflow.Delegate(ctx.Request.Context(), tenantID, actor, ctx.Param("id"), workflow.DelegateInput{
			TargetID: field(ctx, FieldWorkflowTarget), Comment: field(ctx, FieldWorkflowComment),
		})
	} else {
		_, err = c.workflow.Transfer(ctx.Request.Context(), tenantID, actor, ctx.Param("id"), workflow.TransferInput{
			TargetID: field(ctx, FieldWorkflowTarget), Comment: field(ctx, FieldWorkflowComment),
		})
	}
	if err != nil {
		c.failService(ctx, err)
		return
	}
	c.toast(ctx, "任务已转派 | Task reassigned")
	c.workflowTaskListAfterAction(ctx, tenantID, actor)
}

