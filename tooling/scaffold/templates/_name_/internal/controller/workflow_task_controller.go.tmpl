// MgrWorkflowTaskAction dispatches one management task action. | MgrWorkflowTaskAction 分派一次管理端任务动作。
//
// @Summary Manage a task | 管理端任务动作
// @Description Dispatches claim, approve, transfer, delegate, add-sign, remove-sign, return or remind for one task. |
// 分派签收、审批、转办、委派、加签、减签、退回或催办。
// @Tags workflow
// @Accept application/x-www-form-urlencoded
// @Produce html
// @Param id path string true "Task id | 任务 ID"
// @Param action path string true "Action | 动作"
// @Success 200 {string} string "refreshed instance page | 刷新后的实例页面"
// @Failure 403 {string} string "permission denied | 权限不足"
// @Security BearerAuth
// @Router /mgr/workflow-tasks/{id}/{action} [post]
func (c *Controller) MgrWorkflowTaskAction(ctx *router.Ctx) {
	switch strings.ToLower(strings.TrimSpace(ctx.Param("action"))) {
	case "action":
		c.ApproveWorkflowTask(ctx)
	case "claim":
		c.ClaimWorkflowTask(ctx)
	case "transfer":
		c.TransferWorkflowTask(ctx)
	case "delegate":
		c.DelegateWorkflowTask(ctx)
	case "add-sign":
		c.AddSignWorkflowTask(ctx)
	case "remove-sign":
		c.RemoveSignWorkflowTask(ctx)
	case "return":
		c.ReturnWorkflowTask(ctx)
	case "remind":
		c.RemindWorkflowTask(ctx)
	default:
		c.fail(ctx, http.StatusUnprocessableEntity, "未知任务动作 | unknown task action")
	}
}

// workflowTaskDrawerAt renders the shared task drawer with one action prefix. The portal keeps the
// participant check; the back office is already guarded by workflow:read and may inspect any task.
// Action forms are only rendered when the caller can actually execute the matching endpoint:
// workflow:approve in the portal, workflow:admin in the back office. |
// workflowTaskDrawerAt 以指定动作前缀渲染共享任务抽屉。门户保留参与者校验；后台已由
// workflow:read 守卫，可查看任意任务。只有调用方确实能执行对应端点时才渲染动作表单：
// 门户需要 workflow:approve，后台需要 workflow:admin。
func (c *Controller) workflowTaskDrawerAt(ctx *router.Ctx, basePath string, backOffice bool) {
	if !c.workflowServiceOrFail(ctx) {
		return
	}
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return
	}
	actor := c.workflowActor(ctx)
	detail, err := c.workflow.TaskDetail(ctx.Request.Context(), tenantID, ctx.Param("id"))
	if err != nil {
		c.failService(ctx, err)
		return
	}
	if !backOffice {
		visible, err := c.workflow.TaskVisible(ctx.Request.Context(), tenantID, detail.Task, actor)
		if err != nil {
			c.failService(ctx, err)
			return
		}
		if !visible {
			c.fail(ctx, http.StatusForbidden, msgForbidden)
			return
		}
	}
	canAct := authz.Can(ctx.Request.Context(), authz.PermWorkflowApprove)
	if backOffice {
		canAct = authz.Can(ctx.Request.Context(), authz.PermWorkflowAdmin)
	}
	data := workflowTaskView(detail, actor, basePath, canAct)
	data["Fields"] = workflowFormFieldViews(detail.Node.Form, workflowStringValues(detail.Variables, detail.Node.Form))
	// Only the forms that will actually render need the tenant directory or sibling tasks. |
	// 只有确实会渲染的表单才需要租户用户目录或同令牌任务。
	canSign, _ := data["CanSign"].(bool)
	canDelegate, _ := data["CanDelegate"].(bool)
	canReturn, _ := data["CanReturn"].(bool)
	if canSign || canDelegate {
		if users, err := c.users.List(ctx.Request.Context(), tenantID, ""); err == nil {
			rows := make([]map[string]any, 0, len(users))
			options := make([]map[string]any, 0, len(users))
			for _, user := range users {
				rows = append(rows, map[string]any{"ID": user.ID, "Name": user.DisplayName, "Username": user.Username})
				label := user.DisplayName
				if label == "" {
					label = user.Username
				}
				options = append(options, map[string]any{"Value": user.ID, "Label": label})
			}
			data["Users"] = rows
			data["UserOptions"] = options
		}
	}
	if canSign {
		if siblings, err := c.workflow.ListTasks(ctx.Request.Context(), tenantID, workflow.TaskFilter{
			InstanceID: detail.Instance.ID, Page: 1, PageSize: c.workflow.Options().MaxPageSize,
		}); err == nil {
			pending := make([]workflow.Task, 0, 4)
			for _, sibling := range siblings.Items {
				if sibling.TokenID != detail.Task.TokenID || sibling.ID == detail.Task.ID {
					continue
				}
				if sibling.Status == workflow.TaskQueued || sibling.Status == workflow.TaskPending {
					pending = append(pending, sibling)
				}
			}
			data["Siblings"] = pending
			siblingOptions := make([]map[string]any, 0, len(pending))
			for _, sibling := range pending {
				label := sibling.NodeName + " · " + sibling.AssigneeName
				siblingOptions = append(siblingOptions, map[string]any{"Value": sibling.ID, "Label": label})
			}
			data["SiblingOptions"] = siblingOptions
		}
	}
	if canReturn {
		targets := make([]map[string]any, 0, 8)
		if view, ok := data["ReturnTargets"].([]workflow.Node); ok {
			for _, node := range view {
				targets = append(targets, map[string]any{"Value": node.ID, "Label": node.Name})
			}
		}
		data["ReturnOptions"] = targets
	}
	c.render(ctx, http.StatusOK, TplWorkflowTaskDrawer, c.view(ctx, "任务详情 | Task", data))
}

// workflowFormFieldView is one form field prepared for rendering. | workflowFormFieldView 是准备渲染的一个表单字段。
type workflowFormFieldView struct {
	// Field is the domain field. | Field 是领域字段。
	Field workflow.FormField
	// ID is the stable HTML id. | ID 是稳定的 HTML ID。
	ID string
	// Name is the submitted field name. The field_ prefix keeps a design field from colliding with
	// the action form's own decision/comment/title/target fields. | Name 是提交字段名。field_ 前缀
	// 防止设计字段与动作表单自带的 decision/comment/title/target 字段同名覆盖。
	Name string
	// InputType is the HTML input type for generic fields; date, datetime and time use the shared
	// picker component instead. | InputType 是一般字段的 HTML 输入类型；date、datetime 与 time
	// 使用共享选择器组件。
	InputType string
	// Value is the current string value. | Value 是当前字符串值。
	Value string
	// Checked is the boolean state of a checkbox. | Checked 是复选框的布尔状态。
	Checked bool
	// Options are the selectable values. | Options 是可选项。
	Options []map[string]any
}

// workflowFormFieldViews prepares fields with values and select options. | workflowFormFieldViews
// 准备带取值与选项的表单字段。
func workflowFormFieldViews(fields []workflow.FormField, values map[string]string) []workflowFormFieldView {
	out := make([]workflowFormFieldView, 0, len(fields))
	for _, field := range fields {
		value := values[field.Key]
		view := workflowFormFieldView{
			Field:     field,
			ID:        "yd-workflow-field-" + field.Key,
			Name:      "field_" + field.Key,
			InputType: field.Type,
			Value:     value,
			Checked:   value == "true" || value == "on" || value == "1" || value == "yes",
		}
		for _, option := range field.Options {
			view.Options = append(view.Options, map[string]any{
				"Value": option.Value, "Label": option.Label, "Key": "",
				"Selected": option.Value == value,
			})
		}
		out = append(out, view)
	}
	return out
}

// workflowTaskView builds the template contract of one loaded task. canAct is the permission of
// the endpoint that will receive the forms; a viewer without it sees the read-only drawer even
// when they are the assignee. | workflowTaskView 构建已加载任务的模板契约。canAct 是接收表单的
// 端点所要求的权限；没有它的查看者即使是指派人，也只看到只读抽屉。
func workflowTaskView(detail workflow.TaskDetail, actor workflow.Actor, basePath string, canAct bool) map[string]any {
	view := workflowTaskViewData{
		Task:          detail.Task,
		Instance:      detail.Instance,
		Definition:    detail.Definition,
		Version:       detail.Version,
		Node:          detail.Node,
		Comments:      detail.Comments,
		Variables:     detail.Variables,
		FormFields:    detail.Node.Form,
		FormValues:    workflowStringValues(detail.Variables, detail.Node.Form),
		ReturnTargets: workflowReturnTargets(detail),
		BasePath:      basePath,
	}
	assigned := detail.Task.AssigneeID == actor.ID
	view.CanAdmin = canAct && actor.Admin
	view.CanClaim = canAct && detail.Instance.Status == workflow.InstanceRunning &&
		detail.Task.Status == workflow.TaskPending &&
		detail.Task.AssigneeID == "" && workflowTaskHasCandidate(detail.Task, actor.ID)
	view.CanAct = canAct && detail.Instance.Status == workflow.InstanceRunning &&
		(detail.Task.Status == workflow.TaskPending || detail.Task.Status == workflow.TaskClaimed) &&
		(assigned || actor.Admin) && detail.Task.AssigneeID != ""
	view.CanRemind = canAct && detail.Instance.Status == workflow.InstanceRunning &&
		(detail.Instance.InitiatorID == actor.ID || actor.Admin)
	view.CanReturn = view.CanAct && !detail.Design.Settings.ForbidReturn
	view.CanSign = canAct && (view.CanAct || actor.Admin) && !detail.Design.Settings.ForbidAddSign
	view.CanDelegate = view.CanAct && !detail.Design.Settings.ForbidDelegate
	return map[string]any{
		"View":            view,
		"Task":            view.Task,
		"Instance":        view.Instance,
		"Definition":      view.Definition,
		"WorkflowVersion": view.Version,
		"Node":            view.Node,
		"Comments":        view.Comments,
		"Variables":       view.Variables,
		"FormFields":      view.FormFields,
		"FormValues":      view.FormValues,
		"ReturnTargets":   view.ReturnTargets,
		"CanAct":          view.CanAct,
		"CanClaim":        view.CanClaim,
		"CanAdmin":        view.CanAdmin,
		"CanRemind":       view.CanRemind,
		"CanReturn":       view.CanReturn,
		"CanSign":         view.CanSign,
		"CanDelegate":     view.CanDelegate,
		"BasePath":        view.BasePath,
	}
}

// workflowStringValues maps instance variables onto the string form values of one form. |
// workflowStringValues 把实例变量映射到表单的字符串初值。
func workflowStringValues(variables map[string]any, fields []workflow.FormField) map[string]string {
	out := map[string]string{}
	for _, field := range fields {
		value, ok := variables[field.Key]
		if !ok {
			continue
		}
		data, err := json.Marshal(value)
		if err != nil {
			continue
		}
		text := string(data)
		if len(text) >= 2 && text[0] == '"' {
			var decoded string
			if json.Unmarshal(data, &decoded) == nil {
				text = decoded
			}
		}
		out[field.Key] = text
	}
	return out
}

// workflowReturnTargets lists the user tasks a task may return to. | workflowReturnTargets
// 列出任务可以退回的用户任务。
func workflowReturnTargets(detail workflow.TaskDetail) []workflow.Node {
	visited := workflow.DecodeStringList(detail.Instance.VisitedNodes)
	out := make([]workflow.Node, 0, len(visited))
	seen := map[string]bool{}
	for _, id := range visited {
		if seen[id] || id == detail.Task.NodeID {
			continue
		}
		if node, ok := detail.Design.FindNode(id); ok && node.Type == workflow.NodeUserTask {
			seen[id] = true
			out = append(out, node)
		}
	}
	out = append(out, workflow.Node{ID: workflow.InitiatorNodeID, Type: workflow.NodeUserTask, Name: "发起人 | Initiator"})
	return out
}

// workflowTaskHasCandidate reports whether id appears in the candidate pool. | workflowTaskHasCandidate
// 报告 id 是否在候选池中。
func workflowTaskHasCandidate(task workflow.Task, id string) bool {
	for _, candidate := range task.CandidateList() {
		if candidate == id {
			return true
		}
	}
	return false
}

// WorkflowStartDrawer renders the start-process drawer. | WorkflowStartDrawer 渲染发起流程抽屉。
//
// @Summary Start-process drawer | 发起流程抽屉
// @Description Lists published definitions, or renders the selected definition's start form. | 列出已发布定义，或渲染所选定义的发起表单。
// @Tags workflow
// @Produce html
// @Param definition query string false "Definition key | 定义键"
// @Success 200 {string} string "start form | 发起表单"
// @Security BearerAuth
// @Router /workflow/start [get]
func (c *Controller) WorkflowStartDrawer(ctx *router.Ctx) {
	if !c.workflowServiceOrFail(ctx) {
		return
	}
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return
	}
	key := strings.TrimSpace(ctx.Query(FieldWorkflowFilterDefinition))
	data := map[string]any{"BasePath": "/workflow", "Key": key}
	definitions, err := c.workflow.ListDefinitions(ctx.Request.Context(), tenantID, workflow.DefinitionFilter{
		Status: workflow.DefinitionPublished, Page: 1, PageSize: c.workflow.Options().MaxPageSize,
	})
	if err != nil {
		c.failService(ctx, err)
		return
	}
	data["Definitions"] = definitions.Items
	if key != "" {
		definition, err := c.workflow.GetDefinitionByKey(ctx.Request.Context(), tenantID, key)
		if err != nil {
			c.failService(ctx, err)
			return
		}
		if definition.Status != workflow.DefinitionPublished {
			c.fail(ctx, http.StatusNotFound, "该流程未发布 | the process is not published")
			return
		}
		version, design, err := c.workflow.LatestPublishedVersion(ctx.Request.Context(), tenantID, definition.ID)
		if err != nil {
			c.failService(ctx, err)
			return
		}
		data["Definition"] = definition
		data["WorkflowVersion"] = version
		data["Fields"] = workflowFormFieldViews(design.StartForm(), map[string]string{})
		data["FormValues"] = map[string]string{}
	}
	c.render(ctx, http.StatusOK, TplWorkflowStartDrawer, c.view(ctx, "发起流程 | Start", data))
}

// WorkflowStart starts one instance from the drawer form. | WorkflowStart 从抽屉表单发起一个实例。
//
// @Summary Start a process | 发起流程
// @Description Creates an instance from the selected published definition and its start form. | 从所选已发布定义及其发起表单创建实例。
// @Tags workflow
// @Accept application/x-www-form-urlencoded
// @Produce html
// @Param definition formData string true "Definition key | 定义键"
// @Param title formData string true "Instance title | 实例标题"
// @Param business_key formData string false "External business key | 外部业务键"
// @Success 303 {string} string "redirect to my workflows | 跳转到我的流程"
// @Failure 422 {string} string "form validation failed | 表单校验失败"
// @Security BearerAuth
// @Router /workflow/start [post]
func (c *Controller) WorkflowStart(ctx *router.Ctx) {
	if !c.workflowServiceOrFail(ctx) {
		return
	}
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return
	}
	key := strings.TrimSpace(ctx.FormValue(FieldWorkflowFilterDefinition))
	definition, err := c.workflow.GetDefinitionByKey(ctx.Request.Context(), tenantID, key)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	version, design, err := c.workflow.LatestPublishedVersion(ctx.Request.Context(), tenantID, definition.ID)
	if err != nil {
		if errors.Is(err, workflow.ErrNotFound) {
			c.fail(ctx, http.StatusUnprocessableEntity, "该流程尚未发布 | the process has no published version")
			return
		}
		c.failService(ctx, err)
		return
	}
	actor := c.workflowActor(ctx)
	instance, err := c.workflow.Start(ctx.Request.Context(), tenantID, actor, workflow.StartInput{
		DefinitionID: definition.ID,
		Version:      version.Version,
		Title:        field(ctx, FieldWorkflowTitle),
		BusinessKey:  field(ctx, FieldWorkflowBusinessKey),
		FormData:     workflowSubmittedForm(ctx, design.StartForm()),
	})
	if err != nil {
		c.failService(ctx, err)
		return
	}
	c.toast(ctx, "流程已发起 | Workflow started")
	_ = instance
	c.redirect(ctx, "/workflow/tasks?tab=started")
}

// workflowSubmittedForm reads the form fields of one design scope from the request. The field_
// prefix is added by the rendered controls, so a design field can never shadow the action form's
// own decision/comment/title/target fields. | workflowSubmittedForm 从请求读取一个设计作用域的
// 表单字段。渲染控件时加上的 field_ 前缀保证设计字段绝不会覆盖动作表单自带的
// decision/comment/title/target 字段。
func workflowSubmittedForm(ctx *router.Ctx, fields []workflow.FormField) map[string]any {
	values := map[string]any{}
	for _, field := range fields {
		raw := strings.TrimSpace(ctx.FormValue("field_" + field.Key))
		switch field.Type {
		case "number":
			if raw == "" {
				continue
			}
			if parsed, err := strconv.ParseFloat(raw, 64); err == nil {
				values[field.Key] = parsed
			} else {
				values[field.Key] = raw
			}
		case "checkbox":
			values[field.Key] = raw == "on" || raw == "true" || raw == "1"
		default:
			if raw != "" || field.Required {
				values[field.Key] = raw
			}
		}
	}
	return values
}

