// workflowTaskViewData is the template contract of one task drawer. | workflowTaskViewData 是任务抽屉的模板契约。
type workflowTaskViewData struct {
	// Task is the task row. | Task 是任务记录。
	Task workflow.Task
	// Instance is the owning instance. | Instance 是所属实例。
	Instance workflow.Instance
	// Definition and Version describe the pinned process. | Definition 与 Version 描述绑定的流程。
	Definition workflow.Definition
	Version    workflow.Version
	// Node is the current design node. | Node 是当前设计节点。
	Node workflow.Node
	// Comments are the instance comments. | Comments 是实例评论。
	Comments []workflow.Comment
	// Variables are the instance variables. | Variables 是实例变量。
	Variables map[string]any
	// FormFields are the node form fields. | FormFields 是节点表单字段。
	FormFields []workflow.FormField
	// FormValues are the initial string values of the node form. | FormValues 是节点表单的初始字符串值。
	FormValues map[string]string
	// ReturnTargets are the visited user tasks a return may target. | ReturnTargets 是退回可选的已访问用户任务。
	ReturnTargets []workflow.Node
	// CanAct, CanClaim, CanAdmin and CanRemind gate the action forms. | CanAct、CanClaim、CanAdmin 与
	// CanRemind 控制动作表单是否出现。
	CanAct      bool
	CanClaim    bool
	CanAdmin    bool
	CanRemind   bool
	CanReturn   bool
	CanSign     bool
	CanDelegate bool
	// BasePath is the action prefix, portal or management. | BasePath 是动作前缀，门户或后台。
	BasePath string
}

// WorkflowTasks renders the portal task page. | WorkflowTasks 渲染门户待办页面。
//
// @Summary My workflow tasks | 我的流程待办
// @Description Renders the todo, done and started tabs with counts and filters. | 渲染待办、已办与我发起的页签及筛选。
// @Tags workflow
// @Produce html
// @Param tab query string false "todo, done or started | todo、done 或 started"
// @Param q query string false "Search keyword | 搜索关键字"
// @Param page query int false "1-based page | 从 1 开始的页码"
// @Success 200 {string} string "task page | 待办页面"
// @Failure 403 {string} string "permission denied | 权限不足"
// @Security BearerAuth
// @Router /workflow/tasks [get]
func (c *Controller) WorkflowTasks(ctx *router.Ctx) {
	if !c.workflowServiceOrFail(ctx) {
		return
	}
	if workflowHTMXTarget(ctx, "yd-workflow-task-list") {
		c.WorkflowTaskList(ctx)
		return
	}
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return
	}
	tab := strings.ToLower(strings.TrimSpace(ctx.Query(FieldWorkflowFilterTab)))
	if tab != "done" && tab != "started" {
		tab = "todo"
	}
	c.renderWorkflowTasksPage(ctx, tenantID, c.workflowActor(ctx), tab, field(ctx, FieldKeyword), pageNumber(ctx))
}

// renderWorkflowTasksPage renders the whole portal task page for one tab. | renderWorkflowTasksPage
// 为指定页签渲染完整的门户任务页面。
func (c *Controller) renderWorkflowTasksPage(ctx *router.Ctx, tenantID string, actor workflow.Actor, tab, keyword string, pageNo int) {
	if tab != "done" && tab != "started" {
		tab = "todo"
	}
	data := c.pageView(ctx, "我的流程 | My workflows", map[string]any{
		"Tab":        tab,
		"Keyword":    keyword,
		"CanStart":   permissionWorkflowUse(ctx),
		"CanApprove": permissionWorkflowApprove(ctx),
		"TabItems":   c.workflowTaskTabs(ctx, tab),
	})
	if tab == "started" {
		page, err := c.workflow.ListInstances(ctx.Request.Context(), tenantID, workflow.InstanceFilter{
			Query: keyword, InitiatorID: actor.ID, Page: pageNo,
		})
		if err != nil {
			c.failService(ctx, err)
			return
		}
		data["Instances"] = page.Items
		data["Total"] = page.Total
		data["Page"] = page.Page
		data["PageSize"] = page.PageSize
		data["Pagination"] = c.workflowPagination(ctx, "/workflow/tasks", map[string]string{
			"tab": tab, "q": keyword,
		}, page.Page, page.PageSize, page.Total)
	} else {
		filter := workflow.TaskFilter{
			Query: keyword, ActorID: actor.ID, Page: pageNo,
		}
		if tab == "done" {
			filter.Status = workflow.TaskCompleted
		} else {
			filter.Statuses = []string{workflow.TaskPending, workflow.TaskClaimed}
		}
		page, err := c.workflow.ListTasks(ctx.Request.Context(), tenantID, filter)
		if err != nil {
			c.failService(ctx, err)
			return
		}
		data["Tasks"] = page.Items
		data["Total"] = page.Total
		data["Page"] = page.Page
		data["PageSize"] = page.PageSize
		data["Pagination"] = c.workflowPagination(ctx, "/workflow/tasks", map[string]string{
			"tab": tab, "q": keyword,
		}, page.Page, page.PageSize, page.Total)
	}
	if definitions, err := c.workflow.ListDefinitions(ctx.Request.Context(), tenantID, workflow.DefinitionFilter{
		Status: workflow.DefinitionPublished, Page: 1, PageSize: 100,
	}); err == nil {
		data["StartDefinitions"] = definitions.Items
	}
	c.render(ctx, http.StatusOK, TplWorkflowTasks, data)
}

// workflowTaskTabs builds the server-driven tab links. | workflowTaskTabs 构建服务端驱动的页签链接。
func (c *Controller) workflowTaskTabs(ctx *router.Ctx, active string) []map[string]any {
	tabs := []struct {
		Key      string
		LabelKey string
		Label    string
	}{
		{"todo", "workflow.tasks.todo", c.tr(c.lang(ctx), "workflow.tasks.todo")},
		{"done", "workflow.tasks.done", c.tr(c.lang(ctx), "workflow.tasks.done")},
		{"started", "workflow.tasks.started", c.tr(c.lang(ctx), "workflow.tasks.started")},
	}
	out := make([]map[string]any, 0, len(tabs))
	for _, tab := range tabs {
		out = append(out, map[string]any{
			"Href": "/workflow/tasks?tab=" + tab.Key, "Get": "/workflow/tasks?tab=" + tab.Key,
			"Target": "#yd-workspace", "Swap": "innerMorph", "PushURL": true,
			"Label": tab.Label, "LabelKey": tab.LabelKey, "Active": tab.Key == active,
		})
	}
	return out
}

// workflowCurrentQuery reads one query value from the fragment's current URL. | workflowCurrentQuery
// 从片段当前 URL 读取一个查询值。
//
// htmx sends HX-Current-URL for every request, so a drawer action can refresh the page the user
// is actually looking at instead of falling back to the first tab. | htmx 每次请求都会发送
// HX-Current-URL，因此抽屉动作可以刷新用户正在看的页面，而不是退回第一个页签。
func workflowCurrentQuery(ctx *router.Ctx, key string) string {
	raw := strings.TrimSpace(ctx.Request.Header.Get("HX-Current-URL"))
	if raw == "" {
		return ctx.Query(key)
	}
	if i := strings.IndexByte(raw, '?'); i >= 0 {
		raw = raw[i+1:]
	} else {
		return ""
	}
	values, err := url.ParseQuery(raw)
	if err != nil {
		return ""
	}
	return values.Get(key)
}

// pageNumberFromQuery parses a positive page number. | pageNumberFromQuery 解析正整数页码。
func pageNumberFromQuery(ctx *router.Ctx, raw string) int {
	value, err := strconv.Atoi(strings.TrimSpace(raw))
	if err != nil || value < 1 {
		return 1
	}
	return value
}

// permissionWorkflowUse reports workflow:use for a template flag. | permissionWorkflowUse 为模板标记报告 workflow:use。
func permissionWorkflowUse(ctx *router.Ctx) bool {
	return authz.Can(ctx.Request.Context(), authz.PermWorkflowUse)
}

// permissionWorkflowApprove reports workflow:approve for a template flag. | permissionWorkflowApprove
// 为模板标记报告 workflow:approve。
func permissionWorkflowApprove(ctx *router.Ctx) bool {
	return authz.Can(ctx.Request.Context(), authz.PermWorkflowApprove)
}

// WorkflowTaskList renders only the task table after a mutation or filter. | WorkflowTaskList
// 在变更或筛选后只渲染任务表格。
//
// @Summary Task list fragment | 任务列表片段
// @Description Returns the portal task table alone. | 只返回门户任务表格。
// @Tags workflow
// @Produce html
// @Param tab query string false "todo, done or started | todo、done 或 started"
// @Param q query string false "Search keyword | 搜索关键字"
// @Param page query int false "1-based page | 从 1 开始的页码"
// @Success 200 {string} string "task table | 任务表格"
// @Security BearerAuth
// @Router /workflow/tasks/list [get]
func (c *Controller) WorkflowTaskList(ctx *router.Ctx) {
	if !c.workflowServiceOrFail(ctx) {
		return
	}
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return
	}
	actor := c.workflowActor(ctx)
	tab := strings.ToLower(strings.TrimSpace(ctx.Query(FieldWorkflowFilterTab)))
	if tab != "done" && tab != "started" {
		tab = "todo"
	}
	data := c.view(ctx, "任务列表 | Tasks", map[string]any{"Tab": tab, "Keyword": field(ctx, FieldKeyword)})
	if tab == "started" {
		page, err := c.workflow.ListInstances(ctx.Request.Context(), tenantID, workflow.InstanceFilter{
			Query: field(ctx, FieldKeyword), InitiatorID: actor.ID, Page: pageNumber(ctx),
		})
		if err != nil {
			c.failService(ctx, err)
			return
		}
		data["Instances"] = page.Items
		data["Total"] = page.Total
		data["Page"] = page.Page
		data["PageSize"] = page.PageSize
		data["Pagination"] = c.workflowPagination(ctx, "/workflow/tasks", map[string]string{
			"tab": tab, "q": field(ctx, FieldKeyword),
		}, page.Page, page.PageSize, page.Total)
	} else {
		filter := workflow.TaskFilter{Query: field(ctx, FieldKeyword), ActorID: actor.ID, Page: pageNumber(ctx)}
		if tab == "done" {
			filter.Status = workflow.TaskCompleted
		} else {
			filter.Statuses = []string{workflow.TaskPending, workflow.TaskClaimed}
		}
		page, err := c.workflow.ListTasks(ctx.Request.Context(), tenantID, filter)
		if err != nil {
			c.failService(ctx, err)
			return
		}
		data["Tasks"] = page.Items
		data["Total"] = page.Total
		data["Page"] = page.Page
		data["PageSize"] = page.PageSize
		data["Pagination"] = c.workflowPagination(ctx, "/workflow/tasks", map[string]string{
			"tab": tab, "q": field(ctx, FieldKeyword),
		}, page.Page, page.PageSize, page.Total)
	}
	data["OOB"] = true
	c.render(ctx, http.StatusOK, TplWorkflowTaskList, data)
}

