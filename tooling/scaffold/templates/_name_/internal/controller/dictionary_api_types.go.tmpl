// dictionaryCodes collects repeated code parameters and comma-separated codes parameters. |
// dictionaryCodes 收集重复的 code 参数与逗号分隔的 codes 参数。
func dictionaryCodes(ctx *router.Ctx) []string {
	codes := make([]string, 0, 4)
	appendCodes := func(value string) {
		for _, part := range strings.Split(value, ",") {
			if part = strings.TrimSpace(part); part != "" {
				codes = append(codes, part)
			}
		}
	}
	for _, value := range ctx.QueryValuesAll("code") {
		appendCodes(value)
	}
	for _, value := range ctx.QueryValuesAll("codes") {
		appendCodes(value)
	}
	return codes
}

// queryInt reads one integer query parameter and falls back to fallback. | queryInt 读取一个整数查询参数，非法时回退。
func queryInt(ctx *router.Ctx, name string, fallback int) int {
	value, err := strconv.Atoi(strings.TrimSpace(ctx.Query(name)))
	if err != nil {
		return fallback
	}
	return value
}

// dictionaryTypeInput converts a JSON payload into the domain input. | dictionaryTypeInput 把 JSON 载荷转换为领域输入。
func dictionaryTypeInput(request dictionaryTypeRequest) dictionary.TypeInput {
	return dictionary.TypeInput{
		Code:        request.Code,
		Name:        request.Name,
		NameEN:      request.NameEN,
		Description: request.Description,
		Status:      dictionary.Status(request.Status),
		Sort:        request.Sort,
	}
}

// dictionaryItemInput converts a JSON payload into the domain input. | dictionaryItemInput 把 JSON 载荷转换为领域输入。
func dictionaryItemInput(request dictionaryItemRequest) (dictionary.ItemInput, error) {
	extra, err := dictionaryExtraInput(request.Extra)
	if err != nil {
		return dictionary.ItemInput{}, err
	}
	return dictionary.ItemInput{
		Value:   request.Value,
		Label:   request.Label,
		LabelEN: request.LabelEN,
		Extra:   extra,
		Remark:  request.Remark,
		Status:  dictionary.Status(request.Status),
		Default: request.Default,
		Sort:    request.Sort,
	}, nil
}

// dictionaryExtraInput normalizes the JSON metadata field: a string is treated as raw JSON and any
// other value is marshalled; both must produce a JSON object. | dictionaryExtraInput 规范化 JSON 元数据字段：
// 字符串按原始 JSON 处理，其它值序列化；两者都必须产生 JSON 对象。
func dictionaryExtraInput(value any) (string, error) {
	if value == nil {
		return "", nil
	}
	if text, ok := value.(string); ok {
		text = strings.TrimSpace(text)
		if text == "" {
			return "", nil
		}
		if !json.Valid([]byte(text)) {
			return "", dictionary.ErrInvalidExtra
		}
		return text, nil
	}
	data, err := json.Marshal(value)
	if err != nil {
		return "", dictionary.ErrInvalidExtra
	}
	return string(data), nil
}

// dictionarySnapshotViews converts resolved snapshots into API views in request order. | dictionarySnapshotViews
// 按请求顺序把已解析快照转换为 API 视图。
func dictionarySnapshotViews(snapshots map[string]dictionary.Snapshot, order []string) ([]dictionarySnapshotView, []string) {
	views := make([]dictionarySnapshotView, 0, len(order))
	missing := make([]string, 0)
	seen := make(map[string]struct{}, len(order))
	for _, code := range order {
		code = strings.ToLower(strings.TrimSpace(code))
		if code == "" {
			continue
		}
		if _, ok := seen[code]; ok {
			continue
		}
		seen[code] = struct{}{}
		snapshot, ok := snapshots[code]
		if !ok {
			missing = append(missing, code)
			continue
		}
		views = append(views, dictionarySnapshotViewOf(snapshot))
	}
	return views, missing
}

// dictionarySnapshotViewOf converts one snapshot. | dictionarySnapshotViewOf 转换一个快照。
func dictionarySnapshotViewOf(snapshot dictionary.Snapshot) dictionarySnapshotView {
	items := make([]dictionarySnapshotItemView, 0, len(snapshot.Items))
	for _, item := range snapshot.Items {
		items = append(items, dictionarySnapshotItemView{
			Value:     item.Value,
			Label:     item.Label,
			LabelEN:   item.LabelEN,
			Extra:     dictionaryExtraValue(item.Extra),
			IsDefault: item.IsDefault,
			Sort:      item.Sort,
		})
	}
	return dictionarySnapshotView{
		Scope:       string(snapshot.Scope),
		Code:        snapshot.Code,
		Name:        snapshot.Name,
		NameEN:      snapshot.NameEN,
		Description: snapshot.Description,
		Items:       items,
	}
}
