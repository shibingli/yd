// APICMSDashboard returns the aggregate. | APICMSDashboard 返回聚合数据。
//
// @Summary CMS overview API | CMS 概览 API
// @Description Returns article, category, tag, media and comment aggregates. | 返回文章、分类、标签、媒体与评论的聚合。
// @Tags cms-api
// @Produce json
// @Success 200 {object} cms.Counts "aggregate | 聚合"
// @Security BearerAuth
// @Router /api/v1/cms/dashboard [get]
func (c *Controller) APICMSDashboard(ctx *router.Ctx) {
	tenantID, ok := c.tenantID(ctx)
	if !ok || !c.apiCMSAvailable(ctx) || !c.cmsEnsure(ctx, tenantID) {
		return
	}
	if !c.cmsReadAll(ctx) {
		c.apiCMSFail(ctx, cms.ErrForbidden)
		return
	}
	counts, err := c.cms.Dashboard(ctx.Request.Context(), tenantID)
	if err != nil {
		c.apiCMSFail(ctx, err)
		return
	}
	_ = ctx.JSON(http.StatusOK, counts)
}

// APICMSArticles lists articles. | APICMSArticles 列出文章。
//
// @Summary Article list API | 文章列表 API
// @Description Returns article JSON under the filter. | 按筛选条件返回文章 JSON。
// @Tags cms-api
// @Produce json
// @Param q query string false "keyword | 关键字"
// @Param status query string false "status | 状态"
// @Param kind query string false "kind | 类型"
// @Param category query string false "category id | 分类 ID"
// @Param tag query string false "tag id | 标签 ID"
// @Param page query int false "page | 页码"
// @Param page_size query int false "page size | 页长"
// @Success 200 {object} map[string]any "article page | 文章分页"
// @Security BearerAuth
// @Router /api/v1/cms/articles [get]
func (c *Controller) APICMSArticles(ctx *router.Ctx) {
	tenantID, ok := c.tenantID(ctx)
	if !ok || !c.apiCMSAvailable(ctx) || !c.cmsEnsure(ctx, tenantID) {
		return
	}
	filter := cmsArticleFilter(ctx)
	filter.PageSize, _ = strconv.Atoi(ctx.Query("page_size"))
	if filter.PageSize <= 0 {
		filter.PageSize = c.cms.Options().PageSize
	}
	if !c.cmsReadAll(ctx) {
		filter.AuthorID = c.cmsActor(ctx).ID
	}
	page, err := c.cms.Articles(ctx.Request.Context(), tenantID, filter)
	if err != nil {
		c.apiCMSFail(ctx, err)
		return
	}
	_ = ctx.JSON(http.StatusOK, map[string]any{
		"items": model.NewCMSArticles(page.Items, c.cmsActor(ctx).ID, c.cmsActor(ctx).Manage, c.cmsActor(ctx).Publish, c.cmsActor(ctx).Review),
		"total": page.Total, "page": page.Page, "page_size": page.PageSize, "total_pages": page.TotalPages,
	})
}

// APICMSArticle returns one article. | APICMSArticle 返回一篇文章。
//
// @Summary Article detail API | 文章详情 API
// @Description Returns an article by id, including non-public states. | 按 ID 返回文章（含非公开状态）。
// @Tags cms-api
// @Produce json
// @Param id path string true "article id | 文章 ID"
// @Success 200 {object} cms.ArticleView "article | 文章"
// @Failure 404 {string} string "article not found | 文章不存在"
// @Security BearerAuth
// @Router /api/v1/cms/articles/{id} [get]
func (c *Controller) APICMSArticle(ctx *router.Ctx) {
	tenantID, ok := c.tenantID(ctx)
	if !ok || !c.apiCMSAvailable(ctx) {
		return
	}
	article, err := c.cms.Article(ctx.Request.Context(), tenantID, ctx.Param("id"), false)
	if err != nil {
		c.apiCMSFail(ctx, err)
