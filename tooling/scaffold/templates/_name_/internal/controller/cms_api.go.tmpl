// apiCMSAvailable reports whether the CMS can serve an API request. | apiCMSAvailable 报告 CMS 能否服务 API 请求。
func (c *Controller) apiCMSAvailable(ctx *router.Ctx) bool {
	if c.CMSAvailable() {
		return true
	}
	_ = ctx.JSON(http.StatusServiceUnavailable, map[string]any{"error": c.tr(c.lang(ctx), "cms.error.unavailable")})
	return false
}

// apiCMSFail maps a domain error onto JSON. | apiCMSFail 把领域错误映射为 JSON。
func (c *Controller) apiCMSFail(ctx *router.Ctx, err error) {
	status, message := statusFor(err)
	if status >= http.StatusInternalServerError {
		c.log.Error("CMS API request failed | CMS API 请求失败",
			logx.Err(err),
			logx.Str("path", ctx.Path()),
			logx.Str("method", ctx.Method()),
		)
		message = c.tr(c.lang(ctx), "cms.error.internal")
	}
	_ = ctx.JSON(status, map[string]any{"error": message})
}
