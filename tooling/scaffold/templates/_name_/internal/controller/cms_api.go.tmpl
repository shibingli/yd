// cmsArticlePayload is the JSON create/update payload. | cmsArticlePayload 是 JSON 创建/更新载荷。
//
// @Name cmsArticlePayload
type cmsArticlePayload struct {
	// CategoryID is the primary category. | CategoryID 是主分类。
	CategoryID string `json:"category_id"`
	// Title is the article title. | Title 是文章标题。
	Title string `json:"title"`
	// Slug is the optional URL segment. | Slug 是可选 URL 片段。
	Slug string `json:"slug"`
	// Summary is the list and SEO summary. | Summary 是列表与 SEO 摘要。
	Summary string `json:"summary"`
	// CoverURL is the cover image. | CoverURL 是封面图。
	CoverURL string `json:"cover_url"`
	// BodyMarkdown is the editable source. | BodyMarkdown 是可编辑源。
	BodyMarkdown string `json:"body_markdown"`
	// Kind is post or page. | Kind 是文章或单页。
	Kind string `json:"kind"`
	// Visibility is public or private. | Visibility 是公开或私有。
	Visibility string `json:"visibility"`
	// Featured marks the article. | Featured 标记推荐。
	Featured bool `json:"featured"`
	// Pinned pins the article. | Pinned 标记置顶。
	Pinned bool `json:"pinned"`
	// AllowComment accepts comments. | AllowComment 接受评论。
	AllowComment bool `json:"allow_comment"`
	// SEOTitle is the head-title override. | SEOTitle 是文档头标题覆盖。
	SEOTitle string `json:"seo_title"`
	// SEODescription is the meta description. | SEODescription 是元描述。
	SEODescription string `json:"seo_description"`
	// SEOKeywords is the keyword list. | SEOKeywords 是关键词列表。
	SEOKeywords string `json:"seo_keywords"`
	// CanonicalURL is the canonical link. | CanonicalURL 是规范链接。
	CanonicalURL string `json:"canonical_url"`
	// Source credits the original publication. | Source 标注原文出处。
	Source string `json:"source"`
	// Note explains the edit in the revision history. | Note 在修订历史中说明本次编辑。
	Note string `json:"note"`
	// TagIDs attaches existing tags. | TagIDs 挂载已有标签。
	TagIDs []string `json:"tag_ids"`
	// TagNames creates or reuses tags. | TagNames 创建或复用标签。
	TagNames []string `json:"tag_names"`
}

// input converts the payload into the domain input. | input 把载荷转成领域输入。
func (p cmsArticlePayload) input(id string) cms.ArticleInput {
	// 空类型/可见性表示「保持原值」：创建时由领域服务补默认值，更新时保留当前值。
	// An empty kind/visibility means "keep the current value": creation fills defaults and updates preserve them.
	kind := cms.ArticleKind(p.Kind)
	visibility := cms.Visibility(p.Visibility)
	return cms.ArticleInput{
		ID: id, CategoryID: p.CategoryID, Title: p.Title, Slug: p.Slug,
		Summary: p.Summary, CoverURL: p.CoverURL, BodyMarkdown: p.BodyMarkdown,
		Kind: kind, Visibility: visibility, Featured: p.Featured, Pinned: p.Pinned,
		AllowComment: p.AllowComment, SEOTitle: p.SEOTitle, SEODescription: p.SEODescription,
		SEOKeywords: p.SEOKeywords, CanonicalURL: p.CanonicalURL, Source: p.Source,
		Note: p.Note, TagIDs: p.TagIDs, TagNames: p.TagNames,
	}
}

