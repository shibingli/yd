// APICMSTransitionArticle applies an editorial action. | APICMSTransitionArticle 应用编辑动作。
//
// @Summary Article transition API | 文章状态转换 API
// @Description Publishes, schedules, unpublishes, archives, restores, submits and reviews. | 发布、定时、下线、归档、恢复、提交与审核。
// @Tags cms-api
// @Accept json
// @Produce json
// @Param id path string true "article id | 文章 ID"
// @Param body body cmsTransitionPayload true "transition payload | 转换载荷"
// @Success 200 {object} cms.Article "article | 文章"
// @Security BearerAuth
// @Router /api/v1/cms/articles/{id}/transition [post]
func (c *Controller) APICMSTransitionArticle(ctx *router.Ctx) {
	tenantID, ok := c.tenantID(ctx)
	if !ok || !c.apiCMSAvailable(ctx) || !c.cmsEnsure(ctx, tenantID) {
		return
	}
	var payload cmsTransitionPayload
	if err := ctx.Bind(&payload); err != nil {
		c.apiCMSFail(ctx, cms.ErrInvalidInput)
		return
	}
	var at *time.Time
	if value := strings.TrimSpace(payload.PublishAt); value != "" {
		parsed, parseErr := time.Parse(time.RFC3339, value)
		if parseErr != nil {
			c.apiCMSFail(ctx, cms.ErrInvalidInput)
			return
		}
		utc := parsed.UTC()
		at = &utc
	}
	article, err := c.cms.TransitionArticle(ctx.Request.Context(), c.cmsActor(ctx), ctx.Param("id"), cms.ArticleAction(payload.Action), at)
	if err != nil {
		c.apiCMSFail(ctx, err)
		return
	}
	_ = ctx.JSON(http.StatusOK, article)
}

