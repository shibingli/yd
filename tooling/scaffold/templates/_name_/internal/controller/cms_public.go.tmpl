// cmsSitemapURL is one sitemap entry. | cmsSitemapURL 是一个站点地图条目。
type cmsSitemapURL struct {
	// Loc is the absolute address. | Loc 是绝对地址。
	Loc string `xml:"loc"`
	// LastMod is the optional last modification time. | LastMod 是可选最后修改时间。
	LastMod string `xml:"lastmod,omitempty"`
