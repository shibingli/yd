// blogList is the shared implementation of every public list route. | blogList 是全部公开列表路由的共同实现。
func (c *Controller) blogList(ctx *router.Ctx) {
	if !c.cmsAvailable(ctx) {
		return
	}
	tenantID, err := c.cmsPublicTenant(ctx)
	if err != nil {
		status, message := statusFor(err)
		c.failPublic(ctx, status, message)
		return
	}
	if !c.cmsEnsure(ctx, tenantID) {
		return
	}
	settings, err := c.cms.Settings(ctx.Request.Context(), tenantID)
	if err != nil {
		c.failServicePublic(ctx, err)
		return
	}
	pageSize := settings.PostsPerPage
	if pageSize <= 0 {
		pageSize = 10
	}
	pageNo := 0
	// The pager emits ?page=N even when the current route carries /page/N; prefer the query value so
	// Next/Prev advance instead of re-reading the frozen path segment. |
	// 分页器在当前路由带 /page/N 时仍输出 ?page=N；优先读取查询参数，使下一页/上一页真正推进，
	// 而不是反复读取固定的路径段。
	if value := ctx.Query("page"); value != "" {
		pageNo, _ = strconv.Atoi(value)
	}
	if pageNo == 0 {
		pageNo, _ = strconv.Atoi(ctx.Param("page"))
	}
	filter := cms.ArticleFilter{
		Keyword:    strings.TrimSpace(ctx.Query("q")),
		Kind:       cms.KindPost,
		PublicOnly: true,
		Page:       pageNo,
		PageSize:   pageSize,
	}
	extra := map[string]any{
		"Articles":   []model.CMSArticle{},
		"Keyword":    filter.Keyword,
		"Site":       settings,
		"Page":       pageNo,
		"Empty":      true,
		"Categories": []cms.CategoryOption{},
	}
	if slug := strings.TrimSpace(ctx.Param("slug")); slug != "" {
		switch {
		case strings.Contains(ctx.Path(), "/blog/category/"):
			category, lookupErr := c.cms.CategoryBySlug(ctx.Request.Context(), tenantID, slug)
			if lookupErr != nil || !category.Visible {
				c.failPublic(ctx, http.StatusNotFound, cms.ErrCategoryNotFound.Error())
				return
			}
			ids, lookupErr := c.cms.CategorySubtreeIDs(ctx.Request.Context(), tenantID, category.ID)
			if lookupErr != nil {
				c.failServicePublic(ctx, lookupErr)
				return
			}
			filter.CategoryIDs = ids
			extra["CurrentCategory"] = category
		case strings.Contains(ctx.Path(), "/blog/tag/"):
			tag, lookupErr := c.cms.TagBySlug(ctx.Request.Context(), tenantID, slug)
			if lookupErr != nil {
				c.failServicePublic(ctx, lookupErr)
				return
			}
			filter.TagID = tag.ID
			extra["CurrentTag"] = tag
		}
	}
	page, err := c.cms.Articles(ctx.Request.Context(), tenantID, filter)
	if err != nil {
		c.failServicePublic(ctx, err)
		return
	}
	extra["Articles"] = cmsArticleRows(page.Items, c.cmsActor(ctx))
	extra["Total"] = page.Total
	extra["Empty"] = len(page.Items) == 0
	extra["Pager"] = newCMSPager(cmsPageBase(ctx), page.Page, page.TotalPages)
	options, _ := c.cms.PublicCategoryOptions(ctx.Request.Context(), tenantID)
	visible := make([]cms.CategoryOption, 0, len(options))
	for _, option := range options {
		if option.Visible {
			visible = append(visible, option)
		}
	}
	extra["Categories"] = visible
	data := c.cmsPublicData(ctx, tenantID, c.tr(c.lang(ctx), "cms.public.title"), extra)
	c.render(ctx, http.StatusOK, TplCMSPublicList, data)
}

