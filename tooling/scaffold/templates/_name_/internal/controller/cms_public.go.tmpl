// cmsAbsoluteURL builds an absolute URL from the request host. | cmsAbsoluteURL 从请求主机构造绝对 URL。
func cmsAbsoluteURL(ctx *router.Ctx, path string) string {
	scheme := "http"
	if ctx.Request.TLS != nil {
		scheme = "https"
	}
	if forwarded := strings.TrimSpace(ctx.Request.Header.Get("X-Forwarded-Proto")); forwarded == "https" || forwarded == "http" {
		scheme = forwarded
	}
	return scheme + "://" + ctx.Request.Host + path
}

// cmsAllArticles walks every public page for a sitemap. | cmsAllArticles 为站点地图遍历全部公开分页。
func (c *Controller) cmsAllArticles(ctx *router.Ctx, tenantID string, kind cms.ArticleKind) ([]cms.ArticleView, error) {
	out := make([]cms.ArticleView, 0)
	for pageNo := 1; ; pageNo++ {
		page, err := c.cms.Articles(ctx.Request.Context(), tenantID, cms.ArticleFilter{
			Kind: kind, PublicOnly: true, Page: pageNo, PageSize: 100,
		})
		if err != nil {
			return nil, err
		}
		out = append(out, page.Items...)
		if len(page.Items) == 0 || pageNo >= page.TotalPages || page.TotalPages == 0 {
			return out, nil
		}
	}
}

// cmsPublishedAt returns the effective publication time. | cmsPublishedAt 返回有效发布时间。
func cmsPublishedAt(article cms.Article) time.Time {
	if article.PublishAt != nil {
		return article.PublishAt.UTC()
	}
	return article.CreatedAt.UTC()
}

// cmsFeedDescription returns a bounded plain-text summary. | cmsFeedDescription 返回有界的纯文本摘要。
func cmsFeedDescription(article cms.Article) string {
	text := strings.TrimSpace(article.Summary)
	if text == "" {
		text = strings.TrimSpace(article.BodyText)
	}
	runes := []rune(text)
	if len(runes) > 400 {
		text = string(runes[:400])
	}
	return text
}

// failPublic renders an error with the public shell so a missing article or category still looks like
// the public site instead of the sign-in or portal shell. |
// failPublic 用公开站点外壳渲染错误，因此缺失的文章或分类仍然显示为公开站点，而不是登录页或门户外壳。
func (c *Controller) failPublic(ctx *router.Ctx, status int, messages ...string) {
	list := make([]map[string]any, 0, len(messages))
	for _, message := range messages {
		list = append(list, map[string]any{"Text": message})
	}
	c.render(ctx, status, TplError, c.view(ctx, "请求未通过校验 | Request failed validation", map[string]any{
		"Status":     status,
		"Errors":     list,
		"PublicSite": true,
	}))
}

// failServicePublic maps a service error onto a status and the public error page. |
// failServicePublic 把业务错误映射为状态码与公开错误页。
func (c *Controller) failServicePublic(ctx *router.Ctx, err error) {
	if err == nil {
		return
	}
	status, message := statusFor(err)
	c.failPublic(ctx, status, message)
}

// failFeed writes a machine-readable endpoint's failure as plain text instead of the portal HTML
// error page. A feed reader cannot use an HTML body, and embedding htmx markup in a feed is worse
// than a short status line. | failFeed 把机器读取端点的失败写成纯文本，而不是门户 HTML 错误页。
// 订阅器无法使用 HTML 正文，把 htmx 片段塞进订阅源比一行状态文本更糟。
func (c *Controller) failFeed(ctx *router.Ctx, err error) {
	if err == nil {
		return
	}
	status, message := statusFor(err)
	if status >= http.StatusInternalServerError {
		c.log.Error("feed request failed | 订阅源请求失败",
			logx.Err(err), logx.Str("path", ctx.Path()), logx.Str("method", ctx.Method()))
	} else {
		c.log.Warn("feed request refused | 订阅源请求被拒绝",
			logx.Err(err), logx.Str("path", ctx.Path()), logx.Str("method", ctx.Method()))
	}
	_ = ctx.String(status, message)
}
