// blogArticle is the shared implementation of article and page rendering. | blogArticle 是文章与单页渲染的共同实现。
func (c *Controller) blogArticle(ctx *router.Ctx, pageOnly bool) {
	if !c.cmsAvailable(ctx) {
		return
	}
	tenantID, err := c.cmsPublicTenant(ctx)
	if err != nil {
		status, message := statusFor(err)
		c.failPublic(ctx, status, message)
		return
	}
	if !c.cmsEnsure(ctx, tenantID) {
		return
	}
	article, err := c.cms.Article(ctx.Request.Context(), tenantID, ctx.Param("slug"), true)
	if err != nil {
		c.failServicePublic(ctx, err)
		return
	}
	if pageOnly && article.Kind != cms.KindPage {
		c.failPublic(ctx, http.StatusNotFound, cms.ErrArticleNotFound.Error())
		return
	}
	if !pageOnly && article.Kind == cms.KindPage {
		c.failPublic(ctx, http.StatusNotFound, cms.ErrArticleNotFound.Error())
		return
	}
	settings, err := c.cms.Settings(ctx.Request.Context(), tenantID)
	if err != nil {
		c.failServicePublic(ctx, err)
		return
	}
	if !pageOnly {
		if viewErr := c.cms.IncrementView(ctx.Request.Context(), tenantID, article.ID); viewErr != nil {
			c.log.Debug("CMS view counter failed | CMS 浏览量计数失败", logx.Err(viewErr))
		}
	}
	comments, _ := c.cms.Comments(ctx.Request.Context(), tenantID, cms.CommentFilter{
		ArticleID: article.ID, PublicOnly: true, Page: 1, PageSize: 50,
	})
	related, _ := c.cms.RelatedArticles(ctx.Request.Context(), tenantID, article.ID, 5)
	canComment := c.cmsCanInTenant(ctx, tenantID, authz.PermCmsCommentCreate) &&
		settings.CommentsEnabled && article.AllowComment && article.Kind == cms.KindPost
	rows := cmsArticleRows([]cms.ArticleView{article}, c.cmsActor(ctx))
	current := model.CMSArticle{}
	if len(rows) > 0 {
		current = rows[0]
	}
	title := article.Title
	if strings.TrimSpace(article.SEOTitle) != "" {
		title = article.SEOTitle
	}
	data := c.cmsPublicData(ctx, tenantID, title, map[string]any{
		"Article":    current,
		"Comments":   model.NewCMSComments(comments.Items, c.cmsActor(ctx).ID, false),
		"Related":    cmsArticleRows(related, c.cmsActor(ctx)),
		"CanComment": canComment,
		"Site":       settings,
	})
	data["OGType"] = "article"
	if description := strings.TrimSpace(article.SEODescription); description != "" {
		data["MetaDescription"] = description
	} else if summary := strings.TrimSpace(article.Summary); summary != "" {
		data["MetaDescription"] = summary
	}
	if keywords := strings.TrimSpace(article.SEOKeywords); keywords != "" {
		data["MetaKeywords"] = keywords
	}
	if canonical := strings.TrimSpace(article.CanonicalURL); canonical != "" {
		data["CanonicalURL"] = canonical
	} else if article.Kind == cms.KindPage {
		data["CanonicalURL"] = cmsAbsoluteURL(ctx, "/blog/p/"+article.Slug)
	} else {
		data["CanonicalURL"] = cmsAbsoluteURL(ctx, "/blog/"+article.Slug)
	}
	template := TplCMSPublicArticle
	if pageOnly || article.Kind == cms.KindPage {
		template = TplCMSPublicPage
	}
	c.render(ctx, http.StatusOK, template, data)
}

// BlogComment stores one comment from the public article page. | BlogComment 保存公开文章页的一条评论。
//
// @Summary Post comment | 发表评论
// @Description A signed-in user comments on a public article; moderation settings decide the initial state. | 登录用户在公开文章下发表评论；审核设置决定初始状态。
// @Tags cms-public
// @Accept x-www-form-urlencoded
// @Produce html
// @Param slug path string true "article slug | 文章别名"
// @Param body formData string true "comment body | 评论正文"
// @Param parent_id formData string false "parent comment | 父评论"
// @Success 200 {object} map[string]any "article page | 文章页"
// @Success 303 {object} string "redirect after success (non-htmx requests) | 成功后重定向（非 htmx 请求）"
// @Failure 422 {string} string "validation failed | 校验失败"
// @Security BearerAuth
// @Router /blog/{slug}/comments [post]
func (c *Controller) BlogComment(ctx *router.Ctx) {
	if !c.cmsAvailable(ctx) {
		return
	}
	tenantID, err := c.cmsPublicTenant(ctx)
	if err != nil {
		status, message := statusFor(err)
		c.failPublic(ctx, status, message)
		return
	}
	if !c.cmsEnsure(ctx, tenantID) {
		return
	}
	if _, ok := auth.CurrentUser(ctx); !ok {
		c.failPublic(ctx, http.StatusUnauthorized, msgUnauthorized)
		return
	}
	if !c.cmsCanInTenant(ctx, tenantID, authz.PermCmsCommentCreate) {
		c.failPublic(ctx, http.StatusForbidden, msgForbidden)
		return
	}
	article, err := c.cms.Article(ctx.Request.Context(), tenantID, ctx.Param("slug"), true)
	if err != nil {
		c.failServicePublic(ctx, err)
		return
	}
	actor := c.cmsActor(ctx)
	actor.TenantID = tenantID
	if _, err := c.cms.PostComment(ctx.Request.Context(), actor, cms.CommentInput{
		ArticleID: article.ID,
		ParentID:  ctx.FormValue("parent_id"),
		Body:      ctx.FormValue("body"),
	}); err != nil {
		c.failServicePublic(ctx, err)
		return
	}
	c.toast(ctx, c.tr(c.lang(ctx), "cms.notice.comment_submitted"))
	c.redirect(ctx, "/blog/"+article.Slug+"#comments")
}

// BlogMedia serves one public media file. | BlogMedia 提供一个公开媒体文件。
//
// @Summary Public media | 公开媒体
// @Description Serves uploaded media; cross-tenant and missing ids both answer 404. | 提供已上传媒体；跨租户与不存在的 ID 都返回 404。
// @Tags cms-public
// @Produce application/octet-stream
// @Param id path string true "media id | 媒体 ID"
// @Success 200 {file} file "file | 文件"
// @Failure 404 {string} string "media not found | 媒体不存在"
// @Router /blog/media/{id} [get]
func (c *Controller) BlogMedia(ctx *router.Ctx) {
	if c.cms == nil || !c.cms.Available() {
		_ = ctx.String(http.StatusServiceUnavailable, cms.ErrUnavailable.Error())
		return
	}
	tenantID, err := c.cmsPublicTenant(ctx)
	if err != nil {
		_ = ctx.String(http.StatusNotFound, "media not found | 媒体不存在")
		return
	}
	media, data, err := c.cms.ReadMedia(ctx.Request.Context(), tenantID, ctx.Param("id"))
	if err != nil {
		// A missing record/object is 404; a storage outage must stay 503 so a CDN or monitor does not
		// cache the failure as "the media was deleted". |
		// 记录或对象缺失是 404；存储故障必须保持 503，避免 CDN 或监控把它缓存成「媒体已删除」。
		status, message := statusFor(err)
		_ = ctx.String(status, message)
		return
	}
	writeCMSMedia(ctx, media, data, "public, max-age=86400")
}

// writeCMSMedia writes one media payload with the shared headers. The cache policy differs between
// the public site and the authenticated preview, because only the former is safe to share. |
// writeCMSMedia 用共享响应头写出一个媒体载荷。公开站点与鉴权预览的缓存策略不同：
// 只有前者可以安全共享。
func writeCMSMedia(ctx *router.Ctx, media cms.Media, data []byte, cache string) {
	disposition := "attachment"
	if strings.HasPrefix(media.ContentType, "image/") || strings.HasPrefix(media.ContentType, "video/") || strings.HasPrefix(media.ContentType, "audio/") {
		disposition = "inline"
	}
	ctx.Writer.Header().Set("Content-Type", media.ContentType)
	ctx.Writer.Header().Set("Content-Length", strconv.Itoa(len(data)))
	ctx.Writer.Header().Set("Content-Disposition", disposition+"; filename=\"media\"")
	ctx.Writer.Header().Set("Cache-Control", cache)
	ctx.Writer.Header().Set("X-Content-Type-Options", "nosniff")
	ctx.Writer.WriteHeader(http.StatusOK)
	_, _ = ctx.Writer.Write(data)
}

// BlogRSS renders the public RSS 2.0 feed. | BlogRSS 渲染公开 RSS 2.0 订阅源。
//
// @Summary RSS feed | RSS 订阅
// @Description Emits an RSS 2.0 document of recently published public articles. | 输出最近发布公开文章的 RSS 2.0 文档。
// @Tags cms-public
// @Produce application/rss+xml
// @Success 200 {string} string "RSS document | RSS 文档"
// @Failure 404 {string} string "feed disabled | 订阅源已关闭"
// @Router /blog/rss.xml [get]
func (c *Controller) BlogRSS(ctx *router.Ctx) {
	if !c.CMSAvailable() {
		_ = ctx.String(http.StatusServiceUnavailable, cms.ErrUnavailable.Error())
		return
	}
	tenantID, err := c.cmsPublicTenant(ctx)
	if err != nil {
		_ = ctx.String(http.StatusNotFound, "feed not found | 订阅源不存在")
		return
	}
	settings, err := c.cms.Settings(ctx.Request.Context(), tenantID)
	if err != nil {
		c.failFeed(ctx, err)
		return
	}
	if !settings.RSSEnabled {
		_ = ctx.String(http.StatusNotFound, "feed not found | 订阅源不存在")
		return
	}
	page, err := c.cms.Articles(ctx.Request.Context(), tenantID, cms.ArticleFilter{
		Kind: cms.KindPost, PublicOnly: true, Page: 1, PageSize: 50,
	})
	if err != nil {
		c.failFeed(ctx, err)
		return
	}
	channel := cmsRSSChannel{
		Title:       settings.SiteName,
		Link:        cmsAbsoluteURL(ctx, "/blog"),
		Description: settings.SiteDescription,
		Language:    c.lang(ctx),
	}
	for _, article := range page.Items {
		channel.Items = append(channel.Items, cmsRSSItem{
			Title:       article.Title,
			Link:        cmsAbsoluteURL(ctx, "/blog/"+article.Slug),
			GUID:        cmsAbsoluteURL(ctx, "/blog/"+article.Slug),
			PubDate:     cmsPublishedAt(article.Article).Format(time.RFC1123Z),
			Description: cmsFeedDescription(article.Article),
		})
	}
	payload, err := xml.Marshal(cmsRSS{Version: "2.0", Channel: channel})
	if err != nil {
		c.failFeed(ctx, err)
		return
	}
	ctx.Writer.Header().Set("Content-Type", "application/rss+xml; charset=utf-8")
	_, _ = ctx.Writer.Write([]byte(xml.Header))
	_, _ = ctx.Writer.Write(payload)
}

// BlogSitemap renders the public sitemap. | BlogSitemap 渲染公开站点地图。
//
// @Summary Sitemap | 站点地图
// @Description Emits an XML sitemap of posts, pages and categories. | 输出文章、单页与分类的 XML 站点地图。
// @Tags cms-public
// @Produce application/xml
// @Success 200 {string} string "sitemap | 站点地图"
// @Router /blog/sitemap.xml [get]
func (c *Controller) BlogSitemap(ctx *router.Ctx) {
	if !c.CMSAvailable() {
		_ = ctx.String(http.StatusServiceUnavailable, cms.ErrUnavailable.Error())
		return
	}
	tenantID, err := c.cmsPublicTenant(ctx)
	if err != nil {
		_ = ctx.String(http.StatusNotFound, "sitemap not found | 站点地图不存在")
		return
	}
	posts, err := c.cmsAllArticles(ctx, tenantID, cms.KindPost)
	if err != nil {
		c.failFeed(ctx, err)
		return
	}
	pages, err := c.cmsAllArticles(ctx, tenantID, cms.KindPage)
	if err != nil {
		c.failFeed(ctx, err)
		return
	}
	set := cmsURLSet{
		XMLNS: "http://www.sitemaps.org/schemas/sitemap/0.9",
		URLs:  []cmsSitemapURL{},
	}
	set.URLs = append(set.URLs, cmsSitemapURL{Loc: cmsAbsoluteURL(ctx, "/blog")})
	for _, article := range posts {
		set.URLs = append(set.URLs, cmsSitemapURL{
			Loc:     cmsAbsoluteURL(ctx, "/blog/"+article.Slug),
			LastMod: article.UpdatedAt.UTC().Format(time.RFC3339),
		})
	}
	for _, page := range pages {
		set.URLs = append(set.URLs, cmsSitemapURL{
			Loc:     cmsAbsoluteURL(ctx, "/blog/p/"+page.Slug),
			LastMod: page.UpdatedAt.UTC().Format(time.RFC3339),
		})
	}
	options, err := c.cms.PublicCategoryOptions(ctx.Request.Context(), tenantID)
	if err != nil {
		c.failFeed(ctx, err)
		return
	}
	for _, category := range options {
		if !category.Visible {
			continue
		}
		set.URLs = append(set.URLs, cmsSitemapURL{Loc: cmsAbsoluteURL(ctx, "/blog/category/"+category.Slug)})
	}
	payload, err := xml.MarshalIndent(set, "", "  ")
	if err != nil {
		c.failFeed(ctx, err)
		return
	}
	ctx.Writer.Header().Set("Content-Type", "application/xml; charset=utf-8")
	_, _ = ctx.Writer.Write([]byte(xml.Header))
	_, _ = ctx.Writer.Write(payload)
}

// cmsRSS is the RSS document envelope. | cmsRSS 是 RSS 文档信封。
type cmsRSS struct {
	// XMLName is the rss element. | XMLName 是 rss 元素。
	XMLName xml.Name `xml:"rss"`
	// Version is the RSS version. | Version 是 RSS 版本。
	Version string `xml:"version,attr"`
	// Channel is the feed channel. | Channel 是订阅频道。
	Channel cmsRSSChannel `xml:"channel"`
}

// cmsRSSChannel is one RSS channel. | cmsRSSChannel 是一个 RSS 频道。
type cmsRSSChannel struct {
	// Title is the site title. | Title 是站点标题。
	Title string `xml:"title"`
	// Link is the site link. | Link 是站点链接。
	Link string `xml:"link"`
	// Description is the site description. | Description 是站点描述。
	Description string `xml:"description"`
	// Language is the content language. | Language 是内容语言。
	Language string `xml:"language"`
	// Items are the feed entries. | Items 是订阅条目。
	Items []cmsRSSItem `xml:"item"`
}

// cmsRSSItem is one RSS entry. | cmsRSSItem 是一个 RSS 条目。
type cmsRSSItem struct {
	// Title is the article title. | Title 是文章标题。
	Title string `xml:"title"`
	// Link is the article URL. | Link 是文章 URL。
	Link string `xml:"link"`
	// GUID is the stable article identifier. | GUID 是稳定的文章标识。
	GUID string `xml:"guid"`
	// PubDate is the publication time in RFC 1123. | PubDate 是 RFC 1123 格式的发布时间。
	PubDate string `xml:"pubDate"`
	// Description is the feed summary. | Description 是订阅摘要。
	Description string `xml:"description"`
}

// cmsURLSet is the sitemap envelope. | cmsURLSet 是站点地图信封。
type cmsURLSet struct {
	// XMLName is the urlset element. | XMLName 是 urlset 元素。
	XMLName xml.Name `xml:"urlset"`
	// XMLNS is the sitemap namespace. | XMLNS 是站点地图命名空间。
	XMLNS string `xml:"xmlns,attr"`
	// URLs are the listed addresses. | URLs 是列出的地址。
	URLs []cmsSitemapURL `xml:"url"`
