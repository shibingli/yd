// 本文件是 controller 包的管理概览与静态资源类端点：概览是 /mgr 的首页，另有两个只验证路由与渲染的占位图端点。
// This file holds the management overview and asset-like part of package controller: the overview is the /mgr home,
// plus the two placeholder endpoints that exercise routing and rendering only.

package controller

import (
	"bytes"
	"image"
	"image/color"
	"image/draw"
	"image/png"
	"net/http"
	"strconv"

	"{{ .Module }}/internal/model"
	"{{ .YdxModule }}/errs"
	"{{ .YdModule }}/security/guomi"
	"{{ .YdxModule }}/log"
	"{{ .YdxModule }}/router"
	"{{ .YdModule }}/runtime/metricsx"
)

// placeholderSize is the placeholder's edge length in pixels. | placeholderSize 是占位图的边长（像素）。
const placeholderSize = 96

// recentLimit 是首页展示的最近用户条数：首页是概览而不是清单，完整名单在 /mgr/users。
// recentLimit caps the recent users shown on the home page: the home page is an overview, not a list, and the full roster lives at /mgr/users.
const recentLimit = 5

// ManagementHome renders the back-office overview. | ManagementHome 渲染管理后台概览。
//
// @Summary Management overview | 管理概览
// @Description Renders mgr/pages/home.html for the tenant of the token: the counters, the recent users of that tenant
// @Description and the system gauges. It is reachable only under /mgr and never appears in the portal. |
// @Description 为令牌所属租户渲染 mgr/pages/home.html：计数器、该租户的最近用户与系统仪表盘。
// @Description 它只在 /mgr 下可达，绝不出现在门户中。
// @Tags mgr
// @Produce html
// @Success 200 {object} string "overview page or fragment | 概览整页或片段"
// @Failure 400 {object} string "no tenant in context | 上下文没有租户"
// @Failure 401 {object} string "no session | 无有效会话"
// @Failure 500 {object} string "render failure fragment | 渲染失败片段"
// @Security BearerAuth
// @Router /mgr [get]
func (c *Controller) ManagementHome(ctx *router.Ctx) {
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return
	}

	users, err := c.users.List(ctx.Request.Context(), tenantID, "")
	if err != nil {
		c.failService(ctx, err)
		return
	}
	roles, err := c.roles.List(ctx.Request.Context(), tenantID)
	if err != nil {
		c.failService(ctx, err)
		return
	}

	// One provider snapshot feeds both cards, so the gauges and the middleware table describe the same
	// instant. | 一次 provider 快照同时供给两张卡片，因此仪表盘与中间件表描述的是同一时刻。
	snapshot := c.provider.Snapshot()
	c.render(ctx, http.StatusOK, TplManagementHome, c.view(ctx, "概览 | Overview", map[string]any{
		"Users":      head(users, recentLimit),
		"UserCount":  len(users),
		"RoleCount":  len(roles),
		"Permission": len(model.PermissionKeys()),
		"Gauges":     c.metricGauges(snapshot.System),
		"Middleware": c.middlewareRows(snapshot.Middleware),
	}))
}

// Metrics 返回管理概览的系统指标片段；实时刷新由 /mgr/ws/metrics 推送，此端点仅用于直连与无脚本回退。
// Metrics returns the management overview system fragment; live updates arrive over /mgr/ws/metrics and this endpoint
// only serves direct requests and the no-script fallback.
//
// @Summary Resource metrics fragment | 资源指标片段
// @Description Renders the gauge grid for the host CPU and memory plus this process's CPU and memory. The fragment is
// @Description swapped into #yd-metrics with innerMorph, so the gauges update without rebuilding the page. Values come
// @Description from {{ .YdxModule }}/sysinfo and runtime/metrics; a platform that exposes no host CPU or memory times reports the
// @Description corresponding gauge as unavailable instead of inventing a number.
// @Description 渲染宿主机 CPU/内存与本进程 CPU/内存的仪表盘网格。片段以 innerMorph 换入 #yd-metrics，因此仪表盘就地刷新、
// @Description 不重建页面。取值来自 {{ .YdxModule }}/sysinfo 与 runtime/metrics；平台不提供宿主 CPU 或内存时，对应仪表盘显示「不可用」，
// @Description 绝不编造数字。
// @Tags pages
// @Accept html
// @Produce html
// @Success 200 {object} string "metrics fragment | 指标片段"
// @Failure 401 {object} string "no session | 无有效会话"
// @Security BearerAuth
// @Router /mgr/metrics [get]
func (c *Controller) Metrics(ctx *router.Ctx) {
	// The system gauges come from the same provider as the middleware table; the display is unchanged,
	// but the handler no longer knows about the concrete sampler. | 系统仪表盘与中间件表来自同一个 provider；
	// 显示不变，但处理器不再依赖具体采样器。
	c.render(ctx, http.StatusOK, TplMetrics, c.view(ctx, "资源指标 | Metrics", map[string]any{
		"Gauges": c.metricGauges(c.provider.Snapshot().System),
	}))
}

// metricGauge 是模板渲染一个仪表盘所需的全部取值。
// metricGauge carries everything the template needs to render one gauge.
type metricGauge struct {
	// LabelKey is the i18n key of the caption. | LabelKey 是标题的 i18n 键。
	LabelKey string
	// Value is the formatted reading shown in the dial. | Value 是仪表盘中央的格式化读数。
	Value string
	// Tone selects the warn/danger colour pair; empty uses the brand colour. | Tone 选择警示/危险配色；为空时使用品牌色。
	Tone string
	// Percent is the arc fill in [0, 100]. | Percent 是圆弧填充比例，取值 [0, 100]。
	Percent float64
	// Supported reports whether the platform exposed the value. | Supported 报告平台是否提供了该取值。
	Supported bool
}

// metricGauges turns one snapshot into the six dashboard gauges in a fixed order.
// | metricGauges 把一次快照转换为固定顺序的六个仪表盘。
func (c *Controller) metricGauges(m metricsx.SystemSnapshot) []metricGauge {
	gauges := []metricGauge{
		{LabelKey: "metrics.cpu_cores", Value: strconv.Itoa(m.CPUCores), Percent: 100, Supported: true},
		{LabelKey: "metrics.cpu_usage", Value: formatPercent(m.CPUPercent), Percent: clampPercent(m.CPUPercent), Tone: toneFor(m.CPUPercent), Supported: m.HostCPU},
		{LabelKey: "metrics.memory_total", Value: formatBytes(m.MemoryTotal), Percent: 100, Supported: m.HostMemory && m.MemoryTotal > 0},
		{LabelKey: "metrics.memory_usage", Value: formatPercent(m.MemoryPercent), Percent: clampPercent(m.MemoryPercent), Tone: toneFor(m.MemoryPercent), Supported: m.HostMemory},
		{LabelKey: "metrics.process_cpu", Value: formatPercent(m.ProcessCPUPercent), Percent: clampPercent(m.ProcessCPUPercent), Tone: toneFor(m.ProcessCPUPercent), Supported: true},
		{LabelKey: "metrics.process_memory", Value: formatBytes(m.ProcessMemory), Percent: clampPercent(m.ProcessMemoryPercent), Tone: toneFor(m.ProcessMemoryPercent), Supported: true},
	}
	for i := range gauges {
		if !gauges[i].Supported {
			gauges[i].Value = "—"
			gauges[i].Percent = 0
			gauges[i].Tone = ""
		}
	}
	return gauges
}

// formatPercent renders one percentage with a single decimal. | formatPercent 以一位小数渲染百分比。
func formatPercent(v float64) string { return strconv.FormatFloat(v, 'f', 1, 64) + "%" }

// clampPercent confines a percentage to the gauge's [0, 100] range. | clampPercent 把百分比限制在仪表盘的 [0, 100] 区间。
func clampPercent(v float64) float64 {
	switch {
	case v < 0:
		return 0
	case v > 100:
		return 100
	default:
		return v
	}
}

// toneFor maps a usage percentage onto the warn/danger colour pair. | toneFor 把使用率映射到警示/危险配色。
func toneFor(v float64) string {
	switch {
	case v >= 90:
		return "danger"
	case v >= 70:
		return "warn"
	default:
		return ""
	}
}

// formatBytes renders a byte count in the largest binary unit that keeps it readable.
// | formatBytes 用最大的二进制单位渲染字节数，使读数保持易读。
func formatBytes(n uint64) string {
	const (
		kib = 1 << 10
		mib = 1 << 20
		gib = 1 << 30
	)
	switch {
	case n >= gib:
		return strconv.FormatFloat(float64(n)/gib, 'f', 1, 64) + " GiB"
	case n >= mib:
		return strconv.FormatFloat(float64(n)/mib, 'f', 1, 64) + " MiB"
	case n >= kib:
		return strconv.FormatFloat(float64(n)/kib, 'f', 0, 64) + " KiB"
	default:
		return strconv.FormatUint(n, 10) + " B"
	}
}

// Health 健康检查：容器探针与负载均衡使用，永远只回 "ok"。
// Health is the liveness probe for containers and load balancers; it always answers "ok".
//
// @Summary Health probe | 健康检查
// @Description Answers the literal text "ok" so probes never need to parse a body format. The endpoint is deliberately
// @Description public: a probe that needed a token would report a healthy process as down whenever the auth store hiccups.
// @Description 固定返回文本 "ok"，探针无需解析任何响应体格式。该端点刻意公开：需要令牌的探针会在鉴权存储抖动时把健康的进程报成故障。
// @Tags ops
// @Accept text
// @Produce text
// @Success 200 {string} string "ok"
// @Router /healthz [get]
func (c *Controller) Health(ctx *router.Ctx) {
	ctx.SetHeader("Cache-Control", "no-store")
	if err := ctx.String(http.StatusOK, "ok"); err != nil {
		c.log.Warn("health probe write failed | 健康检查写出失败", log.Err(err))
	}
}

// Avatar 头像占位图：验证单段混合捕获模式 /avatar/:id.jpg。
// Avatar serves a placeholder avatar: it exercises the single-segment mixed capture pattern /avatar/:id.jpg.
//
// @Summary Avatar placeholder | 头像占位图
// @Description Derives a deterministic PNG from the captured id and echoes it back in the X-YD-Avatar header, which
// @Description makes the mixed capture pattern observable from a plain HTTP client. The response is cacheable because the
// @Description image is a pure function of the id.
// @Description 依据捕获到的 id 生成确定性 PNG，并通过 X-YD-Avatar 响应头回显，便于用普通 HTTP 客户端观察混合捕获的结果；图片是 id 的
// @Description 纯函数，因此响应可以放心缓存。
// @Tags assets
// @Accept image
// @Produce image
// @Param id path string true "avatar id, captured without the .jpg suffix | 头像 ID，不含 .jpg 后缀"
// @Success 200 {file} file "PNG placeholder | PNG 占位图"
// @Failure 401 {object} string "no session | 无有效会话"
// @Failure 500 {object} string "encoding failure fragment | 编码失败片段"
// @Security BearerAuth
// @Router /avatar/{id}.jpg [get]
func (c *Controller) Avatar(ctx *router.Ctx) {
	id := ctx.Param("id")
	// 回显捕获值：测试与排障不必解码图片即可确认路由把 :id 与 .jpg 正确切开。
	// Echoing the captured value lets tests and debugging confirm the split between :id and .jpg without decoding the image.
	ctx.SetHeader("X-YD-Avatar", id)
	c.writePNG(ctx, "avatar:"+id)
}

// Report 报表占位图：验证「动态段 + 静态后缀」模式 /report/:id-xx.png。
// Report serves a placeholder report: it exercises the "dynamic segment plus static suffix" pattern /report/:id-xx.png.
//
// @Summary Report placeholder | 报表占位图
// @Description Captures only the leading id of /report/:id-xx.png and echoes it in the X-YD-Report header; the "-xx.png"
// @Description part is a fixed suffix declared by the route pattern.
// @Description 只捕获 /report/:id-xx.png 的前导 id，并通过 X-YD-Report 响应头回显；"-xx.png" 是路由模式声明的固定后缀。
// @Tags assets
// @Accept image
// @Produce image
// @Param id path string true "report id, captured before the -xx.png suffix | 报表 ID，不含 -xx.png 后缀"
// @Success 200 {file} file "PNG placeholder | PNG 占位图"
// @Failure 401 {object} string "no session | 无有效会话"
// @Failure 500 {object} string "encoding failure fragment | 编码失败片段"
// @Security BearerAuth
// @Router /report/{id}-xx.png [get]
func (c *Controller) Report(ctx *router.Ctx) {
	id := ctx.Param("id")
	ctx.SetHeader("X-YD-Report", id)
	c.writePNG(ctx, "report:"+id)
}

// writePNG 生成占位图并写出；失败时退化为错误片段，绝不以半个 PNG 结束响应。
// writePNG renders the placeholder and writes it out; on failure it degrades to the error fragment instead of ending the response with half a PNG.
func (c *Controller) writePNG(ctx *router.Ctx, seed string) {
	data, err := placeholderPNG(seed)
	if err != nil {
		c.log.Error("placeholder encode failed | 占位图编码失败", log.Err(err), log.Str("seed", seed))
		c.fail(ctx, http.StatusInternalServerError, msgInternal)
		return
	}

	// 占位图由 seed 唯一决定，因此可以放心交给浏览器与反向代理长期缓存。
	// The placeholder is fully determined by its seed, so browsers and reverse proxies may cache it for long.
	ctx.SetHeader("Cache-Control", "public, max-age=300")
	if err := ctx.Blob(http.StatusOK, "image/png", data); err != nil {
		c.log.Warn("placeholder write failed | 占位图写出失败", log.Err(err), log.Str("seed", seed))
	}
}

// placeholderPNG 由 seed 生成确定性占位图：同一 seed 永远得到同一张图。
// placeholderPNG derives a deterministic placeholder from seed: the same seed always yields the same image.
//
// 绘图只使用标准库（image/png），不引入图形依赖：这里要证明的是路由捕获与响应写出，而不是绘图能力。
// Drawing uses the standard library only (image/png) and pulls in no graphics dependency: what is proven here is route
// capture and response writing, not drawing skill.
func placeholderPNG(seed string) ([]byte, error) {
	digest := guomi.Sum([]byte(seed))

	// 底色取品牌蓝，再按摘要前三个字节微调：颜色与 seed 一一对应，肉眼即可区分不同 id。
	// The base tone is the brand blue, tinted by the first three digest bytes: the colour maps one to one onto the seed,
	// so different ids differ at a glance.
	bg := color.RGBA{
		R: 0x1d + digest[0]/8,
		G: 0x4e + digest[1]/8,
		B: 0xd8 + digest[2]/8,
		A: 0xff,
	}
	// 中央方块取互补的浅色，深浅同样来自摘要。
	// The centre square takes a complementary light tone whose depth also comes from the digest.
	fg := color.RGBA{
		R: 0xff - digest[3]/3,
		G: 0xff - digest[4]/3,
		B: 0xff - digest[5]/3,
		A: 0xff,
	}

	img := image.NewRGBA(image.Rect(0, 0, placeholderSize, placeholderSize))
	draw.Draw(img, img.Bounds(), &image.Uniform{C: bg}, image.Point{}, draw.Src)
	inset := placeholderSize / 4
	draw.Draw(img, image.Rect(inset, inset, placeholderSize-inset, placeholderSize-inset), &image.Uniform{C: fg}, image.Point{}, draw.Src)

	var buf bytes.Buffer
	if err := png.Encode(&buf, img); err != nil {
		return nil, errs.Wrap(err, ErrPlaceholder)
	}
	return buf.Bytes(), nil
}

// head 截取列表的前 n 条，列表更短时原样返回。
// head returns the first n records of a list and the list itself when it is shorter.
func head(list []model.User, n int) []model.User {
	if n <= 0 || len(list) <= n {
		return list
	}
	return list[:n]
}
