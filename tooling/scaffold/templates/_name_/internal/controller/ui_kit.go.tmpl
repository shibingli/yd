// 本文件提供门户「组件示例」页的处理器：页面本身只组合组件模板，处理器只负责注入一张服务端图表。
// This file provides the handler of the portal component gallery: the page composes component templates, and the
// handler only injects one server-rendered chart.

package controller

import (
	"html/template"
	"net/http"
	"strings"

	"{{ .YdModule }}/http/chart"
	"{{ .YdxModule }}/router"
)

// UIKit renders the component gallery. | UIKit 渲染组件示例页。
//
// 图表必须由服务端生成：页面不引入图表库，SVG 的颜色通过语义类继承主题。其余示例在模板里用
// dict/list 组合；处理器只补上组件契约要求由调用方组装的 HTML 片段（动态行、筛选字段、操作条）
// 与按语言生成的日历标签，因为 Go 模板无法在表达式里构造 template.HTML。
// The chart is server-rendered: the page loads no chart library, and the SVG inherits the theme through
// semantic classes. Every other sample is composed in the template with dict/list; the handler only
// supplies the HTML fragments the component contract leaves to the caller (row fields, filter fields,
// action buttons) and the language-specific calendar labels, because a Go template cannot build
// template.HTML inside an expression.
//
// @Summary Component gallery | 组件示例页
// @Description Renders every component of the UI kit on one page for the signed-in member. | 为一个已登录成员在一页内渲染组件层的全部控件。
// @Tags pages
// @Produce html
// @Success 200 {object} string "component gallery | 组件示例"
// @Failure 401 {string} string "no session | 无有效会话"
// @Security BearerAuth
// @Router /ui-kit [get]
func (c *Controller) UIKit(ctx *router.Ctx) {
	// Weekday and month names come from the same catalogue as the rest of the page; a Go template
	// cannot split the pipe-separated catalogue value, so the controller does it once. |
	// 星期与月份名称来自页面同一份目录；Go 模板无法拆分竖线分隔的目录值，因此控制器拆一次。
	weekdays := []string{"Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"}
	monthLabel := "October 2026"
	label := func(key, fallback string) string { return fallback }
	if c.i18n != nil {
		translator := c.i18n.Translator(c.lang(ctx))
		label = func(key, fallback string) string {
			if value := translator.T(key); value != "" && value != key {
				return value
			}
			return fallback
		}
		if parts := strings.Split(translator.T("ui.weekdays"), "|"); len(parts) == 7 {
			weekdays = parts
		}
		months := strings.Split(translator.T("ui.months"), "|")
		if len(months) == 12 {
			monthLabel = months[9] + " 2026"
		}
	}
	// The sample chart follows the request language too: its title, description, series name and
	// weekday labels are UI copy, not data. | 示例图表同样跟随请求语言：标题、说明、系列名与星期标签
	// 都是界面文案，不是数据。
	points := make([]chart.Point, 0, 5)
	for i, value := range []float64{120, 168, 145, 210, 248} {
		points = append(points, chart.Point{Label: weekdays[i], Value: value})
	}
	svg := chart.Line([]chart.Series{
		{
			Label:  label("showcase.chart.series", "Requests"),
			Points: points,
		},
	}, chart.Options{
		Title:       label("showcase.chart.title", "Requests"),
		Description: label("showcase.chart.description", "A server-rendered line chart"),
		ShowGrid:    true,
		ShowAxis:    true,
	})

	c.render(ctx, http.StatusOK, TplUIKit, c.pageView(ctx, "组件示例 | Component gallery", map[string]any{
		"ChartSVG":         template.HTML(svg), //nolint:gosec // chart.Line escapes every label and value | chart.Line 已转义全部标签与数值
		"CalendarMonth":    monthLabel,
		"CalendarWeekdays": weekdays,
		// The component contracts type these three fields as template.HTML because callers assemble
		// them from server data. The gallery supplies one real field/button each so the sample is
		// usable, not a string placeholder. | 三个字段在组件契约中是 template.HTML，由调用方用
		// 服务端数据组装。示例各给一个真实字段/按钮，避免只是字符串占位。
		"RowFields":     template.HTML(`<input class="yd-input" type="text" name="items[]" value="" data-yd-i18n-attr="aria-label:showcase.label.dynamic_rows" aria-label="` + label("showcase.label.dynamic_rows", "Dynamic rows") + `">`), //nolint:gosec // fixed sample markup, no user data | 固定示例标记，无用户数据
		"RowTemplate":   template.HTML(`<input class="yd-input" type="text" name="items[]" value="" data-yd-i18n-attr="aria-label:showcase.label.dynamic_rows" aria-label="` + label("showcase.label.dynamic_rows", "Dynamic rows") + `">`), //nolint:gosec // fixed sample markup, no user data | 固定示例标记，无用户数据
		"FilterFields":  template.HTML(`<input class="yd-input" type="search" name="q" value="" data-yd-i18n-attr="aria-label:ui.search" aria-label="` + label("ui.search", "Search") + `">`), //nolint:gosec // fixed sample markup, no user data | 固定示例标记，无用户数据
		"ActionButtons": template.HTML(`<button type="button" class="yd-btn yd-btn--danger yd-btn--sm" data-yd-i18n="ui.delete">` + label("ui.delete", "Delete") + `</button>`), //nolint:gosec // fixed sample markup, no user data | 固定示例标记，无用户数据
		"PageStyles":    messagePageStyles,
		"PageScripts":   []string{"/static/js/vendored/easymde.min.js"},
	}))
}
