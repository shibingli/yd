// Additional message form field: the recipient checkboxes. | 消息表单的附加字段：收件人多选。
const fieldRecipients = "recipient_ids"

// messageSearchTarget is the element id of the message centre's main pane. The search form uses it as its htmx
// target, so the server renders only the result fragment and never reloads the rail, pinned strip or contacts
// panel. | messageSearchTarget 是消息中心右侧主面板的元素 ID。检索表单以它为 htmx 目标：服务端据此只渲染
// 结果片段，会话栏、置顶条与联系人面板都不重载。
const messageSearchTarget = "yd-msg-main"

// messageHistoryDeltaLimit 是一次增量历史响应的条数上限；超过它说明客户端落后太多，改回整段重取。
// messageHistoryDeltaLimit caps one incremental history response; beyond it the client is too far behind and
// the handler falls back to a full render.
const messageHistoryDeltaLimit = 50

// messageFilters is the parsed filter bar state. | messageFilters 是解析后的过滤栏状态。
type messageFilters struct {
	// Query is the mixed full-text expression. | Query 是混合全文检索表达式。
	Query string
	// TypeKey filters by message type. | TypeKey 按消息类型过滤。
	TypeKey string
	// SenderID filters by author. | SenderID 按作者过滤。
	SenderID string
	// TagID filters by a group or label. | TagID 按分组或标签过滤。
	TagID string
	// Folder is all, unread, sent, system or pinned. | Folder 取 all、unread、sent、system 或 pinned。
	Folder string
	// Page is the 1-based page number. | Page 是从 1 开始的页码。
	Page int
	// Active reports whether any filter is set. | Active 报告是否设置了任何过滤条件。
	Active bool
}

// catalogView is the compose catalogue. | catalogView 是撰写目录。
type catalogView struct {
	// Types are active message types. | Types 是生效的消息类型。
	Types []messageTypeView
	// Groups are active group markers. | Groups 是生效的分组标记。
	Groups []tagView
	// Tags are active free-form labels. | Tags 是生效的自由标签。
	Tags []tagView
}

// TypeOptions returns the compose type options, marking selected. | TypeOptions 返回撰写类型选项，
// 并标记当前选中项。
func (c catalogView) TypeOptions(selected string) []map[string]any {
	out := make([]map[string]any, 0, len(c.Types))
	for _, item := range c.Types {
		out = append(out, map[string]any{
			"Value":    item.Key,
			"Label":    item.Label,
			"Selected": item.Key == selected,
		})
	}
	return out
}

// TypeFilterOptions adds the "all types" entry before the type options. | TypeFilterOptions 在类型选项
// 之前加入「全部类型」条目。
func (c catalogView) TypeFilterOptions(selected string) []map[string]any {
	out := []map[string]any{
		{"Value": "", "Key": "message.all_types"},
	}
	return append(out, c.TypeOptions(selected)...)
}

// TagFilterOptions adds the "all tags" entry, then groups, then labels. | TagFilterOptions 依次加入
// 「全部标签」、分组与自由标签。
func (c catalogView) TagFilterOptions(selected string) []map[string]any {
	out := []map[string]any{
		{"Value": "", "Key": "message.all_tags"},
	}
	for _, group := range c.Groups {
		out = append(out, map[string]any{
			"Value":    group.ID,
			"Label":    group.Label,
			"Selected": group.ID == selected,
		})
	}
	for _, tag := range c.Tags {
		out = append(out, map[string]any{
			"Value":    tag.ID,
			"Label":    "#" + tag.Label,
			"Selected": tag.ID == selected,
		})
	}
	return out
}

// messagePage is the complete data of one message-centre render. | messagePage 是一次消息中心渲染的完整数据。
type messagePage struct {
	// Filters is the filter bar state. | Filters 是过滤栏状态。
	Filters messageFilters
	// Conversations is the conversation list. | Conversations 是会话列表。
	Conversations []conversationView
	// Pinned is the active pinned announcement strip. | Pinned 是生效的置顶公告条。
	Pinned []messageView
	// Catalog is the compose catalogue. | Catalog 是撰写目录。
	Catalog catalogView
	// Friends is the friend picker of the compose drawer. | Friends 是撰写抽屉的好友选择列表。
	Friends []friendView
	// Results is the search result page. | Results 是检索结果页。
	Results []messageView
	// Total is the unpaged search result count. | Total 是不分页的检索结果数。
	Total int
	// SearchMode reports whether the results panel should be shown. | SearchMode 报告是否展示检索结果面板。
	SearchMode bool
	// Active is the open conversation. | Active 是当前打开的会话。
	Active *conversationView
	// Thread is the open conversation's newest page. | Thread 是当前会话的最新一页。
	Thread []messageView
	// CanSend reports message:send. | CanSend 报告 message:send。
	CanSend bool
	// CanManage reports message:manage. | CanManage 报告 message:manage。
	CanManage bool
	// CanSystem reports message:system. | CanSystem 报告 message:system。
	CanSystem bool
	// CanTypeManage reports message-type:manage. | CanTypeManage 报告 message-type:manage。
	CanTypeManage bool
	// UserID is the actor id, used to tell a group owner. | UserID 是主体 ID，用于判断群主。
	UserID string
}

// data flattens the page into the render map. | data 把页面摊平进渲染数据。
func (p messagePage) data() map[string]any {
	return map[string]any{
		"Filters":            p.Filters,
		"Conversations":      p.Conversations,
		"Pinned":             p.Pinned,
		"Catalog":            p.Catalog,
		"Friends":            p.Friends,
		"Results":            p.Results,
		"Total":              p.Total,
		"SearchMode":         p.SearchMode,
		"ActiveConversation": p.Active,
		"Thread":             p.Thread,
		"CanSend":            p.CanSend,
		"CanManage":          p.CanManage,
		"CanSystem":          p.CanSystem,
		"CanTypeManage":      p.CanTypeManage,
		"ActorID":            p.UserID,
		"PageStyles":         messagePageStyles,
		"PageScripts":        messagePageScripts,
	}
}

// Messages renders the message centre. | Messages 渲染消息中心。
//
// @Summary Message centre | 消息中心
// @Description Renders the conversation list, the pinned announcement strip and either the open thread or the mixed
// @Description search results. The filter bar searches title, body, sender and type together, and every query stays
// @Description inside the token's tenant.
// @Description 渲染会话列表、置顶公告条，以及当前线程或混合检索结果。过滤栏同时检索标题、正文、发送人与类型，
// @Description 且每次查询都限制在令牌所属租户内。
// @Tags messages
// @Accept html
// @Produce html
// @Param q query string false "mixed full-text query | 混合全文检索词"
// @Param folder query string false "all|unread|sent|system|pinned | 文件夹"
// @Param type_key query string false "message type key | 消息类型键"
// @Param sender query string false "sender id | 发送人 ID"
// @Param tag query string false "group or label id | 分组或标签 ID"
// @Param HX-Request header string false "htmx partial request | htmx 局部请求标记"
// @Success 200 {object} string "message centre page or fragment | 消息中心整页或片段"
// @Failure 401 {object} string "no session | 无有效会话"
// @Failure 403 {object} string "missing message:read | 缺少 message:read"
// @Failure 503 {object} string "message centre unavailable | 消息中心不可用"
// @Security BearerAuth
// @Router /messages [get]
func (c *Controller) Messages(ctx *router.Ctx) {
	if !c.MessagesAvailable() {
		c.messageUnavailable(ctx)
		return
	}
	filters := parseMessageFilters(ctx)
	// 检索表单只换 #yd-msg-main：结果片段直接落进主面板，会话栏与其它集合完全不参与本次渲染。
	// 清空检索词时以 HX-Retarget 退回整块工作区，恢复线程或欢迎页；没有这一步，主面板会被结果片段占住。
	// The search form swaps only #yd-msg-main: the result fragment lands in the main pane and the rail and the
	// other collections take no part in this render. When the query is cleared, HX-Retarget falls back to the
	// whole workspace so the thread or welcome panel comes back; without it the result fragment would stay put.
	if htmx.IsRequest(ctx.Request) && strings.TrimSpace(htmx.Target(ctx.Request)) == messageSearchTarget {
		if filters.Active {
			page, err := c.loadSearchPage(ctx, filters)
			if err != nil {
				c.failService(ctx, err)
				return
			}
			c.render(ctx, http.StatusOK, TplMessageSearch, c.pageView(ctx, "检索结果 | Search results", map[string]any{
				"Filters":    page.Filters,
				"Results":    page.Results,
				"Total":      page.Total,
				"SearchMode": true,
			}))
			return
		}
		ctx.SetHeader("HX-Retarget", "#yd-workspace")
		ctx.SetHeader("HX-Reswap", "innerMorph")
	}
	page, err := c.loadMessagePage(ctx, "", filters)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	c.renderMessagePage(ctx, http.StatusOK, page, "消息中心 | Messages", "")
}

