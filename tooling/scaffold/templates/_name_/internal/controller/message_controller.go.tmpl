		if closeErr := file.Close(); closeErr != nil {
			c.log.Debug("attachment stream close failed | 附件流关闭失败", log.Err(closeErr))
		}
	}()
	attachment, err := c.messages.UploadAttachment(ctx.Request.Context(), c.messageActor(ctx), header.Filename, header.Size, file)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	c.render(ctx, http.StatusOK, TplMessageAttachment, c.pageView(ctx, "附件 | Attachment", map[string]any{
		"Attachment": messageAttachmentView{
			Attachment: attachment,
			SizeText:   sizeText(attachment.Size),
