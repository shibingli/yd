// messageAdminOrigin reports whether the mutation came from the management area. The current page
// travels in HX-Current-URL for htmx requests and in Referer for plain form posts, so a management
// action refreshes the moderation list while a portal action refreshes the conversation. |
// messageAdminOrigin 报告变更是否来自管理区。htmx 请求的当前页面在 HX-Current-URL，普通表单在 Referer，
// 因此管理动作刷新治理列表，门户动作刷新会话。
func messageAdminOrigin(ctx *router.Ctx) bool {
	current := strings.TrimSpace(ctx.Header("HX-Current-URL"))
	if current == "" {
		current = strings.TrimSpace(ctx.Header("Referer"))
	}
	if current == "" {
		return false
	}
	parsed, err := url.Parse(current)
	if err != nil {
		return false
	}
	return strings.HasPrefix(parsed.Path, "/mgr/") || parsed.Path == "/mgr"
}

// refreshMessageView re-renders the page that issued the mutation: the management area refreshes the
// moderation list, while the portal refreshes the conversation. Sharing one handler keeps the service
// call identical; only the destination differs. |
// refreshMessageView 重新渲染发起变更的页面：管理区刷新治理列表，门户刷新会话。共用处理器让服务调用
// 保持一致，只有落点不同。
func (c *Controller) refreshMessageView(ctx *router.Ctx, conversationID, notice string) {
	if strings.HasPrefix(ctx.Path(), "/mgr/") {
		c.renderAdminPage(ctx, notice)
		return
	}
	c.renderMessagePageByID(ctx, conversationID, notice)
}

