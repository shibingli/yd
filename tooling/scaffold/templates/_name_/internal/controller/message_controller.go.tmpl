// DownloadMessageAttachment streams an attachment after checking message visibility. | DownloadMessageAttachment 在检查消息可见性后流式返回附件。
//
// @Summary Download attachment | 下载附件
// @Description Streams the attachment bytes with a download disposition and nosniff, after the service verifies that the
// @Description actor is its uploader or a participant of the owning message.
// @Description 在服务确认主体是上传者或所属消息的参与者后，以下载处置与 nosniff 流式返回附件字节。
// @Tags messages
// @Produce octet-stream
// @Param id path string true "attachment id | 附件 ID"
// @Success 200 {file} file "attachment bytes | 附件字节"
// @Failure 404 {object} string "attachment not found | 附件不存在"
// @Security BearerAuth
// @Router /messages/attachments/{id} [get]
func (c *Controller) DownloadMessageAttachment(ctx *router.Ctx) {
	if !c.MessagesAvailable() {
		c.messageUnavailable(ctx)
		return
	}
	attachment, data, err := c.messages.DownloadAttachment(ctx.Request.Context(), c.messageActor(ctx), ctx.Param("id"))
	if err != nil {
		c.failService(ctx, err)
		return
	}
	disposition := mime.FormatMediaType("attachment", map[string]string{"filename": safeDownloadName(attachment.OriginalName)})
	if disposition == "" {
		disposition = "attachment"
	}
	ctx.SetHeader("Content-Disposition", disposition)
	ctx.SetHeader("X-Content-Type-Options", "nosniff")
	if err := ctx.Blob(http.StatusOK, attachment.ContentType, data); err != nil {
		c.log.Warn("attachment write failed | 附件写出失败", log.Err(err))
	}
}

// safeDownloadName removes control characters so a file name cannot break the response headers. |
// safeDownloadName 去掉控制字符，使文件名无法破坏响应头。
func safeDownloadName(name string) string {
	name = strings.Map(func(r rune) rune {
		if r < 0x20 || r == 0x7f {
			return -1
		}
		return r
	}, strings.TrimSpace(name))
	name = strings.TrimSpace(name)
	if name == "" {
		return "file"
	}
	return name
}

