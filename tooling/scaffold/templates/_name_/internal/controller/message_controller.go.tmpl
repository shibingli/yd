// MessageThreadHistory renders the message list alone for the realtime refresh. | MessageThreadHistory 只渲染消息列表，供实时刷新使用。
//
// @Summary Message history fragment | 消息历史片段
// @Description Returns only the message list of one conversation. The WebSocket client swaps it into the history
// @Description region, so the inline composer and the draft it holds are never rebuilt.
// @Description 返回一个会话的消息列表。WebSocket 客户端把它换进历史区域，内联撰写区与其中的草稿因此不会被重建。
// @Tags messages
// @Accept html
// @Produce html
// @Param id path string true "conversation id | 会话 ID"
// @Param after query string false "last rendered message id; returns only newer messages | 最后一条已渲染消息 ID，仅返回更新的消息"
// @Success 200 {object} string "message history fragment | 消息历史片段"
// @Failure 404 {object} string "conversation not found | 会话不存在"
// @Security BearerAuth
// @Router /messages/{id}/history [get]
func (c *Controller) MessageThreadHistory(ctx *router.Ctx) {
	if !c.MessagesAvailable() {
		c.messageUnavailable(ctx)
		return
	}
	// 带 after 的请求是实时追加：只返回锚点之后的新消息，客户端用 beforeend 追加。
	// 锚点失效或落后超过上限时退回整段历史，并要求 htmx 改用 innerMorph 替换，而不是继续追加。
	// A request carrying after is a realtime append: return only the messages newer than the anchor and let the
	// client append them with beforeend. An invalid anchor or a client too far behind falls back to the full
	// history and asks htmx to replace with innerMorph instead of appending.
	if afterID := strings.TrimSpace(ctx.Query("after")); afterID != "" {
		data, appended, err := c.historyDeltaData(ctx, ctx.Param("id"), afterID)
		if err == nil && appended {
			c.render(ctx, http.StatusOK, TplMessageHistory, data)
			return
		}
		if err != nil && !errors.Is(err, messaging.ErrNotFound) {
			c.failService(ctx, err)
			return
		}
		ctx.SetHeader("HX-Reswap", "innerMorph")
	}
	data, err := c.historyData(ctx, ctx.Param("id"))
	if err != nil {
		c.failService(ctx, err)
		return
	}
	c.render(ctx, http.StatusOK, TplMessageHistory, data)
}

// historyDeltaData renders only the messages newer than afterID. appended is false when the client is too far
// behind and the caller should render the full history instead. |
// historyDeltaData 只渲染晚于 afterID 的新消息；appended 为 false 表示客户端落后太多，调用方应改为整段渲染。
func (c *Controller) historyDeltaData(ctx *router.Ctx, conversationID, afterID string) (map[string]any, bool, error) {
	actor := c.messageActor(ctx)
	messages, err := c.messages.ConversationMessagesAfter(ctx.Request.Context(), actor, conversationID, afterID, messageHistoryDeltaLimit+1)
	if err != nil {
		return nil, false, err
	}
	if len(messages) > messageHistoryDeltaLimit {
		return nil, false, nil
	}
	return c.pageView(ctx, "会话 | Conversation", map[string]any{
		"Thread": c.messageViewsOf(actor, messages, c.lang(ctx), time.Now().UTC()),
	}), true, nil
}

// MessageConversations renders the conversation list fragment. | MessageConversations 渲染会话列表片段。
//
// @Summary Conversation list | 会话列表
// @Description Returns the conversation list; the realtime client refreshes it after message events.
// @Description 返回会话列表；实时客户端在消息事件后刷新它。
// @Tags messages
// @Accept html
// @Produce html
// @Success 200 {object} string "conversation list fragment | 会话列表片段"
// @Security BearerAuth
// @Router /messages/conversations [get]
func (c *Controller) MessageConversations(ctx *router.Ctx) {
	if !c.MessagesAvailable() {
		// 不能回一个空 200：htmx 会把空响应当成成功换入，会话栏因此被清空且没有任何解释。 |
		// Never answer an empty 200: htmx would swap the empty response successfully, blanking the rail with no
		// explanation.
		c.fail(ctx, http.StatusServiceUnavailable, "message centre is unavailable | 消息中心不可用")
		return
	}
	actor := c.messageActor(ctx)
	activeID := ctx.Query("active")
	conversations, err := c.messages.Conversations(ctx.Request.Context(), actor)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	// 这里只渲染会话列表：此前复用 loadMessagePage 会连带读取置顶条、目录与整份好友汇总，
	// 而实时通道在每条消息后都会重取本片段，那份工作因此被放大成每事件十余次查询。
	// Only the conversation list is rendered here: reusing loadMessagePage also loaded the pinned strip, the
	// catalogue and the whole friend summary, and the realtime channel refetches this fragment after every
	// message, so that work was multiplied into a dozen queries per event.
	data := c.pageView(ctx, "会话 | Conversations", map[string]any{
		"Conversations": c.conversationViewsOf(actor, conversations, c.lang(ctx), activeID),
		"ActiveID":      activeID,
	})
	c.render(ctx, http.StatusOK, TplMessageConversations, data)
}

