// EditMessageDrawer renders the edit drawer. | EditMessageDrawer 渲染编辑抽屉。
//
// @Summary Edit message drawer | 编辑消息抽屉
// @Description Renders the editor for a message the actor may edit; the authorisation is enforced again by the domain
// @Description service when the form is submitted.
// @Description 为当前主体可编辑的消息渲染编辑器；表单提交时领域服务会再次校验授权。
// @Tags messages
// @Accept html
// @Produce html
// @Param id path string true "message id | 消息 ID"
// @Success 200 {object} string "drawer fragment | 抽屉片段"
// @Failure 403 {object} string "edit window expired or not the sender | 编辑窗口已过期或不是发送者"
// @Failure 404 {object} string "message not found | 消息不存在"
// @Security BearerAuth
// @Router /messages/{id}/edit [get]
func (c *Controller) EditMessageDrawer(ctx *router.Ctx) {
	if !c.MessagesAvailable() {
		c.messageUnavailable(ctx)
		return
	}
	actor := c.messageActor(ctx)
	msg, err := c.messages.Message(ctx.Request.Context(), actor, ctx.Param("id"))
	if err != nil {
		c.failService(ctx, err)
		return
	}
	view := c.messageViewOf(actor, msg, c.lang(ctx), time.Now().UTC())
	if !view.CanEdit {
		c.failService(ctx, messaging.ErrEditExpired)
		return
	}
	catalog, err := c.catalogData(ctx, actor)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	c.render(ctx, http.StatusOK, TplMessageCompose, c.pageView(ctx, "编辑消息 | Edit message", map[string]any{
		"Mode":        "edit",
		"Catalog":     catalog,
		"Message":     view,
		"DefaultType": view.TypeKey,
		"PageStyles":  messagePageStyles,
		"PageScripts": messagePageScripts,
	}))
}

// SendMessage sends one message to an existing conversation, a friend or a new group. | SendMessage 向既有会话、好友或新群发送一条消息。
//
// @Summary Send message | 发送消息
// @Description Resolves the target conversation (existing id, one friend, or several friends plus a group title),
// @Description renders Markdown on the server, binds pending attachments and publishes the message event.
// @Description 解析目标会话（既有 ID、单个好友，或多个好友加群名），服务端渲染 Markdown、绑定待挂载附件并发布消息事件。
// @Tags messages
// @Accept html
// @Produce html
// @Param conversation_id formData string false "existing conversation id | 既有会话 ID"
// @Param recipient_ids formData []string false "friend ids for a new direct or group conversation | 新单聊或群聊的好友 ID"
// @Param group_title formData string false "group title | 群名"
// @Param type_key formData string false "message type key | 消息类型键"
// @Param title formData string false "message title | 消息标题"
// @Param body_markdown formData string true "Markdown body | Markdown 正文"
// @Param tag_ids formData []string false "label ids | 标签 ID"
// @Param group_ids formData []string false "group ids | 分组 ID"
// @Param attachment_ids formData []string false "pending attachment ids | 待挂载附件 ID"
// @Success 200 {object} string "refreshed message centre | 刷新后的消息中心"
// @Failure 403 {object} string "not a friend or not a member | 非好友或非成员"
// @Failure 422 {object} string "validation failure | 校验失败"
// @Security BearerAuth
// @Router /messages [post]
func (c *Controller) SendMessage(ctx *router.Ctx) {
	if !c.MessagesAvailable() {
		c.messageUnavailable(ctx)
		return
	}
	actor := c.messageActor(ctx)
	conversationID, err := c.resolveConversation(ctx, actor)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	message, err := c.messages.Send(ctx.Request.Context(), actor, messaging.SendInput{
		ConversationID: conversationID,
		TypeKey:        field(ctx, FieldTypeKey),
		Title:          field(ctx, FieldTitle),
		Markdown:       longField(ctx, FieldMarkdown, c.messages.Options().MaxBodyLen),
		TagIDs:         formValues(ctx, FieldTagIDs),
		GroupIDs:       formValues(ctx, FieldGroupIDs),
		AttachmentIDs:  formValues(ctx, FieldAttachmentIDs),
	})
	if err != nil {
		c.failService(ctx, err)
		return
	}
	c.log.Info("message sent | 消息已发送",
		log.Str("tenant", actor.TenantID),
		log.Str("conversation", message.ConversationID),
		log.Str("message", message.ID),
	)
	c.renderMessagePageByID(ctx, message.ConversationID, "消息已发送 | message sent")
}

// resolveConversation resolves the conversation a create form targets. | resolveConversation 解析新建表单的目标会话。
func (c *Controller) resolveConversation(ctx *router.Ctx, actor messaging.Actor) (string, error) {
	if id := strings.TrimSpace(field(ctx, FieldConversation)); id != "" {
		return id, nil
	}
	recipients := formValues(ctx, fieldRecipients)
	switch len(recipients) {
	case 0:
		return "", errs.Detail(messaging.ErrInvalidInput, "choose a conversation or a friend | 请选择会话或好友")
	case 1:
		conv, err := c.messages.DirectConversation(ctx.Request.Context(), actor, recipients[0])
		if err != nil {
			return "", err
		}
		return conv.ID, nil
	default:
		title := field(ctx, FieldGroupTitle)
		if title == "" {
			title = c.tr(c.lang(ctx), "message.group_default_title")
		}
		conv, err := c.messages.CreateGroup(ctx.Request.Context(), actor, title, recipients)
		if err != nil {
			return "", err
		}
		return conv.ID, nil
	}
}

