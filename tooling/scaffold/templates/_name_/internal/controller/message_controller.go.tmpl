// @Description 保存待挂载附件（服务端强制大小与内容类型），并返回把 ID 绑定到消息表单的标签。
// @Tags messages
// @Accept multipart/form-data
// @Produce html
// @Param file formData file true "attachment | 附件"
// @Success 200 {object} string "attachment chip | 附件标签"
// @Failure 413 {object} string "too large | 超过大小上限"
// @Failure 415 {object} string "content type not allowed | 内容类型不允许"
// @Security BearerAuth
// @Router /messages/attachments [post]
func (c *Controller) UploadMessageAttachment(ctx *router.Ctx) {
	if !c.MessagesAvailable() {
		c.messageUnavailable(ctx)
		return
	}
	file, header, err := ctx.FormFile("file")
	if err != nil {
		c.failService(ctx, messaging.ErrInvalidInput)
		return
	}
