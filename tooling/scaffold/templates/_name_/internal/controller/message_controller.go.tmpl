// loadSearchPage 只执行检索本身：检索片段不需要会话列表、置顶条、撰写目录或好友汇总，
// 因此按键触发的检索不再为这些集合付出查询与渲染成本。
// loadSearchPage runs the search alone: the result fragment needs no conversation list, pinned strip, compose
// catalogue or friend summary, so a keystroke-triggered search no longer pays for any of them.
func (c *Controller) loadSearchPage(ctx *router.Ctx, filters messageFilters) (messagePage, error) {
	page := messagePage{Filters: filters, SearchMode: true}
	actor := c.messageActor(ctx)
	result, err := c.messages.Messages(ctx.Request.Context(), actor, messaging.MessageFilter{
		Query:    filters.Query,
		TypeKey:  filters.TypeKey,
		SenderID: filters.SenderID,
		TagID:    filters.TagID,
		Folder:   filters.Folder,
		Page:     filters.Page,
		PageSize: c.messages.Options().PageSize,
	})
	if err != nil {
		return page, err
	}
	page.Results = c.messageViewsOf(actor, result.Messages, c.lang(ctx), time.Now().UTC())
	page.Total = result.Total
	return page, nil
}

// loadMessagePage assembles the conversation list, catalogue, pinned strip and optional thread/results. |
// loadMessagePage 组装会话列表、目录、置顶条以及可选的线程/检索结果。
func (c *Controller) loadMessagePage(ctx *router.Ctx, activeID string, filters messageFilters) (messagePage, error) {
	actor := c.messageActor(ctx)
	lang := c.lang(ctx)
	now := time.Now().UTC()
	page := messagePage{
		Filters:       filters,
		CanSend:       authz.Can(ctx.Request.Context(), authz.PermMessageSend),
		CanManage:     authz.Can(ctx.Request.Context(), authz.PermMessageManage),
		CanSystem:     authz.Can(ctx.Request.Context(), authz.PermMessageSystem),
		CanTypeManage: authz.Can(ctx.Request.Context(), authz.PermMessageTypeManage),
		UserID:        actor.ID,
	}
	conversations, err := c.messages.Conversations(ctx.Request.Context(), actor)
	if err != nil {
		return page, err
	}
	page.Conversations = c.conversationViewsOf(actor, conversations, lang, activeID)

	pinned, err := c.messages.PinnedMessages(ctx.Request.Context(), actor)
	if err != nil {
		return page, err
	}
	page.Pinned = c.messageViewsOf(actor, pinned, lang, now)

	catalog, err := c.catalogData(ctx, actor)
	if err != nil {
		return page, err
	}
	page.Catalog = catalog

	// 联系人页签只需要已接受的好友；完整汇总里的申请与拉黑由好友页自己加载。
	// The contacts tab needs accepted friends only; the full summary's requests and blocks belong to the friends page.
	if friends, err := c.messages.Friends(ctx.Request.Context(), actor); err == nil {
		page.Friends = friendViewsOf(friends)
	}

	if activeID != "" {
		conv, messages, err := c.messages.Conversation(ctx.Request.Context(), actor, activeID)
		if err != nil {
			return page, err
		}
		views := c.conversationViewsOf(actor, []messaging.ConversationView{conv}, lang, activeID)
		if len(views) > 0 {
			active := views[0]
			page.Active = &active
		}
		page.Thread = c.messageViewsOf(actor, messages, lang, now)
	}

	if filters.Active {
		result, err := c.messages.Messages(ctx.Request.Context(), actor, messaging.MessageFilter{
			Query:    filters.Query,
			TypeKey:  filters.TypeKey,
			SenderID: filters.SenderID,
			TagID:    filters.TagID,
			Folder:   filters.Folder,
			Page:     filters.Page,
			PageSize: c.messages.Options().PageSize,
		})
		if err != nil {
			return page, err
		}
		page.Results = c.messageViewsOf(actor, result.Messages, lang, now)
		page.Total = result.Total
		page.SearchMode = true
	}
	return page, nil
}

// threadData builds the fragment data for a live thread refresh. | threadData 构建实时线程刷新的片段数据。
func (c *Controller) threadData(ctx *router.Ctx, conversationID string) (map[string]any, error) {
	actor := c.messageActor(ctx)
	lang := c.lang(ctx)
	conv, messages, err := c.messages.Conversation(ctx.Request.Context(), actor, conversationID)
	if err != nil {
		return nil, err
	}
	views := c.conversationViewsOf(actor, []messaging.ConversationView{conv}, lang, conversationID)
	var active *conversationView
	if len(views) > 0 {
		active = &views[0]
	}
	catalog, err := c.catalogData(ctx, actor)
	if err != nil {
		return nil, err
	}
	data := c.pageView(ctx, "会话 | Conversation", map[string]any{
		"ActiveConversation": active,
		"Thread":             c.messageViewsOf(actor, messages, lang, time.Now().UTC()),
		"Catalog":            catalog,
		"CanSend":            authz.Can(ctx.Request.Context(), authz.PermMessageSend),
		"CanManage":          authz.Can(ctx.Request.Context(), authz.PermMessageManage),
		"CanSystem":          authz.Can(ctx.Request.Context(), authz.PermMessageSystem),
		"ActorID":            actor.ID,
	})
	return data, nil
}

// historyData 只构造历史消息片段的数据：实时刷新不需要会话标题、撰写目录、能力标记或外壳数据，
// 因此这里既不调用 threadData 的完整装配，也不触发 view 的外壳查询。
// historyData builds only the data of the history fragment: a realtime refresh needs neither the conversation
// header, the compose catalogue, the capability flags nor the shell data, so it never runs threadData's full
// assembly or view's shell queries.
func (c *Controller) historyData(ctx *router.Ctx, conversationID string) (map[string]any, error) {
	actor := c.messageActor(ctx)
	messages, err := c.messages.ConversationMessages(ctx.Request.Context(), actor, conversationID)
	if err != nil {
		return nil, err
	}
	return c.pageView(ctx, "会话 | Conversation", map[string]any{
		"Thread": c.messageViewsOf(actor, messages, c.lang(ctx), time.Now().UTC()),
	}), nil
}

// catalogData converts the active catalogue. | catalogData 转换生效目录。
func (c *Controller) catalogData(ctx *router.Ctx, actor messaging.Actor) (catalogView, error) {
	catalog, err := c.messages.Catalog(ctx.Request.Context(), actor)
	if err != nil {
		return catalogView{}, err
	}
	return catalogView{
		Types:  messageTypeViewsOf(catalog.Types, c.lang(ctx)),
		Groups: tagViewsOf(catalog.Groups, c.lang(ctx)),
		Tags:   tagViewsOf(catalog.Tags, c.lang(ctx)),
	}, nil
}

// messageUnavailable renders the message centre with its unavailable notice. | messageUnavailable 渲染带不可用提示的消息中心。
func (c *Controller) messageUnavailable(ctx *router.Ctx) {
	data := c.pageView(ctx, "消息中心 | Messages", map[string]any{"Unavailable": true})
	c.render(ctx, http.StatusServiceUnavailable, TplMessages, data)
}

// parseMessageFilters reads the filter bar from the query string. | parseMessageFilters 从查询串读取过滤栏。
func parseMessageFilters(ctx *router.Ctx) messageFilters {
	filters := messageFilters{
		Query:    strings.TrimSpace(ctx.Query("q")),
		TypeKey:  strings.TrimSpace(ctx.Query(FieldTypeKey)),
		SenderID: strings.TrimSpace(ctx.Query(FieldSender)),
		TagID:    strings.TrimSpace(ctx.Query(FieldTag)),
		Folder:   strings.TrimSpace(ctx.Query(FieldFolder)),
	}
	if filters.Folder == "" {
		filters.Folder = messaging.FolderAll
	}
	if page, err := strconv.Atoi(ctx.Query("page")); err == nil && page > 0 {
		filters.Page = page
	}
	if filters.Page == 0 {
		filters.Page = 1
	}
	filters.Active = filters.Query != "" || filters.TypeKey != "" || filters.SenderID != "" ||
		filters.TagID != "" || (filters.Folder != messaging.FolderAll && filters.Folder != "")
	return filters
}

// longField reads a long text field and truncates it by runes. | longField 读取长文本字段并按符文截断。
func longField(ctx *router.Ctx, name string, max int) string {
	value := strings.TrimSpace(ctx.FormValue(name))
	if max <= 0 {
		return value
	}
	return truncateText(value, max)
}

// truncateText caps a string by runes. | truncateText 按符文限制字符串长度。
func truncateText(value string, max int) string {
	if utf8.RuneCountInString(value) <= max {
		return value
	}
	runes := []rune(value)
	return string(runes[:max])
}

// parsePinTime parses a datetime-local, date or RFC3339 value. | parsePinTime 解析 datetime-local、日期或 RFC3339 取值。
func parsePinTime(value string) (*time.Time, error) {
	value = strings.TrimSpace(value)
	if value == "" {
		return nil, nil
	}
	layouts := []string{time.RFC3339, "2006-01-02T15:04", "2006-01-02T15:04:05", "2006-01-02"}
	for _, layout := range layouts {
		if parsed, err := time.ParseInLocation(layout, value, time.UTC); err == nil {
			parsed = parsed.UTC()
			return &parsed, nil
		}
	}
	return nil, errs.Detail(messaging.ErrPinWindowInvalid, "value=%[1]q | 取值=%[1]q", value)
}
