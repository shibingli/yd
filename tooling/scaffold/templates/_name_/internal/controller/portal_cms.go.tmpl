// myArticleCounts is the per-status summary shown in the personal centre. | myArticleCounts 是个人中心展示的按状态汇总。
type myArticleCounts struct {
	// Draft is the number of drafts. | Draft 是草稿数。
	Draft int
	// Pending is the number of articles awaiting review. | Pending 是待审文章数。
	Pending int
	// Published is the number of published articles. | Published 是已发布文章数。
	Published int
	// Archived is the number of archived articles. | Archived 是已归档文章数。
	Archived int
}

