// saveMyArticle is the shared create/update implementation. | saveMyArticle 是创建与更新的共同实现。
func (c *Controller) saveMyArticle(ctx *router.Ctx) {
	tenantID, ok := c.tenantID(ctx)
	if !ok || !c.cmsAvailable(ctx) {
		return
	}
	if !c.cmsEnsure(ctx, tenantID) {
		return
	}
	input := cmsArticleInput(ctx)
	// 推荐与置顶属于编辑台策略，普通作者的表单不提供这两项；更新时沿用库中取值，避免一次保存把管理员的编排清掉。 |
	// Featured and pinned are editorial decisions and the member form does not offer them; an update therefore keeps the
	// stored values so a save cannot silently erase an administrator's curation.
	if input.ID != "" {
		current, ok := c.myArticle(ctx, tenantID, input.ID)
		if !ok {
			return
		}
		input.Featured = current.Featured
		input.Pinned = current.Pinned
	}
	article, err := c.cms.SaveArticle(ctx.Request.Context(), c.cmsActor(ctx), input)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	c.log.Info("portal article saved | 门户文章已保存", logx.Str("tenant", tenantID), logx.Str("article", article.ID))
	c.redirect(ctx, "/account/articles/"+article.ID+"/edit")
}

// MyTransitionArticle applies the author-side lifecycle actions. | MyTransitionArticle 应用作者侧的生命周期动作。
//
// @Summary Portal article transition | 门户文章状态转换
// @Description Applies submit, withdraw, archive or restore to an article owned by the signed-in author. Approval,
// @Description rejection and direct publishing are deliberately unavailable here and remain under /mgr/cms. | 对当前作者
// @Description 自己的文章执行提交、撤回、退役或恢复。审核通过、驳回与直接发布刻意不在门户提供，仍归 /mgr/cms。
// @Tags portal-cms
// @Accept x-www-form-urlencoded
// @Produce html
// @Param id path string true "article id | 文章 ID"
// @Param action formData string true "submit|withdraw|archive|restore | 动作"
// @Success 303 {object} string "redirect to the article | 重定向到文章"
// @Failure 403 {string} string "forbidden | 无权限"
// @Failure 409 {string} string "transition refused | 状态不允许"
// @Security BearerAuth
// @Router /account/articles/{id}/transition [post]
func (c *Controller) MyTransitionArticle(ctx *router.Ctx) {
	tenantID, ok := c.tenantID(ctx)
	if !ok || !c.cmsAvailable(ctx) {
		return
	}
	if !c.cmsEnsure(ctx, tenantID) {
		return
	}
	if _, ok := c.myArticle(ctx, tenantID, ctx.Param("id")); !ok {
		return
	}
	action, at, err := cmsTransition(ctx)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	switch action {
	case cms.ActionSubmit, cms.ActionWithdraw, cms.ActionArchive, cms.ActionRestore:
	default:
		c.fail(ctx, http.StatusUnprocessableEntity, cms.ErrInvalidInput.Error())
		return
	}
	article, err := c.cms.TransitionArticle(ctx.Request.Context(), c.cmsActor(ctx), ctx.Param("id"), action, at)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	c.redirect(ctx, "/account/articles/"+article.ID+"/edit")
}

// MyDeleteArticle soft-deletes one of the author's articles. | MyDeleteArticle 软删除作者自己的文章。
//
// @Summary Delete my article | 删除我的文章
// @Description Soft-deletes an article owned by the signed-in author and releases its slug. | 软删除当前作者自己的文章并
// @Description 释放其别名。
// @Tags portal-cms
// @Accept x-www-form-urlencoded
// @Produce html
// @Param id path string true "article id | 文章 ID"
// @Success 303 {object} string "redirect to the list | 重定向到列表"
// @Failure 404 {string} string "article not found | 文章不存在"
// @Security BearerAuth
// @Router /account/articles/{id}/delete [post]
func (c *Controller) MyDeleteArticle(ctx *router.Ctx) {
	tenantID, ok := c.tenantID(ctx)
	if !ok || !c.cmsAvailable(ctx) {
		return
	}
	if !c.cmsEnsure(ctx, tenantID) {
		return
	}
	if _, ok := c.myArticle(ctx, tenantID, ctx.Param("id")); !ok {
		return
	}
	if err := c.cms.DeleteArticle(ctx.Request.Context(), c.cmsActor(ctx), ctx.Param("id")); err != nil {
		c.failService(ctx, err)
		return
	}
	c.redirect(ctx, "/account/articles")
}

// myArticle loads one article and checks that it belongs to the signed-in author. A missing article, another author's
// article and a cross-tenant id all answer cms.ErrArticleNotFound, so the portal never reveals whether somebody else's
// draft exists. | myArticle 读取一篇文章并确认它属于当前作者。文章不存在、属于他人或跨租户时一律返回
// cms.ErrArticleNotFound，门户因此不会泄露他人的草稿是否存在。
func (c *Controller) myArticle(ctx *router.Ctx, tenantID, id string) (cms.ArticleView, bool) {
	article, err := c.cms.Article(ctx.Request.Context(), tenantID, id, false)
	if err != nil || article.AuthorID != c.cmsActor(ctx).ID {
		c.failService(ctx, cms.ErrArticleNotFound)
		return cms.ArticleView{}, false
	}
	return article, true
}

// myEditorData builds the portal editor data. | myEditorData 构造门户编辑器数据。
func (c *Controller) myEditorData(ctx *router.Ctx, tenantID string, article cms.ArticleView, mode, action string) (map[string]any, bool) {
	categories, err := c.cms.CategoryOptions(ctx.Request.Context(), tenantID, "")
	if err != nil {
		c.failService(ctx, err)
		return nil, false
	}
	tags, err := c.cms.Tags(ctx.Request.Context(), tenantID, "")
	if err != nil {
		c.failService(ctx, err)
		return nil, false
	}
	actor := c.cmsActor(ctx)
	rows := model.NewCMSArticles([]cms.ArticleView{article}, actor.ID, actor.Manage, actor.Publish, actor.Review)
	row := model.CMSArticle{}
	if len(rows) > 0 {
		row = rows[0]
	}
	title := c.tr(c.lang(ctx), "cms.article.create_title")
	if mode == "edit" {
		title = c.tr(c.lang(ctx), "cms.article.edit_title")
	}
	data := c.cmsPageData(ctx, title, map[string]any{
		"Article":      row,
		"Categories":   categories,
		"Tags":         tags,
		"SelectedTags": cmsTagsFor(article.Tags),
		"Mode":         mode,
		"Action":       action,
		"CanSubmit":    mode == "edit" && article.Status == cms.ArticleDraft,
		"CanWithdraw":  mode == "edit" && article.Status == cms.ArticlePending,
		"CanArchive":   mode == "edit" && article.Status == cms.ArticlePublished,
		"CanRestore":   mode == "edit" && article.Status == cms.ArticleArchived,
		"CanDelete":    mode == "edit" && authz.Can(ctx.Request.Context(), authz.PermCmsArticleDelete),
		"PageStyles":   cmsEditorStyles,
		"PageScripts":  cmsEditorScripts,
	})
	return data, true
}

// myArticleCounts returns the author's totals for the personal-centre cards. | myArticleCounts 返回个人中心卡片使用的
// 作者维度统计。
func (c *Controller) myArticleCounts(ctx *router.Ctx, tenantID, authorID string) myArticleCounts {
	counts := myArticleCounts{}
	for _, item := range []struct {
		status cms.ArticleStatus
		target *int
	}{
		{cms.ArticleDraft, &counts.Draft},
		{cms.ArticlePending, &counts.Pending},
		{cms.ArticlePublished, &counts.Published},
		{cms.ArticleArchived, &counts.Archived},
	} {
		page, err := c.cms.Articles(ctx.Request.Context(), tenantID, cms.ArticleFilter{
			AuthorID: authorID,
			Status:   item.status,
			Page:     1,
			PageSize: 1,
		})
		if err == nil {
			*item.target = int(page.Total)
		}
	}
	return counts
}
