// MyArticles renders the portal writing centre list. | MyArticles 渲染门户写作中心的文章列表。
//
// @Summary My articles | 我的文章
// @Description Lists the signed-in author's articles with status, keyword and category filters. The author filter is
// @Description always applied server-side; a member never sees another author's drafts. | 列出当前作者的文章，支持按状态、
// @Description 关键字与分类筛选。作者条件始终由服务端强制，成员永远看不到他人的草稿。
// @Tags portal-cms
// @Produce html
// @Param status query string false "status | 状态"
// @Param q query string false "keyword | 关键字"
// @Param category query string false "category id | 分类 ID"
// @Param page query int false "page | 页码"
// @Success 200 {object} map[string]any "article list page | 文章列表页"
// @Security BearerAuth
// @Router /account/articles [get]
func (c *Controller) MyArticles(ctx *router.Ctx) {
	tenantID, ok := c.tenantID(ctx)
	if !ok || !c.cmsAvailable(ctx) {
		return
	}
	if !c.cmsEnsure(ctx, tenantID) {
		return
	}
	actor := c.cmsActor(ctx)
	filter := cmsArticleFilter(ctx)
	filter.AuthorID = actor.ID
	filter.PageSize = c.cms.Options().PageSize
	page, err := c.cms.Articles(ctx.Request.Context(), tenantID, filter)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	categories, err := c.cms.CategoryOptions(ctx.Request.Context(), tenantID, "")
	if err != nil {
		c.failService(ctx, err)
		return
	}
	data := c.cmsPageData(ctx, c.tr(c.lang(ctx), "cms.my.title"), map[string]any{
		"Articles":   cmsArticleRows(page.Items, actor),
		"Total":      page.Total,
		"Page":       page.Page,
		"TotalPages": page.TotalPages,
		"Empty":      len(page.Items) == 0,
		"Keyword":    filter.Keyword,
		"Status":     string(filter.Status),
		"Category":   filter.CategoryID,
		"Categories": categories,
		"Pager":      newCMSPager(cmsPageBase(ctx), page.Page, page.TotalPages),
		"Counts":     c.myArticleCounts(ctx, tenantID, actor.ID),
	})
	c.render(ctx, http.StatusOK, TplMyArticles, data)
}

// MyNewArticle renders a blank portal editor. | MyNewArticle 渲染空白门户编辑器。
//
// @Summary New article | 新建文章
// @Description Returns the portal article editor. | 返回门户文章编辑器。
// @Tags portal-cms
// @Produce html
// @Success 200 {object} map[string]any "editor | 编辑器"
// @Security BearerAuth
// @Router /account/articles/new [get]
func (c *Controller) MyNewArticle(ctx *router.Ctx) {
	tenantID, ok := c.tenantID(ctx)
	if !ok || !c.cmsAvailable(ctx) {
		return
	}
	if !c.cmsEnsure(ctx, tenantID) {
		return
	}
	blank := cms.ArticleView{}
	blank.AllowComment = true
	blank.Visibility = cms.VisibilityPublic
	blank.Kind = cms.KindPost
	data, ok := c.myEditorData(ctx, tenantID, blank, "create", "/account/articles")
	if !ok {
		return
	}
	c.render(ctx, http.StatusOK, TplMyArticleEdit, data)
}

// MyEditArticle renders one of the author's articles in the portal editor. | MyEditArticle 在门户编辑器中渲染作者自己的文章。
//
// @Summary Edit my article | 编辑我的文章
// @Description Returns the editor for an article owned by the signed-in author. Another author's article is
// @Description indistinguishable from a missing one. | 返回当前作者自己文章的编辑器；他人文章与不存在不可区分。
// @Tags portal-cms
// @Produce html
// @Param id path string true "article id | 文章 ID"
// @Success 200 {object} map[string]any "editor | 编辑器"
// @Failure 404 {string} string "article not found | 文章不存在"
// @Security BearerAuth
// @Router /account/articles/{id}/edit [get]
func (c *Controller) MyEditArticle(ctx *router.Ctx) {
	tenantID, ok := c.tenantID(ctx)
	if !ok || !c.cmsAvailable(ctx) {
		return
	}
	if !c.cmsEnsure(ctx, tenantID) {
		return
	}
	article, err := c.cms.Article(ctx.Request.Context(), tenantID, ctx.Param("id"), false)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	if article.AuthorID != c.cmsActor(ctx).ID {
		c.failService(ctx, cms.ErrArticleNotFound)
		return
	}
	data, ok := c.myEditorData(ctx, tenantID, article, "edit", "/account/articles/"+article.ID)
	if !ok {
		return
	}
	c.render(ctx, http.StatusOK, TplMyArticleEdit, data)
}

