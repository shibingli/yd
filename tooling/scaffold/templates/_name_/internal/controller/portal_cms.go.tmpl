//
// @Summary Update my article | 更新我的文章
// @Description Updates an article owned by the signed-in author and snapshots the previous body as a revision. | 更新当前
// @Description 作者自己的文章，并把旧正文快照为修订。
// @Tags portal-cms
// @Accept x-www-form-urlencoded
// @Produce html
// @Param id path string true "article id | 文章 ID"
// @Param title formData string true "title | 标题"
// @Param body_markdown formData string true "Markdown body | Markdown 正文"
// @Success 303 {object} string "redirect to the editor | 重定向到编辑器"
// @Failure 404 {string} string "article not found | 文章不存在"
