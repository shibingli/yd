	return out
}

// tagViewsOf converts groups or labels. | tagViewsOf 转换分组或标签。
func tagViewsOf(list []messaging.Tag, lang string) []tagView {
	out := make([]tagView, 0, len(list))
	for _, item := range list {
		out = append(out, tagView{Tag: item, Label: item.Label(lang), Archived: item.Archived()})
