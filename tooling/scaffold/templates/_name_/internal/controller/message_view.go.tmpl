type messageTagView struct {
	// ID is the tag id. | ID 是标签 ID。
	ID string
	// Key is the stable slug. | Key 是稳定标识。
	Key string
	// Label is the localised name. | Label 是本地化名称。
	Label string
	// Tone is the semantic colour role. | Tone 是语义色角色。
	Tone string
}

// messageAttachmentView is one attachment ready for rendering. | messageAttachmentView 是可直接渲染的附件。
type messageAttachmentView struct {
	// Attachment is the stored record. | Attachment 是存储记录。
	messaging.Attachment
	// SizeText is a human-readable size. | SizeText 是人类可读大小。
	SizeText string
