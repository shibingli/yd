	HTML template.HTML
	// TypeLabel is the localised type name. | TypeLabel 是本地化类型名。
	TypeLabel string
	// SenderName is the display name snapshot. | SenderName 是展示名快照。
	SenderName string
	// SenderInitial is the avatar letter. | SenderInitial 是头像首字母。
	SenderInitial string
	// When is the formatted send time. | When 是格式化的发送时间。
	When string
	// Preview is the plain-text teaser. | Preview 是纯文本摘要。
	Preview string
	// Attachments are the attachment views. | Attachments 是附件视图。
	Attachments []messageAttachmentView
	// Tags are the label views. | Tags 是标签视图。
	Tags []messageTagView
	// Groups are the group views. | Groups 是分组视图。
	Groups []messageTagView
	// CanEdit reports whether the edit action is offered. | CanEdit 报告是否提供编辑动作。
	CanEdit bool
	// CanRecall reports whether the recall action is offered. | CanRecall 报告是否提供撤回动作。
	CanRecall bool
	// CanRevoke reports whether the system revoke action is offered. | CanRevoke 报告是否提供系统撤销动作。
	CanRevoke bool
	// CanPin reports whether the pin action is offered. | CanPin 报告是否提供置顶动作。
	CanPin bool
	// PinnedNow reports whether the pin is active. | PinnedNow 报告置顶是否生效。
	PinnedNow bool
	// Recalled reports whether the message is a tombstone. | Recalled 报告消息是否为墓碑。
	Recalled bool
	// Mine reports whether the actor wrote it. | Mine 报告当前主体是否作者。
