// auditViewsOf converts audit entries. | auditViewsOf 转换审计记录。
func auditViewsOf(list []messaging.AuditEntry) []auditView {
	out := make([]auditView, 0, len(list))
	for _, item := range list {
		out = append(out, auditView{AuditEntry: item, When: formatWhen(item.CreatedAt)})
	}
	return out
}

// initialOf returns the first rune of a display name. | initialOf 返回展示名的第一个符文。
func initialOf(value string) string {
	value = strings.TrimSpace(value)
	if value == "" {
		return "?"
	}
	first, _ := utf8.DecodeRuneInString(value)
	if first == utf8.RuneError {
		return "?"
	}
	return strings.ToUpper(string(first))
}

// previewOf collapses whitespace and truncates by runes. | previewOf 折叠空白并按符文截断。
//
// 一次扫描完成折叠与截断：旧实现先 Fields/Join 造一份中间字符串，再把它整体转成 []rune，
// 一条几 KB 的消息因此会临时分配数万个字节，而摘要最多只要 limit 个符文。
// One pass folds and truncates: the old implementation built an intermediate string with Fields/Join and then
// converted the whole thing to []rune, so a multi-KB message allocated tens of KB for a teaser of at most limit runes.
func previewOf(value string, limit int) string {
	var b strings.Builder
	if limit > 0 && len(value) > limit*4 {
		b.Grow(limit*4 + 3)
	} else {
		b.Grow(len(value))
	}
	written := 0
	space := false
	truncated := false
	for _, r := range value {
		if unicode.IsSpace(r) {
			if written == 0 || space {
				continue
			}
			if limit > 0 && written >= limit {
				truncated = true
				break
			}
			b.WriteByte(' ')
			written++
			space = true
			continue
		}
		if limit > 0 && written >= limit {
			truncated = true
			break
		}
		b.WriteRune(r)
		written++
		space = false
	}
	out := b.String()
	if space && len(out) > 0 {
		out = strings.TrimRight(out, " ")
	}
	if truncated {
		out += "…"
	}
	return out
}

// formatWhen renders a UTC timestamp in the page's fixed list format. | formatWhen 以列表固定格式渲染 UTC 时间戳。
func formatWhen(at time.Time) string {
	if at.IsZero() {
		return ""
	}
	return at.UTC().Format("2006-01-02 15:04")
}

// sizeText renders a byte count as B, KiB or MiB. | sizeText 把字节数渲染为 B、KiB 或 MiB。
func sizeText(size int64) string {
	switch {
	case size < 1024:
		return strconvInt(size) + " B"
	case size < 1024*1024:
		return strconvFloat(float64(size)/1024) + " KiB"
	default:
		return strconvFloat(float64(size)/(1024*1024)) + " MiB"
	}
}

// strconvInt formats an integer without importing fmt into a hot template path. | strconvInt 不把 fmt 引入模板热路径地格式化整数。
func strconvInt(value int64) string {
	if value == 0 {
		return "0"
	}
	negative := value < 0
	if negative {
		value = -value
	}
	var digits [20]byte
	pos := len(digits)
	for value > 0 {
		pos--
		digits[pos] = byte('0' + value%10)
		value /= 10
	}
	if negative {
		pos--
		digits[pos] = '-'
	}
	return string(digits[pos:])
}

// strconvFloat formats one decimal place for a size. | strconvFloat 为大小保留一位小数。
func strconvFloat(value float64) string {
	whole := int64(value)
	frac := int64((value - float64(whole)) * 10)
	if frac < 0 {
		frac = 0
	}
	return strconvInt(whole) + "." + strconvInt(frac)
}

// tr renders one catalogue key outside a template execution. | tr 在模板执行之外渲染一个语言目录键。
func (c *Controller) tr(lang, key string) string {
	if c.i18n == nil {
		return key
	}
	return c.i18n.Translator(lang).T(key)
}
