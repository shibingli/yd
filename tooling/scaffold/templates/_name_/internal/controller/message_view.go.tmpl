// auditViewsOf converts audit entries. | auditViewsOf 转换审计记录。
func auditViewsOf(list []messaging.AuditEntry) []auditView {
	out := make([]auditView, 0, len(list))
	for _, item := range list {
		out = append(out, auditView{AuditEntry: item, When: formatWhen(item.CreatedAt)})
	}
