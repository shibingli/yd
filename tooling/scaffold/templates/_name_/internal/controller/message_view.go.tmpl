// messageViewOf converts one domain message. | messageViewOf 转换一条领域消息。
func (c *Controller) messageViewOf(actor messaging.Actor, msg messaging.MessageView, lang string, now time.Time) messageView {
	view := messageView{
		MessageView:   msg,
		HTML:          template.HTML(msg.BodyHTML), //nolint:gosec // sanitised by the messaging renderer | 已由消息渲染器净化
		TypeLabel:     msg.Label(lang),
		SenderName:    msg.SenderName,
		SenderInitial: initialOf(msg.SenderName),
		When:          formatWhen(msg.CreatedAt),
		Preview:       previewOf(msg.BodyText, 120),
		PinnedNow:     msg.PinnedNow(now),
		Recalled:      msg.Status == messaging.StatusRecalled,
		Mine:          msg.SenderID == actor.ID,
		BasePath:      MessagePortalBase,
	}
	if strings.TrimSpace(view.SenderName) == "" {
		view.SenderName = "?"
	}
	for _, attachment := range msg.Attachments {
		view.Attachments = append(view.Attachments, messageAttachmentView{
			Attachment:   attachment,
			SizeText:     sizeText(attachment.Size),
			DeleteReason: attachment.DeleteReason,
			Image:        attachments.IsImage(attachment),
			Deleted:      attachment.Status == attachments.StatusDeleted,
		})
	}
	for _, tag := range msg.Tags {
		view.Tags = append(view.Tags, messageTagView{ID: tag.ID, Key: tag.Key, Label: tag.Label(lang), Tone: tag.Tone})
	}
	for _, group := range msg.Groups {
		view.Groups = append(view.Groups, messageTagView{ID: group.ID, Key: group.Key, Label: group.Label(lang), Tone: group.Tone})
	}

	sent := msg.Status == messaging.StatusSent
	systemOrigin := msg.Origin == messaging.OriginSystem
	withinEdit := now.Sub(msg.CreatedAt) <= c.messages.Options().EditWindow
	withinRecall := now.Sub(msg.CreatedAt) <= c.messages.Options().RecallWindow
	view.CanEdit = sent && (actor.Manage || (view.Mine && !systemOrigin && withinEdit))
	view.CanRecall = sent && !systemOrigin && (actor.Manage || (view.Mine && withinRecall))
	view.CanRevoke = sent && systemOrigin && actor.System
	view.CanPin = sent && systemOrigin && actor.Manage
	return view
}

// messageViewsOf converts a batch. | messageViewsOf 批量转换。
func (c *Controller) messageViewsOf(actor messaging.Actor, list []messaging.MessageView, lang string, now time.Time) []messageView {
	out := make([]messageView, 0, len(list))
	for _, msg := range list {
		out = append(out, c.messageViewOf(actor, msg, lang, now))
	}
	return out
}

// adminMessageViewsOf converts a batch for the back office, where the same card acts on /mgr/messages. |
// adminMessageViewsOf 为后台转换一批消息，同一张卡片因而对 /mgr/messages 发起动作。
func (c *Controller) adminMessageViewsOf(actor messaging.Actor, list []messaging.MessageView, lang string, now time.Time) []messageView {
	out := c.messageViewsOf(actor, list, lang, now)
	for i := range out {
		out[i].BasePath = MessageAdminBase
	}
	return out
}

// conversationViewsOf converts the conversation list, resolving titles and teasers. |
// conversationViewsOf 转换会话列表，解析标题与摘要。
func (c *Controller) conversationViewsOf(actor messaging.Actor, list []messaging.ConversationView, lang string, activeID string) []conversationView {
	out := make([]conversationView, 0, len(list))
	for _, conv := range list {
		view := conversationView{
			ConversationView: conv,
			IsSystem:         conv.Kind == messaging.KindSystem,
			IsDirect:         conv.Kind == messaging.KindDirect,
			IsGroup:          conv.Kind == messaging.KindGroup,
			IsNotice:         conv.Kind == messaging.KindNotice,
			Active:           conv.ID == activeID,
		}
		switch {
		case conv.Kind == messaging.KindNotice:
			view.Title = c.tr(lang, "message.notice_channel")
			view.Initial = "!"
		case conv.Kind == messaging.KindSystem:
			view.Title = c.tr(lang, "message.system_channel")
			view.Initial = "◆"
		case conv.Kind == messaging.KindDirect && conv.Peer != nil:
			view.Title = conv.Peer.Display()
			view.Initial = initialOf(view.Title)
		default:
			view.Title = conv.Title
			if view.Title == "" {
				view.Title = c.tr(lang, "message.group_untitled")
			}
			view.Initial = initialOf(view.Title)
		}
		if conv.LastMessage != nil {
			view.LastWhen = formatWhen(conv.LastMessage.CreatedAt)
			view.LastRecalled = conv.LastMessage.Recalled()
			view.LastPreview = previewOf(conv.LastMessage.BodyText, 80)
		}
		out = append(out, view)
	}
	return out
}

// friendViewsOf converts friends. | friendViewsOf 转换好友列表。
func friendViewsOf(list []messaging.FriendView) []friendView {
	out := make([]friendView, 0, len(list))
	for _, friend := range list {
		name := friend.Display()
		out = append(out, friendView{FriendView: friend, Name: name, Initial: initialOf(name)})
	}
	return out
}

