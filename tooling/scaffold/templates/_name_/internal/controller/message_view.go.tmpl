// 本文件把消息领域对象转换成模板视图：只做展示派生（标签、时间、首字母、可操作标记），不改变业务判定。
// This file converts message domain objects into template views: it only derives presentation values
// (labels, times, initials, action flags) and never changes a business decision.

package controller

import (
	"html/template"
	"strings"
	"time"
	"unicode"
	"unicode/utf8"

	"{{ .Module }}/internal/middleware"
	"{{ .YdModule }}/attachments"
	"{{ .YdxModule }}/router"
	"{{ .YdModule }}/messaging"
	"{{ .YdModule }}/security/auth"
	"{{ .YdModule }}/security/authz"
)

// 消息页面使用的静态资产：编辑器与实时脚本只在这些页面加载，避免拖慢其它工作区。
// Static assets of the message pages: the editor and realtime scripts load only here, so they never slow down another
// workspace.
var (
	messagePageStyles = []string{
		"/static/js/vendored/easymde.min.css",
	}
	// EasyMDE 不再随页面自动加载：它是消息页最大的一件资产（约 320 KB），而多数访问只是阅读。
	// 编辑器包装元素通过 data-yd-editor-vendor 声明地址，yd-message-editor.js 在内联紧凑编辑器出现时、
	// 首次聚焦其它编辑器或打开抽屉时再同源加载；文本域在此期间保持可用，草稿不会丢。
	// EasyMDE is no longer loaded with the page: it is the message page's largest asset (about 320 KB) and most
	// visits only read. The editor wrapper declares its URL through data-yd-editor-vendor, and yd-message-editor.js
	// loads it same-origin when the compact inline composer appears, on first focus of any other editor, or when a
	// drawer opens; the textarea stays usable meanwhile, so no draft is lost.
	messagePageScripts = []string{
		"/static/js/yd-message-editor.js",
		"/static/js/yd-message.js",
	}
)

// messageActor builds the domain actor from the request. Capabilities come from the authz registry,
// so a permission name is never spelled out here. | messageActor 从请求构造领域主体。
// 能力来自 authz 注册表，这里不写任何权限字面量。
func (c *Controller) messageActor(ctx *router.Ctx) messaging.Actor {
	actor := messaging.Actor{}
	user, ok := auth.CurrentUser(ctx)
	if !ok || user == nil {
		return actor
	}
	actor.ID = user.ID
	actor.TenantID = user.TenantID
	actor.DisplayName = user.DisplayName
	if actor.DisplayName == "" {
		actor.DisplayName = user.Username
	}
	if tenantID, ok := middleware.TenantID(ctx); ok {
		actor.TenantID = tenantID
	}
	request := ctx.Request.Context()
	actor.Manage = authz.Can(request, authz.PermMessageManage)
	actor.System = authz.Can(request, authz.PermMessageSystem)
	actor.TypeManage = authz.Can(request, authz.PermMessageTypeManage)
	return actor
}

