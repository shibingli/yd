// workflowAPIFail writes the shared API error shape. | workflowAPIFail 写出共享 API 错误形态。
func (c *Controller) workflowAPIFail(ctx *router.Ctx, err error) {
	status, message := statusFor(err)
	if status >= http.StatusInternalServerError {
		c.log.Error("workflow API request failed | 流程 API 请求失败", ydlog.Err(err), ydlog.Str("path", ctx.Path()))
	}
	_ = ctx.JSON(status, map[string]any{"error": message})
}

// workflowAPIAvailable guards an API handler. | workflowAPIAvailable 守卫一个 API 处理器。
func (c *Controller) workflowAPIAvailable(ctx *router.Ctx) (string, bool) {
	if !c.WorkflowAvailable() {
		// JSON clients must receive a JSON error, never the HTML fragment produced by the page
		// helper. | JSON 客户端必须收到 JSON 错误，不能拿到页面辅助函数生成的 HTML 片段。
		c.workflowAPIFail(ctx, service.ErrWorkflowUnavailable)
		return "", false
	}
	tenantID, ok := middleware.TenantID(ctx)
	if !ok {
		c.workflowAPIFail(ctx, service.ErrTenantMissing)
		return "", false
	}
	return tenantID, true
}

