// @Security BearerAuth
// @Router /api/v1/workflows/groups/{id} [delete]
func (c *Controller) APIDeleteWorkflowGroup(ctx *router.Ctx) {
	tenantID, ok := c.workflowAPIAvailable(ctx)
	if !ok {
		return
	}
	if err := c.workflow.DeleteGroup(ctx.Request.Context(), tenantID, ctx.Param("id")); err != nil {
		c.workflowAPIFail(ctx, err)
		return
	}
	_ = ctx.NoContent(http.StatusNoContent)
}

// APIWorkflowGroupMembers reads or replaces group members. | APIWorkflowGroupMembers 读取或替换组成员。
//
// @Summary List group members | 列出组成员
// @Description Returns the explicit members of one group. | 返回一个组的显式成员。
// @Tags workflow
// @Produce json
// @Param id path string true "Group id | 组 ID"
// @Success 200 {array} workflowGroupMemberDoc "members | 成员"
// @Security BearerAuth
// @Router /api/v1/workflows/groups/{id}/members [get]
func (c *Controller) APIWorkflowGroupMembers(ctx *router.Ctx) {
	tenantID, ok := c.workflowAPIAvailable(ctx)
	if !ok {
		return
	}
	members, err := c.workflow.GroupMembers(ctx.Request.Context(), tenantID, ctx.Param("id"))
	if err != nil {
		c.workflowAPIFail(ctx, err)
		return
	}
	_ = ctx.JSON(http.StatusOK, members)
}

// APIUpdateWorkflowGroupMembers replaces group members. | APIUpdateWorkflowGroupMembers 替换组成员。
//
// @Summary Replace group members | 替换组成员
// @Description Sets the explicit member list. | 设置显式成员列表。
// @Tags workflow
// @Accept json
// @Produce json
// @Param id path string true "Group id | 组 ID"
// @Param body body workflowGroupMembersRequest true "member payload | 成员载荷"
// @Success 200 {array} workflowGroupMemberDoc "members | 成员"
// @Security BearerAuth
// @Router /api/v1/workflows/groups/{id}/members [put]
func (c *Controller) APIUpdateWorkflowGroupMembers(ctx *router.Ctx) {
	tenantID, ok := c.workflowAPIAvailable(ctx)
	if !ok {
		return
	}
	request := workflowGroupMembersRequest{}
	if err := ctx.Bind(&request); err != nil {
		c.workflowAPIFail(ctx, workflow.ErrInvalidInput)
		return
	}
	members, err := c.workflow.SetGroupMembers(ctx.Request.Context(), tenantID, ctx.Param("id"), request.Members)
	if err != nil {
		c.workflowAPIFail(ctx, err)
		return
	}
	_ = ctx.JSON(http.StatusOK, members)
}
