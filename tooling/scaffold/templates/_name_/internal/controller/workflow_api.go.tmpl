// APIWorkflowExport exports a JSON bundle or one BPMN document. | APIWorkflowExport 导出 JSON 流程包或单个 BPMN 文档。
//
// @Summary Export workflows | 导出流程
// @Description Exports definitions as a JSON bundle, or one version as BPMN 2.0 XML. | 把定义导出为 JSON 流程包，或把一个版本导出为 BPMN 2.0 XML。
// @Tags workflow
// @Produce application/json,application/xml
// @Param keys query string false "Comma-separated definition keys | 逗号分隔的定义键"
// @Param format query string false "json or bpmn | json 或 bpmn"
// @Param version query string false "Version id for BPMN | BPMN 版本 ID"
// @Success 200 {file} file "exported document | 导出文档"
// @Security BearerAuth
// @Router /api/v1/workflows/export [get]
func (c *Controller) APIWorkflowExport(ctx *router.Ctx) {
	tenantID, ok := c.workflowAPIAvailable(ctx)
	if !ok {
		return
	}
	if strings.EqualFold(strings.TrimSpace(ctx.Query(FieldWorkflowFormat)), "bpmn") {
		document, err := c.workflow.ExportBPMN(ctx.Request.Context(), tenantID, strings.TrimSpace(ctx.Query(FieldWorkflowVersion)))
		if err != nil {
			c.workflowAPIFail(ctx, err)
			return
		}
		_ = ctx.Blob(http.StatusOK, "application/xml; charset=utf-8", []byte(document))
		return
	}
	keys := make([]string, 0, 8)
	for _, key := range strings.Split(ctx.Query("keys"), ",") {
		if trimmed := strings.TrimSpace(key); trimmed != "" {
			keys = append(keys, trimmed)
		}
	}
	bundle, err := c.workflow.ExportBundle(ctx.Request.Context(), tenantID, keys)
	if err != nil {
		c.workflowAPIFail(ctx, err)
		return
	}
	_ = ctx.JSON(http.StatusOK, bundle)
}

// APIWorkflowImport imports one bundle or one BPMN document. | APIWorkflowImport 导入一个流程包或一份 BPMN 文档。
//
// @Summary Import workflows | 导入流程
// @Description With format=json (the default) merges a JSON bundle and returns an import report; with
// format=bpmn parses one BPMN 2.0 document and returns the created definition and draft version. |
// format=json（默认）合并 JSON 流程包并返回导入报告；format=bpmn 解析一份 BPMN 2.0 文档并返回新建的定义与草稿版本。
// @Tags workflow
// @Accept json
// @Produce json
// @Param format query string false "json | bpmn"
// @Param body body workflowBundleDoc true "workflow bundle or BPMN XML | 流程包或 BPMN XML"
// @Success 200 {object} map[string]any "import report, or the created definition and version | 导入报告，或新建的定义与版本"
// @Security BearerAuth
// @Router /api/v1/workflows/import [post]
func (c *Controller) APIWorkflowImport(ctx *router.Ctx) {
	tenantID, ok := c.workflowAPIAvailable(ctx)
	if !ok {
		return
	}
	actorID := c.workflowActor(ctx).ID
	if strings.EqualFold(strings.TrimSpace(ctx.Query(FieldWorkflowFormat)), "bpmn") {
		body := ctx.Body()
		defer func() { _ = body.Close() }()
		limit := int64(c.workflow.Options().MaxImportBytes)
		raw, err := io.ReadAll(io.LimitReader(body, limit+1))
		if err != nil {
			c.workflowAPIFail(ctx, workflow.ErrImportInvalid)
			return
		}
		if int64(len(raw)) > limit {
			c.workflowAPIFail(ctx, workflow.ErrLimit)
			return
		}
		process, err := workflow.ParseBPMN(string(raw))
		if err != nil {
			c.workflowAPIFail(ctx, err)
			return
		}
		definition, version, err := c.workflow.ImportBPMN(ctx.Request.Context(), tenantID, actorID, process)
		if err != nil {
			c.workflowAPIFail(ctx, err)
			return
		}
		_ = ctx.JSON(http.StatusOK, map[string]any{"definition": definition, "version": version})
		return
	}
	bundle := workflow.Bundle{}
	if err := ctx.Bind(&bundle); err != nil {
		c.workflowAPIFail(ctx, workflow.ErrImportInvalid)
		return
	}
	report, err := c.workflow.ImportBundle(ctx.Request.Context(), tenantID, actorID, bundle)
	if err != nil {
		c.workflowAPIFail(ctx, err)
		return
	}
	_ = ctx.JSON(http.StatusOK, report)
}

