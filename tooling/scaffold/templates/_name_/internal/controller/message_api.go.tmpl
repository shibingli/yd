// APISendRequest is the JSON/form payload of a send. | APISendRequest 是发送的 JSON/表单载荷。
//
// @Name APISendRequest
type APISendRequest struct {
	// ConversationID is the target conversation. | ConversationID 是目标会话。
	ConversationID string `json:"conversation_id" form:"conversation_id"`
	// RecipientID opens a direct conversation when no conversation is named. | RecipientID 在未指定会话时开启单聊。
	RecipientID string `json:"recipient_id" form:"recipient_id"`
	// GroupTitle names a new group when several recipients are selected. | GroupTitle 在选中多个收件人时命名新群。
	GroupTitle string `json:"group_title" form:"group_title"`
	// GroupMembers lists the new group's recipients. | GroupMembers 列出新群收件人。
	GroupMembers []string `json:"group_members" form:"group_members"`
	// TypeKey is the message type. | TypeKey 是消息类型。
	TypeKey string `json:"type_key" form:"type_key"`
	// Title is the optional subject. | Title 是可选标题。
	Title string `json:"title" form:"title"`
	// Markdown is the body source. | Markdown 是正文源。
	Markdown string `json:"body_markdown" form:"body_markdown"`
	// TagIDs lists labels. | TagIDs 列出标签。
	TagIDs []string `json:"tag_ids" form:"tag_ids"`
	// GroupIDs lists groups. | GroupIDs 列出分组。
	GroupIDs []string `json:"group_ids" form:"group_ids"`
	// AttachmentIDs lists pending uploads. | AttachmentIDs 列出待挂载上传。
	AttachmentIDs []string `json:"attachment_ids" form:"attachment_ids"`
}

