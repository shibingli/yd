// apiRespondFriend applies accept/reject and writes no content. | apiRespondFriend 应用接受/拒绝并写出无内容响应。
func (c *Controller) apiRespondFriend(ctx *router.Ctx, accept bool) {
	if !c.apiAvailable(ctx) {
		return
	}
	if err := c.messages.RespondFriendRequest(ctx.Request.Context(), c.messageActor(ctx), ctx.Param("id"), accept); err != nil {
		c.apiFail(ctx, err)
		return
	}
	if err := ctx.NoContent(http.StatusNoContent); err != nil {
		c.log.Warn("api friend response failed | API 好友响应失败", log.Err(err))
	}
}

