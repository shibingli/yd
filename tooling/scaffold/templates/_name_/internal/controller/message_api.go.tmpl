// @Description 向另一个活跃租户用户发起待处理申请。
// @Tags friends
// @Accept json
// @Produce json
// @Param body body APIFriendRequest true "request payload | 申请载荷"
// @Success 201 {object} string "created request | 已创建申请"
// @Security BearerAuth
// @Router /api/portal/v1/friends/requests [post]
func (c *Controller) APISendFriendRequest(ctx *router.Ctx) {
	if !c.apiAvailable(ctx) {
		return
	}
	var request APIFriendRequest
	if err := ctx.Bind(&request); err != nil {
		c.apiFail(ctx, messaging.ErrInvalidInput)
		return
	}
	friendRequest, err := c.messages.SendFriendRequest(ctx.Request.Context(), c.messageActor(ctx), request.FriendID, request.Message)
	if err != nil {
		c.apiFail(ctx, err)
		return
	}
	_ = ctx.JSON(http.StatusCreated, friendRequest)
}

