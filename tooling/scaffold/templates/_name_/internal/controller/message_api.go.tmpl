//
// @Summary Save group/label | 保存分组/标签
// @Description Creates a group/label when the body has no id, otherwise updates it.
// @Description 请求体没有 id 时新建分组/标签，否则更新。
// @Tags messages
// @Accept json
// @Produce json
// @Param body body APITagRequest true "tag payload | 标签载荷"
// @Success 200 {object} string "saved tag | 已保存标签"
// @Security BearerAuth
// @Router /api/v1/message-tags [post]
func (c *Controller) APISaveMessageTag(ctx *router.Ctx) {
	if !c.apiAvailable(ctx) {
		return
	}
	var request APITagRequest
	if err := ctx.Bind(&request); err != nil {
		c.apiFail(ctx, messaging.ErrInvalidInput)
		return
	}
	actor := c.messageActor(ctx)
	input := messaging.TagInput{Key: request.Key, Name: request.Name, NameEN: request.NameEN, Tone: request.Tone}
	var (
		item messaging.Tag
		err  error
	)
	if request.ID != "" {
		item, err = c.messages.UpdateTag(ctx.Request.Context(), actor, request.ID, input)
	} else {
		item, err = c.messages.CreateTag(ctx.Request.Context(), actor, messaging.TagKind(request.Kind), input)
	}
	if err != nil {
		c.apiFail(ctx, err)
		return
	}
	_ = ctx.JSON(http.StatusOK, item)
}

