// APIMessageTags lists groups or labels. | APIMessageTags 列出分组或标签。
//
// @Summary List groups/labels | 列出分组/标签
// @Description Returns groups when kind=group, otherwise labels; managers also see archived rows.
// @Description kind=group 时返回分组，否则返回标签；管理员还能看到已归档记录。
// @Tags messages
// @Produce json
// @Param kind query string false "group|tag | 分组或标签"
// @Success 200 {object} string "tag list | 标签列表"
// @Security BearerAuth
// @Router /api/v1/message-tags [get]
func (c *Controller) APIMessageTags(ctx *router.Ctx) {
	if !c.apiAvailable(ctx) {
		return
	}
	actor := c.messageActor(ctx)
	kind := messaging.TagKind(ctx.Query(FieldKind))
	if kind != messaging.TagGroup && kind != messaging.TagLabel {
		kind = messaging.TagLabel
	}
	list, err := c.messages.ListTags(ctx.Request.Context(), actor, kind, actor.TypeManage)
	if err != nil {
		c.apiFail(ctx, err)
		return
	}
	_ = ctx.JSON(http.StatusOK, map[string]any{"tags": list})
}

