// apiAvailable reports availability and writes a JSON error when unavailable. | apiAvailable 报告可用性，不可用时写出 JSON 错误。
func (c *Controller) apiAvailable(ctx *router.Ctx) bool {
	if c.MessagesAvailable() {
		return true
	}
	_ = ctx.JSON(http.StatusServiceUnavailable, map[string]any{
		"error": "message centre is unavailable | 消息中心不可用",
	})
	return false
}

// apiFail maps a domain error onto a JSON response. | apiFail 把领域错误映射为 JSON 响应。
func (c *Controller) apiFail(ctx *router.Ctx, err error) {
	status, message := statusFor(err)
	if status == http.StatusInternalServerError {
		c.log.Error("message API request failed | 消息 API 请求失败", log.Err(err), log.Str("path", ctx.Path()))
		message = msgInternal
	}
	_ = ctx.JSON(status, map[string]any{"error": message})
}

// nowUTC returns the current UTC instant. | nowUTC 返回当前 UTC 时刻。
func nowUTC() time.Time { return time.Now().UTC() }
