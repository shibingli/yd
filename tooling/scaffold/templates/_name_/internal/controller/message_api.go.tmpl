// APISendMessage sends a message. | APISendMessage 发送消息。
//
// @Summary Send message | 发送消息
// @Description Resolves a conversation, direct friend or group, then sends the message.
// @Description 解析会话、单聊好友或群，然后发送消息。
// @Tags messages
// @Accept json
// @Produce json
// @Param body body APISendRequest true "send payload | 发送载荷"
// @Success 201 {object} string "created message | 已创建消息"
// @Security BearerAuth
// @Router /api/portal/v1/messages [post]
func (c *Controller) APISendMessage(ctx *router.Ctx) {
	if !c.apiAvailable(ctx) {
		return
	}
	var request APISendRequest
	if err := ctx.Bind(&request); err != nil {
		c.apiFail(ctx, messaging.ErrInvalidInput)
		return
	}
	actor := c.messageActor(ctx)
	conversationID, err := c.apiConversation(ctx, actor, request)
	if err != nil {
		c.apiFail(ctx, err)
		return
	}
	message, err := c.messages.Send(ctx.Request.Context(), actor, messaging.SendInput{
		ConversationID: conversationID,
		TypeKey:        request.TypeKey,
		Title:          request.Title,
		Markdown:       request.Markdown,
		TagIDs:         request.TagIDs,
		GroupIDs:       request.GroupIDs,
		AttachmentIDs:  request.AttachmentIDs,
	})
	if err != nil {
		c.apiFail(ctx, err)
		return
	}
	_ = ctx.JSON(http.StatusCreated, message)
}

// apiConversation resolves the API send target. | apiConversation 解析 API 发送目标。
func (c *Controller) apiConversation(ctx *router.Ctx, actor messaging.Actor, request APISendRequest) (string, error) {
	if request.ConversationID != "" {
		return request.ConversationID, nil
	}
	recipients := request.GroupMembers
	if request.RecipientID != "" {
		recipients = append(recipients, request.RecipientID)
	}
	switch len(recipients) {
	case 0:
		return "", messaging.ErrInvalidInput
	case 1:
		conversation, err := c.messages.DirectConversation(ctx.Request.Context(), actor, recipients[0])
		if err != nil {
			return "", err
		}
		return conversation.ID, nil
	default:
		title := request.GroupTitle
		if title == "" {
			title = c.tr(c.lang(ctx), "message.group_default_title")
		}
		conversation, err := c.messages.CreateGroup(ctx.Request.Context(), actor, title, recipients)
		if err != nil {
			return "", err
		}
		return conversation.ID, nil
	}
}

