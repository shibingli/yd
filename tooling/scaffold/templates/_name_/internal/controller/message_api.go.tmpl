// APISaveMessageType creates or updates a type. | APISaveMessageType 新建或更新类型。
//
// @Summary Save message type | 保存消息类型
// @Description Creates a type, or updates the type named by the JSON body's key.
// @Description 新建类型，或更新请求体 key 指定的类型。
// @Tags messages
// @Accept json
// @Produce json
// @Param body body APITypeRequest true "type payload | 类型载荷"
// @Success 200 {object} string "saved type | 已保存类型"
// @Security BearerAuth
// @Router /api/v1/message-types [post]
func (c *Controller) APISaveMessageType(ctx *router.Ctx) {
	if !c.apiAvailable(ctx) {
		return
	}
	var request APITypeRequest
	if err := ctx.Bind(&request); err != nil {
		c.apiFail(ctx, messaging.ErrInvalidInput)
		return
	}
	actor := c.messageActor(ctx)
	input := messaging.TypeInput{Key: request.Key, Name: request.Name, NameEN: request.NameEN, Tone: request.Tone}
	var (
		item messaging.MessageType
		err  error
	)
	if c.messagesTypeExists(ctx, request.Key) {
		item, err = c.messages.UpdateType(ctx.Request.Context(), actor, request.Key, input)
	} else {
		item, err = c.messages.CreateType(ctx.Request.Context(), actor, input)
	}
	if err != nil {
		c.apiFail(ctx, err)
		return
	}
	_ = ctx.JSON(http.StatusOK, item)
}

