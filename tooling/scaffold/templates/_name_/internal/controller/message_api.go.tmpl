// APIUploadAttachment uploads one pending file. | APIUploadAttachment 上传一个待挂载文件。
//
// @Summary Upload attachment | 上传附件
// @Description Stores a pending upload with the same size and content-type checks as the HTML form.
// @Description 使用与 HTML 表单相同的大小与内容类型校验保存待挂载上传。
// @Tags messages
// @Accept multipart/form-data
// @Produce json
// @Param file formData file true "attachment | 附件"
// @Success 201 {object} string "attachment record | 附件记录"
// @Security BearerAuth
// @Router /api/portal/v1/messages/attachments [post]
func (c *Controller) APIUploadAttachment(ctx *router.Ctx) {
	if !c.apiAvailable(ctx) {
		return
	}
	file, header, err := ctx.FormFile("file")
	if err != nil {
		c.apiFail(ctx, messaging.ErrInvalidInput)
		return
	}
	defer func() { _ = file.Close() }()
	attachment, err := c.messages.UploadAttachment(ctx.Request.Context(), c.messageActor(ctx), header.Filename, header.Size, file)
	if err != nil {
		c.apiFail(ctx, err)
		return
	}
	_ = ctx.JSON(http.StatusCreated, attachment)
}

