// newDictionaryItemDrawer renders an item drawer for one scope. | newDictionaryItemDrawer 渲染一个范围的字典项抽屉。
func (c *Controller) newDictionaryItemDrawer(ctx *router.Ctx, system bool) {
	if !c.DictionariesAvailable() {
		c.dictionaryUnavailable(ctx)
		return
	}
	tenantID, basePath, scope, _, ok := c.dictionaryMutationTarget(ctx, system)
	if !ok {
		return
	}
	current, err := c.dictionaries.GetType(ctx.Request.Context(), tenantID, ctx.Param("id"))
	if err != nil {
		c.failService(ctx, err)
		return
	}
	title := "新建字典项 | New dictionary item"
	if system {
		title = "新建系统字典项 | New system dictionary item"
	}
	c.render(ctx, http.StatusOK, TplDictionaryItemDrawer, c.pageView(ctx, title, map[string]any{
		"Mode":      "create",
		"BasePath":  basePath,
		"Scope":     string(scope),
		"TypeID":    current.ID,
		"TypeCode":  current.Code,
		"TypeLabel": dictionaryTypeViews([]dictionary.Type{current}, c.lang(ctx))[0].Label,
		"Item":      dictionaryItemView{Status: string(dictionary.StatusEnabled)},
	}))
}

// editDictionaryItemDrawer renders an item drawer for one scope. | editDictionaryItemDrawer 渲染一个范围的字典项抽屉。
func (c *Controller) editDictionaryItemDrawer(ctx *router.Ctx, system bool) {
	if !c.DictionariesAvailable() {
		c.dictionaryUnavailable(ctx)
		return
	}
	tenantID, basePath, scope, _, ok := c.dictionaryMutationTarget(ctx, system)
	if !ok {
		return
	}
	current, err := c.dictionaries.GetType(ctx.Request.Context(), tenantID, ctx.Param("id"))
	if err != nil {
		c.failService(ctx, err)
		return
	}
	item, err := c.dictionaries.GetItem(ctx.Request.Context(), tenantID, current.ID, ctx.Param("item_id"))
	if err != nil {
		c.failService(ctx, err)
		return
	}
	title := "编辑字典项 | Edit dictionary item"
	if system {
		title = "编辑系统字典项 | Edit system dictionary item"
	}
	c.render(ctx, http.StatusOK, TplDictionaryItemDrawer, c.pageView(ctx, title, map[string]any{
		"Mode":      "edit",
		"BasePath":  basePath,
		"Scope":     string(scope),
		"TypeID":    current.ID,
		"TypeCode":  current.Code,
		"TypeLabel": dictionaryTypeViews([]dictionary.Type{current}, c.lang(ctx))[0].Label,
		"Item":      dictionaryItemViews([]dictionary.Item{item}, c.lang(ctx))[0],
	}))
}

// saveDictionaryItem creates or updates one item in either scope. | saveDictionaryItem 在任一范围新建或更新字典项。
func (c *Controller) saveDictionaryItem(ctx *router.Ctx, system bool) {
	if !c.DictionariesAvailable() {
		c.dictionaryUnavailable(ctx)
		return
	}
	tenantID, basePath, scope, canManage, ok := c.dictionaryMutationTarget(ctx, system)
	if !ok {
		return
	}
	typeID := ctx.Param("id")
	input := dictionary.ItemInput{
		Value:   field(ctx, FieldDictionaryValue),
		Label:   dictionaryLongField(ctx, FieldDictionaryLabel, 512),
		LabelEN: dictionaryLongField(ctx, FieldDictionaryLabelEN, 512),
		Extra:   dictionaryLongField(ctx, FieldDictionaryExtra, 4096),
		Remark:  dictionaryLongField(ctx, FieldRemark, 2048),
		Status:  dictionary.Status(field(ctx, FieldStatus)),
		Default: field(ctx, FieldDictionaryDefault) != "",
		Sort:    formInt(ctx, FieldDictionarySort),
	}
	itemID := strings.TrimSpace(field(ctx, FieldDictionaryID))
	var (
		saved dictionary.Item
		err   error
	)
	if itemID == "" {
		saved, err = c.dictionaries.CreateItem(ctx.Request.Context(), tenantID, typeID, input)
	} else {
		saved, err = c.dictionaries.UpdateItem(ctx.Request.Context(), tenantID, typeID, itemID, input)
	}
	if err != nil {
		c.failService(ctx, err)
		return
	}
	c.log.Info("dictionary item saved | 数据字典项已保存",
		log.Str("type", saved.TypeID),
		log.Str("id", saved.ID),
		log.Str("value", saved.Value),
		log.Str("scope", string(scope)),
		log.Str("status", string(saved.Status)),
	)
	c.toast(ctx, "字典项已保存 | dictionary item saved")
	c.respondDictionaryPage(ctx, tenantID, typeID, basePath, scope, canManage)
}

// setDictionaryItemStatus flips one item in either scope. | setDictionaryItemStatus 切换任一范围的字典项状态。
func (c *Controller) setDictionaryItemStatus(ctx *router.Ctx, system bool) {
	if !c.DictionariesAvailable() {
		c.dictionaryUnavailable(ctx)
		return
	}
	tenantID, basePath, scope, canManage, ok := c.dictionaryMutationTarget(ctx, system)
	if !ok {
		return
	}
	updated, err := c.dictionaries.SetItemStatus(ctx.Request.Context(), tenantID, ctx.Param("id"), ctx.Param("item_id"), dictionary.Status(field(ctx, FieldStatus)))
	if err != nil {
		c.failService(ctx, err)
		return
	}
	c.log.Info("dictionary item status updated | 数据字典项状态已更新",
		log.Str("type", updated.TypeID),
		log.Str("id", updated.ID),
		log.Str("scope", string(scope)),
		log.Str("status", string(updated.Status)),
	)
	c.toast(ctx, "字典项状态已更新 | dictionary item status updated")
	c.respondDictionaryPage(ctx, tenantID, ctx.Param("id"), basePath, scope, canManage)
}

// deleteDictionaryItem removes one item in either scope. | deleteDictionaryItem 删除任一范围的字典项。
func (c *Controller) deleteDictionaryItem(ctx *router.Ctx, system bool) {
	if !c.DictionariesAvailable() {
		c.dictionaryUnavailable(ctx)
		return
	}
	tenantID, basePath, scope, canManage, ok := c.dictionaryMutationTarget(ctx, system)
	if !ok {
		return
	}
	if err := c.dictionaries.DeleteItem(ctx.Request.Context(), tenantID, ctx.Param("id"), ctx.Param("item_id")); err != nil {
		c.failService(ctx, err)
		return
	}
	c.log.Info("dictionary item deleted | 数据字典项已删除",
		log.Str("type", ctx.Param("id")),
		log.Str("id", ctx.Param("item_id")),
		log.Str("scope", string(scope)),
	)
	c.toast(ctx, "字典项已删除 | dictionary item deleted")
	c.respondDictionaryPage(ctx, tenantID, ctx.Param("id"), basePath, scope, canManage)
}
