// APICreateSystemDictionaryItem creates a system item. | APICreateSystemDictionaryItem 新建一个系统字典项。
//
// @Summary Create a system dictionary item | 新建系统字典项
// @Description Creates a system-wide item; the value must be unique inside the type. |
// @Description 新建系统级字典项；机器值在类型内必须唯一。
// @Tags system-dictionaries
// @Accept json
// @Produce json
// @Param id path string true "type id | 类型 ID"
// @Param body body dictionaryItemRequest true "item payload | 字典项载荷"
// @Success 201 {object} dictionaryItemView "created item | 已创建字典项"
// @Failure 403 {object} string "not the system tenant | 不是系统租户"
// @Failure 409 {object} string "duplicate value | 值重复"
// @Failure 422 {object} string "validation failed | 校验失败"
