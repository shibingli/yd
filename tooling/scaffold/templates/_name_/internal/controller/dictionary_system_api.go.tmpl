func (c *Controller) APICreateSystemDictionaryItem(ctx *router.Ctx) {
	if !c.dictionaryAPIAvailable(ctx) {
		return
	}
	tenantID, ok := c.apiDictionaryWriteTenant(ctx, true)
	if !ok {
		return
	}
	var request dictionaryItemRequest
	if err := ctx.Bind(&request); err != nil {
		c.dictionaryAPIFail(ctx, dictionary.ErrInvalidInput)
		return
	}
	input, err := dictionaryItemInput(request)
	if err != nil {
		c.dictionaryAPIFail(ctx, err)
		return
	}
	created, err := c.dictionaries.CreateItem(ctx.Request.Context(), tenantID, ctx.Param("id"), input)
	if err != nil {
		c.dictionaryAPIFail(ctx, err)
