// APISystemDictionaries lists system-wide dictionary types. | APISystemDictionaries 列出系统级字典类型。
//
// @Summary List system dictionary types | 列出系统字典类型
// @Description Returns one page of system-wide types. Every tenant may read the layer. |
// @Description 返回一页系统级类型。所有租户都可读取该层。
// @Tags system-dictionaries
// @Produce json
// @Param q query string false "search keyword | 搜索关键字"
// @Param status query string false "enabled|disabled | 启停状态"
// @Param page query int false "1-based page | 从 1 开始的页码"
// @Param page_size query int false "page length | 页长"
// @Success 200 {object} string "system type page | 系统类型分页"
// @Failure 403 {object} string "dictionary:read required | 需要 dictionary:read"
// @Failure 503 {object} string "dictionary storage unavailable | 数据字典存储不可用"
// @Security BearerAuth
// @Router /api/v1/system-dictionaries [get]
func (c *Controller) APISystemDictionaries(ctx *router.Ctx) {
	if !c.dictionaryAPIAvailable(ctx) {
		return
	}
	tenantID, ok := c.apiDictionaryReadTenant(ctx, true)
	if !ok {
		return
	}
	page, err := c.dictionaries.ListTypes(ctx.Request.Context(), tenantID, dictionary.Filter{
		Query:    strings.TrimSpace(ctx.Query(FieldKeyword)),
		Status:   dictionary.Status(strings.TrimSpace(ctx.Query(FieldStatus))),
		Page:     queryInt(ctx, "page", 1),
		PageSize: queryInt(ctx, "page_size", defaultPageSize),
	})
	if err != nil {
		c.dictionaryAPIFail(ctx, err)
		return
	}
	_ = ctx.JSON(http.StatusOK, map[string]any{
		"items":     dictionaryTypeViews(page.Items, c.lang(ctx)),
		"total":     page.Total,
		"page":      page.Page,
		"page_size": page.PageSize,
	})
}

// APISystemDictionary returns one system type and its items. | APISystemDictionary 返回一个系统类型及其字典项。
//
// @Summary Read a system dictionary type | 读取系统字典类型
// @Description Returns one system-wide type and one page of its items. Disabled items are included
// @Description by default; pass include_disabled=false for enabled items only.
// @Description 返回一个系统级类型及其一页字典项。默认包含停用项；传 include_disabled=false 只返回启用项。
// @Tags system-dictionaries
// @Produce json
// @Param id path string true "type id | 类型 ID"
// @Param include_disabled query bool false "false returns enabled items only | 传 false 只返回启用项"
// @Param page query int false "1-based item page | 从 1 开始的字典项页码"
// @Param page_size query int false "item page length | 字典项页长"
// @Success 200 {object} string "type and items | 类型与字典项"
// @Failure 403 {object} string "dictionary:read required | 需要 dictionary:read"
// @Failure 404 {object} string "type not found | 类型不存在"
// @Security BearerAuth
// @Router /api/v1/system-dictionaries/{id} [get]
func (c *Controller) APISystemDictionary(ctx *router.Ctx) {
	if !c.dictionaryAPIAvailable(ctx) {
		return
	}
	tenantID, ok := c.apiDictionaryReadTenant(ctx, true)
	if !ok {
		return
	}
	current, err := c.dictionaries.GetType(ctx.Request.Context(), tenantID, ctx.Param("id"))
	if err != nil {
		c.dictionaryAPIFail(ctx, err)
		return
	}
	status := dictionary.Status("")
	if strings.EqualFold(strings.TrimSpace(ctx.Query("include_disabled")), "false") {
		status = dictionary.StatusEnabled
	}
	page, err := c.dictionaries.ListItems(ctx.Request.Context(), tenantID, current.ID, dictionary.ItemFilter{
		Status:   status,
		Page:     queryInt(ctx, "page", 1),
		PageSize: queryInt(ctx, "page_size", defaultPageSize),
	})
	if err != nil {
		c.dictionaryAPIFail(ctx, err)
		return
	}
	_ = ctx.JSON(http.StatusOK, map[string]any{
		"type":      dictionaryTypeViews([]dictionary.Type{current}, c.lang(ctx))[0],
		"items":     dictionaryItemViews(page.Items, c.lang(ctx)),
		"total":     page.Total,
		"page":      page.Page,
		"page_size": page.PageSize,
	})
}

// APICreateSystemDictionary creates a system type. | APICreateSystemDictionary 新建一个系统类型。
//
// @Summary Create a system dictionary type | 新建系统字典类型
// @Description Creates a system-wide type from the configured system tenant. | 从配置的系统租户新建系统级类型。
// @Tags system-dictionaries
// @Accept json
// @Produce json
// @Param body body dictionaryTypeRequest true "type payload | 类型载荷"
// @Success 201 {object} dictionaryTypeView "created type | 已创建类型"
// @Failure 403 {object} string "not the system tenant | 不是系统租户"
// @Failure 409 {object} string "duplicate code | 编码重复"
// @Failure 422 {object} string "validation failed | 校验失败"
// @Security BearerAuth
// @Router /api/v1/system-dictionaries [post]
func (c *Controller) APICreateSystemDictionary(ctx *router.Ctx) {
	if !c.dictionaryAPIAvailable(ctx) {
		return
	}
	tenantID, ok := c.apiDictionaryWriteTenant(ctx, true)
	if !ok {
		return
	}
	var request dictionaryTypeRequest
	if err := ctx.Bind(&request); err != nil {
		c.dictionaryAPIFail(ctx, dictionary.ErrInvalidInput)
		return
	}
	created, err := c.dictionaries.CreateType(ctx.Request.Context(), tenantID, dictionaryTypeInput(request))
	if err != nil {
		c.dictionaryAPIFail(ctx, err)
		return
	}
	c.log.Info("system dictionary type created | 系统数据字典类型已创建",
		log.Str("id", created.ID),
		log.Str("code", created.Code),
	)
	_ = ctx.JSON(http.StatusCreated, dictionaryTypeViews([]dictionary.Type{created}, c.lang(ctx))[0])
}

