// APIDeleteSystemDictionary deletes a system type and its items. | APIDeleteSystemDictionary
// 删除一个系统类型及其字典项。
//
// @Summary Delete a system dictionary type | 删除系统字典类型
// @Description Deletes one non-builtin system-wide type and every item it owns. |
// @Description 删除一个非内置系统级类型及其全部字典项。
// @Tags system-dictionaries
// @Produce json
// @Param id path string true "type id | 类型 ID"
// @Success 204 {string} string "no content | 无内容"
// @Failure 403 {object} string "not the system tenant | 不是系统租户"
// @Failure 409 {object} string "built-in dictionary | 内置字典"
// @Security BearerAuth
// @Router /api/v1/system-dictionaries/{id} [delete]
func (c *Controller) APIDeleteSystemDictionary(ctx *router.Ctx) {
	if !c.dictionaryAPIAvailable(ctx) {
		return
	}
	tenantID, ok := c.apiDictionaryWriteTenant(ctx, true)
	if !ok {
		return
	}
	if err := c.dictionaries.DeleteType(ctx.Request.Context(), tenantID, ctx.Param("id")); err != nil {
		c.dictionaryAPIFail(ctx, err)
		return
	}
	c.log.Info("system dictionary type deleted | 系统数据字典类型已删除", log.Str("id", ctx.Param("id")))
	if err := ctx.NoContent(http.StatusNoContent); err != nil {
		c.log.Warn("system dictionary API delete response failed | 系统数据字典 API 删除响应失败", log.Err(err))
	}
}

