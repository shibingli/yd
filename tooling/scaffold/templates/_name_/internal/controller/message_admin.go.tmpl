// @Success 200 {object} string "drawer fragment | 抽屉片段"
// @Security BearerAuth
// @Router /mgr/message-settings/types/{key}/edit [get]
func (c *Controller) EditMessageTypeDrawer(ctx *router.Ctx) {
	if !c.MessagesAvailable() {
		c.messageUnavailable(ctx)
		return
	}
	types, err := c.messages.ListTypes(ctx.Request.Context(), c.messageActor(ctx), true)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	var item *messaging.MessageType
