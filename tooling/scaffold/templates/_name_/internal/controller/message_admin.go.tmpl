// pageQuery parses the page query parameter. | pageQuery 解析 page 查询参数。
func pageQuery(ctx *router.Ctx) int {
	value := strings.TrimSpace(ctx.Query("page"))
	if value == "" {
		return 1
	}
	page := 0
	for _, r := range value {
		if r < '0' || r > '9' {
			return 1
		}
		page = page*10 + int(r-'0')
		if page > 100000 {
			return 100000
		}
	}
	if page < 1 {
		return 1
	}
	return page
}

