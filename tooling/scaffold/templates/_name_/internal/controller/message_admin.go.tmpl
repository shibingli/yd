// settingsData loads the catalogue page. | settingsData 加载目录页面数据。
func (c *Controller) settingsData(ctx *router.Ctx) (map[string]any, error) {
	actor := c.messageActor(ctx)
	lang := c.lang(ctx)
	includeArchived := authz.Can(ctx.Request.Context(), authz.PermMessageTypeManage)
	types, err := c.messages.ListTypes(ctx.Request.Context(), actor, includeArchived)
	if err != nil {
		return nil, err
	}
	groups, err := c.messages.ListTags(ctx.Request.Context(), actor, messaging.TagGroup, includeArchived)
	if err != nil {
		return nil, err
	}
	tags, err := c.messages.ListTags(ctx.Request.Context(), actor, messaging.TagLabel, includeArchived)
	if err != nil {
		return nil, err
	}
	return c.view(ctx, "消息目录 | Message catalogue", map[string]any{
		"Types":         messageTypeViewsOf(types, lang),
		"Groups":        tagViewsOf(groups, lang),
		"Tags":          tagViewsOf(tags, lang),
		"CanTypeManage": authz.Can(ctx.Request.Context(), authz.PermMessageTypeManage),
	}), nil
}

