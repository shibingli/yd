	c.render(ctx, http.StatusOK, TplMessageTypeDrawer, c.view(ctx, "编辑消息类型 | Edit message type", map[string]any{
		"Mode": "edit",
		"Item": messageTypeViewsOf([]messaging.MessageType{*item}, c.lang(ctx))[0],
	}))
}

// SaveMessageType creates or updates a type. | SaveMessageType 新建或更新类型。
//
// @Summary Save type | 保存类型
// @Description Creates a type when the key is absent, otherwise updates its labels and tone.
// @Description 键不存在时新建类型，否则更新其标签与语义色。
// @Tags messages
// @Accept html
// @Produce html
// @Param key formData string true "type key | 类型键"
// @Param name formData string true "Chinese label | 中文名"
// @Param name_en formData string true "English label | 英文名"
// @Param tone formData string false "neutral|info|success|warn|danger | 语义色"
// @Success 200 {object} string "refreshed settings fragment | 刷新后的设置片段"
// @Security BearerAuth
// @Router /mgr/message-settings/types [post]
func (c *Controller) SaveMessageType(ctx *router.Ctx) {
	if !c.MessagesAvailable() {
		c.messageUnavailable(ctx)
		return
	}
	actor := c.messageActor(ctx)
	input := messaging.TypeInput{
		Key:    field(ctx, FieldKey),
		Name:   field(ctx, FieldName),
		NameEN: field(ctx, FieldNameEN),
		Tone:   field(ctx, FieldTone),
	}
	var err error
	if c.messagesTypeExists(ctx, input.Key) {
		_, err = c.messages.UpdateType(ctx.Request.Context(), actor, input.Key, input)
	} else {
		_, err = c.messages.CreateType(ctx.Request.Context(), actor, input)
	}
	if err != nil {
		c.failService(ctx, err)
		return
	}
	c.toast(ctx, "类型已保存 | type saved")
	data, err := c.settingsData(ctx)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	c.render(ctx, http.StatusOK, TplMessageSettingsBody, data)
}

// messagesTypeExists reports whether a type key is already present. | messagesTypeExists 报告类型键是否已存在。
func (c *Controller) messagesTypeExists(ctx *router.Ctx, key string) bool {
	if strings.TrimSpace(key) == "" {
		return false
	}
	types, err := c.messages.ListTypes(ctx.Request.Context(), c.messageActor(ctx), true)
	if err != nil {
		return false
	}
	for _, item := range types {
		if item.Key == strings.ToLower(strings.TrimSpace(key)) {
			return true
		}
	}
	return false
}

