// renderAdminPage builds the moderation page with a notice. | renderAdminPage 构建带提示的治理页面。
func (c *Controller) renderAdminPage(ctx *router.Ctx, notice string) {
	actor := c.messageActor(ctx)
	lang := c.lang(ctx)
	filters := parseMessageFilters(ctx)
	result, err := c.messages.Messages(ctx.Request.Context(), actor, messaging.MessageFilter{
		Query:    filters.Query,
		TypeKey:  filters.TypeKey,
		SenderID: filters.SenderID,
		TagID:    filters.TagID,
		Folder:   filters.Folder,
		Page:     filters.Page,
		PageSize: c.messages.Options().PageSize,
	})
	if err != nil {
		c.failService(ctx, err)
		return
	}
	audit, auditTotal, err := c.messages.Audit(ctx.Request.Context(), actor, messaging.AuditFilter{
		Page:     1,
		PageSize: c.messages.Options().PageSize,
	})
	if err != nil {
		c.failService(ctx, err)
		return
	}
	page := messagePage{
		Filters:       filters,
		Results:       c.adminMessageViewsOf(actor, result.Messages, lang, nowUTC()),
		Total:         result.Total,
		CanManage:     true,
		CanSystem:     authz.Can(ctx.Request.Context(), authz.PermMessageSystem),
		CanTypeManage: authz.Can(ctx.Request.Context(), authz.PermMessageTypeManage),
		UserID:        actor.ID,
	}
	data := c.view(ctx, "消息治理 | Message moderation", page.data())
	data["AdminMode"] = true
	data["Audit"] = auditViewsOf(audit)
	data["AuditTotal"] = auditTotal
	if notice != "" {
		c.toast(ctx, notice)
	}
	c.render(ctx, http.StatusOK, TplMessageAudit, data)
}

// renderAuditPage builds the audit-focused page. | renderAuditPage 构建以审计为中心的页面。
func (c *Controller) renderAuditPage(ctx *router.Ctx, notice string) {
	actor := c.messageActor(ctx)
	filter := messaging.AuditFilter{
		Action:    strings.TrimSpace(ctx.Query("action")),
		MessageID: strings.TrimSpace(ctx.Query("message_id")),
		Page:      pageQuery(ctx),
		PageSize:  c.messages.Options().PageSize,
	}
	audit, total, err := c.messages.Audit(ctx.Request.Context(), actor, filter)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	data := c.view(ctx, "消息审计 | Message audit", map[string]any{
		"Audit":      auditViewsOf(audit),
		"AuditTotal": total,
		"AuditMode":  true,
		"Filter":     filter,
		"CanManage":  true,
		"ActorID":    actor.ID,
	})
	if notice != "" {
		c.toast(ctx, notice)
	}
	c.render(ctx, http.StatusOK, TplMessageAudit, data)
}

