// SaveMessageTag creates or updates a group or label. | SaveMessageTag 新建或更新分组或标签。
//
// @Summary Save group/label | 保存分组/标签
// @Description Creates a group/label when the id is absent, otherwise updates its labels and tone.
// @Description ID 不存在时新建分组/标签，否则更新其标签与语义色。
// @Tags messages
// @Accept html
// @Produce html
// @Param id formData string false "existing tag id | 既有标签 ID"
// @Param kind formData string true "group|tag | 分组或标签"
// @Param key formData string true "stable slug | 稳定标识"
// @Param name formData string true "Chinese label | 中文名"
// @Param name_en formData string true "English label | 英文名"
// @Param tone formData string false "semantic tone | 语义色"
// @Success 200 {object} string "refreshed settings fragment | 刷新后的设置片段"
// @Security BearerAuth
// @Router /mgr/message-settings/tags [post]
func (c *Controller) SaveMessageTag(ctx *router.Ctx) {
	if !c.MessagesAvailable() {
		c.messageUnavailable(ctx)
		return
	}
	actor := c.messageActor(ctx)
	input := messaging.TagInput{
		Key:    field(ctx, FieldKey),
		Name:   field(ctx, FieldName),
		NameEN: field(ctx, FieldNameEN),
		Tone:   field(ctx, FieldTone),
	}
	id := field(ctx, "id")
	var err error
	if id != "" {
		_, err = c.messages.UpdateTag(ctx.Request.Context(), actor, id, input)
	} else {
		kind := messaging.TagKind(field(ctx, FieldKind))
		_, err = c.messages.CreateTag(ctx.Request.Context(), actor, kind, input)
	}
	if err != nil {
		c.failService(ctx, err)
		return
	}
