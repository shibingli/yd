// readCMSUpload reads one multipart file within the configured ceiling. | readCMSUpload 在配置上限内读取一个 multipart 文件。
func (c *Controller) readCMSUpload(ctx *router.Ctx) (cms.MediaInput, error) {
	// ctx.FormFile 由路由器统一施加 MaxBodySize；直接调用 Request.FormFile 会绕过请求体上限，
	// 让一个超大 multipart 在解析阶段就吃掉内存或磁盘。 |
	// ctx.FormFile applies the router's MaxBodySize; calling Request.FormFile directly would bypass the request-body
	// limit and let one oversized multipart body consume memory or disk during parsing.
	file, header, err := ctx.FormFile("file")
	if err != nil {
		if errors.Is(err, router.ErrBodyTooLarge) {
			return cms.MediaInput{}, err
		}
		return cms.MediaInput{}, cms.ErrInvalidInput
	}
	defer func() { _ = file.Close() }()
	limit := c.cms.Options().MaxMediaSize
	if limit <= 0 {
		limit = 32 << 20
	}
	data, err := io.ReadAll(io.LimitReader(file, limit+1))
	if err != nil {
		return cms.MediaInput{}, cms.ErrInvalidInput
	}
	if int64(len(data)) > limit {
		return cms.MediaInput{}, cms.ErrMediaTooLarge
	}
	return cms.MediaInput{
		OriginalName: header.Filename,
		ContentType:  header.Header.Get("Content-Type"),
		Alt:          ctx.FormValue("alt"),
		Data:         data,
	}, nil
}

