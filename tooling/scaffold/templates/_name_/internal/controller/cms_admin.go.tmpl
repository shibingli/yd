// saveCMSArticle is the shared create/update implementation. | saveCMSArticle 是创建/更新的共同实现。
func (c *Controller) saveCMSArticle(ctx *router.Ctx) {
	tenantID, ok := c.tenantID(ctx)
	if !ok || !c.cmsAvailable(ctx) || !c.cmsEnsure(ctx, tenantID) {
		return
	}
	actor := c.cmsActor(ctx)
	input := cmsArticleInput(ctx)
	article, err := c.cms.SaveArticle(ctx.Request.Context(), actor, input)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	c.log.Info("CMS article saved | CMS 文章已保存", logx.Str("tenant", tenantID), logx.Str("article", article.ID))
	c.redirect(ctx, "/mgr/cms/articles/"+article.ID+"/edit")
}

// CMSTransitionArticle applies one editorial action. | CMSTransitionArticle 应用一次编辑动作。
//
// @Summary Article transition | 文章状态转换
// @Description Submit, approve, reject, publish, schedule, unpublish, archive and restore. | 提交审核、通过、驳回、发布、定时、下线、归档与恢复。
// @Tags cms
// @Accept x-www-form-urlencoded
// @Produce html
// @Param id path string true "article id | 文章 ID"
// @Param action formData string true "action | 动作"
// @Param publish_at formData string false "scheduled publish time | 定时发布时间"
// @Success 200 {object} map[string]any "editor | 编辑器"
// @Success 303 {object} string "redirect after success (non-htmx requests) | 成功后重定向（非 htmx 请求）"
// @Failure 403 {string} string "forbidden | 无权限"
// @Failure 409 {string} string "transition refused | 状态不允许"
// @Security BearerAuth
// @Router /mgr/cms/articles/{id}/transition [post]
func (c *Controller) CMSTransitionArticle(ctx *router.Ctx) {
	tenantID, ok := c.tenantID(ctx)
	if !ok || !c.cmsAvailable(ctx) || !c.cmsEnsure(ctx, tenantID) {
		return
	}
	action, at, err := cmsTransition(ctx)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	article, err := c.cms.TransitionArticle(ctx.Request.Context(), c.cmsActor(ctx), ctx.Param("id"), action, at)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	c.toast(ctx, c.tr(c.lang(ctx), "cms.notice.transition"))
	c.redirect(ctx, "/mgr/cms/articles/"+article.ID+"/edit")
}

