// saveCMSCategory is the shared category create/update implementation. | saveCMSCategory 是分类创建/更新的共同实现。
func (c *Controller) saveCMSCategory(ctx *router.Ctx, update bool) {
	tenantID, ok := c.tenantID(ctx)
	if !ok || !c.cmsAvailable(ctx) || !c.cmsEnsure(ctx, tenantID) {
		return
	}
	input := cms.CategoryInput{
		Name:        ctx.FormValue("name"),
		Slug:        ctx.FormValue("slug"),
		Description: ctx.FormValue("description"),
		ParentID:    ctx.FormValue("parent_id"),
		Visible:     cmsChecked(ctx, "visible"),
	}
	sortOrder, _ := strconv.Atoi(strings.TrimSpace(ctx.FormValue("sort_order")))
	input.SortOrder = sortOrder
	var err error
	if update {
		_, err = c.cms.UpdateCategory(ctx.Request.Context(), c.cmsActor(ctx), ctx.Param("id"), input)
	} else {
		_, err = c.cms.CreateCategory(ctx.Request.Context(), c.cmsActor(ctx), input)
	}
	if err != nil {
		c.failService(ctx, err)
		return
	}
	c.toast(ctx, c.tr(c.lang(ctx), "cms.notice.saved"))
	c.redirect(ctx, "/mgr/cms/categories")
}

