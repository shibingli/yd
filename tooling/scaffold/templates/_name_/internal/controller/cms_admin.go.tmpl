// CMSDashboard renders the management overview. | CMSDashboard 渲染管理概览。
//
// @Summary CMS overview | CMS 概览
// @Description Shows article status, categories, tags, media and pending comments. | 展示文章状态、分类、标签、媒体与待审评论的聚合。
// @Tags cms
// @Produce html
// @Success 200 {object} map[string]any "overview page | 概览页"
// @Success 303 {string} string "members without the tenant-wide view are redirected to the article list | 无全租户视图的成员被重定向到文章列表"
// @Failure 503 {string} string "CMS unavailable | 内容管理不可用"
// @Security BearerAuth
// @Router /mgr/cms [get]
func (c *Controller) CMSDashboard(ctx *router.Ctx) {
	tenantID, ok := c.tenantID(ctx)
	if !ok || !c.cmsAvailable(ctx) || !c.cmsEnsure(ctx, tenantID) {
		return
	}
	if !c.cmsReadAll(ctx) {
		c.redirect(ctx, "/mgr/cms/articles")
		return
	}
	actor := c.cmsActor(ctx)
	counts, err := c.cms.Dashboard(ctx.Request.Context(), tenantID)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	categories, err := c.cms.CategoryOptions(ctx.Request.Context(), tenantID, "")
	if err != nil {
		c.failService(ctx, err)
		return
	}
	tags, err := c.cms.Tags(ctx.Request.Context(), tenantID, "")
	if err != nil {
		c.failService(ctx, err)
		return
	}
	data := c.cmsPageData(ctx, c.tr(c.lang(ctx), "cms.title.dashboard"), map[string]any{
		"Stats":      counts,
		"Articles":   cmsArticleRows(counts.Recent, actor),
		"Comments":   model.NewCMSComments(counts.RecentComments, actor.ID, actor.Moderate),
		"Categories": categories,
		"Tags":       tags,
	})
	c.render(ctx, http.StatusOK, TplCMSDashboard, data)
}

// CMSArticles renders the article management page and its htmx fragments. | CMSArticles 渲染文章管理页及其 htmx 片段。
//
// @Summary Article management | 文章管理
// @Description Filters articles by keyword, status, kind, category and tag; htmx requests receive the same fragment. | 按关键字、状态、类型、分类与标签筛选文章；htmx 请求返回同一片段。
// @Tags cms
// @Produce html
// @Param q query string false "keyword | 关键字"
// @Param status query string false "status | 状态"
// @Param kind query string false "kind | 类型"
// @Param category query string false "category id | 分类 ID"
// @Param tag query string false "tag id | 标签 ID"
// @Param page query int false "page | 页码"
// @Success 200 {object} map[string]any "article list | 文章列表"
// @Failure 503 {string} string "CMS unavailable | 内容管理不可用"
// @Security BearerAuth
// @Router /mgr/cms/articles [get]
func (c *Controller) CMSArticles(ctx *router.Ctx) {
	tenantID, ok := c.tenantID(ctx)
	if !ok || !c.cmsAvailable(ctx) || !c.cmsEnsure(ctx, tenantID) {
		return
	}
	actor := c.cmsActor(ctx)
	filter := cmsArticleFilter(ctx)
	filter.PageSize = c.cms.Options().PageSize
	if !c.cmsReadAll(ctx) {
		filter.AuthorID = actor.ID
	}
	page, err := c.cms.Articles(ctx.Request.Context(), tenantID, filter)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	categories, err := c.cms.CategoryOptions(ctx.Request.Context(), tenantID, "")
	if err != nil {
		c.failService(ctx, err)
		return
	}
	tags, err := c.cms.Tags(ctx.Request.Context(), tenantID, "")
	if err != nil {
		c.failService(ctx, err)
		return
	}
	data := c.cmsPageData(ctx, c.tr(c.lang(ctx), "cms.title.articles"), map[string]any{
		"Articles":   cmsArticleRows(page.Items, actor),
		"Total":      page.Total,
		"Page":       page.Page,
		"TotalPages": page.TotalPages,
		"Empty":      len(page.Items) == 0,
		"Keyword":    filter.Keyword,
		"Status":     string(filter.Status),
		"Kind":       string(filter.Kind),
		"Category":   filter.CategoryID,
		"Tag":        filter.TagID,
		"Categories": categories,
		"Tags":       tags,
		"Pager":      newCMSPager(cmsPageBase(ctx), page.Page, page.TotalPages),
	})
	c.render(ctx, http.StatusOK, TplCMSArticles, data)
}

// CMSNewArticle renders an empty editor. | CMSNewArticle 渲染空白编辑器。
//
// @Summary New article | 新建文章
// @Description Returns the article/page editor. | 返回文章/单页编辑器。
// @Tags cms
// @Produce html
// @Success 200 {object} map[string]any "editor | 编辑器"
// @Security BearerAuth
// @Router /mgr/cms/articles/new [get]
func (c *Controller) CMSNewArticle(ctx *router.Ctx) {
	tenantID, ok := c.tenantID(ctx)
	if !ok || !c.cmsAvailable(ctx) || !c.cmsEnsure(ctx, tenantID) {
		return
	}
	blank := cms.ArticleView{}
	blank.AllowComment = true
	blank.Visibility = cms.VisibilityPublic
	blank.Kind = cms.KindPost
	data, ok := c.cmsEditorData(ctx, tenantID, blank, "create", "/mgr/cms/articles")
	if !ok {
		return
	}
	c.render(ctx, http.StatusOK, TplCMSArticleEdit, data)
}

// CMSEditArticle renders the editor for one article. | CMSEditArticle 渲染一篇文章的编辑器。
//
// @Summary Edit article | 编辑文章
// @Description Returns the editor with current content and revision history. | 返回带当前内容与修订历史的编辑器。
// @Tags cms
// @Produce html
// @Param id path string true "article id | 文章 ID"
// @Success 200 {object} map[string]any "editor | 编辑器"
// @Failure 404 {string} string "article not found | 文章不存在"
// @Security BearerAuth
// @Router /mgr/cms/articles/{id}/edit [get]
func (c *Controller) CMSEditArticle(ctx *router.Ctx) {
	tenantID, ok := c.tenantID(ctx)
	if !ok || !c.cmsAvailable(ctx) || !c.cmsEnsure(ctx, tenantID) {
		return
	}
	article, err := c.cms.Article(ctx.Request.Context(), tenantID, ctx.Param("id"), false)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	if !c.cmsReadAll(ctx) && article.AuthorID != c.cmsActor(ctx).ID {
		c.failService(ctx, cms.ErrArticleNotFound)
		return
	}
	data, ok := c.cmsEditorData(ctx, tenantID, article, "edit", "/mgr/cms/articles/"+article.ID)
	if !ok {
		return
	}
	c.render(ctx, http.StatusOK, TplCMSArticleEdit, data)
}

// cmsEditorData assembles the editor view. | cmsEditorData 装配编辑器视图。
func (c *Controller) cmsEditorData(ctx *router.Ctx, tenantID string, article cms.ArticleView, mode, action string) (map[string]any, bool) {
	categories, err := c.cms.CategoryOptions(ctx.Request.Context(), tenantID, "")
	if err != nil {
		c.failService(ctx, err)
		return nil, false
	}
	tags, err := c.cms.Tags(ctx.Request.Context(), tenantID, "")
	if err != nil {
		c.failService(ctx, err)
		return nil, false
	}
	revisions, _ := c.cms.Revisions(ctx.Request.Context(), tenantID, article.ID)
	actor := c.cmsActor(ctx)
	rows := model.NewCMSArticles([]cms.ArticleView{article}, actor.ID, actor.Manage, actor.Publish, actor.Review)
	row := model.CMSArticle{}
	if len(rows) > 0 {
		row = rows[0]
	}
	data := c.cmsPageData(ctx, c.tr(c.lang(ctx), "cms.title.editor"), map[string]any{
		"Article":      row,
		"Categories":   categories,
		"Tags":         tags,
		"SelectedTags": cmsTagsFor(article.Tags),
		"Revisions":    revisions,
		"Mode":         mode,
		"Action":       action,
		"CanPublish":   actor.Publish || actor.Manage,
		"CanSubmit":    row.CanSubmit,
		"CanReview":    actor.Review || actor.Manage,
		"CanDelete":    article.AuthorID == actor.ID || actor.Manage,
		"PageStyles":   cmsEditorStyles,
		"PageScripts":  cmsEditorScripts,
	})
	return data, true
}

