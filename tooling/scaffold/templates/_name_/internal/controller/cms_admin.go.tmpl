// CMSAudit renders the audit trail. | CMSAudit 渲染审计轨迹。
//
// @Summary Content audit | 内容审计
// @Description Filters management audit entries by target and action. | 按目标与动作筛选管理审计记录。
// @Tags cms
// @Produce html
// @Param target query string false "target id | 目标 ID"
// @Param action query string false "action | 动作"
// @Param page query int false "page | 页码"
// @Success 200 {object} map[string]any "audit page | 审计页"
// @Security BearerAuth
// @Router /mgr/cms/audit [get]
func (c *Controller) CMSAudit(ctx *router.Ctx) {
	tenantID, ok := c.tenantID(ctx)
	if !ok || !c.cmsAvailable(ctx) {
		return
	}
	if !c.cmsReadAll(ctx) {
		c.failService(ctx, cms.ErrForbidden)
		return
	}
	pageNo, _ := strconv.Atoi(ctx.Query("page"))
	filter := cms.AuditFilter{
		TargetID: strings.TrimSpace(ctx.Query("target")),
		Action:   strings.TrimSpace(ctx.Query("action")),
		Page:     pageNo,
	}
	filter.PageSize = c.cms.Options().PageSize
	page, err := c.cms.Audit(ctx.Request.Context(), tenantID, filter)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	c.render(ctx, http.StatusOK, TplCMSAudit, c.cmsPageData(ctx, c.tr(c.lang(ctx), "cms.title.audit"), map[string]any{
		"Entries": page.Items,
		"Total":   page.Total,
		"Target":  filter.TargetID,
		"Empty":   len(page.Items) == 0,
		"Pager":   newCMSPager(cmsPageBase(ctx), page.Page, page.TotalPages),
	}))
}
