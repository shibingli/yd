// cmsPager is the template-facing pagination state. | cmsPager 是模板使用的分页状态。
type cmsPager struct {
	// Page is the current one-based page. | Page 是当前从一的页码。
	Page int
	// TotalPages is the number of pages. | TotalPages 是总页数。
	TotalPages int
	// HasPrev reports whether a previous page exists. | HasPrev 表示存在上一页。
	HasPrev bool
	// HasNext reports whether a next page exists. | HasNext 表示存在下一页。
	HasNext bool
	// Prev is the previous page URL. | Prev 是上一页 URL。
	Prev string
	// Next is the next page URL. | Next 是下一页 URL。
	Next string
}

// newCMSPager builds a pager for a base URL that may already carry a query string. |
// newCMSPager 为可能已带查询串的基础 URL 构造分页器。
func newCMSPager(base string, page, totalPages int) cmsPager {
	if page < 1 {
		page = 1
	}
	return cmsPager{
		Page:       page,
		TotalPages: totalPages,
		HasPrev:    page > 1,
		HasNext:    page < totalPages,
		Prev:       cmsPageURL(base, page-1),
		Next:       cmsPageURL(base, page+1),
	}
}

// cmsPageURL appends a page parameter to a URL. | cmsPageURL 把页码参数追加到 URL。
func cmsPageURL(base string, page int) string {
	if page < 1 {
		page = 1
	}
	separator := "?"
	if strings.Contains(base, "?") {
		separator = "&"
	}
	return base + separator + "page=" + strconv.Itoa(page)
}

// cmsPageBase rebuilds the current path with its query minus page. | cmsPageBase 重建当前路径的查询串并去掉 page。
func cmsPageBase(ctx *router.Ctx) string {
	query := url.Values{}
	for key, values := range ctx.QueryValues() {
		if key == "page" {
			continue
		}
		for _, value := range values {
			if strings.TrimSpace(value) != "" {
				query.Add(key, value)
			}
		}
	}
	encoded := query.Encode()
	if encoded == "" {
		return ctx.Path()
	}
	return ctx.Path() + "?" + encoded
}

// cmsActor maps authz capabilities onto the domain actor. | cmsActor 把 authz 能力映射为领域 Actor。
func (c *Controller) cmsActor(ctx *router.Ctx) cms.Actor {
	actor := cms.Actor{}
	user, ok := auth.CurrentUser(ctx)
	if !ok || user == nil {
		return actor
	}
	actor.ID = user.ID
	actor.TenantID = user.TenantID
	actor.DisplayName = strings.TrimSpace(user.DisplayName)
	if actor.DisplayName == "" {
		actor.DisplayName = user.Username
	}
	if tenantID, ok := middleware.TenantID(ctx); ok {
		actor.TenantID = tenantID
	}
	request := ctx.Request.Context()
	actor.Manage = authz.Can(request, authz.PermCmsArticleManage)
	actor.Publish = authz.Can(request, authz.PermCmsArticlePublish)
	actor.Review = authz.Can(request, authz.PermCmsArticleReview)
	actor.Moderate = authz.Can(request, authz.PermCmsCommentModerate)
	actor.MediaManage = authz.Can(request, authz.PermCmsMediaDelete)
	actor.SiteManage = authz.Can(request, authz.PermCmsSiteManage)
	return actor
}

// cmsReadAll reports whether the actor sees every author's content. Members without a review,
// publish or manage capability only see their own rows; the auditor keeps the read-only,
// tenant-wide view. | cmsReadAll 报告主体是否能看到全部作者的内容。没有审核/发布/管理能力的成员
// 只看到自己的记录；审计员保留只读的全租户视图。
func (c *Controller) cmsReadAll(ctx *router.Ctx) bool {
	actor := c.cmsActor(ctx)
	if actor.Manage || actor.Review || actor.Publish {
		return true
	}
	return authz.HasRole(ctx.Request.Context(), authz.RoleAuditor)
}

// cmsCanInTenant reports whether the signed-in user holds perm in tenantID, which may differ from the
// session's active tenant. Public pages use it so a reader who belongs to the public tenant can comment
// even when their session is currently active in another tenant. |
// cmsCanInTenant 报告已登录用户在 tenantID（可能不同于会话活动租户）是否持有 perm。公开页面用它，
// 使隶属于公开租户的读者即使当前会话在别的租户，也仍然可以评论。
func (c *Controller) cmsCanInTenant(ctx *router.Ctx, tenantID, perm string) bool {
	user, ok := auth.CurrentUser(ctx)
	if !ok || user == nil || strings.TrimSpace(tenantID) == "" {
		return false
	}
	if user.TenantID == tenantID {
		return authz.Can(ctx.Request.Context(), perm)
	}
	member := false
	for _, id := range user.TenantIDs {
		if id == tenantID {
			member = true
			break
		}
	}
	if !member {
		return false
	}
	target, err := c.Auth().GetUser(ctx.Request.Context(), tenantID, user.ID)
	if err != nil || target == nil {
		return false
	}
	return c.Auth().HasPermission(target, auth.Permission(perm))
}

// cmsAvailable reports whether the CMS can serve the request. | cmsAvailable 报告 CMS 能否服务该请求。
func (c *Controller) cmsAvailable(ctx *router.Ctx) bool {
	if c.CMSAvailable() {
		return true
	}
	// 公开站点用公开外壳渲染 503，后台与管理页用各自的外壳。 |
	// The public site renders its 503 inside the public shell; the back office uses its own shell.
	if strings.HasPrefix(ctx.Path(), "/blog") {
		c.failPublic(ctx, 503, service.ErrCMSUnavailable.Error())
	} else {
		c.fail(ctx, 503, service.ErrCMSUnavailable.Error())
	}
	return false
}

// cmsEnsure creates the tenant's default category and settings once. | cmsEnsure 一次性创建租户的默认分类与设置。
func (c *Controller) cmsEnsure(ctx *router.Ctx, tenantID string) bool {
	if err := c.cms.EnsureTenant(ctx.Request.Context(), tenantID); err != nil {
		if strings.HasPrefix(ctx.Path(), "/blog") {
			c.failServicePublic(ctx, err)
		} else {
			c.failService(ctx, err)
		}
		return false
	}
	return true
}

// cmsPageData builds management page data. | cmsPageData 构造管理页面数据。
func (c *Controller) cmsPageData(ctx *router.Ctx, title string, extra map[string]any) map[string]any {
	data := c.view(ctx, title, extra)
	data["CMSAvailable"] = c.CMSAvailable()
	data["PublicSite"] = false
	return data
}

// cmsPublicTenant resolves the tenant of a public page: the request tenant when present, otherwise the
// configured public tenant slug. A tenant the request itself does not name is never guessed. |
// cmsPublicTenant 解析公开页面的租户：请求已指定时用它，否则用配置的公开租户标识。
// 请求本身没有指定的租户不会被猜测。
func (c *Controller) cmsPublicTenant(ctx *router.Ctx) (string, error) {
	if tenantID, ok := middleware.TenantID(ctx); ok && strings.TrimSpace(tenantID) != "" {
		return tenantID, nil
	}
	if c.cms == nil || !c.cms.Available() {
		return "", service.ErrCMSUnavailable
	}
	key := strings.TrimSpace(c.cms.PublicTenant())
	if key == "" {
		return "", cms.ErrNotFound
	}
	tenantID, err := c.tenants.Resolve(ctx.Request.Context(), key)
	if err != nil {
		return "", errx.Wrap(err, cms.ErrNotFound)
	}
	return tenantID, nil
}

// cmsPublicData builds public page data, including the site settings and navigation tree. |
// cmsPublicData 构造公开页面数据，含站点设置与导航树。
func (c *Controller) cmsPublicData(ctx *router.Ctx, tenantID, title string, extra map[string]any) map[string]any {
	data := c.view(ctx, title, extra)
	data["CMSAvailable"] = true
	data["PublicSite"] = true
	settings, err := c.cms.Settings(ctx.Request.Context(), tenantID)
	if err != nil {
		c.log.Warn("CMS settings unavailable | CMS 设置不可用", logx.Err(err))
	} else {
		data["Site"] = settings
		data["MetaDescription"] = settings.SiteDescription
		data["MetaKeywords"] = settings.SiteKeywords
	}
	tree, err := c.cms.CategoryTree(ctx.Request.Context(), tenantID, false)
	if err == nil {
		data["PublicNav"] = tree
	}
	data["CanonicalURL"] = cmsAbsoluteURL(ctx, ctx.Path())
	data["OGType"] = "website"
	return data
}

// cmsArticleFilter parses the management list filter. | cmsArticleFilter 解析管理列表筛选。
func cmsArticleFilter(ctx *router.Ctx) cms.ArticleFilter {
	page, _ := strconv.Atoi(ctx.Query("page"))
	return cms.ArticleFilter{
		Keyword:    strings.TrimSpace(ctx.Query("q")),
		Status:     cms.ArticleStatus(strings.TrimSpace(ctx.Query("status"))),
		Kind:       cms.ArticleKind(strings.TrimSpace(ctx.Query("kind"))),
		CategoryID: strings.TrimSpace(ctx.Query("category")),
		TagID:      strings.TrimSpace(ctx.Query("tag")),
		Page:       page,
		Order:      strings.TrimSpace(ctx.Query("order")),
	}
}

// cmsArticleInput parses the editor form. | cmsArticleInput 解析编辑器表单。
func cmsArticleInput(ctx *router.Ctx) cms.ArticleInput {
	_ = ctx.Request.ParseForm()
	kind := cms.KindPost
	if ctx.FormValue("kind") == string(cms.KindPage) {
		kind = cms.KindPage
	}
	visibility := cms.VisibilityPublic
	if ctx.FormValue("visibility") == string(cms.VisibilityPrivate) {
		visibility = cms.VisibilityPrivate
	}
	return cms.ArticleInput{
		ID:             ctx.Param("id"),
		CategoryID:     ctx.FormValue("category_id"),
		Title:          ctx.FormValue("title"),
		Slug:           ctx.FormValue("slug"),
		Summary:        ctx.FormValue("summary"),
		CoverURL:       ctx.FormValue("cover_url"),
		BodyMarkdown:   ctx.FormValue("body_markdown"),
		Kind:           kind,
		Visibility:     visibility,
		Featured:       cmsChecked(ctx, "featured"),
		Pinned:         cmsChecked(ctx, "pinned"),
		AllowComment:   cmsChecked(ctx, "allow_comment"),
		SEOTitle:       ctx.FormValue("seo_title"),
		SEODescription: ctx.FormValue("seo_description"),
		SEOKeywords:    ctx.FormValue("seo_keywords"),
		CanonicalURL:   ctx.FormValue("canonical_url"),
		Source:         ctx.FormValue("source"),
		Note:           ctx.FormValue("note"),
		TagIDs:         ctx.Request.Form["tag_ids"],
		TagNames:       cmsSplitList(ctx.FormValue("tag_names")),
	}
}

// cmsChecked reports whether a checkbox was submitted. | cmsChecked 报告复选框是否被提交。
func cmsChecked(ctx *router.Ctx, name string) bool {
	switch strings.ToLower(strings.TrimSpace(ctx.FormValue(name))) {
	case "on", "true", "1", "yes":
		return true
	default:
		return false
	}
}

// cmsSplitList splits comma- or newline-separated values. | cmsSplitList 拆分逗号或换行分隔的值。
func cmsSplitList(value string) []string {
	fields := strings.FieldsFunc(value, func(r rune) bool { return r == ',' || r == '\n' || r == ';' })
	out := make([]string, 0, len(fields))
	for _, field := range fields {
		if trimmed := strings.TrimSpace(field); trimmed != "" {
			out = append(out, trimmed)
		}
	}
	return out
}

// cmsTransition parses an editorial action and its optional schedule. | cmsTransition 解析编辑动作与可选定时。
func cmsTransition(ctx *router.Ctx) (cms.ArticleAction, *time.Time, error) {
	action := cms.ArticleAction(strings.TrimSpace(ctx.FormValue("action")))
	if action == "" {
		return "", nil, cms.ErrInvalidInput
	}
	value := strings.TrimSpace(ctx.FormValue("publish_at"))
	if value == "" {
		return action, nil, nil
	}
	layouts := []string{time.RFC3339, "2006-01-02T15:04", "2006-01-02 15:04:05", "2006-01-02"}
	for _, layout := range layouts {
		if parsed, err := time.ParseInLocation(layout, value, time.UTC); err == nil {
			utc := parsed.UTC()
			return action, &utc, nil
		}
	}
	return "", nil, cms.ErrInvalidInput
}

// cmsCommentFilter parses the moderation list filter. | cmsCommentFilter 解析审核列表筛选。
func cmsCommentFilter(ctx *router.Ctx) cms.CommentFilter {
	page, _ := strconv.Atoi(ctx.Query("page"))
	return cms.CommentFilter{
		ArticleID: strings.TrimSpace(ctx.Query("article")),
		Status:    cms.CommentStatus(strings.TrimSpace(ctx.Query("status"))),
		Keyword:   strings.TrimSpace(ctx.Query("q")),
		Page:      page,
	}
}

// cmsTagsFor selects the article form's tag checkbox state. | cmsTagsFor 选择文章表单的标签勾选状态。
func cmsTagsFor(tags []cms.Tag) map[string]bool {
	out := make(map[string]bool, len(tags))
	for _, tag := range tags {
		out[tag.ID] = true
	}
	return out
}

// cmsArticleRows decorates article views for one actor. | cmsArticleRows 为一个主体装饰文章视图。
func cmsArticleRows(items []cms.ArticleView, actor cms.Actor) []model.CMSArticle {
	return model.NewCMSArticles(items, actor.ID, actor.Manage, actor.Publish, actor.Review)
}
