// 本文件是 controller 包的实时推送端点：SSE 与 WebSocket 共用 service.Ticker 渲染出的同一份时钟片段。
// This file is the realtime part of package controller: the SSE and WebSocket endpoints share the very same clock
// fragment rendered by service.Ticker.

package controller

import (
	"html"
	"net/http"
	"strings"
	"time"

	"{{ .Module }}/internal/service"
	"{{ .YdModule }}/core/logx"
	"{{ .YdModule }}/http/router"
	"{{ .YdModule }}/http/sse"
	"{{ .YdModule }}/http/ws"
)

// 推送端点的时间参数：心跳与重连间隔是前端体验参数，与推送间隔分开配置。
// Timing of the push endpoints: the heartbeat and the reconnect interval shape the front-end experience and are kept
// separate from the push interval.
const (
	// heartbeatInterval is the SSE comment-frame heartbeat, which keeps idle timeouts in middleboxes from dropping the stream. | heartbeatInterval 是 SSE 的注释帧心跳间隔，用于穿透中间设备的空闲超时。
	heartbeatInterval = 15 * time.Second
	// retryInterval is the suggested reconnect interval after an SSE disconnect. | retryInterval 是 SSE 断线后的重连间隔建议值。
	retryInterval = 3 * time.Second
)

// Page 渲染实时演示页：整页请求得到布局包裹的页面，htmx 请求得到片段。
// Page renders the realtime demo page: a full-page request gets the layout-wrapped page and an htmx request the fragment.
//
// @Summary Realtime demo page | 实时推送演示页
// @Description Renders portal/pages/realtime.html, which subscribes to the SSE endpoint through hx-sse:connect (htmx 4 swaps
// @Description unnamed messages automatically) and to the WebSocket endpoint through the htmx WebSocket extension. Both
// @Description channels push the same server-rendered clock fragment, so one target element is fed twice and a broken
// @Description channel is visible at a glance.
// @Description 渲染 portal/pages/realtime.html：页面通过 hx-sse:connect 订阅 SSE 端点（htmx 4 自动交换无名消息），并通过 htmx 的
// @Description WebSocket 扩展订阅 WebSocket 端点。两条通道推送的是同一份服务端渲染的时钟片段，因此同一个目标元素被两路刷新，
// @Description 坏掉的通道一眼可见。
// @Tags pages
// @Accept html
// @Produce html
// @Param HX-Request header string false "htmx partial request | htmx 局部请求标记"
// @Success 200 {object} string "realtime page or fragment | 实时演示整页或片段"
// @Failure 401 {object} string "no session | 无有效会话"
// @Security BearerAuth
// @Router /realtime [get]
func (c *Controller) Page(ctx *router.Ctx) {
	c.render(ctx, http.StatusOK, TplRealtime, c.view(ctx, "实时推送 | Realtime", map[string]any{
		"Topic":    service.EventsTopic,
		"Target":   service.ClockTarget,
		"Swap":     service.ClockSwap,
		"Interval": service.DefaultTickInterval.String(),
	}))
}

// Stream 构造 SSE 端点处理器：按 EventsTopic 订阅并持续把服务端渲染的片段写给客户端。
// Stream builds the SSE endpoint handler: it subscribes to EventsTopic and keeps writing server-rendered fragments.
//
// 工厂函数本身即处理器的注册处，因此 OpenAPI 注解块写在这里（与 ws.HtmxHandler 的约定一致）。
// The factory is the registration site of the handler, so the OpenAPI annotation block lives here (the same convention
// as ws.HtmxHandler).
//
// @Summary Event stream (SSE) | 事件流（SSE）
// @Description Opens a text/event-stream subscribed to the yd.events topic. Clock frames arrive as unnamed htmx partial
// @Description updates (htmx 4 swaps them automatically), and a yd:tick event accompanies each frame. A `: ping` comment
// @Description frame is written every 15 seconds, and the Last-Event-ID request header is preserved for resumption by
// @Description upper layers.
// @Description 打开 text/event-stream 并订阅 yd.events 主题：时钟帧以无名 htmx 局部更新形式到达（htmx 4 自动交换），
// @Description 每帧附带一个 yd:tick 事件；每 15 秒写一条 `: ping` 注释帧，Last-Event-ID 请求头保留给上层做断点续传。
// @Tags realtime
// @Accept text
// @Produce text
// @Param Last-Event-ID header string false "last received event id for resumption | 断点续传所用的最后事件 ID"
// @Success 200 {string} string "text/event-stream | 事件流"
// @Failure 401 {object} string "no session | 无有效会话"
// @Security BearerAuth
// @Router /events [get]
func (c *Controller) Stream(broker *sse.Broker) router.HandlerFunc {
	return sse.Handler(broker, service.EventsTopic, sse.Options{
		Heartbeat: heartbeatInterval,
		Retry:     retryInterval,
	})
}

// HTTP/2 与 HTTP/3 的 WebSocket 绑定在请求流上：处理器必须阻塞到连接结束，返回即结束流。
// HTTP/1.1 的 hijack 连接则可以把 Conn 交给其它协程后返回。
// On HTTP/2 and HTTP/3 the WebSocket is bound to the request stream: the handler must stay alive
// until the connection ends — returning closes the stream. An HTTP/1.1 hijacked connection may be
// handed to another goroutine before returning.
//
// Socket 构造 WebSocket 端点处理器：内建回显，并周期性主动推送时钟片段。
// Socket builds the WebSocket endpoint handler: the echo behaviour is built in and the clock fragment is pushed
// periodically on top of it.
//
// 回显由 OnMessage 完成：htmx 4 把表单字段作为顶层键发送（没有 BODY 字段），ws.HtmxMessage 已把唯一值或约定的
// message 字段解为 Body；这里再做 HTML 转义后追加到日志。主动推送则由 OnOpen 启动的协程完成：写失败即代表对端已断开，
// 协程立即返回，不需要额外的生命周期管理。
// The echo is handled by OnMessage: htmx 4 sends form fields as top-level keys (there is no BODY field), and
// ws.HtmxMessage resolves the single value or the conventional message field into Body; the handler escapes it and
// appends it to the log. The push is performed by the goroutine started in OnOpen: a write error means the peer is gone,
// so the goroutine returns at once and needs no further lifecycle management.
//
// @Summary WebSocket echo and push | WebSocket 回显与推送
// @Description Upgrades the connection with the htmx subprotocol, echoes every htmx message envelope back and pushes a
// @Description clock fragment to the #yd-clock target every push interval, so the same page element is fed by both the
// @Description SSE and the WebSocket channel.
// @Description 以 htmx 子协议升级连接：回显每条 htmx 消息信封，并按推送间隔向 #yd-clock 目标推送时钟片段，
// @Description 因此同一个页面元素既可以由 SSE 也可以由 WebSocket 通道刷新。
// @Tags realtime
// @Accept json
// @Produce json
// @Param Upgrade header string true "must be websocket | 必须为 websocket"
// @Success 101 {string} string "switching protocols | 协议切换"
// @Success 200 {string} string "extended CONNECT established | 扩展连接已建立"
// @Failure 400 {object} string "upgrade failure written by the framework | 框架写出的升级失败响应"
// @Failure 401 {object} string "no session | 无有效会话"
// @Security BearerAuth
// @Router /ws [get]
func (c *Controller) Socket(ticker *service.Ticker) router.HandlerFunc {
	return ws.HtmxHandler(ws.HtmxOptions{
		// 子协议与 htmx 的 WebSocket 扩展一致；不声明它，浏览器可能拒绝握手。
		// The subprotocol matches the htmx WebSocket extension; without it the browser may refuse the handshake.
		Subprotocols: []string{"htmx"},
		OnOpen: func(conn *ws.Conn) {
			go c.pushClock(conn, ticker)
		},
		OnMessage: func(conn *ws.Conn, msg ws.HtmxMessage) {
			c.echoMessage(conn, msg)
		},
		OnClose: func(conn *ws.Conn, err error) {
			c.app.Logger().Debug("websocket closed | WebSocket 已关闭",
				logx.Str("remote", remoteAddr(conn)),
				logx.Err(err),
			)
		},
	})
}

// echoMessage 把一条转义后的消息片段追加到发送方的回显日志。
// echoMessage appends one escaped message fragment to the sender's echo log.
//
// 回显内容是用户输入，必须 HTML 转义：htmx 会把片段内容交换进页面，未转义的输入会被当作标记执行。
// The echoed content is user input and must be HTML-escaped: htmx swaps the fragment into the page, so
// unescaped input would be executed as markup.
func (c *Controller) echoMessage(conn *ws.Conn, msg ws.HtmxMessage) {
	text := strings.TrimSpace(msg.Body)
	if text == "" {
		return
	}
	fragment := `<p class="yd-stream__item">` + html.EscapeString(text) + `</p>`
	if err := conn.WriteHtmxFragment(service.EchoTarget, service.EchoSwap, fragment); err != nil {
		c.app.Logger().Debug("websocket echo failed | WebSocket 回显失败", logx.Err(err))
	}
}

// pushClock 按推送节拍向单条连接写时钟片段，直到写出失败（对端已断开）为止。
// pushClock writes clock frames to one connection on the push cadence until a write fails (the peer is gone).
func (c *Controller) pushClock(conn *ws.Conn, ticker *service.Ticker) {
	interval := ticker.Interval()
	clock := time.NewTicker(interval)
	defer clock.Stop()

	// 立即推一帧：连接建立后页面立刻有内容，不必等第一个节拍。
	// One immediate frame so the page has content right after the handshake instead of waiting for the first tick.
	if err := conn.WriteHtmxFragment(service.ClockTarget, service.ClockSwap, ticker.Fragment()); err != nil {
		return
	}

	for range clock.C {
		if err := conn.WriteHtmxFragment(service.ClockTarget, service.ClockSwap, ticker.Fragment()); err != nil {
			return
		}
	}
}

// remoteAddr 安全地取出对端地址，连接已被回收时返回空串。
// remoteAddr safely reads the peer address and returns an empty string once the connection has been recycled.
func remoteAddr(conn *ws.Conn) string {
	if conn == nil || conn.RemoteAddr() == nil {
		return ""
	}
	return conn.RemoteAddr().String()
}
