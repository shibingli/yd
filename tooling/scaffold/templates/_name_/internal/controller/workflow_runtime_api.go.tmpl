// APIWorkflowSignal delivers one message event. | APIWorkflowSignal 投递一个消息事件。
//
// @Summary Deliver a message event | 投递消息事件
// @Description Wakes matching message tokens and merges the payload into the variables. | 唤醒匹配的消息令牌并把载荷合并进变量。
// @Tags workflow
// @Accept json
// @Produce json
// @Param id path string true "Instance id | 实例 ID"
// @Param body body workflowSignalRequest true "signal payload | 信号载荷"
// @Success 200 {object} map[string]int "woken token count | 唤醒令牌数"
// @Security BearerAuth
// @Router /api/v1/workflow-instances/{id}/signal [post]
func (c *Controller) APIWorkflowSignal(ctx *router.Ctx) {
	tenantID, ok := c.workflowAPIAvailable(ctx)
	if !ok {
		return
	}
	request := workflowSignalRequest{}
	if err := ctx.Bind(&request); err != nil {
		c.workflowAPIFail(ctx, workflow.ErrInvalidInput)
		return
	}
	woken, err := c.workflow.Signal(ctx.Request.Context(), tenantID, c.workflowActor(ctx), ctx.Param("id"), request.Signal, request.Payload)
	if err != nil {
		c.workflowAPIFail(ctx, err)
		return
	}
	_ = ctx.JSON(http.StatusOK, map[string]int{"woken": woken})
