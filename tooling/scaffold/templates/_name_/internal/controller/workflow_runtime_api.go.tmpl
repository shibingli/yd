// APIWorkflowTaskAction performs one task action. | APIWorkflowTaskAction 执行一个任务动作。
//
// @Summary Task action | 任务动作
// @Description Runs approve, reject, claim, transfer, delegate, add-sign, remove-sign, return or remind. | 执行通过、驳回、签收、转办、委派、加签、减签、退回或催办。
// @Tags workflow
// @Accept json
// @Produce json
// @Param id path string true "Task id | 任务 ID"
// @Param action path string true "Action word | 动作词"
// @Param body body workflowActionRequest true "action payload | 动作载荷"
// @Success 200 {object} workflowTaskActionResponse "updated task and instance | 更新后的任务与实例"
// @Security BearerAuth
// @Router /api/v1/workflow-tasks/{id}/{action} [post]
func (c *Controller) APIWorkflowTaskAction(ctx *router.Ctx) {
	tenantID, ok := c.workflowAPIAvailable(ctx)
	if !ok {
		return
	}
	action := strings.ToLower(strings.TrimSpace(ctx.Param("action")))
	actor := c.workflowActor(ctx)
	taskID := ctx.Param("id")
	var task workflow.Task
	var err error
	switch action {
	case "approve", "reject":
		request := workflowActionRequest{}
		if bindErr := ctx.Bind(&request); bindErr != nil {
			c.workflowAPIFail(ctx, workflow.ErrInvalidInput)
			return
		}
		decision := request.Decision
		if decision == "" {
			decision = action
		}
		if action == "approve" {
			decision = workflow.DecisionApprove
		} else if action == "reject" {
			decision = workflow.DecisionReject
		}
		task, err = c.workflow.Approve(ctx.Request.Context(), tenantID, actor, taskID, workflow.ActionInput{
			Decision: decision, Comment: request.Comment, FormData: request.FormData,
		})
	case "claim":
		task, err = c.workflow.Claim(ctx.Request.Context(), tenantID, actor, taskID)
	case "transfer", "delegate":
		request := workflowReassignRequest{}
		if bindErr := ctx.Bind(&request); bindErr != nil {
			c.workflowAPIFail(ctx, workflow.ErrInvalidInput)
			return
		}
		if action == "delegate" {
			task, err = c.workflow.Delegate(ctx.Request.Context(), tenantID, actor, taskID, workflow.DelegateInput{TargetID: request.TargetID, Comment: request.Comment})
		} else {
			task, err = c.workflow.Transfer(ctx.Request.Context(), tenantID, actor, taskID, workflow.TransferInput{TargetID: request.TargetID, Comment: request.Comment})
		}
	case "add-sign":
		request := workflowAddSignRequest{}
		if bindErr := ctx.Bind(&request); bindErr != nil {
			c.workflowAPIFail(ctx, workflow.ErrInvalidInput)
			return
		}
		if _, err = c.workflow.AddSign(ctx.Request.Context(), tenantID, actor, taskID, workflow.AddSignInput{
			UserIDs: request.UserIDs, Position: request.Position, Comment: request.Comment,
		}); err == nil {
			task, err = c.workflow.GetTask(ctx.Request.Context(), tenantID, taskID)
		}
	case "remove-sign":
		request := workflowRemoveSignRequest{}
		if bindErr := ctx.Bind(&request); bindErr != nil {
			c.workflowAPIFail(ctx, workflow.ErrInvalidInput)
			return
		}
		err = c.workflow.RemoveSign(ctx.Request.Context(), tenantID, actor, taskID, request.TaskID, request.Comment)
		if err == nil {
			task, err = c.workflow.GetTask(ctx.Request.Context(), tenantID, taskID)
		}
	case "return":
		request := workflowReturnRequest{}
		if bindErr := ctx.Bind(&request); bindErr != nil {
			c.workflowAPIFail(ctx, workflow.ErrInvalidInput)
			return
		}
		err = c.workflow.Return(ctx.Request.Context(), tenantID, actor, taskID, workflow.ReturnInput{
			TargetNodeID: request.TargetNodeID, Comment: request.Comment,
		})
		if err == nil {
			task, err = c.workflow.GetTask(ctx.Request.Context(), tenantID, taskID)
		}
	case "remind":
		request := workflowRemindRequest{}
		_ = ctx.Bind(&request)
		task, err = c.workflow.Remind(ctx.Request.Context(), tenantID, actor, taskID, request.Comment)
	default:
		c.workflowAPIFail(ctx, workflow.ErrInvalidInput)
		return
	}
	if err != nil {
		c.workflowAPIFail(ctx, err)
		return
	}
	instance, instanceErr := c.workflow.GetInstance(ctx.Request.Context(), tenantID, task.InstanceID)
	if instanceErr != nil {
		c.workflowAPIFail(ctx, instanceErr)
		return
	}
	_ = ctx.JSON(http.StatusOK, workflowTaskActionResponse{Task: task, Instance: instance})
}

