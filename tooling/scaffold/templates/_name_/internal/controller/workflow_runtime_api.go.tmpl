// APIWorkflowTasks lists tasks. | APIWorkflowTasks 列出任务。
//
// @Summary List tasks | 列出任务
// @Description Returns one page; the portal endpoint only returns tasks assigned to or claimable by the caller. | 返回分页；门户端点只返回指派给调用方或调用方可抢的任务。
// @Tags workflow
// @Produce json
// @Param tab query string false "todo or done | todo 或 done"
// @Param status query string false "Task state | 任务状态"
// @Param q query string false "Search keyword | 搜索关键字"
// @Param instance query string false "Instance id | 实例 ID"
// @Param page query int false "1-based page | 从 1 开始的页码"
// @Param page_size query int false "Page length | 页长"
// @Success 200 {object} workflowTaskPageDoc "task page | 任务分页"
// @Security BearerAuth
// @Router /api/v1/workflow-tasks [get]
func (c *Controller) APIWorkflowTasks(ctx *router.Ctx) {
	tenantID, ok := c.workflowAPIAvailable(ctx)
	if !ok {
		return
	}
	filter := workflow.TaskFilter{
		Query: strings.TrimSpace(ctx.Query(FieldKeyword)), Status: strings.TrimSpace(ctx.Query(FieldStatus)),
		InstanceID: strings.TrimSpace(ctx.Query("instance")),
		Page:       queryInt(ctx, "page", 1), PageSize: queryInt(ctx, "page_size", defaultPageSize),
	}
	portal := strings.HasPrefix(ctx.Path(), "/api/portal/")
	if portal {
		filter.ActorID = c.workflowActor(ctx).ID
	}
	tab := strings.ToLower(strings.TrimSpace(ctx.Query(FieldWorkflowFilterTab)))
	if portal && filter.Status == "" {
		if tab == "done" {
			filter.Status = workflow.TaskCompleted
		} else {
			filter.Statuses = []string{workflow.TaskPending, workflow.TaskClaimed}
		}
	}
	page, err := c.workflow.ListTasks(ctx.Request.Context(), tenantID, filter)
	if err != nil {
		c.workflowAPIFail(ctx, err)
		return
	}
	_ = ctx.JSON(http.StatusOK, page)
}

