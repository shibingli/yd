// APIWorkflowCatalog lists the published definitions a member may start. | APIWorkflowCatalog
// 列出成员可发起的已发布定义。
//
// @Summary Startable definitions | 可发起流程
// @Description Returns every published definition. | 返回全部已发布定义。
// @Tags workflow
// @Produce json
// @Success 200 {object} workflowDefinitionPageDoc "definitions | 定义分页"
// @Security BearerAuth
// @Router /api/portal/v1/workflows/definitions [get]
func (c *Controller) APIWorkflowCatalog(ctx *router.Ctx) {
	tenantID, ok := c.workflowAPIAvailable(ctx)
	if !ok {
		return
	}
	page, err := c.workflow.ListDefinitions(ctx.Request.Context(), tenantID, workflow.DefinitionFilter{
		Status: workflow.DefinitionPublished, Page: 1, PageSize: 100,
	})
	if err != nil {
		c.workflowAPIFail(ctx, err)
		return
	}
	_ = ctx.JSON(http.StatusOK, page)
}

// APIWorkflowStart starts one instance. | APIWorkflowStart 发起一个实例。
//
// @Summary Start a process | 发起流程
// @Description Creates an instance from a published definition and its start form. | 从已发布定义及其发起表单创建实例。
// @Tags workflow
// @Accept json
// @Produce json
// @Param body body workflowStartRequest true "start payload | 发起载荷"
// @Success 201 {object} workflowInstanceDoc "created instance | 已创建实例"
// @Failure 422 {object} string "form validation failed | 表单校验失败"
// @Security BearerAuth
// @Router /api/portal/v1/workflows/instances [post]
func (c *Controller) APIWorkflowStart(ctx *router.Ctx) {
	tenantID, ok := c.workflowAPIAvailable(ctx)
	if !ok {
		return
	}
	request := workflowStartRequest{}
	if err := ctx.Bind(&request); err != nil {
		c.workflowAPIFail(ctx, workflow.ErrInvalidInput)
		return
	}
	instance, err := c.workflow.Start(ctx.Request.Context(), tenantID, c.workflowActor(ctx), workflow.StartInput{
		DefinitionID: request.DefinitionID, DefinitionKey: request.DefinitionKey, Version: request.Version,
		Title: request.Title, BusinessKey: request.BusinessKey, Category: request.Category,
		Variables: request.Variables, FormData: request.FormData,
	})
	if err != nil {
		c.workflowAPIFail(ctx, err)
		return
	}
	_ = ctx.JSON(http.StatusCreated, instance)
}

// APIWorkflowInstances lists instances. | APIWorkflowInstances 列出实例。
//
// @Summary List instances | 列出实例
// @Description Returns one page with the lean projection (no variables or node snapshots); the portal endpoint only returns the caller's own instances. | 返回精简投影分页（不含变量与节点快照）；门户端点只返回调用方自己的实例。
// @Tags workflow
// @Produce json
// @Param status query string false "Instance state | 实例状态"
// @Param category query string false "Process category | 流程分类"
// @Param q query string false "Search keyword | 搜索关键字"
// @Param page query int false "1-based page | 从 1 开始的页码"
// @Param page_size query int false "Page length | 页长"
// @Success 200 {object} workflowInstancePageDoc "instance page | 实例分页"
// @Security BearerAuth
// @Router /api/v1/workflow-instances [get]
func (c *Controller) APIWorkflowInstances(ctx *router.Ctx) {
	tenantID, ok := c.workflowAPIAvailable(ctx)
	if !ok {
		return
	}
	filter := workflow.InstanceFilter{
		Query: strings.TrimSpace(ctx.Query(FieldKeyword)), Status: strings.TrimSpace(ctx.Query(FieldStatus)),
		Category: strings.TrimSpace(ctx.Query(FieldWorkflowCategory)),
		Page:     queryInt(ctx, "page", 1), PageSize: queryInt(ctx, "page_size", defaultPageSize),
	}
	if strings.HasPrefix(ctx.Path(), "/api/portal/") {
		filter.InitiatorID = c.workflowActor(ctx).ID
	}
	page, err := c.workflow.ListInstances(ctx.Request.Context(), tenantID, filter)
	if err != nil {
		c.workflowAPIFail(ctx, err)
		return
	}
	_ = ctx.JSON(http.StatusOK, page)
}

// APIWorkflowInstance reads one instance. | APIWorkflowInstance 读取一个实例。
//
// @Summary Read instance | 读取实例
// @Description Returns the instance, tasks, events, comments and variables. | 返回实例、任务、事件、评论与变量。
// @Tags workflow
// @Produce json
// @Param id path string true "Instance id | 实例 ID"
// @Success 200 {object} workflowInstanceDetailDoc "instance detail | 实例详情"
// @Security BearerAuth
// @Router /api/v1/workflow-instances/{id} [get]
func (c *Controller) APIWorkflowInstance(ctx *router.Ctx) {
	tenantID, ok := c.workflowAPIAvailable(ctx)
	if !ok {
		return
	}
	detail, err := c.workflow.InstanceDetail(ctx.Request.Context(), tenantID, ctx.Param("id"))
	if err != nil {
		c.workflowAPIFail(ctx, err)
		return
	}
	if strings.HasPrefix(ctx.Path(), "/api/portal/") {
		visible, err := c.workflow.InstanceVisible(ctx.Request.Context(), tenantID, detail.Instance, c.workflowActor(ctx))
		if err != nil {
			c.workflowAPIFail(ctx, err)
			return
		}
		if !visible {
			c.workflowAPIFail(ctx, workflow.ErrForbidden)
			return
		}
	}
	_ = ctx.JSON(http.StatusOK, detail)
}

