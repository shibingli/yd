// renderFriendSummaryWithNotice renders the friend panel and emits a toast. | renderFriendSummaryWithNotice 渲染好友面板并发出提示。
func (c *Controller) renderFriendSummaryWithNotice(ctx *router.Ctx, notice string) {
	actor := c.messageActor(ctx)
	summary, err := c.messages.FriendSummary(ctx.Request.Context(), actor)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	c.toast(ctx, notice)
	c.log.Debug("friend action finished | 好友动作完成", logx.Str("actor", actor.ID))
	c.render(ctx, http.StatusOK, TplFriendSummary, c.friendPageData(ctx, summary))
}
