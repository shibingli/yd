// FriendRemarkDrawer renders the remark drawer. | FriendRemarkDrawer 渲染备注抽屉。
//
// @Summary Friend remark drawer | 好友备注抽屉
// @Description Renders the alias form for one accepted friend.
// @Description 渲染一位已接受好友的备注表单。
// @Tags friends
// @Accept html
// @Produce html
// @Param id path string true "friend user id | 好友用户 ID"
// @Success 200 {object} string "drawer fragment | 抽屉片段"
// @Security BearerAuth
// @Router /friends/{id}/remark [get]
func (c *Controller) FriendRemarkDrawer(ctx *router.Ctx) {
	if !c.MessagesAvailable() {
		c.messageUnavailable(ctx)
		return
	}
	actor := c.messageActor(ctx)
	summary, err := c.messages.FriendSummary(ctx.Request.Context(), actor)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	for _, friend := range summary.Friends {
		if friend.Profile.ID != ctx.Param("id") {
			continue
		}
		c.render(ctx, http.StatusOK, TplFriendRemark, c.view(ctx, "好友备注 | Friend remark", map[string]any{
			"Friend": friendViewsOf([]messaging.FriendView{friend})[0],
		}))
		return
	}
	c.failService(ctx, messaging.ErrNotFriend)
}

