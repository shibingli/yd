// 本文件是角色与权限矩阵端点：角色增删、权限授予/回收与矩阵页。
// This file holds the role and permission-matrix endpoints: role create/delete, capability grant/revoke and the matrix page.
//
// 权限矩阵是本项目的权限模型的可视化：行是权限目录（固定顺序），列是角色，单元格是一次授予/回收。
// The matrix visualises this project's permission model: rows are the capability catalogue in a fixed order, columns are
// roles and a cell is one grant or revoke.

package controller

import (
	"net/http"
	"strconv"

	"{{ .Module }}/internal/model"
	"{{ .YdModule }}/security/auth"
	"{{ .YdxModule }}/log"
	"{{ .YdxModule }}/router"
)

// Roles 渲染角色列表与新建表单。
// Roles renders the role list together with the creation form.
//
// @Summary Role list | 角色列表
// @Description Renders mgr/pages/roles.html: every role of the tenant with its capabilities and its built-in marker. Built-in
// @Description roles can be edited — a tenant may extend auditor, say — but never deleted.
// @Description 渲染 mgr/pages/roles.html：列出本租户的每个角色及其权限与内置标记。内置角色可以编辑（例如给 auditor 增权），但不可删除。
// @Tags roles
// @Accept html
// @Produce html
// @Param HX-Request header string false "htmx partial request | htmx 局部请求标记"
// @Success 200 {object} string "role page or fragment | 角色整页或片段"
// @Failure 401 {object} string "no session | 无有效会话"
// @Failure 403 {object} string "missing role:read | 缺少 role:read"
// @Security BearerAuth
// @Router /mgr/roles [get]
func (c *Controller) Roles(ctx *router.Ctx) {
	c.rolesPage(ctx, http.StatusOK, "")
}

// NewRoleForm returns the form fragment of the role creation drawer. | NewRoleForm 返回新建角色抽屉的表单片段。
//
// @Summary Role creation form | 新建角色表单
// @Description Renders the drawer fragment fetched by the "create role" button; the form posts to POST /roles.
// @Description 渲染「新建角色」按钮取用的抽屉片段；表单提交到 POST /roles。
// @Tags roles
// @Accept html
// @Produce html
// @Success 200 {object} string "drawer fragment | 抽屉片段"
// @Failure 401 {object} string "no session | 无有效会话"
// @Failure 403 {object} string "missing role:manage | 缺少 role:manage"
// @Security BearerAuth
// @Router /mgr/roles/new [get]
func (c *Controller) NewRoleForm(ctx *router.Ctx) {
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return
	}
	_, catalogue, err := c.roles.Matrix(ctx.Request.Context(), tenantID)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	c.render(ctx, http.StatusOK, TplRoleCreateDrawer, c.pageView(ctx, "新建角色 | Create role", map[string]any{
		"Catalogue": catalogue,
	}))
}

// EditRoleForm 返回编辑角色抽屉：名称只读，说明与权限勾选可改。
// EditRoleForm returns the role edit drawer: the name is read-only while description and capabilities stay editable.
//
// @Summary Role edit form | 编辑角色表单
// @Description Renders one role with the full capability catalogue ticked to its current grants. The form posts to
// @Description POST /roles, whose upsert semantics keep the existing role id because the name travels in a hidden field.
// @Description 渲染单个角色与完整能力目录，勾选状态对应当前授予。表单提交到 POST /roles；名称由隐藏字段带回，
// @Description 因此 upsert 语义会更新既有角色而不是新建一个。
// @Tags roles
// @Accept html
// @Produce html
// @Param id path string true "role id | 角色 ID"
// @Success 200 {object} string "drawer fragment | 抽屉片段"
// @Failure 401 {object} string "no session | 无有效会话"
// @Failure 403 {object} string "missing role:manage | 缺少 role:manage"
// @Failure 404 {object} string "no such role in this tenant | 本租户内没有该角色"
// @Security BearerAuth
// @Router /mgr/roles/{id}/edit [get]
func (c *Controller) EditRoleForm(ctx *router.Ctx) {
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return
	}
	role, err := c.roles.Get(ctx.Request.Context(), tenantID, ctx.Param("id"))
	if err != nil {
		c.failService(ctx, err)
		return
	}
	_, catalogue, err := c.roles.Matrix(ctx.Request.Context(), tenantID)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	// 勾选状态在这里算好：模板只读布尔值，不调用带参数的方法。
	// The ticked state is computed here: the template only reads a boolean and never calls a
	// method with an argument.
	options := make([]permissionOption, 0, len(catalogue))
	for _, info := range catalogue {
		options = append(options, permissionOption{Info: info, Granted: role.Granted(info.Key)})
	}
	// The key must not be "Role": authz.Data injects the role-name map under that very key and
	// would overwrite the record. | 键名不能是 "Role"：authz.Data 会在同名键下注入角色名映射，
	// 从而覆盖这条记录。
	c.render(ctx, http.StatusOK, TplRoleEditDrawer, c.pageView(ctx, "编辑角色 | Edit role", map[string]any{
		"Target":            role,
		"PermissionOptions": options,
	}))
}

// permissionOption 是权限目录中的一项与它在该角色上的勾选状态。
// permissionOption pairs one catalogue entry with its ticked state on a role.
type permissionOption struct {
	// Info is the catalogue entry. | Info 是权限目录项。
	Info model.PermissionInfo
	// Granted reports whether this role holds it. | Granted 报告该角色是否已授予它。
	Granted bool
}

// SaveRole 新建或覆盖一个角色（同名即覆盖，因此表单既新建也编辑）。
// SaveRole creates or replaces a role; the same name replaces, so one form both creates and edits.
//
// @Summary Save role | 保存角色
// @Description Upserts by name inside the tenant and normalises the submitted capabilities against the catalogue:
// @Description unknown tokens are refused with 422 and duplicates collapse, so the stored set is always a subset of the
// @Description catalogue in catalogue order.
// @Description 在租户内按名称 upsert，并把提交的能力对照目录规范化：未知标识以 422 拒绝、重复项合并，因此存储的集合永远是目录的子集
// @Description 且按目录顺序排列。
// @Tags roles
// @Accept html
// @Produce html
// @Param name formData string true "role name, unique inside the tenant | 角色名，租户内唯一"
// @Param description formData string false "human-readable description | 说明文案"
// @Param permissions formData []string false "capability tokens | 能力标识"
// @Success 200 {object} string "refreshed role list fragment | 刷新后的角色列表片段"
// @Failure 401 {object} string "no session | 无有效会话"
// @Failure 403 {object} string "missing role:manage | 缺少 role:manage"
// @Failure 422 {object} string "unknown capability or empty name | 未知能力或名称为空"
// @Security BearerAuth
// @Router /mgr/roles [post]
func (c *Controller) SaveRole(ctx *router.Ctx) {
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return
	}

	perms := make([]model.Permission, 0, len(model.Permissions()))
	for _, key := range formValues(ctx, FieldPermission) {
		perms = append(perms, model.Permission(key))
	}
	// Anti-escalation: an administrator may write only capabilities it already holds. Without this
	// an admin could grant itself tenant:delete or permission:manage, which the registry
	// deliberately withholds. | 防越权：管理员只能写入自己已持有的能力。缺少这道检查时，管理员
	// 可以给自己授予注册表刻意保留的 tenant:delete 或 permission:manage。
	if !c.actorHoldsAll(ctx, perms) {
		c.failService(ctx, auth.ErrForbidden)
		return
	}

	saved, err := c.roles.Save(ctx.Request.Context(), tenantID, field(ctx, FieldName), field(ctx, FieldDescription), perms)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	c.log.Info("role saved | 角色已保存",
		log.Str("tenant", tenantID),
		log.Str("role", saved.Name),
		log.Int("permissions", len(saved.Permissions)),
	)
	c.rolesPage(ctx, http.StatusOK, "角色已保存 | role saved")
}

// ToggleRolePermission 在权限矩阵里授予或回收一项能力。
// ToggleRolePermission grants or revokes one capability in the permission matrix.
//
// @Summary Grant or revoke a capability | 授予或回收权限
// @Description Adds or removes one capability from one role of the tenant. Both the role and the capability are validated
// @Description against this tenant's state and the global catalogue, so a matrix cell can only ever hold a real capability.
// @Description 为本租户的某个角色增删一项能力。角色与能力都对照本租户状态和全局目录校验，因此矩阵单元格里只可能出现真实的能力标识。
// @Tags roles
// @Accept html
// @Produce html
// @Param id path string true "role id | 角色 ID"
// @Param permission formData string true "capability token | 能力标识"
// @Param granted formData string true "true to grant, anything else revokes | true 为授予，其余为回收"
// @Success 200 {object} string "refreshed role list fragment | 刷新后的角色列表片段"
// @Failure 401 {object} string "no session | 无有效会话"
// @Failure 403 {object} string "missing role:update | 缺少 role:update"
// @Failure 404 {object} string "no such role in this tenant | 本租户内没有该角色"
// @Failure 422 {object} string "unknown capability | 未知能力"
// @Security BearerAuth
// @Router /mgr/roles/{id}/permissions [post]
func (c *Controller) ToggleRolePermission(ctx *router.Ctx) {
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return
	}
	roleID := ctx.Param("id")
	permission := model.Permission(field(ctx, FieldPermission))
	granted := field(ctx, FieldGranted) == "true"

	current, err := c.roles.Get(ctx.Request.Context(), tenantID, roleID)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	// The actor must already hold every capability the role carries (so it cannot edit an
	// owner-level role) and, when granting, the capability itself. | 管理员必须已经持有该角色的
	// 全部能力（因此改不了所有者级角色），授予时还必须持有被授予的那一项。
	if !c.actorHoldsAll(ctx, current.Permissions) || (granted && !c.actorHoldsAll(ctx, []model.Permission{permission})) {
		c.failService(ctx, auth.ErrForbidden)
		return
	}

	role, err := c.roles.Toggle(ctx.Request.Context(), tenantID, roleID, permission, granted)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	c.log.Info("capability toggled | 权限已切换",
		log.Str("tenant", tenantID),
		log.Str("role", role.Name),
		log.Str("permission", string(permission)),
		log.Bool("granted", granted),
	)
	c.rolesPage(ctx, http.StatusOK, "权限已更新 | permission updated")
}

// DeleteRole 删除本租户的一个角色；内置角色以 409 拒绝。
// DeleteRole removes one role of the tenant and refuses a built-in one with 409.
//
// @Summary Delete role | 删除角色
// @Description Removes a custom role. The four built-in roles are protected with 409: they are what every new tenant is
// @Description seeded with and what the user-create fallback assigns, so deleting one would break tenant provisioning.
// @Description 删除自定义角色。四个内置角色以 409 保护：每个新租户都靠它们初始化，建号回退也依赖它们，删掉会破坏租户的开通流程。
// @Tags roles
// @Accept html
// @Produce html
// @Param id path string true "role id | 角色 ID"
// @Success 200 {object} string "refreshed role list fragment | 刷新后的角色列表片段"
// @Failure 401 {object} string "no session | 无有效会话"
// @Failure 403 {object} string "missing role:delete | 缺少 role:delete"
// @Failure 404 {object} string "no such role in this tenant | 本租户内没有该角色"
// @Failure 409 {object} string "built-in roles are protected | 内置角色受保护"
// @Security BearerAuth
// @Router /mgr/roles/{id}/delete [post]
func (c *Controller) DeleteRole(ctx *router.Ctx) {
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return
	}
	roleID := ctx.Param("id")
	current, err := c.roles.Get(ctx.Request.Context(), tenantID, roleID)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	// A role carrying capabilities the actor does not hold is above its authority. | 携带管理员未持有
	// 能力的角色在管理员的权限之上。
	if !c.actorHoldsAll(ctx, current.Permissions) {
		c.failService(ctx, auth.ErrForbidden)
		return
	}

	if err := c.roles.Delete(ctx.Request.Context(), tenantID, roleID); err != nil {
		c.failService(ctx, err)
		return
	}
	c.log.Info("role deleted | 角色已删除",
		log.Str("tenant", tenantID),
		log.Str("role", roleID),
	)
	c.rolesPage(ctx, http.StatusOK, "角色已删除 | role deleted")
}

// Permissions 渲染权限矩阵：行是能力目录，列是角色，单元格可勾选。
// Permissions renders the permission matrix: rows are capabilities, columns are roles and a cell is a tick box.
//
// @Summary Permission matrix | 权限矩阵
// @Description Renders mgr/pages/permissions.html from two axes the service guarantees: the capability catalogue in its fixed
// @Description order and this tenant's roles. The matrix is the same data the navbar gates on, so what an operator sees
// @Description here is exactly what RequirePermission enforces at the router.
// @Description 用服务层保证的两条轴渲染 mgr/pages/permissions.html：固定顺序的能力目录，以及本租户的角色。矩阵与导航栏的显隐判定同源，
// @Description 因此这里看到的，就是路由上 RequirePermission 真正执行的那一套。
// @Tags permissions
// @Accept html
// @Produce html
// @Param HX-Request header string false "htmx partial request | htmx 局部请求标记"
// @Success 200 {object} string "permission matrix page or fragment | 权限矩阵整页或片段"
// @Failure 401 {object} string "no session | 无有效会话"
// @Failure 403 {object} string "missing permission:read | 缺少 permission:read"
// @Security BearerAuth
// @Router /mgr/permissions [get]
func (c *Controller) Permissions(ctx *router.Ctx) {
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return
	}

	roles, catalogue, err := c.roles.Matrix(ctx.Request.Context(), tenantID)
	if err != nil {
		c.failService(ctx, err)
		return
	}

	c.render(ctx, http.StatusOK, TplPermissions, c.pageView(ctx, "权限矩阵 | Permission matrix", map[string]any{
		"Roles":     roles,
		"Catalogue": catalogue,
	}))
}

// rolesPage 渲染角色列表片段，message 非空时附带一条提示。
// rolesPage renders the role list fragment and attaches a notice when message is non-empty.
func (c *Controller) rolesPage(ctx *router.Ctx, status int, message string) {
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return
	}

	roles, catalogue, err := c.roles.Matrix(ctx.Request.Context(), tenantID)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	total := len(roles)
	currentPage, pageCountValue, start, end := pageBounds(total, pageNumber(ctx), defaultPageSize)
	pages, prevHref, nextHref := pageLinks(total, currentPage, defaultPageSize, func(n int) string {
		return "/mgr/roles?page=" + strconv.Itoa(n)
	})
	if message != "" {
		c.toast(ctx, message)
	}
	c.render(ctx, status, TplRoles, c.pageView(ctx, "角色管理 | Roles", map[string]any{
		"Roles":     roles[start:end],
		"Catalogue": catalogue,
		"Total":     total,
		"Empty":     total == 0,
		"Page":      currentPage,
		"PageCount": pageCountValue,
		"Pages":     pages,
		"PrevHref":  prevHref,
		"NextHref":  nextHref,
	}))
}
