// dictionaryTypeView is the template and JSON projection of one dictionary type. | dictionaryTypeView
// 是一个字典类型的模板与 JSON 投影。
//
// @Name dictionaryTypeView
type dictionaryTypeView struct {
	// CreatedAt is the creation instant. | CreatedAt 是创建时刻。
	CreatedAt time.Time `json:"created_at"`
	// UpdatedAt is the last-write instant. | UpdatedAt 是最后写入时刻。
	UpdatedAt time.Time `json:"updated_at"`
	// ID is the primary key. | ID 是主键。
	ID string `json:"id"`
	// Code is the immutable dictionary code. | Code 是不可变字典编码。
	Code string `json:"code"`
	// Name is the Chinese display name. | Name 是中文展示名。
	Name string `json:"name"`
	// NameEN is the English display name. | NameEN 是英文展示名。
	NameEN string `json:"name_en,omitempty"`
	// Description explains the dictionary. | Description 说明字典用途。
	Description string `json:"description,omitempty"`
	// Status is enabled or disabled. | Status 取 enabled 或 disabled。
	Status string `json:"status"`
	// Scope is the tenant or system layer. | Scope 取租户层或系统层。
	Scope string `json:"scope"`
	// Sort is the display order. | Sort 是展示顺序。
	Sort int `json:"sort"`
	// ItemCount is the number of items. | ItemCount 是字典项数量。
	ItemCount int `json:"item_count"`
	// Builtin marks a framework-seeded dictionary. | Builtin 标记框架预置字典。
	Builtin bool `json:"builtin,omitempty"`
	// Label is the locale-selected name used by templates only. | Label 是模板使用的按语言选择的名称。
	Label string `json:"-"`
	// Href is the workbench URL selecting this type, used by templates only. | Href 是选择该类型的工作台 URL，仅模板使用。
	Href string `json:"-"`
	// Active marks the row selected by the current request, used by templates only. | Active 标记当前请求选中的行，仅模板使用。
	Active bool `json:"-"`
}

