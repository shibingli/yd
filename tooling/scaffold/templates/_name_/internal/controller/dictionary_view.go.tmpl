// dictionaryHref builds one workbench URL with the complete view state. | dictionaryHref 构造带完整视图状态的工作台 URL。
func dictionaryHref(basePath, selectedID, keyword, itemKeyword string, page, itemPage int) string {
	basePath = strings.TrimSpace(basePath)
	if basePath == "" {
		basePath = "/mgr/dictionaries"
	}
	values := url.Values{}
	if selectedID = strings.TrimSpace(selectedID); selectedID != "" {
		values.Set("type", selectedID)
	}
	if keyword = strings.TrimSpace(keyword); keyword != "" {
		values.Set("q", keyword)
	}
	if itemKeyword = strings.TrimSpace(itemKeyword); itemKeyword != "" {
		values.Set("iq", itemKeyword)
	}
	if page > 1 {
		values.Set("page", strconv.Itoa(page))
	}
	if itemPage > 1 {
		values.Set("ipage", strconv.Itoa(itemPage))
	}
	if len(values) == 0 {
		return basePath
	}
	return basePath + "?" + values.Encode()
}

// dictionaryItemPageNumber reads the 1-based item page query. | dictionaryItemPageNumber 读取从 1 开始的字典项页码。
func dictionaryItemPageNumber(ctx *router.Ctx) int {
	page, err := strconv.Atoi(strings.TrimSpace(ctx.Query("ipage")))
	if err != nil || page < 1 {
		return 1
	}
	return page
}

// formInt reads one integer form field and falls back to zero. | formInt 读取一个整数表单字段，非法时回到零值。
func formInt(ctx *router.Ctx, name string) int {
	value, err := strconv.Atoi(strings.TrimSpace(ctx.FormValue(name)))
	if err != nil {
		return 0
	}
	return value
}

// dictionaryLongField reads a form field with an explicit byte cap, for descriptions, remarks and JSON. |
// dictionaryLongField 以显式字节上限读取表单字段，用于说明、备注与 JSON。
func dictionaryLongField(ctx *router.Ctx, name string, max int) string {
	value := strings.TrimSpace(ctx.FormValue(name))
	if max > 0 && len(value) > max {
		cut := max
		for cut > 0 && value[cut]&0xC0 == 0x80 {
			cut--
		}
		value = value[:cut]
	}
	return value
}

// dictionaryUnavailable ends an HTML request with the assembly error. | dictionaryUnavailable 以装配错误结束 HTML 请求。
func (c *Controller) dictionaryUnavailable(ctx *router.Ctx) {
	message := service.ErrDictionaryUnavailable.Error()
	if c.dictionaryErr != nil {
		message = c.dictionaryErr.Error()
	}
	c.fail(ctx, http.StatusServiceUnavailable, message)
}

// dictionaryTypeViews converts domain types into template/API views. | dictionaryTypeViews 把领域类型转换为模板/API 视图。
func dictionaryTypeViews(types []dictionary.Type, lang string) []dictionaryTypeView {
	out := make([]dictionaryTypeView, 0, len(types))
	for _, current := range types {
		out = append(out, dictionaryTypeView{
			CreatedAt:   current.CreatedAt,
			UpdatedAt:   current.UpdatedAt,
			ID:          current.ID,
			Code:        current.Code,
			Name:        current.Name,
			NameEN:      current.NameEN,
			Description: current.Description,
			Status:      string(current.Status),
			Scope:       string(dictionary.ScopeOf(current.TenantID)),
			Sort:        current.Sort,
			ItemCount:   current.ItemCount,
			Builtin:     current.Builtin,
			Label:       dictionaryDisplay(current.Name, current.NameEN, lang),
		})
	}
	return out
}

// dictionaryItemViews converts domain items into template/API views. | dictionaryItemViews 把领域字典项转换为模板/API 视图。
func dictionaryItemViews(items []dictionary.Item, lang string) []dictionaryItemView {
	out := make([]dictionaryItemView, 0, len(items))
	for _, current := range items {
		out = append(out, dictionaryItemView{
			CreatedAt: current.CreatedAt,
			UpdatedAt: current.UpdatedAt,
			ID:        current.ID,
			TypeID:    current.TypeID,
			Value:     current.Value,
			Label:     dictionaryDisplay(current.Label, current.LabelEN, lang),
			LabelZH:   current.Label,
			LabelEN:   current.LabelEN,
			Extra:     dictionaryExtraValue(current.Extra),
			ExtraText: current.Extra,
			Remark:    current.Remark,
			Status:    string(current.Status),
			Scope:     string(dictionary.ScopeOf(current.TenantID)),
			IsDefault: current.IsDefault,
			Sort:      current.Sort,
		})
	}
	return out
}

// dictionaryDisplay selects the English label for an English locale when it exists. | dictionaryDisplay
// 在英文语言环境且存在英文标签时选择英文标签。
func dictionaryDisplay(chinese, english, lang string) string {
	if strings.HasPrefix(strings.ToLower(strings.TrimSpace(lang)), "en") && strings.TrimSpace(english) != "" {
		return english
	}
	return chinese
}

// dictionaryExtraValue decodes stored JSON metadata for the API; invalid stored data is omitted. |
// dictionaryExtraValue 为 API 解码已存储的 JSON 元数据；损坏的存量数据直接省略。
func dictionaryExtraValue(raw string) any {
	raw = strings.TrimSpace(raw)
	if raw == "" {
		return nil
	}
	var value any
	if err := json.Unmarshal([]byte(raw), &value); err != nil {
		return nil
	}
	return value
}
