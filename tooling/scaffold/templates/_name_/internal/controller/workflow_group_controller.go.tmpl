// renderWorkflowGroupList renders the group table after one mutation. | renderWorkflowGroupList
// 在变更后渲染组表格。
func (c *Controller) renderWorkflowGroupList(ctx *router.Ctx, tenantID string) {
	// Mutations carry no filters of their own; recover them from the page the operator was on. |
	// 变更请求本身不带筛选条件，从操作人所在页面恢复。
	keyword := firstNonEmpty(field(ctx, "return_q"), workflowCurrentQuery(ctx, FieldKeyword))
	status := firstNonEmpty(field(ctx, "return_status"), workflowCurrentQuery(ctx, FieldWorkflowFilterStatus))
	pageNo := pageNumberFromQuery(ctx, firstNonEmpty(field(ctx, "return_page"), workflowCurrentQuery(ctx, "page")))
	page, err := c.workflow.ListGroups(ctx.Request.Context(), tenantID, workflow.GroupFilter{
		Query: keyword, Status: status, Page: pageNo,
	})
	if err != nil {
		c.failService(ctx, err)
		return
	}
	c.render(ctx, http.StatusOK, TplWorkflowGroupList, c.view(ctx, "流程组 | Groups", map[string]any{
		"Groups": page.Items, "Total": page.Total, "Page": page.Page, "PageSize": page.PageSize,
		"Keyword": keyword, "Status": status,
		"CanManage": c.workflowCanManage(ctx),
		"OOB":       true,
		"Pagination": c.workflowPagination(ctx, "/mgr/workflow-groups", map[string]string{
			"q": keyword, "status": status,
		}, page.Page, page.PageSize, page.Total),
	}))
}

// WorkflowGroupMembersDrawer renders the membership drawer. | WorkflowGroupMembersDrawer 渲染成员抽屉。
//
// @Summary Group membership drawer | 组成员抽屉
// @Description Returns explicit members; workflow:manage also receives the editable checkboxes. | 返回显式成员；workflow:manage 还会得到可编辑的勾选框。
// @Tags workflow
// @Produce html
// @Param id path string true "Group id | 组 ID"
// @Success 200 {string} string "membership form | 成员表单"
// @Security BearerAuth
// @Router /mgr/workflow-groups/{id}/members [get]
func (c *Controller) WorkflowGroupMembersDrawer(ctx *router.Ctx) {
	if !c.workflowServiceOrFail(ctx) {
		return
	}
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return
	}
	group, err := c.workflow.GetGroup(ctx.Request.Context(), tenantID, ctx.Param("id"))
	if err != nil {
		c.failService(ctx, err)
		return
	}
	members, err := c.workflow.GroupMembers(ctx.Request.Context(), tenantID, group.ID)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	canManage := c.workflowCanManage(ctx)
	rows := make([]map[string]any, 0, len(members))
	if canManage {
		users, err := c.users.List(ctx.Request.Context(), tenantID, "")
		if err != nil {
			c.failService(ctx, err)
			return
		}
		selected := make(map[string]bool, len(members))
		for _, member := range members {
			selected[member.UserID] = true
		}
		rows = make([]map[string]any, 0, len(users))
		for _, user := range users {
			rows = append(rows, map[string]any{
				"ID": user.ID, "Name": user.DisplayName, "Username": user.Username, "Selected": selected[user.ID],
			})
		}
	} else {
		// Read-only viewers see the explicit members only; the full tenant user directory
		// belongs to workflow:manage. | 只读查看者只看到显式成员；完整租户用户目录属于
		// workflow:manage。
		for _, member := range members {
			name := member.UserName
			if name == "" {
				name = member.UserID
			}
			rows = append(rows, map[string]any{
				"ID": member.UserID, "Name": name, "Username": "", "Selected": true,
			})
		}
	}
	c.render(ctx, http.StatusOK, TplWorkflowGroupMembers, c.view(ctx, "组成员 | Group members", map[string]any{
		"Group": group, "Users": rows, "Selected": len(members), "CanManage": canManage,
	}))
}

// SetWorkflowGroupMembers replaces the explicit members of one group. | SetWorkflowGroupMembers
// 替换一个组的显式成员。
//
// @Summary Replace group members | 替换组成员
// @Description Sets the explicit member list; linked role holders remain implicit members. | 设置显式成员列表；关联角色的持有者仍是隐式成员。
// @Tags workflow
// @Accept application/x-www-form-urlencoded
// @Produce html
// @Param id path string true "Group id | 组 ID"
// @Param members formData string false "Repeated user ids | 重复出现的用户 ID"
// @Success 200 {string} string "group table | 组表格"
// @Security BearerAuth
// @Router /mgr/workflow-groups/{id}/members [post]
func (c *Controller) SetWorkflowGroupMembers(ctx *router.Ctx) {
	if !c.workflowServiceOrFail(ctx) {
		return
	}
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return
	}
	userIDs := formValues(ctx, FieldWorkflowMembers)
	if len(userIDs) == 0 {
		for _, value := range strings.Split(ctx.FormValue(FieldWorkflowMembers), ",") {
			if trimmed := strings.TrimSpace(value); trimmed != "" {
				userIDs = append(userIDs, trimmed)
			}
		}
	}
	if _, err := c.workflow.SetGroupMembers(ctx.Request.Context(), tenantID, ctx.Param("id"), userIDs); err != nil {
		c.failService(ctx, err)
		return
	}
	c.toast(ctx, "组成员已保存 | Group members saved")
	c.renderWorkflowGroupList(ctx, tenantID)
}

// workflowRoleOptions renders the optional linked-role select. | workflowRoleOptions 渲染可选的关联角色下拉项。
func workflowRoleOptions(roles []model.Role, selected string) []map[string]any {
	options := make([]map[string]any, 0, len(roles))
	for _, role := range roles {
		options = append(options, map[string]any{
			"Value":    role.Name,
			"Label":    role.Name,
			"Selected": role.Name == selected,
		})
	}
	return options
}
