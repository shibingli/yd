// SaveWorkflowGroup creates one group. | SaveWorkflowGroup 创建一个组。
//
// @Summary Create group | 创建组
// @Description Creates a workflow group with an optional linked role. | 创建可关联角色的流程组。
// @Tags workflow
// @Accept application/x-www-form-urlencoded
// @Produce html
// @Param key formData string true "Immutable group key | 不可变组键"
// @Param name formData string true "Chinese name | 中文名"
// @Param role formData string false "Linked yd role | 关联 yd 角色"
// @Success 200 {string} string "group table | 组表格"
// @Security BearerAuth
// @Router /mgr/workflow-groups [post]
func (c *Controller) SaveWorkflowGroup(ctx *router.Ctx) {
	if !c.workflowServiceOrFail(ctx) {
		return
	}
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return
	}
	if _, err := c.workflow.CreateGroup(ctx.Request.Context(), tenantID, workflow.GroupInput{
		Key:         field(ctx, FieldWorkflowKey),
		Name:        field(ctx, FieldName),
		NameEN:      field(ctx, FieldNameEN),
		Description: workflowLongField(ctx, FieldDescription, 500),
		Role:        field(ctx, FieldWorkflowGroupRole),
		Status:      firstNonEmpty(field(ctx, FieldStatus), workflow.GroupEnabled),
	}); err != nil {
		c.failService(ctx, err)
		return
	}
	c.toast(ctx, "流程组已创建 | Group created")
	c.renderWorkflowGroupList(ctx, tenantID)
}

