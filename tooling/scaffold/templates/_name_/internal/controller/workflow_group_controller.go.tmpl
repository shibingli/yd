// WorkflowGroups renders the group directory. | WorkflowGroups 渲染流程组目录。
//
// @Summary Workflow groups | 流程组目录
// @Description Lists workflow-owned approval groups with member counts and linked roles. | 列出流程自有审批组、成员数与关联角色。
// @Tags workflow
// @Produce html
// @Param q query string false "Search keyword | 搜索关键字"
// @Param status query string false "Group state | 组状态"
// @Param page query int false "1-based page | 从 1 开始的页码"
// @Success 200 {string} string "group page | 组页面"
// @Security BearerAuth
// @Router /mgr/workflow-groups [get]
func (c *Controller) WorkflowGroups(ctx *router.Ctx) {
	if !c.workflowServiceOrFail(ctx) {
		return
	}
	if workflowHTMXTarget(ctx, "yd-workflow-groups") {
		c.WorkflowGroupList(ctx)
		return
	}
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return
	}
	page, err := c.workflow.ListGroups(ctx.Request.Context(), tenantID, workflow.GroupFilter{
		Query: field(ctx, FieldKeyword), Status: field(ctx, FieldWorkflowFilterStatus), Page: pageNumber(ctx),
	})
	if err != nil {
		c.failService(ctx, err)
		return
	}
	data := c.pageView(ctx, "流程组 | Workflow groups", map[string]any{
		"Groups":    page.Items,
		"Total":     page.Total,
		"Page":      page.Page,
		"PageSize":  page.PageSize,
		"Keyword":   field(ctx, FieldKeyword),
		"Status":    field(ctx, FieldWorkflowFilterStatus),
		"CanManage": c.workflowCanManage(ctx),
		"Pagination": c.workflowPagination(ctx, "/mgr/workflow-groups", map[string]string{
			"q": field(ctx, FieldKeyword), "status": field(ctx, FieldWorkflowFilterStatus),
		}, page.Page, page.PageSize, page.Total),
	})
	c.render(ctx, http.StatusOK, TplWorkflowGroups, data)
}

