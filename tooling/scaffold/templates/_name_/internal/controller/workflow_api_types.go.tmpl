// workflowDefinitionRequest is the create/update payload of a definition. | workflowDefinitionRequest
// 是流程定义的创建/更新载荷。
// @Name workflowDefinitionRequest
type workflowDefinitionRequest struct {
	// Key is required on create. | Key 在创建时必填。
	Key string `json:"key"`
	// Name and NameEN are the bilingual display names. | Name 与 NameEN 是中英展示名。
	Name   string `json:"name"`
	NameEN string `json:"name_en"`
	// Description explains the process. | Description 说明流程用途。
	Description string `json:"description"`
	// Category groups processes. | Category 为流程分组。
	Category string `json:"category"`
	// Icon is a lucide icon name. | Icon 是 lucide 图标名。
	Icon string `json:"icon"`
	// Status is the lifecycle state for updates. | Status 是更新时的生命周期状态。
	Status string `json:"status"`
}

// workflowVersionRequest is the create/update payload of a draft version. | workflowVersionRequest
// 是草稿版本的创建/更新载荷。
// @Name workflowVersionRequest
type workflowVersionRequest struct {
	// Design is the graph document. | Design 是图文档。
	Design workflow.Design `json:"design"`
	// Note is the draft or publication note. | Note 是草稿或发布说明。
	Note string `json:"note"`
}

// workflowPublishRequest is the publish payload. | workflowPublishRequest 是发布载荷。
// @Name workflowPublishRequest
type workflowPublishRequest struct {
	// Note is the publication note. | Note 是发布说明。
	Note string `json:"note"`
}

// workflowGroupRequest is the create/update payload of a workflow group. | workflowGroupRequest
// 是流程组的创建/更新载荷。
// @Name workflowGroupRequest
type workflowGroupRequest struct {
	// Key is required on create. | Key 在创建时必填。
	Key string `json:"key"`
	// Name and NameEN are the bilingual display names. | Name 与 NameEN 是中英展示名。
	Name   string `json:"name"`
	NameEN string `json:"name_en"`
	// Description explains the group. | Description 说明组用途。
	Description string `json:"description"`
	// Role links the group to a yd role. | Role 把组关联到 yd 角色。
	Role string `json:"role"`
	// Status is enabled or disabled. | Status 取 enabled 或 disabled。
	Status string `json:"status"`
}

// workflowGroupMembersRequest replaces the explicit member list. | workflowGroupMembersRequest
// 替换显式成员列表。
// @Name workflowGroupMembersRequest
type workflowGroupMembersRequest struct {
	// Members are the user ids. | Members 是用户 ID。
	Members []string `json:"members"`
}

// workflowStartRequest starts one instance. | workflowStartRequest 发起一个实例。
// @Name workflowStartRequest
type workflowStartRequest struct {
	// DefinitionID or DefinitionKey selects the definition. | DefinitionID 或 DefinitionKey 选择定义。
	DefinitionID  string `json:"definition_id"`
	DefinitionKey string `json:"definition_key"`
	// Version pins a published version; zero selects the latest. | Version 绑定已发布版本；零值选择最新。
	Version int `json:"version"`
	// Title is the instance subject. | Title 是实例标题。
	Title string `json:"title"`
	// BusinessKey is the external reference. | BusinessKey 是外部业务键。
	BusinessKey string `json:"business_key"`
	// Category overrides the definition category. | Category 覆盖定义分类。
	Category string `json:"category"`
	// Variables are instance variables. | Variables 是实例变量。
	Variables map[string]any `json:"variables"`
	// FormData is the start form submission. | FormData 是发起表单提交。
	FormData map[string]any `json:"form_data"`
}

// workflowActionRequest is one approve or reject call. | workflowActionRequest 是一次通过或驳回调用。
// @Name workflowActionRequest
type workflowActionRequest struct {
	// Action is approve or reject; empty falls back to Decision. | Action 取 approve 或 reject；空值回退到 Decision。
	Action string `json:"action"`
	// Decision is approve or reject. | Decision 取 approve 或 reject。
	Decision string `json:"decision"`
	// Comment is the approval note. | Comment 是审批意见。
	Comment string `json:"comment"`
	// FormData is the node form submission. | FormData 是节点表单提交。
	FormData map[string]any `json:"form_data"`
}

// workflowReassignRequest is one transfer or delegation call. | workflowReassignRequest 是一次转办或委派调用。
// @Name workflowReassignRequest
type workflowReassignRequest struct {
	// TargetID is the new assignee or delegate. | TargetID 是新处理人或受托人。
	TargetID string `json:"target_id"`
	// Comment explains the action. | Comment 说明动作原因。
	Comment string `json:"comment"`
}

// workflowAddSignRequest adds approvers. | workflowAddSignRequest 增加审批人。
// @Name workflowAddSignRequest
type workflowAddSignRequest struct {
	// UserIDs are the added approvers. | UserIDs 是新增审批人。
	UserIDs []string `json:"user_ids"`
	// Position is before or after. | Position 取 before 或 after。
	Position string `json:"position"`
	// Comment explains the action. | Comment 说明动作原因。
	Comment string `json:"comment"`
}

// workflowReturnRequest returns an instance. | workflowReturnRequest 退回实例。
// @Name workflowReturnRequest
type workflowReturnRequest struct {
	// TargetNodeID is a visited user task or the initiator node. | TargetNodeID 是已访问用户任务或发起人节点。
	TargetNodeID string `json:"target_node_id"`
	// Comment explains the return. | Comment 说明退回原因。
	Comment string `json:"comment"`
}

// workflowRemoveSignRequest removes one queued task. | workflowRemoveSignRequest 移除一条排队任务。
// @Name workflowRemoveSignRequest
type workflowRemoveSignRequest struct {
	// TaskID is the queued task to cancel. | TaskID 是要取消的排队任务。
	TaskID string `json:"task_id"`
	// Comment explains the removal. | Comment 说明减签原因。
	Comment string `json:"comment"`
}

// workflowReasonRequest carries a withdrawal or termination reason. | workflowReasonRequest
// 承载撤回或终止原因。
// @Name workflowReasonRequest
type workflowReasonRequest struct {
	// Reason explains the action. | Reason 说明动作原因。
	Reason string `json:"reason"`
}

// workflowRemindRequest carries one reminder note. | workflowRemindRequest 承载一条催办说明。
// @Name workflowRemindRequest
type workflowRemindRequest struct {
	// Comment is the reminder text. | Comment 是催办文本。
	Comment string `json:"comment"`
}

// workflowSignalRequest delivers one message event. | workflowSignalRequest 投递一个消息事件。
// @Name workflowSignalRequest
type workflowSignalRequest struct {
	// Signal is the message name. | Signal 是消息名。
	Signal string `json:"signal"`
	// Payload is merged into the instance variables. | Payload 合并进实例变量。
	Payload map[string]any `json:"payload"`
}

// workflowTaskActionResponse is the API shape after one task action. | workflowTaskActionResponse
// 是一次任务动作后的 API 形态。
// @Name workflowTaskActionResponse
type workflowTaskActionResponse struct {
	// Task is the updated task. | Task 是更新后的任务。
	Task workflow.Task `json:"task"`
	// Instance is the reloaded instance. | Instance 是重新读取的实例。
	Instance workflow.Instance `json:"instance"`
}

// workflowVersionResponse adds the parsed design to one version. | workflowVersionResponse
// 为一个版本补充解析后的设计。
// @Name workflowVersionResponse
type workflowVersionResponse struct {
	// Version is the stored row. | Version 是存储行。
	workflow.Version
	// Document is the parsed design. | Document 是解析后的设计。
	Document workflow.Design `json:"document"`
}

