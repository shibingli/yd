// @Param body body dictionaryTypeRequest true "type payload | 类型载荷"
// @Success 201 {object} dictionaryTypeView "created type | 已创建类型"
// @Failure 409 {object} string "duplicate code | 编码重复"
// @Failure 422 {object} string "validation failed | 校验失败"
// @Security BearerAuth
// @Router /api/v1/dictionaries [post]
func (c *Controller) APICreateDictionary(ctx *router.Ctx) {
	if !c.dictionaryAPIAvailable(ctx) {
		return
	}
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return
	}
	var request dictionaryTypeRequest
	if err := ctx.Bind(&request); err != nil {
		c.dictionaryAPIFail(ctx, dictionary.ErrInvalidInput)
		return
