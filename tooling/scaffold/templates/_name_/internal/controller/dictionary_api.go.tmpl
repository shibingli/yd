// dictionaryAPIAvailable reports availability and writes a JSON error when unavailable. | dictionaryAPIAvailable
// 报告可用性，不可用时写出 JSON 错误。
func (c *Controller) dictionaryAPIAvailable(ctx *router.Ctx) bool {
	if c.DictionariesAvailable() {
		return true
	}
	message := service.ErrDictionaryUnavailable.Error()
	if c.dictionaryErr != nil {
		message = c.dictionaryErr.Error()
	}
	_ = ctx.JSON(http.StatusServiceUnavailable, map[string]any{"error": message})
	return false
}

// dictionaryAPIFail maps a domain error onto a JSON response. | dictionaryAPIFail 把领域错误映射为 JSON 响应。
func (c *Controller) dictionaryAPIFail(ctx *router.Ctx, err error) {
	status, message := statusFor(err)
	if status >= http.StatusInternalServerError {
		c.log.Error("dictionary API request failed | 数据字典 API 请求失败", log.Err(err), log.Str("path", ctx.Path()))
	}
	_ = ctx.JSON(status, map[string]any{"error": message})
}

