// APIPortalDictionaries resolves a batch of dictionaries. | APIPortalDictionaries 批量解析数据字典。
//
// @Summary Resolve dictionaries | 批量解析数据字典
// @Description Resolves up to 50 codes in one call. Both repeated code parameters and a comma-separated
// @Description codes parameter are accepted. Disabled types and items never appear; unknown codes are
// @Description reported under missing.
// @Description 一次解析最多 50 个编码。支持重复的 code 参数与逗号分隔的 codes 参数。停用的类型与字典项
// @Description 不会出现；未知编码列在 missing 下。
// @Tags dictionaries
// @Produce json
// @Param code query []string false "dictionary code, repeatable | 字典编码，可重复"
// @Param codes query string false "comma-separated codes | 逗号分隔的编码"
// @Success 200 {object} dictionaryBatchResponse "resolved dictionaries | 已解析字典"
// @Failure 422 {object} string "invalid or too many codes | 编码非法或过多"
// @Failure 503 {object} string "dictionary storage unavailable | 数据字典存储不可用"
// @Security BearerAuth
// @Router /api/portal/v1/dictionaries [get]
func (c *Controller) APIPortalDictionaries(ctx *router.Ctx) {
	if !c.dictionaryAPIAvailable(ctx) {
		return
	}
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return
	}
	codes := dictionaryCodes(ctx)
	if len(codes) == 0 {
		c.dictionaryAPIFail(ctx, dictionary.ErrInvalidInput)
		return
	}
	snapshots, err := c.dictionaries.ResolveMany(ctx.Request.Context(), tenantID, codes)
	if err != nil {
		c.dictionaryAPIFail(ctx, err)
		return
	}
	views, missing := dictionarySnapshotViews(snapshots, codes)
	_ = ctx.JSON(http.StatusOK, dictionaryBatchResponse{Dictionaries: views, Missing: missing})
}

// APIPortalDictionary resolves one dictionary by code. | APIPortalDictionary 按编码解析一个字典。
//
// @Summary Resolve one dictionary | 解析单个数据字典
// @Description Returns the enabled type and its enabled items. | 返回启用类型及其启用字典项。
// @Tags dictionaries
// @Produce json
// @Param code path string true "dictionary code | 字典编码"
// @Success 200 {object} dictionarySnapshotView "resolved dictionary | 已解析字典"
// @Failure 404 {object} string "dictionary not found or disabled | 字典不存在或已停用"
// @Failure 503 {object} string "dictionary storage unavailable | 数据字典存储不可用"
// @Security BearerAuth
// @Router /api/portal/v1/dictionaries/{code} [get]
func (c *Controller) APIPortalDictionary(ctx *router.Ctx) {
	if !c.dictionaryAPIAvailable(ctx) {
		return
	}
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return
	}
	snapshot, err := c.dictionaries.Resolve(ctx.Request.Context(), tenantID, ctx.Param("code"))
	if err != nil {
		c.dictionaryAPIFail(ctx, err)
		return
	}
	_ = ctx.JSON(http.StatusOK, dictionarySnapshotViewOf(snapshot))
}

// APIDictionaries lists dictionary types. | APIDictionaries 列出数据字典类型。
//
// @Summary List dictionary types | 列出字典类型
// @Description Returns one page of types, including disabled ones. q matches code and both names.
// @Description 返回一页类型（含停用类型）。q 匹配编码与中英文名称。
// @Tags dictionaries
// @Produce json
// @Param q query string false "search keyword | 搜索关键字"
// @Param status query string false "enabled|disabled | 启停状态"
// @Param page query int false "1-based page | 从 1 开始的页码"
// @Param page_size query int false "page length | 页长"
// @Success 200 {object} string "type page | 类型分页"
// @Failure 503 {object} string "dictionary storage unavailable | 数据字典存储不可用"
// @Security BearerAuth
// @Router /api/v1/dictionaries [get]
func (c *Controller) APIDictionaries(ctx *router.Ctx) {
	if !c.dictionaryAPIAvailable(ctx) {
		return
	}
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return
	}
	page, err := c.dictionaries.ListTypes(ctx.Request.Context(), tenantID, dictionary.Filter{
		Query:    strings.TrimSpace(ctx.Query(FieldKeyword)),
		Status:   dictionary.Status(strings.TrimSpace(ctx.Query(FieldStatus))),
		Page:     queryInt(ctx, "page", 1),
		PageSize: queryInt(ctx, "page_size", defaultPageSize),
	})
	if err != nil {
		c.dictionaryAPIFail(ctx, err)
		return
	}
	_ = ctx.JSON(http.StatusOK, map[string]any{
		"items":     dictionaryTypeViews(page.Items, c.lang(ctx)),
		"total":     page.Total,
		"page":      page.Page,
		"page_size": page.PageSize,
	})
}

// APIDictionary returns one type and its items. | APIDictionary 返回一个类型及其字典项。
//
// @Summary Read a dictionary type | 读取字典类型
// @Description Returns the type and one page of its items. Disabled items are included by default;
// @Description pass include_disabled=false for enabled items only.
// @Description 返回类型及其一页字典项。默认包含停用项；传 include_disabled=false 只返回启用项。
// @Tags dictionaries
// @Produce json
// @Param id path string true "type id | 类型 ID"
// @Param include_disabled query bool false "false returns enabled items only | 传 false 只返回启用项"
// @Param page query int false "1-based item page | 从 1 开始的字典项页码"
// @Param page_size query int false "item page length | 字典项页长"
// @Success 200 {object} string "type and items | 类型与字典项"
// @Failure 404 {object} string "type not found | 类型不存在"
// @Security BearerAuth
// @Router /api/v1/dictionaries/{id} [get]
func (c *Controller) APIDictionary(ctx *router.Ctx) {
	if !c.dictionaryAPIAvailable(ctx) {
		return
	}
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return
	}
	current, err := c.dictionaries.GetType(ctx.Request.Context(), tenantID, ctx.Param("id"))
	if err != nil {
		c.dictionaryAPIFail(ctx, err)
		return
	}
	status := dictionary.Status("")
	if strings.EqualFold(strings.TrimSpace(ctx.Query("include_disabled")), "false") {
		status = dictionary.StatusEnabled
	}
	page, err := c.dictionaries.ListItems(ctx.Request.Context(), tenantID, current.ID, dictionary.ItemFilter{
		Status:   status,
		Page:     queryInt(ctx, "page", 1),
		PageSize: queryInt(ctx, "page_size", defaultPageSize),
	})
	if err != nil {
		c.dictionaryAPIFail(ctx, err)
		return
	}
	_ = ctx.JSON(http.StatusOK, map[string]any{
		"type":      dictionaryTypeViews([]dictionary.Type{current}, c.lang(ctx))[0],
		"items":     dictionaryItemViews(page.Items, c.lang(ctx)),
		"total":     page.Total,
		"page":      page.Page,
		"page_size": page.PageSize,
	})
}

