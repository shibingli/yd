// APICleanupAttachments deletes every unreferenced attachment matching the request. | APICleanupAttachments 删除匹配
// 请求的全部未引用附件。
//
// @Summary Clean up unreferenced attachments | 清理未引用附件
// @Description Deletes every unreferenced attachment matching the optional name, uploader and date filters, sends one
// @Description summary notice per affected uploader, and returns the total plus the per-uploader counts.
// @Description 删除匹配可选名称、上传者与日期筛选的全部未引用附件，为每个受影响的上传者发送一条汇总通知，并返回总数
// @Description 与按上传者分组的数量。
// @Tags attachments
// @Accept json
// @Produce json
// @Param body body apiAttachmentCleanupRequest true "cleanup filters and reason | 清理筛选与原因"
// @Success 200 {object} string "cleanup report | 清理报告"
// @Failure 403 {object} string "missing attachment:manage | 缺少 attachment:manage"
// @Failure 422 {object} string "missing or overlong reason | 原因缺失或过长"
// @Failure 503 {object} string "attachment centre unavailable | 附件中心不可用"
// @Security BearerAuth
// @Router /api/v1/attachments/cleanup [post]
func (c *Controller) APICleanupAttachments(ctx *router.Ctx) {
	if !c.attachmentsReady(ctx) {
		return
	}
	var request apiAttachmentCleanupRequest
	if err := ctx.Bind(&request); err != nil {
		c.apiFail(ctx, attachments.ErrInvalidInput)
		return
	}
	filters := attachmentFilters{
		Query:      strings.TrimSpace(request.Query),
		UploaderID: strings.TrimSpace(request.UploaderID),
		From:       strings.TrimSpace(request.From),
		To:         strings.TrimSpace(request.To),
	}
	report, err := c.attachments.DeleteUnreferenced(ctx.Request.Context(), c.attachmentActor(ctx), request.Reason, attachmentFilter(filters, 1, 1))
	if err != nil {
		c.apiFail(ctx, err)
		return
	}
	byUploader := make(map[string]int, len(report.ByUploader))
	for uploaderID, group := range report.ByUploader {
		byUploader[uploaderID] = group.Count
	}
	_ = ctx.JSON(http.StatusOK, map[string]any{
		"deleted":     report.Count,
		"by_uploader": byUploader,
	})
}

// attachmentsPage loads and renders either the portal or the management page. | attachmentsPage 加载并渲染门户或
// 管理页面。
func (c *Controller) attachmentsPage(ctx *router.Ctx, management bool, notice string) {
	templateName := TplAttachments
	titleKey := "page.attachments.title"
	if management {
		templateName = TplMgrAttachments
		titleKey = "page.mgr_attachments.title"
	}
	title := c.tr(c.lang(ctx), titleKey)
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return
	}
	page := attachmentPage{
		Filters:           parseAttachmentFilters(ctx),
		CanCreate:         authz.Can(ctx.Request.Context(), authz.PermAttachmentCreate),
		CanDelete:         authz.Can(ctx.Request.Context(), authz.PermAttachmentDelete),
		CanManage:         authz.Can(ctx.Request.Context(), authz.PermAttachmentManage),
		ReasonMax:         0,
		MaxSizeText:       "",
		AllowedTypesText:  "",
		CleanupURL:        "",
		UnreferencedURL:   "",
		Uploaders:         nil,
		Items:             nil,
		Pages:             nil,
		PrevHref:          "",
		NextHref:          "",
		Error:             "",
		Total:             0,
		Page:              1,
		PageCount:         0,
		CleanupCount:      0,
		Unavailable:       false,
		Empty:             false,
	}
	if !c.AttachmentsAvailable() {
		page.Unavailable = true
		if err := c.AttachmentError(); err != nil {
			page.Error = err.Error()
		}
		c.render(ctx, http.StatusServiceUnavailable, templateName, c.pageView(ctx, title, page.data()))
		return
	}
	options := c.attachments.Options()
	page.ReasonMax = options.MaxReasonLen
	page.MaxSizeText = sizeText(options.MaxSize)
	page.AllowedTypesText = strings.Join(options.AllowedTypes, ", ")
	actor := c.attachmentActor(ctx)
	filter := attachmentFilter(page.Filters, options.PageSize, 0)
	var result attachments.Page
	var err error
	if management {
		if !actor.Manage && !actor.ReadAll {
			c.failService(ctx, attachments.ErrNotFound)
			return
		}
		result, err = c.attachments.ListAll(ctx.Request.Context(), actor, filter)
	} else {
		result, err = c.attachments.ListOwn(ctx.Request.Context(), actor, filter)
	}
	if err != nil {
		c.failService(ctx, err)
		return
	}
	current, pageCount, _, _ := pageBounds(result.Total, page.Filters.Page, result.PageSize)
	if current != page.Filters.Page {
		// An out-of-range page refetches the last page instead of presenting an empty result. |
		// 页码越界时重取最后一页，而不是把空页当成结果。
		page.Filters.Page = current
		filter = attachmentFilter(page.Filters, options.PageSize, 0)
		if management {
			result, err = c.attachments.ListAll(ctx.Request.Context(), actor, filter)
		} else {
			result, err = c.attachments.ListOwn(ctx.Request.Context(), actor, filter)
		}
		if err != nil {
			c.failService(ctx, err)
			return
		}
	}
	page.Total = result.Total
	page.Page = current
	page.PageCount = pageCount
	page.Empty = len(result.Items) == 0
	page.Filtered = page.Filters.Query != "" || page.Filters.Status != "" || page.Filters.Referenced != "" ||
		page.Filters.UploaderID != "" || page.Filters.From != "" || page.Filters.To != ""

	var names map[string]string
	if management {
		names = c.uploaderNames(ctx, tenantID, result.Items)
		page.Uploaders = c.uploaderOptions(ctx, tenantID, page.Filters.UploaderID)
	}
	base := attachmentPortalBase
	if management {
		base = attachmentMgrBase
	}
	views := make([]attachmentView, 0, len(result.Items))
	for _, item := range result.Items {
		deletable := page.CanDelete && !management &&
			item.UploaderID == actor.ID && item.Status == attachments.StatusPending && item.RefCount == 0
		views = append(views, c.attachmentViewOf(item, base, names[item.UploaderID], deletable))
	}
	page.Items = views
	href := func(n int) string {
		return page.Filters.href(base, n)
	}
	page.Pages, page.PrevHref, page.NextHref = pageLinks(result.Total, current, result.PageSize, href)
	page.UnreferencedURL = page.Filters.withReferenced("no").href(base, 1)
	if management {
		cleanupFilters := page.Filters
		cleanupFilters.Referenced = "no"
		cleanupFilters.Status = ""
		cleanupFilters.Page = 1
		cleanupResult, cleanupErr := c.attachments.ListAll(ctx.Request.Context(), actor, attachmentFilter(cleanupFilters, options.PageSize, 1))
		if cleanupErr != nil {
			c.failService(ctx, cleanupErr)
			return
		}
		page.CleanupCount = cleanupResult.Total
		page.CleanupURL = cleanupFilters.href(attachmentMgrBase+"/cleanup", 1)
	}
	if notice != "" {
		c.toast(ctx, notice)
	}
	c.render(ctx, http.StatusOK, templateName, c.pageView(ctx, title, page.data()))
}

// attachmentViewOf converts one domain row. | attachmentViewOf 转换一条领域记录。
func (c *Controller) attachmentViewOf(item attachments.Attachment, base, uploaderName string, canDelete bool) attachmentView {
	downloadURL := base + "/" + item.ID + "/download"
	view := attachmentView{
		Attachment:   item,
		SizeText:     sizeText(item.Size),
		CreatedText:  item.CreatedAt.UTC().Format("2006-01-02 15:04"),
		UploaderName: uploaderName,
		DownloadURL:  downloadURL,
		PreviewURL:   "",
		StatusKey:    "attachment.status." + string(item.Status),
		StatusTone:   attachmentStatusTone(item.Status),
		DeleteURL:    base + "/" + item.ID + "/delete",
		Image:        false,
		Deleted:      item.Status == attachments.StatusDeleted,
		CanDelete:    canDelete,
	}
	if attachments.IsImage(item) {
		view.Image = true
		view.PreviewURL = downloadURL + "?inline=1"
	}
	if strings.TrimSpace(view.UploaderName) == "" {
		view.UploaderName = item.UploaderID
	}
	return view
}

// attachmentStatusTone maps a lifecycle state onto a badge tone. | attachmentStatusTone 把生命周期状态映射为徽标色调。
func attachmentStatusTone(status attachments.Status) string {
	switch status {
	case attachments.StatusReferenced:
		return "info"
	case attachments.StatusDeleted:
		return "danger"
	default:
		return "muted"
	}
}

// apiAttachmentRecordOf converts one row for JSON. | apiAttachmentRecordOf 转换一条 JSON 记录。
func (c *Controller) apiAttachmentRecordOf(item attachments.Attachment, base, uploaderName string) apiAttachmentRecord {
	downloadURL := base + "/" + item.ID + "/download"
	record := apiAttachmentRecord{
		Attachment:   item,
		SizeText:     sizeText(item.Size),
		DownloadURL:  downloadURL,
		UploaderName: uploaderName,
	}
	if attachments.IsImage(item) {
		record.PreviewURL = downloadURL + "?inline=1"
	}
	return record
}

// apiAttachmentList writes one JSON page. | apiAttachmentList 写出一个 JSON 分页。
func (c *Controller) apiAttachmentList(ctx *router.Ctx, management bool) {
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return
	}
	if !c.attachmentsReady(ctx) {
		return
	}
	actor := c.attachmentActor(ctx)
	filters := parseAttachmentFilters(ctx)
	options := c.attachments.Options()
	filter := attachmentFilter(filters, options.PageSize, 0)
	var result attachments.Page
	var err error
	if management {
		result, err = c.attachments.ListAll(ctx.Request.Context(), actor, filter)
	} else {
		result, err = c.attachments.ListOwn(ctx.Request.Context(), actor, filter)
	}
	if err != nil {
		c.apiFail(ctx, err)
		return
	}
	var names map[string]string
	base := attachmentPortalAPI
	if management {
		base = attachmentMgrAPI
		names = c.uploaderNames(ctx, tenantID, result.Items)
	}
	items := make([]apiAttachmentRecord, 0, len(result.Items))
	for _, item := range result.Items {
		items = append(items, c.apiAttachmentRecordOf(item, base, names[item.UploaderID]))
	}
	_ = ctx.JSON(http.StatusOK, apiAttachmentList{
		Items:    items,
		Total:    result.Total,
		Page:     result.Page,
		PageSize: result.PageSize,
	})
}

// attachmentsReady reports whether the capability can serve the request and answers 503 otherwise. |
// attachmentsReady 报告附件能力能否服务请求，否则以 503 应答。
func (c *Controller) attachmentsReady(ctx *router.Ctx) bool {
	if c.AttachmentsAvailable() {
		return true
	}
	reason := service.ErrAttachmentUnavailable
	if err := c.AttachmentError(); err != nil {
		reason = err
	}
	c.failService(ctx, reason)
	return false
}

// attachmentActor builds the domain actor from the request. | attachmentActor 从请求构造领域主体。
func (c *Controller) attachmentActor(ctx *router.Ctx) attachments.Actor {
	actor := attachments.Actor{}
	user, ok := auth.CurrentUser(ctx)
	if !ok || user == nil {
		return actor
	}
	actor.ID = user.ID
	actor.TenantID = user.TenantID
	actor.DisplayName = user.DisplayName
	if strings.TrimSpace(actor.DisplayName) == "" {
		actor.DisplayName = user.Username
	}
	if tenantID, ok := middleware.TenantID(ctx); ok {
		actor.TenantID = tenantID
	}
	request := ctx.Request.Context()
	actor.Manage = authz.Can(request, authz.PermAttachmentManage)
	actor.ReadAll = authz.Can(request, authz.PermAttachmentRead)
	return actor
}

// uploaderNames resolves the display names of a page of attachments. A failure only falls back to ids: the list
// itself stays usable when the user directory has a hiccup. | uploaderNames 解析一页附件的上传者展示名。失败时回退到
// ID：用户目录抖动不应让列表本身不可用。
func (c *Controller) uploaderNames(ctx *router.Ctx, tenantID string, items []attachments.Attachment) map[string]string {
	names := make(map[string]string, len(items))
	ids := make([]string, 0, len(items))
	seen := make(map[string]struct{}, len(items))
	for _, item := range items {
		if item.UploaderID == "" {
			continue
		}
		if _, ok := seen[item.UploaderID]; ok {
			continue
		}
		seen[item.UploaderID] = struct{}{}
		ids = append(ids, item.UploaderID)
	}
	if len(ids) == 0 {
		return names
	}
	users, err := c.store.Auth().GetUsers(ctx.Request.Context(), tenantID, ids)
	if err != nil {
		c.log.Warn("attachment uploader names are unavailable | 无法解析附件上传者名称", log.Err(err))
		return names
	}
	for _, user := range users {
		name := user.DisplayName
		if strings.TrimSpace(name) == "" {
			name = user.Username
		}
		names[user.ID] = name
	}
	return names
}

// uploaderOptions builds the management uploader filter. | uploaderOptions 构造管理端上传者筛选。
func (c *Controller) uploaderOptions(ctx *router.Ctx, tenantID, selected string) []attachmentUploaderOption {
	users, err := c.store.Auth().ListUsers(ctx.Request.Context(), tenantID)
	if err != nil {
		c.log.Warn("attachment uploader filter is unavailable | 无法加载附件上传者筛选", log.Err(err))
		return nil
	}
	options := make([]attachmentUploaderOption, 0, len(users))
	for _, user := range users {
		label := user.DisplayName
		if strings.TrimSpace(label) == "" {
			label = user.Username
		}
		options = append(options, attachmentUploaderOption{Value: user.ID, Label: label, Selected: user.ID == selected})
	}
	sort.SliceStable(options, func(i, j int) bool {
		return strings.ToLower(options[i].Label) < strings.ToLower(options[j].Label)
	})
	return options
}

// parseAttachmentFilters reads the query-string filter bar. | parseAttachmentFilters 读取查询串过滤栏。
func parseAttachmentFilters(ctx *router.Ctx) attachmentFilters {
	return attachmentFilters{
		Query:      strings.TrimSpace(ctx.Query("q")),
		Status:     strings.TrimSpace(ctx.Query("status")),
		Referenced: strings.TrimSpace(ctx.Query("referenced")),
		UploaderID: strings.TrimSpace(ctx.Query("uploader")),
		From:       strings.TrimSpace(ctx.Query("from")),
		To:         strings.TrimSpace(ctx.Query("to")),
		Page:       pageNumber(ctx),
	}
}

// parseAttachmentFormFilters reads the same fields from a form body, which is how POSTs carry their filters. |
// parseAttachmentFormFilters 从表单正文读取同样的字段，POST 因此能携带自己的筛选。
func parseAttachmentFormFilters(ctx *router.Ctx) attachmentFilters {
	return attachmentFilters{
		Query:      field(ctx, "q"),
		Status:     field(ctx, "status"),
		Referenced: field(ctx, "referenced"),
		UploaderID: field(ctx, "uploader"),
		From:       field(ctx, "from"),
		To:         field(ctx, "to"),
		Page:       1,
	}
}

// href builds a page link preserving every filter. | href 构造保留全部筛选的页面链接。
func (f attachmentFilters) href(base string, page int) string {
	query := url.Values{}
	if f.Query != "" {
		query.Set("q", f.Query)
	}
	if f.Status != "" {
		query.Set("status", f.Status)
	}
	if f.Referenced != "" {
		query.Set("referenced", f.Referenced)
	}
	if f.UploaderID != "" {
		query.Set("uploader", f.UploaderID)
	}
	if f.From != "" {
		query.Set("from", f.From)
	}
	if f.To != "" {
		query.Set("to", f.To)
	}
	if page > 0 {
		query.Set("page", strconv.Itoa(page))
	}
	if len(query) == 0 {
		return base
	}
	return base + "?" + query.Encode()
}

// withReferenced returns a copy with the reference filter replaced. | withReferenced 返回替换引用筛选后的副本。
func (f attachmentFilters) withReferenced(value string) attachmentFilters {
	f.Referenced = value
	// The shortcut means "show unreferenced rows", not "show unreferenced tombstones". | 快捷入口表达的是
	// 「显示未引用记录」，而不是「显示未引用的墓碑」。
	f.Status = ""
	f.Page = 1
	return f
}

// attachmentFilter maps the view state onto the domain filter. pageSize 0 keeps the service default. |
// attachmentFilter 把视图状态映射为领域筛选；pageSize 为 0 时沿用服务默认。
func attachmentFilter(filters attachmentFilters, pageSize int, pageOverride int) attachments.Filter {
	page := filters.Page
	if pageOverride > 0 {
		page = pageOverride
	}
	filter := attachments.Filter{
		Query:      filters.Query,
		UploaderID: filters.UploaderID,
		Page:       page,
		PageSize:   pageSize,
	}
	if status := attachments.Status(filters.Status); status.Valid() {
		filter.Status = status
		if status == attachments.StatusDeleted {
			filter.IncludeDeleted = true
		}
	}
	switch filters.Referenced {
	case "yes":
		filter.Referenced = attachmentBool(true)
	case "no":
		filter.Referenced = attachmentBool(false)
	}
	if from, ok := parseAttachmentDate(filters.From, false); ok {
		filter.From = &from
	}
	if to, ok := parseAttachmentDate(filters.To, true); ok {
		filter.To = &to
	}
	return filter
}

// parseAttachmentDate parses a YYYY-MM-DD bound; endOfDay makes the upper bound inclusive. |
// parseAttachmentDate 解析 YYYY-MM-DD 边界；endOfDay 让上界包含一整天。
func parseAttachmentDate(value string, endOfDay bool) (time.Time, bool) {
	value = strings.TrimSpace(value)
	if value == "" {
		return time.Time{}, false
	}
	parsed, err := time.Parse("2006-01-02", value)
	if err != nil {
		return time.Time{}, false
	}
	if endOfDay {
		parsed = parsed.Add(24*time.Hour - time.Nanosecond)
	}
	return parsed.UTC(), true
}

// attachmentBool returns a pointer to value. | attachmentBool 返回 value 的指针。
func attachmentBool(value bool) *bool { return &value }
