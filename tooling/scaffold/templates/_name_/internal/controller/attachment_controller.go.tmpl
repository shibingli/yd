// matching namespace. | apiUploadAttachment 保存一次 API 上传，并返回带对应命名空间下载地址的记录。
func (c *Controller) apiUploadAttachment(ctx *router.Ctx, base string) {
	if !c.attachmentsReady(ctx) {
		return
	}
	file, header, err := ctx.FormFile("file")
	if err != nil {
		c.apiFail(ctx, attachments.ErrInvalidInput)
		return
	}
	defer func() {
		if closeErr := file.Close(); closeErr != nil {
			c.log.Debug("attachment stream close failed | 附件流关闭失败", log.Err(closeErr))
		}
	}()
	attachment, err := c.attachments.Upload(ctx.Request.Context(), c.attachmentActor(ctx), header.Filename, header.Size, file)
	if err != nil {
		c.apiFail(ctx, err)
		return
	}
	_ = ctx.JSON(http.StatusCreated, c.apiAttachmentRecordOf(attachment, base, ""))
}

