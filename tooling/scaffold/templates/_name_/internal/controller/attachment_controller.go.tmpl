// 本文件是通用附件端点：门户管理自己的附件，后台管理租户内全部附件，两套 JSON API 与页面共用同一份领域服务。
// This file holds the generic attachment endpoints: the portal manages one's own files, the back office manages every
// file of the tenant, and both JSON APIs share the very same domain service as the pages.
//
// 附件能力不专属于消息中心：任何业务都能上传文件、用 (ref_type, ref_id) 绑定到自己的对象，并在之后解除引用。
// 上传与下载都在租户边界内完成，跨租户与不存在的记录一律返回 404，绝不泄露存在性。
// Attachments do not belong to the message centre: any feature may upload a file, bind it to its own object through a
// (ref_type, ref_id) pair and release it later. Uploads and downloads stay inside the tenant boundary, and a foreign or
// missing record always answers 404 without leaking whether it existed.

package controller

import (
	"fmt"
	"net/http"
	"net/url"
	"sort"
	"strconv"
	"strings"
	"time"

	"{{ .Module }}/internal/middleware"
	"{{ .Module }}/internal/service"
	"{{ .YdModule }}/attachments"
	"{{ .YdModule }}/security/auth"
	"{{ .YdModule }}/security/authz"
	"{{ .YdxModule }}/log"
	"{{ .YdxModule }}/router"
)

// Attachment page paths. | 附件页面路径。
const (
	// attachmentPortalBase is the portal page and action prefix. | attachmentPortalBase 是门户页面与动作前缀。
	attachmentPortalBase = "/attachments"
	// attachmentMgrBase is the back-office page and action prefix. | attachmentMgrBase 是后台页面与动作前缀。
	attachmentMgrBase = "/mgr/attachments"
	// attachmentPortalAPI is the member JSON API prefix. | attachmentPortalAPI 是成员 JSON API 前缀。
	attachmentPortalAPI = "/api/portal/v1/attachments"
	// attachmentMgrAPI is the management JSON API prefix. | attachmentMgrAPI 是管理 JSON API 前缀。
	attachmentMgrAPI = "/api/v1/attachments"
)

// attachmentFilters is the filter bar state. | attachmentFilters 是过滤栏状态。
type attachmentFilters struct {
	// Query matches the original file name. | Query 匹配原始文件名。
	Query string
	// Status is pending, referenced or deleted; empty means every live state. | Status 取 pending、referenced 或
	// deleted；空表示全部未删除状态。
	Status string
	// Referenced is "yes", "no" or empty. | Referenced 取 yes、no 或空。
	Referenced string
	// UploaderID narrows a management page to one uploader. | UploaderID 把管理页面限定到一个上传者。
	UploaderID string
	// From and To are inclusive YYYY-MM-DD bounds. | From 与 To 是包含端点的 YYYY-MM-DD 边界。
	From string
	// To is the inclusive upper date. | To 是包含的上界日期。
	To string
	// Page is the 1-based page number. | Page 是从 1 开始的页码。
	Page int
}

// attachmentUploaderOption is one uploader choice of the management filter. | attachmentUploaderOption 是管理筛选
// 的一个上传者选项。
type attachmentUploaderOption struct {
	// Value is the user id. | Value 是用户 ID。
	Value string
	// Label is the display name. | Label 是展示名。
	Label string
	// Selected marks the active uploader. | Selected 标记当前选中的上传者。
	Selected bool
}

// attachmentView is one attachment row ready for rendering. | attachmentView 是可直接渲染的附件行。
type attachmentView struct {
	// Attachment is the stored record. | Attachment 是存储记录。
	attachments.Attachment
	// SizeText is a human-readable size. | SizeText 是人类可读大小。
	SizeText string
	// CreatedText is the formatted upload time. | CreatedText 是格式化的上传时间。
	CreatedText string
	// UploaderName is the resolved display name, empty on the portal. | UploaderName 是解析后的展示名，门户为空。
	UploaderName string
	// DownloadURL is the download endpoint. | DownloadURL 是下载端点。
	DownloadURL string
	// PreviewURL is the inline preview endpoint for an image. | PreviewURL 是图片的内联预览端点。
	PreviewURL string
	// StatusKey is the i18n key of the lifecycle state. | StatusKey 是生命周期状态的 i18n 键。
	StatusKey string
	// StatusTone is the semantic badge tone of the state. | StatusTone 是状态的语义徽标色调。
	StatusTone string
	// DeleteURL is the self-service deletion endpoint. | DeleteURL 是自助删除端点。
	DeleteURL string
	// Image reports whether the row can be previewed inline. | Image 报告该行能否内联预览。
	Image bool
	// Deleted reports a tombstone. | Deleted 报告是否为墓碑。
	Deleted bool
	// CanDelete reports whether the visitor may delete this row. | CanDelete 报告访问者能否删除该行。
	CanDelete bool
}

// attachmentPage is the complete data of one attachment page render. | attachmentPage 是一次附件页面渲染的完整数据。
type attachmentPage struct {
	// Filters is the filter bar state. | Filters 是过滤栏状态。
	Filters attachmentFilters
	// Items is the current page. | Items 是当前页。
	Items []attachmentView
	// Uploaders is the management uploader filter. | Uploaders 是管理端上传者筛选。
	Uploaders []attachmentUploaderOption
	// Pages is the pagination link model. | Pages 是分页链接模型。
	Pages []map[string]any
	// PrevHref and NextHref are the neighbouring page links. | PrevHref 与 NextHref 是相邻页链接。
	PrevHref string
	// NextHref is the next page link. | NextHref 是下一页链接。
	NextHref string
	// CleanupURL opens the unreferenced-cleanup drawer. | CleanupURL 打开未引用附件清理抽屉。
	CleanupURL string
	// UnreferencedURL filters the list to unreferenced rows. | UnreferencedURL 把列表筛选为未引用记录。
	UnreferencedURL string
	// MaxSizeText is the per-file ceiling. | MaxSizeText 是单文件上限。
	MaxSizeText string
	// AllowedTypesText is the MIME allow list. | AllowedTypesText 是 MIME 白名单。
	AllowedTypesText string
	// Error is the unavailability reason. | Error 是不可用原因。
	Error string
	// ReasonMax bounds the deletion reason. | ReasonMax 限制删除原因长度。
	ReasonMax int
	// Total is the matching row count. | Total 是匹配总数。
	Total int
	// Page is the current page number. | Page 是当前页码。
	Page int
	// PageCount is the number of pages. | PageCount 是页数。
	PageCount int
	// CleanupCount is the number of unreferenced rows under the current filters. | CleanupCount 是当前筛选下的未引用数量。
	CleanupCount int
	// CanCreate reports attachment:create. | CanCreate 报告 attachment:create。
	CanCreate bool
	// CanDelete reports attachment:delete. | CanDelete 报告 attachment:delete。
	CanDelete bool
	// CanManage reports attachment:manage. | CanManage 报告 attachment:manage。
	CanManage bool
	// Unavailable reports a missing store or blob backend. | Unavailable 报告存储或字节后端缺失。
	Unavailable bool
	// Empty reports an empty page. | Empty 报告空页。
	Empty bool
	// Filtered reports that a filter is active, so an empty page means "no match". | Filtered 报告当前有筛选，
	// 因此空页表示「没有匹配项」。
	Filtered bool
}

// data flattens the page into the render map. | data 把页面摊平进渲染数据。
func (p attachmentPage) data() map[string]any {
	return map[string]any{
		"Filters":          p.Filters,
		"Items":            p.Items,
		"Uploaders":        p.Uploaders,
		"Pages":            p.Pages,
		"PrevHref":         p.PrevHref,
		"NextHref":         p.NextHref,
		"CleanupURL":       p.CleanupURL,
		"UnreferencedURL":  p.UnreferencedURL,
		"MaxSizeText":      p.MaxSizeText,
		"AllowedTypesText": p.AllowedTypesText,
		"Error":            p.Error,
		"ReasonMax":        p.ReasonMax,
		"Total":            p.Total,
		"Page":             p.Page,
		"PageCount":        p.PageCount,
		"CleanupCount":     p.CleanupCount,
		"CanCreate":        p.CanCreate,
		"CanDelete":        p.CanDelete,
		"CanManage":        p.CanManage,
		"Unavailable":      p.Unavailable,
		"Empty":            p.Empty,
		"Filtered":         p.Filtered,
	}
}

