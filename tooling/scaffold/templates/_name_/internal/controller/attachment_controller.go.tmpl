// UploadAttachment stores one file from the portal upload form. | UploadAttachment 保存门户上传表单中的一个文件。
//
// @Summary Upload attachment | 上传附件
// @Description Streams the multipart file into the configured blob backend and records a pending attachment. The
// @Description content type is sniffed from the bytes, the size is enforced before and after reading, and the stored
// @Description key contains only opaque identifiers plus a date partition.
// @Description 把 multipart 文件写入配置的字节后端并登记为待引用附件。内容类型由字节嗅探，大小在读取前后各校验一次，
// @Description 存储键只含不透明标识与日期分区。
// @Tags attachments
// @Accept multipart/form-data
// @Produce html
// @Param file formData file true "file to upload | 待上传文件"
// @Success 200 {object} string "refreshed attachment page | 刷新后的附件页面"
// @Failure 401 {object} string "no session | 无有效会话"
// @Failure 403 {object} string "missing attachment:create | 缺少 attachment:create"
// @Failure 413 {object} string "file too large | 文件过大"
// @Failure 415 {object} string "content type not allowed | 内容类型不允许"
// @Failure 422 {object} string "invalid upload | 上传参数非法"
// @Failure 503 {object} string "attachment centre unavailable | 附件中心不可用"
// @Security BearerAuth
// @Router /attachments [post]
func (c *Controller) UploadAttachment(ctx *router.Ctx) {
	if !c.attachmentsReady(ctx) {
		return
	}
	file, header, err := ctx.FormFile("file")
	if err != nil {
		c.failService(ctx, attachments.ErrInvalidInput)
		return
	}
	defer func() {
		if closeErr := file.Close(); closeErr != nil {
			c.log.Debug("attachment stream close failed | 附件流关闭失败", log.Err(closeErr))
		}
	}()
	if _, err := c.attachments.Upload(ctx.Request.Context(), c.attachmentActor(ctx), header.Filename, header.Size, file); err != nil {
		c.failService(ctx, err)
		return
	}
	c.attachmentsPage(ctx, false, "附件已上传 | attachment uploaded")
}

// DownloadAttachment streams one attachment after the service authorizes visibility. | DownloadAttachment 在服务完成
// 可见性鉴权后流式返回附件。
//
// @Summary Download attachment | 下载附件
// @Description Streams the bytes with nosniff and a private no-store cache policy. The inline flag is honoured only for
// @Description images, so a non-image can never be rendered as a document in the browser. The service allows the
// @Description uploader, a manager and a read-only auditor; everyone else receives 404.
// @Description 以 nosniff 与 private no-store 缓存策略流式返回字节。内联标志只对图片生效，非图片绝不会按文档在
// @Description 浏览器中渲染。服务放行上传者、管理员与只读审计员，其余主体一律收到 404。
// @Tags attachments
// @Produce octet-stream
// @Param id path string true "attachment id | 附件 ID"
// @Param inline query string false "1 to preview an image inline | 取 1 时内联预览图片"
// @Success 200 {file} file "attachment bytes | 附件字节"
// @Failure 404 {object} string "attachment not found | 附件不存在"
// @Failure 503 {object} string "attachment centre unavailable | 附件中心不可用"
// @Security BearerAuth
// @Router /attachments/{id}/download [get]
func (c *Controller) DownloadAttachment(ctx *router.Ctx) {
	if !c.attachmentsReady(ctx) {
		return
	}
	attachment, data, err := c.attachments.Download(ctx.Request.Context(), c.attachmentActor(ctx), ctx.Param("id"))
	if err != nil {
		c.failService(ctx, err)
		return
	}
	inline := strings.TrimSpace(ctx.Query("inline")) == "1" && attachments.IsImage(attachment)
	ctx.SetHeader("Content-Disposition", attachments.ContentDisposition(attachment, inline))
	ctx.SetHeader("X-Content-Type-Options", "nosniff")
	ctx.SetHeader("Cache-Control", "private, no-store")
	if err := ctx.Blob(http.StatusOK, attachment.ContentType, data); err != nil {
		c.log.Warn("attachment write failed | 附件写出失败", log.Err(err))
	}
}

