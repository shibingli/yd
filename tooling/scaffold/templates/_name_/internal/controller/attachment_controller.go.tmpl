// DeleteOwnAttachment removes one unreferenced pending attachment owned by the visitor. | DeleteOwnAttachment 删除访问者
// 拥有的一个未被引用的待引用附件。
//
// @Summary Delete my attachment | 删除我的附件
// @Description Deletes a pending attachment with no references. A referenced attachment is refused with 409 because
// @Description deleting it would leave the owning feature pointing at a missing file; the owner must first remove the
// @Description consuming object.
// @Description 删除没有引用的待引用附件。已被引用的附件以 409 拒绝，因为删除会让持有它的业务指向一个不存在的文件；
// @Description 所有者必须先删除消费它的业务对象。
// @Tags attachments
// @Accept html
// @Produce html
// @Param id path string true "attachment id | 附件 ID"
// @Success 200 {object} string "refreshed attachment page | 刷新后的附件页面"
// @Failure 403 {object} string "missing attachment:delete | 缺少 attachment:delete"
// @Failure 404 {object} string "attachment not found | 附件不存在"
// @Failure 409 {object} string "attachment is still referenced | 附件仍被引用"
// @Failure 503 {object} string "attachment centre unavailable | 附件中心不可用"
// @Security BearerAuth
// @Router /attachments/{id}/delete [post]
func (c *Controller) DeleteOwnAttachment(ctx *router.Ctx) {
	if !c.attachmentsReady(ctx) {
