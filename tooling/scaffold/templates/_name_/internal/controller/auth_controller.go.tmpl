// 本文件是登录与账号自助端点：登录、登出、改密与 sec_key 轮换。
// This file holds sign-in and self-service account endpoints: sign-in, sign-out, password change and sec_key rotation.

package controller

import (
	"net/http"
	"strings"
	"time"

	"{{ .Module }}/internal/meta"
	"{{ .Module }}/internal/middleware"
	"{{ .Module }}/internal/service"
