// 本文件是登录与账号自助端点：登录、登出、改密与 sec_key 轮换。
// This file holds sign-in and self-service account endpoints: sign-in, sign-out, password change and sec_key rotation.

package controller

import (
	"net/http"
	"time"

	"{{ .Module }}/internal/meta"
	"{{ .Module }}/internal/middleware"
	"{{ .Module }}/internal/service"
	"{{ .YdModule }}/security/auth"
	"{{ .YdModule }}/core/logx"
	"{{ .YdModule }}/http/router"
)

// Pubkey 返回 SM2 公钥，供前端在提交前加密口令字段。
// Pubkey returns the SM2 public key the front end uses to encrypt the password field before submitting it.
//
// @Summary SM2 public key | SM2 公钥
// @Description Returns the uncompressed SM2 public key in hexadecimal as text/plain, which is what yd-guomi.js fetches
// @Description once and reuses for every encrypted field. Public by design: a key that could only be fetched with a token
// @Description would be unusable for the sign-in form it exists to protect.
// @Description 以 text/plain 返回十六进制的不压缩 SM2 公钥，yd-guomi.js 取一次即复用于所有加密字段。该端点按设计公开：如果取公钥需要
// @Description 令牌，那么它本来要保护的登录表单就永远用不上它。
// @Tags auth
// @Accept text
// @Produce text
// @Success 200 {string} string "hexadecimal SM2 public key | 十六进制 SM2 公钥"
// @Router /guomi/pubkey [get]
func (c *Controller) Pubkey(ctx *router.Ctx) {
	// 公钥每次会话都可能变化（开发期热重载、多实例各自持有一把），因此不允许缓存。
	// The key may change between sessions (hot reload in development, one key per instance in a cluster), so it is never cached.
	ctx.SetHeader("Cache-Control", "no-store")
	if err := ctx.String(http.StatusOK, c.PublicKey()); err != nil {
		c.log.Warn("public key write failed | 公钥写出失败", logx.Err(err))
	}
}

// LoginPage 渲染登录页。
// LoginPage renders the sign-in page.
//
// @Summary Sign-in page | 登录页
// @Description Renders pages/login.html: the tenant key field, the user name and the password field that
// @Description yd-guomi-htmx.js encrypts with SM2 before the form is submitted. A visitor who already holds a valid
// @Description session is redirected to the workspace instead.
// @Description 渲染 pages/login.html：租户标识、用户名字段，以及由 yd-guomi-htmx.js 在提交前用 SM2 加密的口令字段；
// @Description 已持有有效会话的访问者会被直接送回工作区。
// @Tags auth
// @Accept html
// @Produce html
// @Param lang query string false "language tag | 语言标签"
// @Param HX-Request header string false "htmx partial request | htmx 局部请求标记"
// @Success 200 {object} string "sign-in page or fragment | 登录整页或片段"
// @Failure 303 {object} string "already signed in | 已登录，重定向"
// @Router /login [get]
func (c *Controller) LoginPage(ctx *router.Ctx) {
	if user, ok := auth.CurrentUser(ctx); ok && user != nil {
		c.redirect(ctx, "/")
		return
	}
	c.render(ctx, http.StatusOK, TplLogin, c.loginData(ctx, "", ""))
}

// Login 校验 SM2 密文口令并写下会话 cookie。
// Login verifies the SM2 ciphertext password and writes the session cookie.
//
// @Summary Sign in | 登录
// @Description Resolves the tenant (form field, X-Tenant header or subdomain), decrypts the SM2 payload submitted in the
// @Description password field and issues a token written into the HttpOnly yd_token cookie. An htmx request gets
// @Description HX-Redirect and a plain form post a 303, both pointing at the workspace. Every failure - unknown tenant,
// @Description wrong password, disabled user - answers with the same 401 and the same copy, so nothing can be probed.
// @Description 解析租户（表单字段、X-Tenant 请求头或子域名），解密 password 字段里的 SM2 密文并签发票据，写入 HttpOnly 的
// @Description yd_token cookie；htmx 请求得到 HX-Redirect，普通表单提交得到 303，都指向工作区。任何失败——租户不存在、口令
// @Description 错误、用户被停用——都返回同一个 401 与同一句文案，因此探测不出任何信息。
// @Tags auth
// @Accept html
// @Produce html
// @Param X-YD-Encrypted header string true "must be sm2 | 必须为 sm2"
// @Param X-Tenant header string false "tenant slug or id, when the form field is empty | 表单字段为空时的租户标识或 ID"
// @Param tenant formData string true "tenant slug or tn_ id | 租户标识或 tn_ ID"
// @Param username formData string true "sign-in name inside the tenant | 租户内的登录名"
// @Param password formData string true "SM2 ciphertext, Base64 or raw | SM2 密文，Base64 或原始字节"
// @Success 200 {object} string "HX-Redirect to the workspace | 指向工作区的 HX-Redirect"
// @Success 303 {object} string "redirect to the workspace | 303 跳转到工作区"
// @Failure 401 {object} string "sign-in refused | 登录被拒绝"
// @Failure 422 {object} string "malformed input | 输入不合法"
// @Security BearerAuth
// @Router /login [post]
func (c *Controller) Login(ctx *router.Ctx) {
	username := field(ctx, FieldUsername)
	tenantKey := field(ctx, FieldTenant)
	if tenantKey == "" {
		// 请求头里的租户由租户解析中间件记下，这里复用它的结果，避免两处各解析一次。
		// The header-named tenant was recorded by the tenant middleware; reusing it avoids resolving the same key twice.
		tenantKey, _ = middleware.TenantSlug(ctx)
	}

	tenantID, err := c.tenants.Resolve(ctx.Request.Context(), tenantKey)
	if err != nil {
		// 租户不存在与口令错误回同一句：登录接口是匿名可达的，任何差异都会变成租户枚举的旁路。
		// An unknown tenant and a wrong password answer alike: the sign-in endpoint is reachable anonymously and any
		// difference would become a side channel for enumerating tenants.
		c.log.Warn("sign-in refused: unresolvable tenant | 登录被拒绝：租户无法解析",
			logx.Err(err),
			logx.Str("tenant_key", tenantKey),
		)
		c.loginFailed(ctx, http.StatusUnauthorized, msgUnauthorized, username)
		return
	}

	result, err := c.auth.Login(ctx.Request.Context(), service.LoginInput{
		TenantID: tenantID,
		Username: username,
		Password: payload(ctx, FieldPassword),
		Scheme:   scheme(ctx),
	})
	if err != nil {
		status, message := statusFor(err)
		if status == http.StatusUnauthorized {
			message = msgUnauthorized
		}
		c.loginFailed(ctx, status, message, username)
		return
	}

	c.setSession(ctx, result)
	c.redirect(ctx, "/")
}

// Logout 清掉会话 cookie 并把浏览器送回登录页。
// Logout drops the session cookie and sends the browser back to the sign-in page.
//
// @Summary Sign out | 登出
// @Description Clears the yd_token cookie. Only this session's own token is dropped: no tenant-wide or user-wide state
// @Description is touched, which is why a POST is enough and why the endpoint is mounted publicly — clearing a stale
// @Description cookie must also work when the token inside it is long dead.
// @Description 清掉 yd_token cookie：只丢弃本次会话自己的令牌，不触碰任何租户级或用户级状态，因此一个 POST 就足够；
// @Description 它也正因如此挂在公开组上——cookie 里那枚令牌早已失效时，清理动作仍然要能完成。
// @Tags auth
// @Accept html
// @Produce html
// @Success 200 {object} string "HX-Redirect to the sign-in page | 指向登录页的 HX-Redirect"
// @Success 303 {object} string "redirect to the sign-in page | 303 跳转到登录页"
// @Router /logout [post]
func (c *Controller) Logout(ctx *router.Ctx) {
	c.clearSession(ctx)
	if user, ok := auth.CurrentUser(ctx); ok && user != nil {
		c.log.Info("signed out | 已登出",
			logx.Str("tenant", user.TenantID),
			logx.Str("user", user.ID),
		)
	}
	c.redirect(ctx, "/login")
}

// Account 渲染账号自助页：当前身份、权限全集、改密与 sec_key 轮换。
// Account renders the self-service page: the current identity, the full capability set, the password change and the sec_key rotation.
//
// @Summary Account page | 账号页
// @Description Renders pages/account.html for the signed-in user: identity, tenant, roles, capabilities and the two
// @Description self-service forms. The page also carries the mandatory first-sign-in password notice whenever the
// @Description account still uses the seeded password.
// @Description 为已登录用户渲染 pages/account.html：身份、租户、角色、权限，以及两个自助表单；只要账号仍在用种子口令，
// @Description 页面还会展示「首登必改口令」的提示。
// @Tags account
// @Accept html
// @Produce html
// @Param HX-Request header string false "htmx partial request | htmx 局部请求标记"
// @Success 200 {object} string "account page or fragment | 账号整页或片段"
// @Failure 401 {object} string "no session | 无有效会话"
// @Security BearerAuth
// @Router /account [get]
func (c *Controller) Account(ctx *router.Ctx) {
	user, ok := auth.CurrentUser(ctx)
	if !ok || user == nil {
		c.fail(ctx, http.StatusUnauthorized, msgUnauthorized)
		return
	}
	c.render(ctx, http.StatusOK, TplAccount, c.view(ctx, "账号 | Account", map[string]any{
		"Roles":       user.Roles,
		"Permissions": c.auth.Permissions(user),
	}))
}

// ChangePassword 修改当前账号的口令：校验旧口令、设置新口令并轮换 sec_key。
// ChangePassword changes the current account's password: it verifies the old one, sets the new one and rotates the sec_key.
//
// @Summary Change own password | 修改自己的口令
// @Description Verifies current against the stored hash, then writes next and rotates the account's sec_key. Rotation
// @Description invalidates every token issued before the change - including the one used to make the request - so the
// @Description session cookie is cleared too and the browser is sent back to the sign-in page.
// @Description 用已存散列校验 current，写入 next 并轮换该账号的 sec_key。轮换会让改密之前签发的所有令牌——包括发起本次请求的那一枚
// @Description ——立即失效，因此会话 cookie 同时被清掉，浏览器被送回登录页。
// @Tags account
// @Accept html
// @Produce html
// @Param X-YD-Encrypted header string true "must be sm2 | 必须为 sm2"
// @Param current formData string true "current password as SM2 ciphertext | 当前口令的 SM2 密文"
// @Param password formData string true "new password as SM2 ciphertext | 新口令的 SM2 密文"
// @Param confirm formData string true "repeated new password as SM2 ciphertext | 重复输入的新口令 SM2 密文"
// @Success 200 {object} string "HX-Redirect to the sign-in page | 指向登录页的 HX-Redirect"
// @Success 303 {object} string "redirect to the sign-in page | 303 跳转到登录页"
// @Failure 401 {object} string "no session or wrong current password | 无有效会话或当前口令错误"
// @Failure 422 {object} string "the new passwords do not match | 两次输入的新口令不一致"
// @Security BearerAuth
// @Router /account/password [post]
func (c *Controller) ChangePassword(ctx *router.Ctx) {
	user, ok := auth.CurrentUser(ctx)
	if !ok || user == nil {
		c.fail(ctx, http.StatusUnauthorized, msgUnauthorized)
		return
	}
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return
	}

	err := c.auth.ChangePassword(ctx.Request.Context(), tenantID, user.ID, service.ChangePasswordInput{
		Current: payload(ctx, FieldCurrent),
		Next:    payload(ctx, FieldPassword),
		Confirm: payload(ctx, FieldConfirm),
		Scheme:  scheme(ctx),
	})
	if err != nil {
		c.failService(ctx, err)
		return
	}

	// 口令已改、sec_key 已换：本枚令牌失效，会话必须显式结束，否则浏览器会带着一枚死令牌反复撞 401。
	// The password changed and the sec_key rotated, so this very token is dead: the session ends explicitly instead of
	// leaving the browser to hammer a 401 with a stale cookie.
	c.clearSession(ctx)
	c.redirect(ctx, "/login")
}

// RotateSecKey 轮换当前账号的 sec_key：口令不变，旧令牌全部失效。
// RotateSecKey rotates the current account's sec_key: the password stays and every old token dies.
//
// @Summary Rotate own sec_key | 轮换自己的 sec_key
// @Description Issues a fresh per-user sec_key, which is what token validation is keyed on. Every previously issued
// @Description token stops verifying at once, so this is the "sign out everywhere" button; the password is untouched and
// @Description the session cookie is cleared locally as well.
// @Description 重新生成该用户的 sec_key，而令牌校验正是绑定在它上面的：此前签发的每一枚令牌立刻失效，因此这就是「退出所有设备」
// @Description 按钮；口令不受影响，本地会话 cookie 同时被清掉。
// @Tags account
// @Accept html
// @Produce html
// @Success 200 {object} string "HX-Redirect to the sign-in page | 指向登录页的 HX-Redirect"
// @Success 303 {object} string "redirect to the sign-in page | 303 跳转到登录页"
// @Failure 401 {object} string "no session | 无有效会话"
// @Security BearerAuth
// @Router /account/sec-key [post]
func (c *Controller) RotateSecKey(ctx *router.Ctx) {
	user, ok := auth.CurrentUser(ctx)
	if !ok || user == nil {
		c.fail(ctx, http.StatusUnauthorized, msgUnauthorized)
		return
	}
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return
	}

	if err := c.auth.RotateSecKey(ctx.Request.Context(), tenantID, user.ID); err != nil {
		c.failService(ctx, err)
		return
	}
	c.clearSession(ctx)
	c.redirect(ctx, "/login")
}

// loginData 构造登录页数据：失败时把文案与已填的登录名一起回显，用户不必重新敲一遍。
// loginData builds the sign-in page data: a failure echoes the copy together with the typed user name so it need not be retyped.
func (c *Controller) loginData(ctx *router.Ctx, message, username string) map[string]any {
	// KeyEndpoint 不在这里补：view() 已经把 PubkeyPath 注入每一份页面数据，重复一次只会多一处可能与路由漂移的字符串。
	// KeyEndpoint is not repeated here: view() already injects PubkeyPath into every page's data, and a second copy would
	// only add one more string that can drift away from the route.
	return c.view(ctx, "登录 | Sign in", map[string]any{
		"Error":      message,
		"Username":   username,
		"SeedTenant": meta.SeedTenantSlug,
		"SeedNotice": meta.SeedPasswordNotice,
	})
}

// loginFailed 以登录页片段 + 状态码结束一次失败的登录，而不是把用户丢到一个通用错误页上。
// loginFailed ends a refused sign-in with the sign-in fragment plus a status code instead of dropping the user on a generic error page.
func (c *Controller) loginFailed(ctx *router.Ctx, status int, message, username string) {
	c.render(ctx, status, TplLogin, c.loginData(ctx, message, username))
}

// setSession 把令牌写进 HttpOnly cookie。
// setSession writes the token into an HttpOnly cookie.
//
// 两个布尔值各有用处：HttpOnly 让脚本读不到令牌（XSS 拿不走会话），SameSite=Lax 让跨站表单提交不携带它（CSRF 的第一道墙）。
// Both booleans earn their place: HttpOnly keeps scripts away from the token (an XSS cannot steal the session) and
// SameSite=Lax keeps it off cross-site form posts (the first wall against CSRF).
func (c *Controller) setSession(ctx *router.Ctx, result *auth.LoginResult) {
	if result == nil {
		return
	}
	ttl := time.Until(result.ExpiresAt)
	if ttl <= 0 {
		ttl = auth.DefaultTokenTTL
	}
	ctx.SetCookie(&http.Cookie{
		Name:     meta.TokenCookie,
		Value:    result.Token,
		Path:     "/",
		MaxAge:   int(ttl.Seconds()),
		HttpOnly: true,
		SameSite: http.SameSiteLaxMode,
		Secure:   meta.IsProduction(),
	})

	c.log.Info("session established | 会话已建立",
		logx.Str("tenant", result.User.TenantID),
		logx.Str("user", result.User.ID),
		logx.Str("expires_at", result.ExpiresAt.UTC().Format(time.RFC3339)),
	)
}

// clearSession 让浏览器立刻丢弃会话 cookie。
// clearSession makes the browser drop the session cookie at once.
func (c *Controller) clearSession(ctx *router.Ctx) {
	ctx.SetCookie(&http.Cookie{
		Name:     meta.TokenCookie,
		Value:    "",
		Path:     "/",
		MaxAge:   -1,
		HttpOnly: true,
		SameSite: http.SameSiteLaxMode,
		Secure:   meta.IsProduction(),
	})
}
