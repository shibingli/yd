	"{{ .YdModule }}/messaging/realtime"
	"{{ .YdModule }}/runtime/app"
	"{{ .YdModule }}/runtime/metricsx"
	"{{ .YdModule }}/security/auth"
	"{{ .YdModule }}/security/authz"
	"{{ .YdModule }}/security/captcha"
	"{{ .YdxModule }}/cache"
	"{{ .YdxModule }}/cron"
	"{{ .YdxModule }}/errs"
	"{{ .YdxModule }}/i18n"
	ydlog "{{ .YdxModule }}/log"
	"{{ .YdxModule }}/render"
	"{{ .YdxModule }}/router"
	"{{ .YdxModule }}/workflow"
)

