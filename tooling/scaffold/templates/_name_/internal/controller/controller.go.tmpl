// 对外路径常量：模板、控制器与路由引用同一份取值，前端脚本取公钥时也不会写错地址。
// Public path constants: templates, controllers and the router read one set of values, so the front-end script can never
// fetch the public key from a misspelled address.
const (
	// PubkeyPath is the SM2 public-key endpoint that the sign-in form's data-yd-pubkey and the docs point at. | PubkeyPath 是 SM2 公钥端点；登录表单的 data-yd-pubkey 与文档都指向它。
	PubkeyPath = "/guomi/pubkey"
	// LoginPath is the sign-in path that sign-out and refusals lead back to. | LoginPath 是登录页路径，登出与拒绝跳转都回到这里。
	LoginPath = "/login"
)

// 面向用户的兜底文案：未知错误只回显这一句，绝不把内部细节带出服务端。
// User-facing fallback copy: unknown errors show this single line and never leak internal details.
const (
	// msgInternal is the fallback copy for 500. | msgInternal 是 500 的兜底文案。
	msgInternal = "服务器内部错误，请稍后重试 | Internal server error, please retry later"
	// msgUnauthorized 是登录失败的兜底文案：租户不存在与口令错误共用它，避免探测租户是否存在。
	// msgUnauthorized is the fallback copy for a failed sign-in; an unknown tenant and a wrong password share it so tenant existence cannot be probed.
	msgUnauthorized = "租户、用户名或口令不正确 | Wrong tenant, user name or password"
	// msgForbidden is the fallback copy for a refused escalation attempt. | msgForbidden 是越权访问的兜底文案。
	msgForbidden = "没有权限执行该操作 | You are not allowed to perform this action"
)

// 分页与列表上限：内存仓储一次返回全部记录，这里只作为渲染护栏。
// Paging and list bounds: the in-memory store returns every record at once and this only guards the render.
const (
	// defaultPageSize is the number of rows on one admin list page. | defaultPageSize 是管理列表一页的行数。
	defaultPageSize = 20
	// maxFormFieldLen caps one form field so oversized input never reaches the business layer. | maxFormFieldLen 限制单个表单字段的长度，避免超长输入进入业务层。
	maxFormFieldLen = 256
)

