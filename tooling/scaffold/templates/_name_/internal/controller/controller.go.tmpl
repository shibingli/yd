// New 装配控制器：业务服务在这里一次性构造，彼此共享同一个 Store 与同一个 AuthService。
// New wires the controller: the services are built once here and share one Store and one AuthService.
//
// 共享 AuthService 是硬要求：SM2 密钥对只应存在一份，登录解密、建号解密与改密解密必须用同一把私钥，
// 否则浏览器取到的公钥与解密用的私钥就会错位。
// Sharing one AuthService is mandatory: exactly one SM2 key pair may exist, because sign-in, user creation and password
// changes all have to decrypt with the very same private key — two key pairs would silently mismatch the public key the
// browser fetched.
// redisClient is the one process-wide client opened by service.NewRedis; nil means Redis is unavailable and the
// message bus stays in-process. | redisClient 是由 service.NewRedis 打开的进程级客户端；nil 表示 Redis 不可用，
// 消息总线保持在进程内。
func New(a *app.App, store *repository.Store, log *ydlog.Logger, captchaSvc *captcha.Service, redisClient goredis.UniversalClient) (*Controller, error) {
	if a == nil || store == nil {
		return nil, service.ErrAuthUnavailable
	}
	if log == nil {
		log = ydlog.Default()
	}

	authSvc, err := service.NewAuthService(store, log)
	if err != nil {
		return nil, err
	}
	metricsSvc := service.NewMetricsService()
	hub, closeMessageBus, busErr := service.NewMessageBus(a.Config(), log, a.NodeID(), redisClient)
	if busErr != nil {
		log.Warn("message bus is unavailable, falling back to in-process delivery | 消息总线不可用，回退到进程内投递",
			ydlog.Err(busErr),
		)
		hub = realtime.New(log)
		closeMessageBus = func() error { return nil }
	}
	a.OnShutdown(func(context.Context) error { return closeMessageBus() })
	var bundle *i18n.Bundle
	if value, ok := a.Get(app.ServiceI18n); ok {
		bundle, _ = value.(*i18n.Bundle)
	}
	attachmentsSvc, attachmentErr := service.NewAttachmentService(store.AttachmentStore(), a.Config(), log, redisClient)
	if attachmentErr != nil {
		log.Warn("attachment centre is disabled | 附件中心已禁用", ydlog.Err(attachmentErr))
	}
	messages, messageErr := service.NewMessageService(store, hub, a.Config(), log, attachmentsSvc)
	if messageErr != nil {
		if !errors.Is(messageErr, service.ErrMessageUnavailable) {
			return nil, messageErr
		}
		log.Warn("message centre is disabled | 消息中心已禁用", ydlog.Err(messageErr))
	}
	if attachmentsSvc != nil {
		if messages != nil && messages.Available() {
			// Deletion notices are delivered through the message centre, but the attachment domain never
			// imports it; this closure is the only seam between the two. | 删除通知经消息中心投递，但附件域
			// 从不导入消息中心；这个闭包是两者之间唯一的接缝。
			attachmentsSvc.SetNoticeWriter(func(ctx context.Context, tenantID, recipientID string, actor messaging.Actor, title, markdown string) error {
				_, err := messages.NotifyUser(ctx, tenantID, recipientID, actor, title, markdown)
				return err
			})
		} else {
			log.Warn("attachment deletion notices are disabled because the message centre is unavailable | 消息中心不可用，附件删除通知已关闭")
		}
	}
	var cacheManager *cache.Manager
	if value, ok := a.Get(app.ServiceCache); ok {
		cacheManager, _ = value.(*cache.Manager)
	}
	dictionaries, dictionaryErr := service.NewDictionaryService(a.Config(), store.DictionaryStore(), cacheManager, log)
	if dictionaryErr != nil {
		log.Warn("data dictionary is disabled | 数据字典已禁用", ydlog.Err(dictionaryErr))
	}
	cronSvc := service.NewCronService(a.Config(), a.NodeID(), log, redisClient)
	workflowSvc, workflowErr := service.NewWorkflowService(a.Config(), store.WorkflowStore(), store.Auth(), messages, log, cronSvc.Scheduler())
	if workflowErr != nil {
		log.Warn("workflow engine is disabled | 流程引擎已禁用", ydlog.Err(workflowErr))
	}
	tenants := service.NewTenantService(store)
	systemTenantID := ""
	if key := strings.TrimSpace(a.Config().GetString(service.ConfigDictionarySystemTenant)); key != "" {
		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		resolved, resolveErr := tenants.Resolve(ctx, key)
		cancel()
		if resolveErr != nil {
			log.Warn("system dictionary tenant cannot be resolved, system management is disabled | 系统级字典租户无法解析，系统管理已关闭",
				ydlog.Str("key", key),
				ydlog.Err(resolveErr),
			)
		} else {
			systemTenantID = resolved
			log.Info("system dictionary management enabled | 系统级字典管理已启用",
				ydlog.Str("tenant", resolved),
			)
		}
	}
	return &Controller{
		app:            a,
		store:          store,
		auth:           authSvc,
		captcha:        captchaSvc,
		tenants:        tenants,
		users:          service.NewUserService(store, authSvc),
		roles:          service.NewRoleService(store),
		provider:       metricsx.NewCollector(metricsSvc, a.MiddlewareMetrics()),
		messages:       messages,
		messageErr:     messageErr,
		attachments:    attachmentsSvc,
		attachmentErr:  attachmentErr,
		dictionaries:   dictionaries,
		dictionaryErr:  dictionaryErr,
		workflow:       workflowSvc,
		workflowErr:    workflowErr,
		cronSvc:        cronSvc,
		systemTenantID: systemTenantID,
		hub:            hub,
		i18n:           bundle,
		log:            log,
		bundleURLs:     web.BundleURLs(),
	}, nil
}

