// Controller 持有应用门面与业务服务：门面负责渲染与配置，服务负责规则。
// Controller holds the application facade and the business services: the facade renders and configures, the services own the rules.
type Controller struct {
	// app is the application facade (rendering, logging, configuration). | app 是应用门面（渲染、日志、配置）。
	app *app.App
	// store owns the auth store and the token issuer, shared by the auth middleware and the controllers. | store 持有鉴权存储与令牌签发器，鉴权中间件与控制器共用同一份。
	store *repository.Store
	// auth serves sign-in, password changes and sec_key rotation. | auth 是登录、改密与 sec_key 轮换服务。
	auth *service.AuthService
	// captcha owns the optional human-verification guard for sign-in and password changes. | captcha 持有登录与改密的可选人机验证守卫。
	captcha *captcha.Service
	// tenants is the tenant service. | tenants 是租户服务。
	tenants *service.TenantService
	// users is the user service. | users 是用户服务。
	users *service.UserService
	// roles is the role and permission-matrix service. | roles 是角色与权限矩阵服务。
	roles *service.RoleService
	// provider composes the system gauges with the middleware registry behind one interface; it is the only
	// path the controllers use for metrics. | provider 把系统仪表盘与中间件注册表组合在同一个接口之后；它是控制器
	// 读取指标的唯一路径。
	provider metricsx.Provider
	// messages is the message-centre facade; nil-capable when the project has no database. | messages 是消息中心门面；项目没有数据库时可为空。
	messages *service.MessageService
	// messageErr records why the message centre is unavailable, shown on its pages. | messageErr 记录消息中心不可用的原因，并在其页面上展示。
	messageErr error
	// attachments is the generic attachment facade shared by the message centre and every other
	// feature; it is nil when the metadata store or the blob backend is unavailable. | attachments 是消息
	// 中心与其它功能共用的通用附件门面；元数据存储或字节后端不可用时为 nil。
	attachments *service.AttachmentService
	// attachmentErr records why attachments are unavailable, shown on their pages. | attachmentErr 记录附件
	// 不可用的原因，并在其页面上展示。
	attachmentErr error
	// dictionaries is the data-dictionary facade; nil when the project has no database. | dictionaries
	// 是数据字典门面；项目没有数据库时为 nil。
	dictionaries *service.DictionaryService
	// dictionaryErr records why data dictionaries are unavailable. | dictionaryErr 记录数据字典不可用的原因。
	dictionaryErr error
	// workflow is the process-engine facade; nil when the project has no database. | workflow 是流程引擎门面；
	// 项目没有数据库时为 nil。
	workflow *service.WorkflowService
	// workflowErr records why the process engine is unavailable. | workflowErr 记录流程引擎不可用的原因。
	workflowErr error
	// cronSvc is the process-wide scheduler shared by the workflow scan and business jobs. | cronSvc 是流程
	// 扫描与业务任务共用的进程级调度器。
	cronSvc *service.CronService
	// systemTenantID is the resolved owner of the system dictionary layer; empty disables system
	// management and leaves that layer read-only. | systemTenantID 是系统级字典层的解析归属；
	// 为空时关闭系统管理，该层保持只读。
	systemTenantID string
	// hub fans message events out to WebSocket subscribers. | hub 把消息事件分发给 WebSocket 订阅者。
	hub *realtime.Hub
