// actorPermissions returns the permissions of the signed-in user. | actorPermissions 返回当前登录用户的权限集合。
func (c *Controller) actorPermissions(ctx *router.Ctx) map[model.Permission]struct{} {
	user, ok := auth.CurrentUser(ctx)
	if !ok || user == nil {
		return nil
	}
	held := make(map[model.Permission]struct{})
	for _, p := range c.auth.Permissions(user) {
		held[p] = struct{}{}
	}
	return held
}

// actorHoldsAll reports whether the signed-in user holds every wanted capability. | actorHoldsAll
// 报告当前登录用户是否持有全部所需能力。
//
// This is the anti-escalation gate: an administrator may hand out only what it already holds, so
// the deliberately withheld owner-only capabilities cannot be granted by their holder. | 这是防越权
// 闸门：管理员只能分发自己已经持有的能力，因此刻意保留给所有者、管理员并不持有的能力无法由
// 管理员授出。
func (c *Controller) actorHoldsAll(ctx *router.Ctx, wanted []model.Permission) bool {
	held := c.actorPermissions(ctx)
	if held == nil {
		return false
	}
	for _, p := range wanted {
		if _, ok := held[p]; !ok {
			return false
		}
	}
	return true
}

// userPermissions returns the union of the permissions granted by a user's roles. | userPermissions
// 返回某个用户全部角色所授予的权限并集。
func (c *Controller) userPermissions(ctx *router.Ctx, tenantID, userID string) ([]model.Permission, error) {
	user, err := c.users.Get(ctx.Request.Context(), tenantID, userID)
	if err != nil {
		return nil, err
	}
	roles, err := c.roles.List(ctx.Request.Context(), tenantID)
	if err != nil {
		return nil, err
	}
	byName := make(map[string]model.Role, len(roles))
	for _, role := range roles {
		byName[strings.ToLower(role.Name)] = role
	}
	seen := make(map[model.Permission]struct{})
	out := make([]model.Permission, 0, len(user.Roles))
	for _, name := range user.Roles {
		role, ok := byName[strings.ToLower(name)]
		if !ok {
			continue
		}
		for _, p := range role.Permissions {
			if _, dup := seen[p]; dup {
				continue
			}
			seen[p] = struct{}{}
			out = append(out, p)
		}
	}
	return out, nil
}

// canManageUser reports whether the actor may change a user: it must hold every capability the
// target currently has. Otherwise an admin could reset the owner's password and sign in as them.
// | canManageUser 报告管理员能否修改某个用户：它必须持有目标当前的全部能力，否则管理员可以
// 重置所有者口令并以其身份登录。
func (c *Controller) canManageUser(ctx *router.Ctx, tenantID, userID string) bool {
	current, err := c.userPermissions(ctx, tenantID, userID)
	if err != nil {
		return false
	}
	return c.actorHoldsAll(ctx, current)
}

// generatedTenantID returns the tenant resolved by middleware.Tenant for this request. Generated
// CRUD controllers call it before every repository operation, so a generated module inherits the
// same tenant boundary as the hand-written ones. | generatedTenantID 返回 middleware.Tenant 为本请求
// 解析出的租户。生成的 CRUD 控制器在每次仓储操作前调用它，使生成模块继承与手写模块相同的租户边界。
func generatedTenantID(c *router.Ctx) (string, bool) {
	if id, ok := middleware.TenantID(c); ok {
		return id, true
	}
	_ = c.HTMLString(http.StatusForbidden, string(htmx.ErrorFragment("forbidden | 禁止访问")))
	return "", false
}

// PublicKey returns the hexadecimal SM2 public key. | PublicKey 返回 SM2 公钥的十六进制形式。
func (c *Controller) PublicKey() string { return c.auth.PublicKeyHex() }

// ResolveTenant 把租户标识或租户 ID 解析为租户 ID，签名与 middleware.TenantResolver 一致，因此可以直接注入中间件。
// ResolveTenant maps a tenant key or id onto a tenant id; its signature is middleware.TenantResolver, so the tenant
// middleware takes it as-is.
//
// 解析规则留在 internal/service（业务规则不下沉到中间件），中间件只负责「什么时候问、问到结果怎么用」。
// The resolution rule stays in internal/service (business rules never sink into middleware) and the middleware only
// decides when to ask and what to do with the answer.
func (c *Controller) ResolveTenant(ctx context.Context, key string) (string, error) {
	return c.tenants.Resolve(ctx, key)
}

// Deny 渲染中间件层的拒绝：鉴权中间件、权限校验与租户校验共用它，因此「被拒绝」的页面表现只有一种。
// Deny renders a refusal raised in a middleware: the auth middleware, the permission guard and the tenant check all
// share it, so a refused request looks the same whichever layer refused it.
//
// 未登录的普通浏览请求改送登录页而不是丢一个错误片段：浏览器地址栏里的 /users 换成一个 401 页面毫无帮助，
// 换成登录页才给人一条出路；htmx 请求与 API 客户端（带 Authorization、不认 HTML）继续得到 401 片段。
// A plain browsing request without a session goes to the sign-in page instead of receiving an error fragment: answering
// /users with a 401 page helps nobody, while the sign-in page offers a way forward; htmx requests and API clients
// (which send Authorization and do not parse HTML) keep getting the 401 fragment.
func (c *Controller) Deny(ctx *router.Ctx, err error) {
	status, message := statusFor(err)
	if isAPIPath(ctx.Path()) {
		// API 客户端不会跟随登录页，也不解析 HTML；拒绝必须以同一种 JSON 形态到达。 |
		// API clients neither follow the sign-in page nor parse HTML; the refusal must arrive as JSON.
		c.log.Warn("middleware refused the API request | 中间件拒绝了 API 请求",
			ydlog.Err(err), ydlog.Str("path", ctx.Path()), ydlog.Str("method", ctx.Method()), ydlog.Int("status", status))
		c.failJSON(ctx, status, message)
		return
	}
	if status == http.StatusUnauthorized && !htmx.IsRequest(ctx.Request) {
		c.clearSession(ctx)
		c.redirect(ctx, "/login")
		return
	}
	c.log.Warn("middleware refused the request | 中间件拒绝了请求",
		ydlog.Err(err),
		ydlog.Str("path", ctx.Path()),
		ydlog.Str("method", ctx.Method()),
		ydlog.Int("status", status),
	)
	c.fail(ctx, status, message)
}

// view 构造页面数据：所有模板共享的字段在这里注入一次，页面只需追加自己的键。
// view builds the page data: every field shared by all templates is injected once here, and pages only add their own keys.
//
// 权限在这里接入（路由侧的另一半是 authz.Middleware），并一次注入四样东西：模板助手 can/hasRole 读的 .Authz、
// 数据键 .Perm/.Role（模板写 {{ "{{ .Perm.UserRead }}" }} 或 data-yd-perm="{{ "{{ .Perm.UserRead }}" }}"），
// 以及 base.html 注入到 <script id="yd-authz"> 的 .AuthzJSON——前端 yd-authz.js 与服务器的判定因此同源，
// 页面显示的按钮就是服务端真的会放行的按钮。
// The authority is wired here (its other half is authz.Middleware in the router) and injects four things at once: the
// .Authz read by the can/hasRole helpers, the .Perm/.Role data keys (templates write {{ "{{ .Perm.UserRead }}" }} or
// data-yd-perm="{{ "{{ .Perm.UserRead }}" }}"), and the .AuthzJSON base.html puts into <script id="yd-authz">. The
// front-end guard and the server therefore decide from one source, so a button a page offers is one the server will let
// through.
//
// .User 在未登录时是真正的 nil（而不是装了 nil 指针的接口）：模板里的 {{ "{{ if .User }}" }} 才能按预期判假。
// .User is a genuine nil when nobody is signed in rather than an interface holding a nil pointer, which is what makes
// {{ "{{ if .User }}" }} behave as written in the templates.
func (c *Controller) view(ctx *router.Ctx, title string, extra map[string]any) map[string]any {
	return c.renderData(ctx, title, extra, true)
}

// pageView 为「可能返回片段」的处理器选择数据深度：htmx 工作区片段跳过只属于外壳的查询，整页请求与
// 整块外壳请求仍拿到完整数据。
// pageView chooses the data depth for handlers that may answer with a fragment: an htmx workspace fragment skips
// the shell-only lookups, while a whole-page request and a shell swap still receive the full data.
func (c *Controller) pageView(ctx *router.Ctx, title string, extra map[string]any) map[string]any {
	return c.renderData(ctx, title, extra, !htmx.IsPartial(ctx.Request) || isShellTarget(ctx.Request))
}

// renderData 是 view 与 pageView 的共同实现。full 为 false 时省掉的四项都只服务外壳：
// 重新读取用户、租户成员关系、当前租户记录与未读汇总；片段模板用不到它们，却会因此为每次局部刷新
// 付出十余次查询（种子管理员的 SeedPassword 检查还包含一次口令散列校验）。
// renderData is the shared implementation of view and pageView. With full false it omits the four
// shell-only jobs: re-reading the user, the tenant memberships, the current tenant record and the unread summary.
// Fragment templates never read them, yet every partial refresh would otherwise pay a dozen queries — and for the
// seeded administrator the SeedPassword check adds a password-hash verification on top.
func (c *Controller) renderData(ctx *router.Ctx, title string, extra map[string]any, full bool) map[string]any {
	data := map[string]any{
		"Title":               title,
		"Name":                meta.Name,
		"Module":              meta.Module,
		"Description":         meta.Description,
		"Version":             meta.Version,
		"GoVersion":           meta.GoVersion,
		"HtmxVersion":         meta.HtmxVersion,
		"TailwindVersion":     meta.TailwindVersion,
		"Features":            meta.Features,
		"Scripts":             meta.HtmxExtScripts,
		"BundleURLs":          c.bundleURLs,
		"Path":                ctx.Path(),
		"PublicKey":           c.PublicKey(),
		"KeyEndpoint":         PubkeyPath,
		"Lang":                c.lang(ctx),
		"TenantHeader":        meta.TenantHeader,
		"SeedNotice":          meta.SeedPasswordNotice,
		"User":                nil,
		"Tenant":              nil,
		"Tenants":             []model.Tenant{},
		"DefaultTenantID":     "",
		"SignedIn":            false,
		"SeedPassword":        false,
		"Permissions":         []model.Permission{},
		"PageStyles":          []string{},
		"PageScripts":         []string{},
		"Unread":              messaging.UnreadSummary{},
		"MessageAvailable":    c.MessagesAvailable(),
		"MessageError":        "",
		"AttachmentAvailable": c.AttachmentsAvailable(),
		"AttachmentError":     "",
		"DictionaryAvailable": c.DictionariesAvailable(),
		"WorkflowAvailable":   c.WorkflowAvailable(),
		"WorkflowError":       workflowErrorMessage(c.WorkflowError()),
		// The captcha switches appear in every page's data: the sign-in and account pages decide from them whether
		// to render the widget, and the whole block is omitted while disabled.
		// 验证码开关在每一份页面数据里都出现：登录页与账号页据此决定是否渲染组件，关闭时模板整块省略。
		"CaptchaLogin":                c.captcha.Enabled(captcha.ActionLogin),
		"CaptchaPasswordChange":       c.captcha.Enabled(captcha.ActionPasswordChange),
		"CaptchaEndpoint":             captcha.Endpoint,
		"CaptchaTokenField":           captcha.TokenField,
		"CaptchaLoginAction":          captcha.ActionLogin,
		"CaptchaPasswordChangeAction": captcha.ActionPasswordChange,
	}
	layout, shell, portal := c.layoutForPath(ctx.Path())
	data[render.LayoutKey] = layout
	data["Shell"] = shell
	data["Portal"] = portal
	data["Mgr"] = !portal
	for k, v := range extra {
		data[k] = v
	}

	user, _ := auth.CurrentUser(ctx)

	// 默认租户可以在账号页随时修改，而上下文里的用户来自本请求刚开始时的令牌校验。
	// 每次渲染前按「当前活动租户」重读一次，页面上的默认标记与右上角下拉因此总是最新的；
	// 读失败时保留令牌里的视图，渲染不因一次存储抖动而失败。
	// The default tenant can change at any time on the account page, while the user in the
	// context was loaded when this request was verified. Re-reading the user for the active
	// tenant before each render keeps the default marker and the top-right dropdown current;
	// a failed read keeps the token view, so one store hiccup never fails the render.
	if full && user != nil {
		if tenantID, ok := middleware.TenantID(ctx); ok {
			if fresh, err := c.store.Auth().GetUser(ctx.Request.Context(), tenantID, user.ID); err == nil {
				user = fresh
				ctx.Set(auth.DefaultCtxKey, fresh)
			}
		}
	}

	// 权限信封在「未登录」的提前返回**之前**合并：匿名请求因此也会得到一个「什么都不授予」的信封，
	// 页面在两种情况下走的是同一条路径，而不是各自判空。链上没有 authz.Middleware 时在这里自建主体，
	// 于是一次漏装配的后果是「受守卫的控件不显示」，而不是渲染失败——失败方向与缺权限完全一致（失败关闭）。
	// The envelope is merged **ahead of** the anonymous early return, so an anonymous request also receives an envelope
	// that grants nothing and both cases take one path instead of a nil check each. Without authz.Middleware on the chain
	// the subject is built here, so a missing wiring hides guarded controls rather than failing the render: the failure
	// direction is the same as a missing permission (fail closed).
	subject, ok := authz.SubjectOf(ctx.Request.Context())
	if !ok {
		subject = authz.NewSubject(c.Auth(), user)
	}
	// A fragment never renders the shell and therefore never uses the inline .AuthzJSON: take the authority and
	// the two name maps only, skipping one JSON serialisation on every partial refresh. | 片段从不渲染外壳，
	// 也就从不使用内联的 .AuthzJSON：只取判定主体与两张名字表，省掉每次局部刷新都要做的一次 JSON 序列化。
	authzData := authz.TemplateData(subject)
	if full {
		authzData = authz.Data(subject)
	}
	for k, v := range authzData {
		data[k] = v
	}

	if user == nil {
		return data
	}

	// 页面拿到的是 internal/model 的用户视图而不是框架的 *auth.User：模板需要的是展示名与头像首字母这类派生值，
	// 而它们只定义在模型层；把框架结构体直接塞进模板会让每一个页面各自重算一遍。
	// Pages receive the internal/model view rather than the framework's *auth.User: what a template needs are derived
	// values such as the display name and the avatar initial, which live in the model layer alone. Handing the framework
	// struct to a template would make every page recompute them.
	data["User"] = model.UserFromAuth(user)
	data["SignedIn"] = true
	data["DefaultTenantID"] = user.DefaultTenantID
	data["Permissions"] = c.auth.Permissions(user)

	// 以下四项只被整页外壳（侧栏、顶栏）与首页/账号页使用：片段模板不读它们，局部刷新因此不必付出
	// 用户重读、租户列表、租户记录、未读汇总与种子口令校验的代价。
	// The four blocks below serve only the whole-page shell (rail, top bar) and the home/account pages. Fragment
	// templates never read them, so a partial refresh need not pay for the user re-read, tenant list, tenant
	// record, unread summary or seed-password verification.
	if full {
		data["SeedPassword"] = c.auth.SeedPasswordUnchanged(user)

		// 右上角的租户下拉读的就是这份成员清单：只有成员租户才会出现在里面，切换服务端再校验一次。
		// The top-right tenant dropdown reads exactly this membership list: only tenants the user
		// belongs to appear, and the switch endpoint verifies the membership again server-side.
		if members, err := c.users.Tenants(ctx.Request.Context(), user.ID); err == nil {
			data["Tenants"] = members
		} else {
			c.log.Warn("tenant memberships unavailable | 租户成员关系不可用", ydlog.Err(err), ydlog.Str("user", user.ID))
		}
	}

	// 模板不再需要「能不能写用户」这类布尔值：判断改由 can/hasRole 与 .Perm 数据键完成，
	// 助手把引用交给注册表解析，因此授权规则只有注册表那一处，模板里既没有权限清单，也没有第二份判定。
	// No "may write users" booleans are injected any more: the judgement moved to can/hasRole and the .Perm data keys,
	// and the helpers resolve their references through the registry, so the authorization rule lives in exactly one
	// place — a template holds neither a permission list nor a second copy of the decision.

	if tenantID, ok := middleware.TenantID(ctx); ok {
		data["TenantID"] = tenantID
		if full {
			if tenant, err := c.tenants.Get(ctx.Request.Context(), tenantID); err == nil {
				data["Tenant"] = tenant
			}
		}
	}

	// 未读徽标在每个登录整页渲染：消息中心不可用时保持零值，且绝不因为它拖垮整页渲染。片段的角标由
	// WebSocket 推送的 TplUnreadFrames 单独渲染，因此这里只在整页请求时查询。
	// The unread badge renders on every signed-in whole page: when the centre is unavailable it stays zero, and it
	// must never take the whole page down. Fragment badges are rendered separately from the WebSocket's
	// TplUnreadFrames, so the summary is queried only for a whole-page request.
	if full && c.MessagesAvailable() {
		if summary, err := c.messages.Unread(ctx.Request.Context(), c.messageActor(ctx)); err == nil {
			data["Unread"] = summary
		} else {
			c.log.Debug("unread summary unavailable | 未读汇总不可用", ydlog.Err(err))
		}
	}
	if c.messageErr != nil {
		data["MessageError"] = c.messageErr.Error()
	}
	if c.attachmentErr != nil {
		data["AttachmentError"] = c.attachmentErr.Error()
	}
	return data
}

// pageNumber reads the 1-based page query and falls back to one when it is absent or invalid. | pageNumber 读取从 1 开始的页码，非法或缺失时回到第一页。
func pageNumber(ctx *router.Ctx) int {
	page, err := strconv.Atoi(strings.TrimSpace(ctx.Query("page")))
	if err != nil || page < 1 {
		return 1
	}
	return page
}

// pageBounds 把总行数、页码与页长归一化为页码、页数以及切片起止下标。 |
// pageBounds normalises total, page and page size into the current page, page count and slice bounds.
func pageBounds(total, page, pageSize int) (current, pages, start, end int) {
	if pageSize <= 0 {
		pageSize = defaultPageSize
	}
	pages = (total + pageSize - 1) / pageSize
	if pages < 1 {
		pages = 1
	}
	if page < 1 {
		page = 1
	}
	if page > pages {
		page = pages
	}
	start = (page - 1) * pageSize
	end = start + pageSize
	if end > total {
		end = total
	}
	return page, pages, start, end
}

// pageLinks 构造分页窗口：首页、末页与当前页前后各一页，中间以省略号连接。
// pageLinks builds the pager window: first, last and one page around the current page, with ellipses in between.
func pageLinks(total, page, pageSize int, href func(int) string) (pages []map[string]any, prevHref, nextHref string) {
	current, count, _, _ := pageBounds(total, page, pageSize)
	if count <= 1 {
		return nil, "", ""
	}
	if current > 1 {
		prevHref = href(current - 1)
	}
	if current < count {
		nextHref = href(current + 1)
	}
	numbers := make([]int, 0, 5)
	for n := 1; n <= count; n++ {
		if n == 1 || n == count || (n >= current-1 && n <= current+1) {
			numbers = append(numbers, n)
		}
	}
	for i, n := range numbers {
		if i > 0 && n-numbers[i-1] > 1 {
			pages = append(pages, map[string]any{"Ellipsis": true})
		}
		pages = append(pages, map[string]any{
			"Number":  n,
			"Href":    href(n),
			"Current": n == current,
		})
	}
	return pages, prevHref, nextHref
}

// lang 返回请求语言；i18n 未装配时回退到 meta.DefaultLang，页面 lang 属性因此永不为空。
// lang returns the request language and falls back to meta.DefaultLang when i18n is not wired, so the lang attribute is never empty.
func (c *Controller) lang(ctx *router.Ctx) string {
	if t := i18n.FromContext(ctx); t != nil {
		return t.Lang()
	}
	return meta.DefaultLang
}

// field 读取并裁剪一个表单字段，同时限制长度。
// field reads and trims one form field, capping its length.
func field(ctx *router.Ctx, name string) string {
	value := strings.TrimSpace(ctx.FormValue(name))
	if len(value) > maxFormFieldLen {
		value = value[:maxFormFieldLen]
	}
	return value
}

// firstNonEmpty returns the first non-empty value. | firstNonEmpty 返回第一个非空值。
func firstNonEmpty(values ...string) string {
	for _, value := range values {
		if strings.TrimSpace(value) != "" {
			return strings.TrimSpace(value)
		}
	}
	return ""
}

// workflowHTMXTarget reports whether an htmx request swaps one specific container. Page handlers
// then answer with the list fragment, so a filtered URL stays the canonical page URL while the
// browser history and HX-Current-URL both carry the filters. | workflowHTMXTarget 报告 htmx 请求是否
// 换入指定容器。页面处理器因此返回列表片段，筛选后的 URL 仍是规范页面 URL，浏览器历史与
// HX-Current-URL 都带着筛选条件。
func workflowHTMXTarget(ctx *router.Ctx, id string) bool {
	return strings.TrimPrefix(strings.TrimSpace(ctx.Request.Header.Get("HX-Target")), "#") == id
}

// payload 读取一个密文字段并还原为字节：前端提交的是 Base64，auth.DecryptLoginPayload 两种形态都接受。
// payload reads a ciphertext field and turns it back into bytes: the front end submits Base64 while
// auth.DecryptLoginPayload accepts both that and the raw form.
func payload(ctx *router.Ctx, name string) []byte { return []byte(field(ctx, name)) }

// scheme reads the marker header of a national-cryptography payload. | scheme 读取国密载荷的标记请求头。
func scheme(ctx *router.Ctx) string { return ctx.Header(auth.LoginEncryptedHeader) }

// formValues 返回同名表单字段的全部取值（多选框与复选框由此读取）。
// formValues returns every value of a form field with the same name, which is how checkbox groups are read.
//
// 先调一次 FormValue：它会完成表单解析并受 MaxBodySize 限制，随后 Request.Form 才持有全部同名取值。
// It calls FormValue once first: that parses the body under the MaxBodySize bound, and only then does Request.Form hold
// every value sharing the name.
func formValues(ctx *router.Ctx, name string) []string {
	_ = ctx.FormValue(name)
	values := ctx.Request.Form[name]
	out := make([]string, 0, len(values))
	for _, v := range values {
		trimmed := strings.TrimSpace(v)
		if trimmed == "" || len(trimmed) > maxFormFieldLen {
			continue
		}
		out = append(out, trimmed)
	}
	return out
}

// layoutForPath selects the portal or management skeleton from the request path. The split is a
// single decision, so a page cannot accidentally render inside the other area's shell. |
// layoutForPath 按请求路径选择门户或管理骨架。这个决定只有一处，页面因此不会误用另一侧的布局。
func (c *Controller) layoutForPath(path string) (layout, shell string, portal bool) {
	if strings.HasPrefix(path, "/mgr") || strings.HasPrefix(path, "/api/v1") {
		return LayoutMgr, ShellMgr, false
	}
	return LayoutPortal, ShellPortal, true
}

// render 渲染片段或整页：app.Render 依据 HX-Request 与 HX-Request-Type 自动选择「只片段」还是「布局包裹片段」。
// render renders a fragment or a whole page: app.Render picks "fragment only" or "layout-wrapped fragment" from HX-Request and HX-Request-Type.
//
// 「整块外壳」请求（hx-target="#yd-shell"）先渲染页面片段，再把它作为 .Content 交给 layouts/shell.html：
// 侧栏高亮与语言因此随每次导航一起更新。表单与局部刷新仍然只换 #yd-workspace，不会重建外壳。
// A "whole shell" request (hx-target="#yd-shell") renders the page fragment first and then hands it to
// layouts/shell.html as .Content, which is what keeps the sidebar highlight and language in step with every
// navigation. Forms and partial refreshes still swap #yd-workspace alone and never rebuild the shell.
func (c *Controller) render(ctx *router.Ctx, status int, name string, data map[string]any) {
	if isShellTarget(ctx.Request) {
		c.renderShell(ctx, status, name, data)
		return
	}
	if err := c.app.Render(ctx, status, name, data); err != nil {
		c.log.Error("render failed | 渲染失败",
			ydlog.Err(err),
			ydlog.Str("template", name),
			ydlog.Str("path", ctx.Path()),
		)
	}
}

// isShellTarget reports whether this htmx request swaps the whole shell rather than the workspace. | isShellTarget 报告本次 htmx 请求换入的是整块外壳而不是工作区。
func isShellTarget(r *http.Request) bool {
	return strings.Contains(htmx.Target(r), "yd-shell")
}

// renderShell renders the page fragment and then the shell around it. | renderShell 先渲染页面片段，再把它包进外壳。
//
// 页面片段直接经渲染器写出，因此译者必须在这里显式注入：app.Render 只会在它自己的调用里补译者，
// 这次中转不经过它。外壳本身仍由 app.Render 渲染，译者照常注入。
// The page fragment is rendered directly through the renderer, so the translator has to be injected here:
// app.Render only adds it inside its own call, which this intermediate step bypasses. The shell itself is
// still rendered by app.Render, which injects the translator as usual.
func (c *Controller) renderShell(ctx *router.Ctx, status int, name string, data map[string]any) {
	if c.app.Renderer() == nil {
		c.fail(ctx, http.StatusInternalServerError, msgInternal)
		return
	}
	pageData := make(map[string]any, len(data)+1)
	for k, v := range data {
		pageData[k] = v
	}
	pageData[render.TranslatorKey] = i18n.FromContext(ctx)

	var page bytes.Buffer
	if err := c.app.Renderer().Render(&page, name, pageData); err != nil {
		c.log.Error("shell fragment render failed | 外壳片段渲染失败",
			ydlog.Err(err),
			ydlog.Str("template", name),
			ydlog.Str("path", ctx.Path()),
		)
		return
	}

	shellData := make(map[string]any, len(data)+1)
	for k, v := range data {
		shellData[k] = v
	}
	shellData["Content"] = template.HTML(page.String()) //nolint:gosec // trusted: rendered from a template | 可信：由模板渲染
	shellName := ShellPortal
	if name, ok := data["Shell"].(string); ok && strings.TrimSpace(name) != "" {
		shellName = name
	}
	if err := c.app.Render(ctx, status, shellName, shellData); err != nil {
		c.log.Error("shell render failed | 外壳渲染失败",
			ydlog.Err(err),
			ydlog.Str("path", ctx.Path()),
		)
	}
}

// toast 下发一条浏览器提示：事件名由 internal/meta 定义，页面在 body 上订阅。
// toast fires one browser-side notice: the event name comes from internal/meta and the page subscribes on the body.
func (c *Controller) toast(ctx *router.Ctx, message string) {
	htmx.TriggerFromCtx(ctx, htmx.Event{Name: meta.ToastEvent, Detail: message})
}

// fail 输出错误片段：状态码 + partials/pages/error.html。
// fail writes the error fragment: the status code plus partials/pages/error.html.
//
// htmx 侧由表单上的 hx-status:422="target:#yd-errors swap:innerHTML" 声明式接管，
// 因此这里既不需要额外的响应头，也不需要前端为失败路径写命令式代码。
// The htmx side takes it over declaratively through hx-status:422="target:#yd-errors swap:innerHTML" on the form, so
// neither an extra response header nor imperative front-end code for the failure path is needed.
func (c *Controller) fail(ctx *router.Ctx, status int, messages ...string) {
	if isAPIPath(ctx.Path()) {
		message := msgInternal
		if len(messages) > 0 {
			message = messages[0]
		}
		c.failJSON(ctx, status, message)
		return
	}
	list := make([]map[string]any, 0, len(messages))
	for _, m := range messages {
		list = append(list, map[string]any{"Text": m})
	}
	templateName := TplError
	if strings.HasPrefix(ctx.Path(), "/mgr") || strings.HasPrefix(ctx.Path(), "/api/v1") {
		templateName = TplMgrError
	}
	c.render(ctx, status, templateName, c.view(ctx, "请求未通过校验 | Request failed validation", map[string]any{
		"Status": status,
		"Errors": list,
	}))
}

// failJSON writes the one error shape every API consumer sees. | failJSON 输出所有 API 消费者看到的统一错误形态。
func (c *Controller) failJSON(ctx *router.Ctx, status int, message string) {
	_ = ctx.JSON(status, map[string]any{"error": message})
}

// isAPIPath reports whether a path belongs to the machine-readable API surface. |
// isAPIPath 报告路径是否属于机器读取的 API 面。
func isAPIPath(path string) bool {
	return strings.HasPrefix(path, "/api/")
}

// failService 把业务哨兵映射为状态码与文案，并输出错误片段。
// failService maps a business sentinel onto a status code and copy, then writes the error fragment.
func (c *Controller) failService(ctx *router.Ctx, err error) {
	if err == nil {
		return
	}
	status, message := statusFor(err)
	if status >= http.StatusInternalServerError {
		// A 500 must leave the full error chain for the access log and for alerting. | 500 必须留下完整错误链，供中间件的访问日志与告警消费。
		c.log.Error("request failed | 请求失败",
			ydlog.Err(err),
			ydlog.Str("path", ctx.Path()),
			ydlog.Str("method", ctx.Method()),
		)
	} else {
		// A 4xx leaves one line: an escalation attempt or a validation failure is a business event, not an incident. | 4xx 只记一行：越权与校验失败是业务事件，不是故障。
		c.log.Warn("request refused | 请求被拒绝",
			ydlog.Err(err),
			ydlog.Str("path", ctx.Path()),
			ydlog.Str("method", ctx.Method()),
		)
	}
	c.fail(ctx, status, message)
}

// redirect 让浏览器换一个地址：htmx 请求走 HX-Redirect，普通请求走 303。
// redirect sends the browser elsewhere: an htmx request gets HX-Redirect and a plain one a 303.
func (c *Controller) redirect(ctx *router.Ctx, target string) {
	if htmx.IsRequest(ctx.Request) {
		htmx.Redirect(ctx.Writer, target)
		if err := ctx.String(http.StatusOK, ""); err != nil {
			c.log.Warn("redirect write failed | 重定向写出失败", ydlog.Err(err))
		}
		return
	}
	if err := ctx.Redirect(http.StatusSeeOther, target); err != nil {
		c.log.Warn("redirect write failed | 重定向写出失败", ydlog.Err(err))
	}
}

// tenantID 取出当前请求的租户 ID；缺失时以 400 结束响应并返回 false。
// tenantID reads the tenant id of the current request and ends the response with a 400 when it is missing.
//
// 受保护端点上的租户由令牌的 tid 声明决定（见 internal/middleware/tenant.go），因此这里取不到只可能是装配错误，
// 但它依然以业务错误收场，而不是继续往下读一个空租户的数据。
// On a protected endpoint the tenant comes from the token's tid claim (see internal/middleware/tenant.go), so a miss can
// only be an assembly mistake — and it still ends as a business error instead of reading data for an empty tenant.
func (c *Controller) tenantID(ctx *router.Ctx) (string, bool) {
	if id, ok := middleware.TenantID(ctx); ok {
		return id, true
	}
	c.fail(ctx, http.StatusBadRequest, service.ErrTenantMissing.Error())
	return "", false
}

// statusFor 把哨兵错误映射为 HTTP 状态码与用户可见文案。
// statusFor maps a sentinel error onto an HTTP status code and the copy shown to the user.
func statusFor(err error) (int, string) {
	switch {
	case errors.Is(err, service.ErrUserNameRequired),
		errors.Is(err, service.ErrUserEmailInvalid),
		errors.Is(err, service.ErrUserPasswordWeak),
		errors.Is(err, service.ErrPasswordMismatch),
		errors.Is(err, service.ErrRoleUnknown),
		errors.Is(err, service.ErrRoleNameRequired),
		errors.Is(err, service.ErrPermissionUnknown),
		errors.Is(err, service.ErrTenantNameRequired),
		errors.Is(err, service.ErrTenantSlugInvalid),
		errors.Is(err, service.ErrTenantSelection):
		// 校验失败一律 422：与前端的 hx-status:422 契约对齐，且语义比 400 更精确。
		// Validation failures are always 422: it matches the front end's hx-status:422 contract and is more precise than 400.
		return http.StatusUnprocessableEntity, err.Error()
	case errors.Is(err, service.ErrUserNotFound), errors.Is(err, service.ErrRoleNotFound):
		return http.StatusNotFound, err.Error()
	case errors.Is(err, middleware.ErrTenantRequired),
		errors.Is(err, auth.ErrTenantRequired),
		errors.Is(err, service.ErrCipherRequired),
		errors.Is(err, service.ErrCipherInvalid),
		errors.Is(err, service.ErrCipherKeyMissing),
		errors.Is(err, service.ErrTenantMissing):
		// 加密链路与租户解析出错：告知客户端换一枚新公钥或补上租户后重试，而不是回落到明文。
		// The encryption chain or the tenant resolution failed: ask the client to refetch the key or to name a tenant rather than falling back to plain text.
		return http.StatusBadRequest, err.Error()
	case errors.Is(err, service.ErrCredentials),
		errors.Is(err, service.ErrAuthUnavailable),
		errors.Is(err, auth.ErrTokenInvalid),
		errors.Is(err, auth.ErrInvalidCredentials),
		errors.Is(err, auth.ErrUserDisabled):
		// 令牌无效、口令不符与被停用共用同一句：鉴权失败的对内分类足够细，对外则必须一样粗。
		// An invalid token, a wrong password and a disabled user share one sentence: the internal classification is fine
		// grained while the outward one has to stay coarse.
		return http.StatusUnauthorized, msgUnauthorized
	case errors.Is(err, auth.ErrNotFound),
		errors.Is(err, messaging.ErrNotFound),
		errors.Is(err, messaging.ErrAttachmentNotFound),
		errors.Is(err, attachments.ErrNotFound):
		return http.StatusNotFound, err.Error()
	case errors.Is(err, auth.ErrWeakPassword), errors.Is(err, auth.ErrInvalidInput):
		// 框架 sentinel 与项目 sentinel 落在同一个状态码上：调用方分辨不出拒绝来自哪一层。
		// Framework sentinels land on the same status codes as this project's own, so a caller cannot tell which layer refused.
		return http.StatusUnprocessableEntity, err.Error()
	case errors.Is(err, auth.ErrForbidden), errors.Is(err, middleware.ErrTenantMismatch),
		errors.Is(err, messaging.ErrForbidden), errors.Is(err, messaging.ErrNotFriend),
		errors.Is(err, messaging.ErrBlocked), errors.Is(err, messaging.ErrNotSender),
		errors.Is(err, messaging.ErrSystemOnly), errors.Is(err, messaging.ErrPinNotAllowed),
		errors.Is(err, messaging.ErrNotMember):
		// 跨租户访问与越权访问都落在这里：对外只回一句，不回显任何租户或用户信息。消息中心把
		// 「不是好友」「不是成员」与权限拒绝映射到同一个 403，调用方因此无法探测关系是否存在。
		// Cross-tenant access and privilege escalation both land here: one sentence goes out and no tenant or user
		// information ever does. The message centre maps "not a friend" and "not a member" onto the same 403, so a
		// caller cannot probe whether a relationship exists.
		return http.StatusForbidden, msgForbidden
	case errors.Is(err, service.ErrSelfOperation), errors.Is(err, service.ErrBuiltinRoleProtected), errors.Is(err, auth.ErrConflict),
		errors.Is(err, messaging.ErrRecallExpired), errors.Is(err, messaging.ErrEditExpired),
		errors.Is(err, messaging.ErrDuplicateRequest), errors.Is(err, messaging.ErrConversationClosed),
		errors.Is(err, messaging.ErrRequestClosed), errors.Is(err, messaging.ErrRecalled),
		errors.Is(err, messaging.ErrTypeProtected), errors.Is(err, messaging.ErrTypeInUse):
		return http.StatusConflict, err.Error()
	case errors.Is(err, messaging.ErrAttachmentTooLarge), errors.Is(err, attachments.ErrTooLarge):
		return http.StatusRequestEntityTooLarge, err.Error()
	case errors.Is(err, messaging.ErrAttachmentType), errors.Is(err, attachments.ErrTypeNotAllowed):
		return http.StatusUnsupportedMediaType, err.Error()
	case errors.Is(err, messaging.ErrUnavailable), errors.Is(err, attachments.ErrUnavailable),
		errors.Is(err, service.ErrAttachmentUnavailable):
		return http.StatusServiceUnavailable, err.Error()
	case errors.Is(err, attachments.ErrReferenced):
		return http.StatusConflict, err.Error()
	case errors.Is(err, attachments.ErrInvalidInput), errors.Is(err, attachments.ErrReasonRequired),
		errors.Is(err, attachments.ErrReasonTooLong), errors.Is(err, attachments.ErrRefInvalid):
		return http.StatusUnprocessableEntity, err.Error()
	case errors.Is(err, messaging.ErrInvalidInput), errors.Is(err, messaging.ErrSelfOperation),
		errors.Is(err, messaging.ErrTypeUnknown), errors.Is(err, messaging.ErrTagUnknown),
		errors.Is(err, messaging.ErrPinWindowInvalid), errors.Is(err, messaging.ErrTooManyMembers),
		errors.Is(err, messaging.ErrTooManyAttachments), errors.Is(err, messaging.ErrSearchTooBroad):
		return http.StatusUnprocessableEntity, err.Error()
	case errors.Is(err, dictionary.ErrInvalidInput), errors.Is(err, dictionary.ErrInvalidExtra),
		errors.Is(err, dictionary.ErrTooManyCodes), errors.Is(err, dictionary.ErrItemLimit):
		return http.StatusUnprocessableEntity, err.Error()
	case errors.Is(err, dictionary.ErrNotFound):
		return http.StatusNotFound, err.Error()
	case errors.Is(err, dictionary.ErrCodeTaken), errors.Is(err, dictionary.ErrValueTaken),
		errors.Is(err, dictionary.ErrBuiltinProtected):
		return http.StatusConflict, err.Error()
	case errors.Is(err, dictionary.ErrUnavailable), errors.Is(err, service.ErrDictionaryUnavailable):
		return http.StatusServiceUnavailable, err.Error()
	case errors.Is(err, workflow.ErrInvalidInput), errors.Is(err, workflow.ErrInvalidDesign),
		errors.Is(err, workflow.ErrInvalidCondition), errors.Is(err, workflow.ErrInvalidForm),
		errors.Is(err, workflow.ErrImportInvalid), errors.Is(err, workflow.ErrBPMNInvalid),
		errors.Is(err, workflow.ErrNoAssignee), errors.Is(err, workflow.ErrLimit):
		return http.StatusUnprocessableEntity, err.Error()
	case errors.Is(err, workflow.ErrNotFound):
		return http.StatusNotFound, err.Error()
	case errors.Is(err, workflow.ErrForbidden), errors.Is(err, workflow.ErrTaskNotMine):
		return http.StatusForbidden, msgForbidden
	case errors.Is(err, workflow.ErrConflict), errors.Is(err, workflow.ErrTaskClosed),
		errors.Is(err, workflow.ErrInstanceClosed), errors.Is(err, workflow.ErrVersionPublished),
		errors.Is(err, workflow.ErrDefinitionPublished), errors.Is(err, workflow.ErrWithdrawExpired),
		errors.Is(err, workflow.ErrRemindLimit):
		return http.StatusConflict, err.Error()
	case errors.Is(err, workflow.ErrUnavailable), errors.Is(err, workflow.ErrAIUnavailable),
		errors.Is(err, workflow.ErrNotificationFailed), errors.Is(err, service.ErrWorkflowUnavailable):
		return http.StatusServiceUnavailable, err.Error()
	case errors.Is(err, router.ErrBodyTooLarge):
		return http.StatusRequestEntityTooLarge, err.Error()
	default:
		return http.StatusInternalServerError, msgInternal
	}
}

// workflowPagination builds the server-driven page links shared by the workflow lists. |
// workflowPagination 构建流程列表共用的服务端分页链接。
func (c *Controller) workflowPagination(ctx *router.Ctx, base string, params map[string]string, page, pageSize, total int) map[string]any {
	if total <= pageSize || pageSize <= 0 {
		return nil
	}
	totalPages := (total + pageSize - 1) / pageSize
	if totalPages < 1 {
		totalPages = 1
	}
	if page < 1 {
		page = 1
	}
	if page > totalPages {
		page = totalPages
	}
	href := func(number int) string {
		values := url.Values{}
		for key, value := range params {
			if strings.TrimSpace(value) != "" {
				values.Set(key, value)
			}
		}
		if number > 1 {
			values.Set("page", strconv.Itoa(number))
		}
		if encoded := values.Encode(); encoded != "" {
			return base + "?" + encoded
		}
		return base
	}
	pages := make([]map[string]any, 0, 7)
	addPage := func(number int) {
		pages = append(pages, map[string]any{"Number": number, "Href": href(number), "Current": number == page})
	}
	addEllipsis := func() {
		pages = append(pages, map[string]any{"Ellipsis": true})
	}
	switch {
	case totalPages <= 7:
		for number := 1; number <= totalPages; number++ {
			addPage(number)
		}
	default:
		addPage(1)
		start, end := page-1, page+1
		if start < 2 {
			start, end = 2, 4
		}
		if end > totalPages-1 {
			start, end = totalPages-3, totalPages-1
		}
		if start > 2 {
			addEllipsis()
		}
		for number := start; number <= end; number++ {
			addPage(number)
		}
		if end < totalPages-1 {
			addEllipsis()
		}
		addPage(totalPages)
	}
	var prevHref, nextHref string
	if page > 1 {
		prevHref = href(page - 1)
	}
	if page < totalPages {
		nextHref = href(page + 1)
	}
	return map[string]any{
		"LabelKey": "ui.pagination",
		"Summary":  fmt.Sprintf(c.tr(c.lang(ctx), "ui.page_summary"), page, totalPages),
		"PrevHref": prevHref,
		"NextHref": nextHref,
		"Pages":    pages,
	}
}

// workflowErrorMessage renders an unavailable-engine reason for page data. | workflowErrorMessage
// 为页面数据渲染引擎不可用原因。
func workflowErrorMessage(err error) string {
	if err == nil {
		return ""
	}
	return err.Error()
}
