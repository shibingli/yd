// CronScheduler returns the process-wide cron scheduler so business code can register task handlers
// and add its own jobs. The scheduler keeps definitions in memory only; there is no Reload. |
// CronScheduler 返回进程级 cron 调度器，业务代码可在它上面注册任务处理器并添加自己的任务。调度器只把
// 定义保存在内存中，因此没有 Reload。
func (c *Controller) CronScheduler() *cron.Scheduler {
	if c == nil || c.cronSvc == nil {
		return nil
	}
	return c.cronSvc.Scheduler()
}

// StartWorkflowRuntime starts the shared cron scheduler and the workflow scan mounted on it, then
// attaches their stop actions to the shutdown chain. The cron stop hook is registered first, so the
// reverse-order shutdown detaches the scan before the scheduler closes. |
// StartWorkflowRuntime 启动共享 cron 调度器与挂载其上的流程扫描，并把停止动作挂到退出链上。cron 的停止
// 钩子先登记，因此逆序关停会先卸载扫描任务、再关闭调度器。
func (c *Controller) StartWorkflowRuntime(ctx context.Context) {
	c.startCronRuntime(ctx)
	if !c.WorkflowAvailable() {
		return
	}
	if err := c.workflow.SchedulerStart(ctx); err != nil {
		c.log.Warn("workflow scheduler failed to start | 流程调度器启动失败", ydlog.Err(err))
	}
	c.app.OnShutdown(func(context.Context) error { return c.workflow.SchedulerStop() })
}

// startCronRuntime starts the shared scheduler and registers its stop hook. |
// startCronRuntime 启动共享调度器并登记其停止钩子。
func (c *Controller) startCronRuntime(ctx context.Context) {
	if c == nil || c.cronSvc == nil {
		return
	}
	if err := c.cronSvc.Start(ctx); err != nil {
		c.log.Warn("cron scheduler failed to start | 定时任务调度器启动失败", ydlog.Err(err))
		return
	}
	c.app.OnShutdown(func(context.Context) error { return c.cronSvc.Stop() })
}

// workflowActor returns the engine actor of the signed-in user. | workflowActor 返回当前登录用户的流程操作人。
func (c *Controller) workflowActor(ctx *router.Ctx) workflow.Actor {
	user, ok := auth.CurrentUser(ctx)
	if !ok || user == nil {
		return workflow.Actor{}
	}
	return workflow.Actor{
		ID:    user.ID,
		Name:  user.DisplayName,
		Admin: authz.Can(ctx.Request.Context(), authz.PermWorkflowAdmin),
	}
}

// workflowServiceOrFail writes a 503 when the engine is unavailable and reports false. |
// workflowServiceOrFail 在引擎不可用时写出 503 并返回 false。
func (c *Controller) workflowServiceOrFail(ctx *router.Ctx) bool {
	if c.WorkflowAvailable() {
		return true
	}
	message := "流程引擎不可用 | workflow engine is unavailable"
	if c.workflowErr != nil {
		message = c.workflowErr.Error()
	}
	c.fail(ctx, http.StatusServiceUnavailable, message)
	return false
}

// CanManageSystemDictionaries reports whether the caller is an authenticated member of the
// configured system tenant holding dictionary:system_manage. Every other tenant is read-only. |
// CanManageSystemDictionaries 报告调用方是否为配置系统租户中持有 dictionary:system_manage 的成员；
// 其它租户始终只读。
func (c *Controller) CanManageSystemDictionaries(ctx *router.Ctx) bool {
	if c == nil || ctx == nil || c.systemTenantID == "" || !c.DictionariesAvailable() {
		return false
	}
	if !authz.Can(ctx.Request.Context(), authz.PermDictionarySystemManage) {
		return false
	}
	tenantID, ok := middleware.TenantID(ctx)
	return ok && tenantID == c.systemTenantID
}

