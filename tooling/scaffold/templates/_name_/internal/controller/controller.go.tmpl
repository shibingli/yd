// Package controller 承载 HTTP 处理器：只做编排与数据组装，业务规则一律放 internal/service。
// Package controller holds the HTTP handlers: they only orchestrate and assemble data, and every business rule lives in internal/service.
//
// Four hard rules: | 四条硬性约定：
//   - every handler carries a complete OpenAPI 3.0 annotation block above it (see docs/developer_guidelines.md §9.2), which yd build turns into the document; | 每个处理器上方的注释块都是完整的 OpenAPI 3.0 注解（见 docs/developer_guidelines.md §9.2），yd build 据此生成文档；
//   - endpoints answer with HTML fragments rather than JSON (/events, /ws and /ws/metrics are streaming, /guomi/pubkey returns the public key as plain text); | 端点返回 HTML 片段而不是 JSON（/events、/ws 与 /ws/metrics 是流式端点，/guomi/pubkey 是纯文本公钥）；
//   - multi-tenancy is a hard boundary: every business call carries the tenant id from the context, and cross-tenant reads and writes are refused in both the service and the repository layer; | 多租户是硬边界：每一次业务调用都带着上下文里的租户 ID，跨租户的读写在 service/repository 两层各拦一次；
//   - status codes are derived from the business sentinels via errors.Is and never from parsing error messages. | 状态码由业务哨兵映射而来（errors.Is），绝不解析错误文案。
package controller

import (
	"bytes"
	"context"
	"errors"
	"html/template"
	"net/http"
	"strings"

	"{{ .Module }}/internal/meta"
	"{{ .Module }}/internal/middleware"
	"{{ .Module }}/internal/model"
	"{{ .Module }}/internal/repository"
	"{{ .Module }}/internal/service"
	"{{ .YdModule }}/runtime/app"
	"{{ .YdModule }}/security/auth"
	"{{ .YdModule }}/security/authz"
	"{{ .YdModule }}/core/errx"
	"{{ .YdModule }}/http/htmx"
	"{{ .YdModule }}/http/i18n"
	"{{ .YdModule }}/core/logx"
	"{{ .YdModule }}/http/render"
	"{{ .YdModule }}/http/router"
	"{{ .YdModule }}/messaging"
	"{{ .YdModule }}/messaging/realtime"
	"{{ .YdModule }}/runtime/metricsx"
)

