// workflowDefinitionRows loads one page and decorates every row with its versions. | workflowDefinitionRows
// 加载一页定义并为每行补充版本。
func (c *Controller) workflowDefinitionRows(ctx *router.Ctx, tenantID string, filter workflow.DefinitionFilter) (workflow.DefinitionPage, []workflowDefinitionView, error) {
	page, err := c.workflow.ListDefinitions(ctx.Request.Context(), tenantID, filter)
	if err != nil {
		return workflow.DefinitionPage{}, nil, err
	}
	ids := make([]string, 0, len(page.Items))
	for _, definition := range page.Items {
		ids = append(ids, definition.ID)
	}
	summariesByDefinition, err := c.workflow.VersionSummariesForDefinitions(ctx.Request.Context(), tenantID, ids)
	if err != nil {
		return workflow.DefinitionPage{}, nil, err
	}
	views := make([]workflowDefinitionView, 0, len(page.Items))
	for _, definition := range page.Items {
		summaries := summariesByDefinition[definition.ID]
		view := workflowDefinitionView{
			Definition: definition,
			CanManage:  c.workflowCanManage(ctx),
		}
		for _, version := range summaries {
			if version.Status == workflow.VersionDraft && view.Draft.ID == "" {
				view.Draft = version
			}
			if version.Status == workflow.VersionPublished && view.Published.ID == "" {
				view.Published = version
			}
		}
		views = append(views, view)
	}
	return page, views, nil
}

