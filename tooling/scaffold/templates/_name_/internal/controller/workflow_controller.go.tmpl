// WorkflowImport reads one upload and merges it. | WorkflowImport 读取一个上传并合并。
//
// @Summary Import workflows | 导入流程
// @Description Accepts a JSON bundle or a BPMN 2.0 XML document and merges it into the tenant. | 接收 JSON 流程包或 BPMN 2.0 XML 文档并合并进租户。
// @Tags workflow
// @Accept multipart/form-data
// @Produce html
// @Param file formData file true "Bundle or BPMN file | 流程包或 BPMN 文件"
// @Success 200 {string} string "definition table | 定义表格"
// @Failure 422 {string} string "invalid document | 文档非法"
// @Security BearerAuth
// @Router /mgr/workflows/import [post]
func (c *Controller) WorkflowImport(ctx *router.Ctx) {
	if !c.workflowServiceOrFail(ctx) {
		return
	}
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return
	}
	file, header, err := ctx.FormFile(FieldWorkflowFile)
	if err != nil {
		c.fail(ctx, http.StatusUnprocessableEntity, "请选择要导入的文件 | choose a file to import")
		return
	}
	defer func() { _ = file.Close() }()
	limit := int64(c.workflow.Options().MaxImportBytes)
	if header.Size > limit {
		c.fail(ctx, http.StatusRequestEntityTooLarge, "导入文件过大 | import file is too large")
		return
	}
	content, readErr := io.ReadAll(io.LimitReader(file, limit+1))
	if readErr != nil {
		c.fail(ctx, http.StatusUnprocessableEntity, "读取导入文件失败 | the import file could not be read")
		return
	}
	if int64(len(content)) > limit {
		c.fail(ctx, http.StatusRequestEntityTooLarge, "导入文件过大 | import file is too large")
		return
	}
	actor := c.workflowActor(ctx)
	extension := strings.ToLower(filepath.Ext(header.Filename))
	if extension == ".bpmn" || extension == ".xml" || firstNonSpace(content) == '<' {
		process, parseErr := workflow.ParseBPMN(string(content))
		if parseErr != nil {
			c.failService(ctx, parseErr)
			return
		}
		if _, _, err := c.workflow.ImportBPMN(ctx.Request.Context(), tenantID, actor.ID, process); err != nil {
			c.failService(ctx, err)
			return
		}
		c.toast(ctx, "BPMN 已导入为草稿 | BPMN imported as a draft")
		c.renderWorkflowList(ctx, tenantID)
		return
	}
	bundle := workflow.Bundle{}
	if err := json.Unmarshal(content, &bundle); err != nil || len(bundle.Definitions) == 0 {
		single := workflow.BundleDefinition{}
		if singleErr := json.Unmarshal(content, &single); singleErr != nil || single.Key == "" {
			c.fail(ctx, http.StatusUnprocessableEntity, "无法识别的流程包 | unrecognised workflow bundle")
			return
		}
		bundle = workflow.Bundle{SchemaVersion: workflow.BundleSchemaVersion, Definitions: []workflow.BundleDefinition{single}}
	}
	report, err := c.workflow.ImportBundle(ctx.Request.Context(), tenantID, actor.ID, bundle)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	c.toast(ctx, "导入完成 | Import finished")
	c.log.Info("workflow bundle imported | 流程包已导入",
		ydlog.Int("definitions", report.Definitions),
		ydlog.Int("created", report.Created),
		ydlog.Int("updated", report.Updated),
		ydlog.Int("skipped", report.Skipped),
	)
	c.renderWorkflowList(ctx, tenantID)
}

// firstNonSpace returns the first non-whitespace byte, or 0. | firstNonSpace 返回首个非空白字节，或 0。
func firstNonSpace(content []byte) byte {
	for _, b := range content {
		if b == ' ' || b == '\t' || b == '\n' || b == '\r' {
			continue
		}
		return b
	}
	return 0
}

// workflowLongField reads one form field with a larger cap than the generic helper. |
// workflowLongField 以比通用助手更大的上限读取一个表单字段。
func workflowLongField(ctx *router.Ctx, name string, limit int) string {
	value := strings.TrimSpace(ctx.FormValue(name))
	if len([]rune(value)) > limit {
		value = string([]rune(value)[:limit])
	}
	return value
}

