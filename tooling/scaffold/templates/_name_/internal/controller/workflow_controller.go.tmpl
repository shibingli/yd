// workflowDesignerVersion returns the newest draft, cloning the newest version when necessary. The
// summaries query keeps every older design and BPMN document out of the page render. | workflowDesignerVersion
// 返回最近草稿，必要时克隆最新版本。摘要查询让所有旧设计与 BPMN 文档不进入页面渲染。
func (c *Controller) workflowDesignerVersion(ctx *router.Ctx, tenantID string, definition workflow.Definition) (workflow.Version, error) {
	summaries, err := c.workflow.VersionSummariesForDefinitions(ctx.Request.Context(), tenantID, []string{definition.ID})
	if err != nil {
		return workflow.Version{}, err
	}
	versions := summaries[definition.ID]
	var newest workflow.Version
	if len(versions) > 0 {
		for _, summary := range versions {
			if summary.Status == workflow.VersionDraft {
				return c.workflow.GetVersion(ctx.Request.Context(), tenantID, summary.ID)
			}
		}
		newest, err = c.workflow.GetVersion(ctx.Request.Context(), tenantID, versions[0].ID)
		if err != nil {
			return workflow.Version{}, err
		}
	}
	design := defaultWorkflowDesign()
	if newest.ID != "" {
		parsed, err := workflow.DesignOf(newest)
		if err != nil {
			return workflow.Version{}, err
		}
		design = parsed
	}
	actor := c.workflowActor(ctx)
	return c.workflow.CreateVersion(ctx.Request.Context(), tenantID, definition.ID, actor.ID, workflow.VersionInput{
		Design: design, Note: "设计器自动创建 | created by the designer",
	})
}

// defaultWorkflowDesign returns the starter graph of a new process. | defaultWorkflowDesign 返回新流程的起始图。
func defaultWorkflowDesign() workflow.Design {
	design := workflow.DefaultDesign()
	design.Nodes = []workflow.Node{
		{ID: "start", Type: workflow.NodeStart, Name: "开始 | Start", Position: workflow.Position{X: 80, Y: 220}},
		{
			ID: "approve", Type: workflow.NodeUserTask, Name: "审批 | Approve",
			Assignee:   workflow.Assignment{Type: workflow.AssigneeInitiator, Claim: workflow.ClaimAssigned},
			Completion: workflow.Completion{Mode: workflow.CompletionAny, RejectMode: workflow.RejectModeAny},
			OnReject:   workflow.OnRejectTerminate, AllowAuto: true,
			Position: workflow.Position{X: 280, Y: 200},
		},
		{ID: "end", Type: workflow.NodeEnd, Name: "结束 | End", Position: workflow.Position{X: 560, Y: 220}},
	}
	design.Edges = []workflow.Edge{
		{ID: "flow_start_approve", Source: "start", Target: "approve", Sort: 0},
		{ID: "flow_approve_end", Source: "approve", Target: "end", Sort: 1},
	}
	return design
}

// workflowDirectoryJSON renders users, roles and groups for the designer pickers. | workflowDirectoryJSON
// 为设计器选择器渲染用户、角色与流程组。
func (c *Controller) workflowDirectoryJSON(ctx *router.Ctx, tenantID string) (string, error) {
	users, err := c.users.List(ctx.Request.Context(), tenantID, "")
	if err != nil {
		return "", err
	}
	roles, err := c.roles.List(ctx.Request.Context(), tenantID)
	if err != nil {
		return "", err
	}
	groups, err := c.workflow.ListGroups(ctx.Request.Context(), tenantID, workflow.GroupFilter{Page: 1, PageSize: 100})
	if err != nil {
		return "", err
	}
	type directoryUser struct {
		ID       string `json:"id"`
		Name     string `json:"name"`
		Username string `json:"username"`
	}
	type directoryGroup struct {
		Key  string `json:"key"`
		Name string `json:"name"`
		Role string `json:"role,omitempty"`
	}
	directory := struct {
		Users  []directoryUser  `json:"users"`
		Roles  []string         `json:"roles"`
		Groups []directoryGroup `json:"groups"`
	}{
		Users:  make([]directoryUser, 0, len(users)),
		Roles:  make([]string, 0, len(roles)),
		Groups: make([]directoryGroup, 0, len(groups.Items)),
	}
	for _, user := range users {
		directory.Users = append(directory.Users, directoryUser{ID: user.ID, Name: user.DisplayName, Username: user.Username})
	}
	for _, role := range roles {
		directory.Roles = append(directory.Roles, role.Name)
	}
	for _, group := range groups.Items {
		directory.Groups = append(directory.Groups, directoryGroup{Key: group.Key, Name: group.Name, Role: group.Role})
	}
	data, err := json.Marshal(directory)
	if err != nil {
		return "", errs.Wrap(err, workflow.ErrInvalidInput)
	}
	return string(data), nil
}

