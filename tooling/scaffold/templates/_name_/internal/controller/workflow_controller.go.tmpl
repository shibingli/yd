// workflowDefinitionView is one definition row with lightweight version markers. | workflowDefinitionView 是带轻量版本标记的定义行。
type workflowDefinitionView struct {
	// Definition is the row itself. | Definition 是定义行本身。
	Definition workflow.Definition
	// Published is the newest published version, when any. | Published 是最新的已发布版本（如有）。
	Published workflow.VersionSummary
	// Draft is the newest draft, when any. | Draft 是最近的草稿（如有）。
	Draft workflow.VersionSummary
	// CanManage reports whether the caller may mutate this definition. | CanManage 报告调用方能否修改该定义。
	CanManage bool
}

// Workflows renders the process-definition workbench. | Workflows 渲染流程定义工作台。
//
// @Summary Process definitions | 流程定义工作台
// @Description Renders the definition workbench with filters, version state and lifecycle actions. | 渲染带筛选、版本状态与生命周期动作的定义工作台。
// @Tags workflow
// @Produce html
// @Param q query string false "Search keyword | 搜索关键字"
// @Param status query string false "draft, published or disabled | draft、published 或 disabled"
// @Param category query string false "Process category | 流程分类"
// @Param page query int false "1-based page | 从 1 开始的页码"
// @Success 200 {string} string "definition workbench | 定义工作台"
// @Failure 403 {string} string "permission denied | 权限不足"
// @Failure 503 {string} string "workflow engine unavailable | 流程引擎不可用"
// @Security BearerAuth
// @Router /mgr/workflows [get]
func (c *Controller) Workflows(ctx *router.Ctx) {
	if !c.workflowServiceOrFail(ctx) {
		return
	}
	if workflowHTMXTarget(ctx, "yd-workflow-definitions") {
		c.WorkflowDefinitionList(ctx)
		return
	}
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return
	}
	page, views, err := c.workflowDefinitionRows(ctx, tenantID, workflow.DefinitionFilter{
		Query:    field(ctx, FieldKeyword),
		Status:   field(ctx, FieldWorkflowFilterStatus),
		Category: field(ctx, FieldWorkflowCategory),
		Page:     pageNumber(ctx),
	})
	if err != nil {
		c.failService(ctx, err)
		return
	}
	data := c.pageView(ctx, "流程管理 | Workflows", map[string]any{
		"Definitions": views,
		"Total":       page.Total,
		"Page":        page.Page,
		"PageSize":    page.PageSize,
		"Keyword":     field(ctx, FieldKeyword),
		"Status":      field(ctx, FieldWorkflowFilterStatus),
		"Category":    field(ctx, FieldWorkflowCategory),
		"CanManage":   c.workflowCanManage(ctx),
		"Pagination": c.workflowPagination(ctx, "/mgr/workflows", map[string]string{
			"q": field(ctx, FieldKeyword), "status": field(ctx, FieldWorkflowFilterStatus), "category": field(ctx, FieldWorkflowCategory),
		}, page.Page, page.PageSize, page.Total),
	})
	c.render(ctx, http.StatusOK, TplWorkflows, data)
}

