// renderWorkflowList renders the definition table after one mutation. | renderWorkflowList 在变更后渲染定义表格。
func (c *Controller) renderWorkflowList(ctx *router.Ctx, tenantID string) {
	// Mutations carry no filters of their own; recover them from the page the operator was on. |
	// 变更请求本身不带筛选条件，从操作人所在页面恢复。
	keyword := firstNonEmpty(field(ctx, "return_q"), workflowCurrentQuery(ctx, FieldKeyword))
	status := firstNonEmpty(field(ctx, "return_status"), workflowCurrentQuery(ctx, FieldWorkflowFilterStatus))
	category := firstNonEmpty(field(ctx, "return_category"), workflowCurrentQuery(ctx, FieldWorkflowCategory))
	pageNo := pageNumberFromQuery(ctx, firstNonEmpty(field(ctx, "return_page"), workflowCurrentQuery(ctx, "page")))
	page, views, err := c.workflowDefinitionRows(ctx, tenantID, workflow.DefinitionFilter{
		Query: keyword, Status: status, Category: category, Page: pageNo,
	})
	if err != nil {
		c.failService(ctx, err)
		return
	}
	c.render(ctx, http.StatusOK, TplWorkflowDefinitionList, c.view(ctx, "流程列表 | Workflows", map[string]any{
		"Definitions": views,
		"Total":       page.Total,
		"Page":        page.Page,
		"PageSize":    page.PageSize,
		"Keyword":     keyword,
		"Status":      status,
		"Category":    category,
		"CanManage":   c.workflowCanManage(ctx),
		"OOB":         true,
		"Pagination": c.workflowPagination(ctx, "/mgr/workflows", map[string]string{
			"q": keyword, "status": status, "category": category,
		}, page.Page, page.PageSize, page.Total),
	}))
}

