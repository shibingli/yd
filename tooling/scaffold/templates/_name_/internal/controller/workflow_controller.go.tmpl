// WorkflowExport downloads definitions as a JSON bundle or one BPMN document. | WorkflowExport
// 以 JSON 流程包或单个 BPMN 文档下载定义。
//
// @Summary Export definitions | 导出定义
// @Description Exports selected definitions as a JSON bundle, or one version as BPMN 2.0 XML. | 把选定定义导出为 JSON 流程包，或把一个版本导出为 BPMN 2.0 XML。
// @Tags workflow
// @Produce application/json,application/xml
// @Param keys query string false "Comma-separated definition keys; empty exports all | 逗号分隔的定义键；空表示全部"
// @Param definition query string false "Definition id for one BPMN export | 单个 BPMN 导出的定义 ID"
// @Param version query string false "Version id for a BPMN export | BPMN 导出的版本 ID"
// @Param format query string false "json or bpmn | json 或 bpmn"
// @Success 200 {file} file "exported document | 导出文档"
// @Failure 404 {string} string "definition not found | 定义不存在"
// @Security BearerAuth
// @Router /mgr/workflows/export [get]
func (c *Controller) WorkflowExport(ctx *router.Ctx) {
	if !c.workflowServiceOrFail(ctx) {
		return
	}
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return
	}
	format := strings.ToLower(strings.TrimSpace(ctx.Query(FieldWorkflowFormat)))
	if format == "" {
		format = "json"
	}
	if format == "bpmn" {
		versionID := strings.TrimSpace(ctx.Query(FieldWorkflowVersion))
		if versionID == "" {
			definitionID := strings.TrimSpace(ctx.Query(FieldWorkflowFilterDefinition))
			definition, err := c.workflow.GetDefinition(ctx.Request.Context(), tenantID, definitionID)
			if err != nil {
				c.failService(ctx, err)
				return
			}
			version, _, err := c.workflow.LatestPublishedVersion(ctx.Request.Context(), tenantID, definition.ID)
			if err != nil {
				c.failService(ctx, err)
				return
			}
			versionID = version.ID
		}
		document, err := c.workflow.ExportBPMN(ctx.Request.Context(), tenantID, versionID)
		if err != nil {
			c.failService(ctx, err)
			return
		}
		if err := ctx.DownloadBytes([]byte(document), router.DownloadOptions{
			Filename: "workflow.bpmn", ContentType: "application/xml; charset=utf-8",
		}); err != nil {
			c.log.Warn("workflow BPMN download failed | 流程 BPMN 下载失败", ydlog.Err(err))
		}
		return
	}
	keys := make([]string, 0, 8)
	for _, key := range strings.Split(ctx.Query("keys"), ",") {
		if trimmed := strings.TrimSpace(key); trimmed != "" {
			keys = append(keys, trimmed)
		}
	}
	bundle, err := c.workflow.ExportBundle(ctx.Request.Context(), tenantID, keys)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	data, err := json.MarshalIndent(bundle, "", "  ")
	if err != nil {
		c.failService(ctx, err)
		return
	}
	if err := ctx.DownloadBytes(append(data, '\n'), router.DownloadOptions{
		Filename: "workflows.json", ContentType: "application/json; charset=utf-8",
	}); err != nil {
		c.log.Warn("workflow bundle download failed | 流程包下载失败", ydlog.Err(err))
	}
}

