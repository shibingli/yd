// CreateWorkflowDraft appends a draft cloned from the newest version. | CreateWorkflowDraft 从最新版本克隆一个草稿。
//
// @Summary Create draft version | 创建草稿版本
// @Description Clones the newest version into a new draft, or starts an empty graph. | 把最新版本克隆为新草稿，或从空图开始。
// @Tags workflow
// @Accept application/x-www-form-urlencoded
// @Produce html
// @Param id path string true "Definition id | 定义 ID"
// @Success 200 {string} string "version drawer | 版本抽屉"
// @Security BearerAuth
// @Router /mgr/workflows/{id}/versions [post]
func (c *Controller) CreateWorkflowDraft(ctx *router.Ctx) {
	if !c.workflowServiceOrFail(ctx) {
		return
	}
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return
	}
	definition, err := c.workflow.GetDefinition(ctx.Request.Context(), tenantID, ctx.Param("id"))
	if err != nil {
		c.failService(ctx, err)
		return
	}
	design := defaultWorkflowDesign()
	summaries, err := c.workflow.VersionSummariesForDefinitions(ctx.Request.Context(), tenantID, []string{definition.ID})
	if err != nil {
		c.failService(ctx, err)
		return
	}
	if versions := summaries[definition.ID]; len(versions) > 0 {
		newest, err := c.workflow.GetVersion(ctx.Request.Context(), tenantID, versions[0].ID)
		if err != nil {
			c.failService(ctx, err)
			return
		}
		parsed, err := workflow.DesignOf(newest)
		if err != nil {
			c.failService(ctx, err)
			return
		}
		design = parsed
	}
	actor := c.workflowActor(ctx)
	if _, err := c.workflow.CreateVersion(ctx.Request.Context(), tenantID, definition.ID, actor.ID, workflow.VersionInput{
		Design: design, Note: field(ctx, FieldWorkflowNote),
	}); err != nil {
		c.failService(ctx, err)
		return
	}
	c.toast(ctx, "草稿已创建 | Draft created")
	c.WorkflowVersions(ctx)
}

