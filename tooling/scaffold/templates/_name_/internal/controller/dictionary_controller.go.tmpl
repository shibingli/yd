const (
	// dictionaryBasePath is the tenant workbench and its mutation prefix. | dictionaryBasePath 是租户工作台及其变更前缀。
	dictionaryBasePath = "/mgr/dictionaries"
	// systemDictionaryBasePath is the system workbench and its mutation prefix. | systemDictionaryBasePath 是系统工作台及其变更前缀。
	systemDictionaryBasePath = "/mgr/system-dictionaries"
)

// Dictionaries renders the data-dictionary workbench. | Dictionaries 渲染数据字典工作台。
//
// @Summary Data dictionary workbench | 数据字典工作台
// @Description Lists dictionary types and the items of the selected type. Selecting a type, searching
// @Description and paging are htmx requests that keep the URL and history.
// @Description 列出字典类型与所选类型的字典项。选择类型、搜索与分页都是 htmx 请求，并保留 URL 与历史。
// @Tags dictionaries
// @Accept html
// @Produce html
// @Param type query string false "selected type id | 选中的类型 ID"
// @Param q query string false "type search keyword | 类型搜索关键字"
// @Param page query int false "type page | 类型页码"
// @Param ipage query int false "item page | 字典项页码"
// @Success 200 {object} string "workbench page or fragment | 工作台页面或片段"
// @Failure 503 {object} string "dictionary storage unavailable | 数据字典存储不可用"
// @Security BearerAuth
// @Router /mgr/dictionaries [get]
func (c *Controller) Dictionaries(ctx *router.Ctx) {
	c.dictionaryWorkbench(ctx, false)
}

// dictionaryWorkbench renders either the tenant or the system workbench. | dictionaryWorkbench
// 渲染租户或系统工作台。
func (c *Controller) dictionaryWorkbench(ctx *router.Ctx, system bool) {
	if !c.DictionariesAvailable() {
		c.dictionaryUnavailable(ctx)
		return
	}
	tenantID, basePath, scope, canManage, ok := c.dictionaryReadTarget(ctx, system)
	if !ok {
		return
	}
	data, err := c.dictionaryPageData(ctx, tenantID, ctx.Query("type"), ctx.Query(FieldKeyword), ctx.Query(FieldItemQuery), pageNumber(ctx), dictionaryItemPageNumber(ctx), basePath, scope, canManage)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	c.render(ctx, http.StatusOK, TplDictionaries, data)
}

// dictionaryReadTarget returns the tenant, base path, scope and write capability of a workbench
// read. | dictionaryReadTarget 返回工作台读取使用的租户、基础路径、范围与写权限。
func (c *Controller) dictionaryReadTarget(ctx *router.Ctx, system bool) (string, string, dictionary.Scope, bool, bool) {
	if system {
		return dictionary.SystemTenantID, systemDictionaryBasePath, dictionary.ScopeSystem, c.CanManageSystemDictionaries(ctx), true
	}
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return "", "", "", false, false
	}
	return tenantID, dictionaryBasePath, dictionary.ScopeTenant, authz.Can(ctx.Request.Context(), authz.PermDictionaryManage), true
}

// dictionaryMutationTarget authorizes a tenant or system mutation and returns its target. System
// writes require both dictionary:system_manage and membership in the configured system tenant. |
// dictionaryMutationTarget 授权租户或系统变更并返回目标；系统写入同时要求
// dictionary:system_manage 与配置系统租户的成员关系。
func (c *Controller) dictionaryMutationTarget(ctx *router.Ctx, system bool) (string, string, dictionary.Scope, bool, bool) {
	if system {
		if !c.CanManageSystemDictionaries(ctx) {
			c.fail(ctx, http.StatusForbidden, msgForbidden)
			return "", "", "", false, false
		}
		return dictionary.SystemTenantID, systemDictionaryBasePath, dictionary.ScopeSystem, true, true
	}
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return "", "", "", false, false
	}
	if !authz.Can(ctx.Request.Context(), authz.PermDictionaryManage) {
		c.fail(ctx, http.StatusForbidden, msgForbidden)
		return "", "", "", false, false
	}
	return tenantID, dictionaryBasePath, dictionary.ScopeTenant, true, true
}

