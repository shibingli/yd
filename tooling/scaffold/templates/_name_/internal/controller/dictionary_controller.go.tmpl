// editDictionaryDrawer renders the edit-type drawer for one scope. | editDictionaryDrawer 渲染一个范围的编辑类型抽屉。
func (c *Controller) editDictionaryDrawer(ctx *router.Ctx, system bool) {
	if !c.DictionariesAvailable() {
		c.dictionaryUnavailable(ctx)
