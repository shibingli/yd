// SaveDictionaryItem creates or updates one item. The hidden id selects the mode. | SaveDictionaryItem
// 新建或更新一个字典项；隐藏的 id 字段决定模式。
//
// @Summary Save dictionary item | 保存字典项
// @Description Creates an item when the id is absent, otherwise updates it. The value is immutable after creation.
// @Description 没有 id 时新建字典项，否则更新；机器值在创建后不可修改。
// @Tags dictionaries
// @Accept html
// @Produce html
// @Param id path string true "type id | 类型 ID"
// @Param item_id formData string false "item id | 字典项 ID"
// @Param value formData string true "immutable value | 不可变机器值"
// @Param label formData string true "Chinese label | 中文标签"
// @Param label_en formData string false "English label | 英文标签"
// @Param extra formData string false "JSON metadata object | JSON 元数据对象"
// @Param remark formData string false "administrative note | 管理备注"
// @Param status formData string false "enabled|disabled | 启停状态"
// @Param default formData bool false "preselect this item | 预选该项"
// @Param sort formData int false "display order | 展示顺序"
// @Success 200 {object} string "refreshed workbench | 刷新后的工作台"
// @Failure 409 {object} string "duplicate value | 值重复"
// @Failure 422 {object} string "validation failed | 校验失败"
// @Security BearerAuth
// @Router /mgr/dictionaries/{id}/items [post]
func (c *Controller) SaveDictionaryItem(ctx *router.Ctx) {
	if !c.DictionariesAvailable() {
		c.dictionaryUnavailable(ctx)
		return
	}
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return
	}
	typeID := ctx.Param("id")
	input := dictionary.ItemInput{
		Value:   field(ctx, FieldDictionaryValue),
		Label:   dictionaryLongField(ctx, FieldDictionaryLabel, 512),
		LabelEN: dictionaryLongField(ctx, FieldDictionaryLabelEN, 512),
		Extra:   dictionaryLongField(ctx, FieldDictionaryExtra, 4096),
		Remark:  dictionaryLongField(ctx, FieldRemark, 2048),
		Status:  dictionary.Status(field(ctx, FieldStatus)),
		Default: field(ctx, FieldDictionaryDefault) != "",
		Sort:    formInt(ctx, FieldDictionarySort),
	}
	itemID := strings.TrimSpace(field(ctx, FieldDictionaryID))
	var (
		saved dictionary.Item
		err   error
	)
	if itemID == "" {
		saved, err = c.dictionaries.CreateItem(ctx.Request.Context(), tenantID, typeID, input)
	} else {
		saved, err = c.dictionaries.UpdateItem(ctx.Request.Context(), tenantID, typeID, itemID, input)
	}
	if err != nil {
		c.failService(ctx, err)
		return
	}
	c.log.Info("dictionary item saved | 数据字典项已保存",
		log.Str("type", saved.TypeID),
		log.Str("id", saved.ID),
		log.Str("value", saved.Value),
		log.Str("status", string(saved.Status)),
	)
	c.toast(ctx, "字典项已保存 | dictionary item saved")
	c.respondDictionaryPage(ctx, tenantID, typeID)
}

