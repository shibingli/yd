// saveDictionary is the shared create/update path. An empty id creates a type. | saveDictionary 是新建/更新的共享路径；
// id 为空时新建。
func (c *Controller) saveDictionary(ctx *router.Ctx, id string) {
	if !c.DictionariesAvailable() {
		c.dictionaryUnavailable(ctx)
		return
	}
	tenantID, ok := c.tenantID(ctx)
	if !ok {
		return
	}
	input := dictionary.TypeInput{
		Code:        field(ctx, FieldDictionaryCode),
		Name:        dictionaryLongField(ctx, FieldName, 512),
		NameEN:      dictionaryLongField(ctx, FieldNameEN, 512),
		Description: dictionaryLongField(ctx, FieldDescription, 2048),
		Status:      dictionary.Status(field(ctx, FieldStatus)),
		Sort:        formInt(ctx, FieldDictionarySort),
	}
	var (
		saved dictionary.Type
		err   error
	)
	if strings.TrimSpace(id) == "" {
		saved, err = c.dictionaries.CreateType(ctx.Request.Context(), tenantID, input)
	} else {
		saved, err = c.dictionaries.UpdateType(ctx.Request.Context(), tenantID, id, input)
	}
	if err != nil {
		c.failService(ctx, err)
		return
	}
	c.log.Info("dictionary type saved | 数据字典类型已保存",
		log.Str("id", saved.ID),
		log.Str("code", saved.Code),
		log.Str("status", string(saved.Status)),
	)
	c.toast(ctx, "字典类型已保存 | dictionary type saved")
	c.respondDictionaryPage(ctx, tenantID, saved.ID)
}

