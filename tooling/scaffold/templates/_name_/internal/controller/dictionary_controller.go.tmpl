// UpdateDictionary updates one dictionary type selected by the path. | UpdateDictionary 更新路径指定的一个字典类型。
//
// @Summary Update dictionary type | 更新字典类型
// @Description Updates the editable fields of one type. The code is immutable and ignored.
// @Description 更新一个类型的可编辑字段；编码不可变，会被忽略。
// @Tags dictionaries
// @Accept html
// @Produce html
// @Param id path string true "type id | 类型 ID"
// @Param code formData string false "immutable code | 不可变编码"
// @Param name formData string true "Chinese name | 中文名"
// @Param name_en formData string false "English name | 英文名"
// @Param description formData string false "description | 说明"
// @Param status formData string false "enabled|disabled | 启停状态"
// @Param sort formData int false "display order | 展示顺序"
// @Success 200 {object} string "refreshed workbench | 刷新后的工作台"
// @Failure 404 {object} string "type not found | 类型不存在"
