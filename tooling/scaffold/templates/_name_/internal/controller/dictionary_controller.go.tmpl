// @Tags dictionaries
// @Accept html
// @Produce html
// @Param id path string true "type id | 类型 ID"
// @Success 200 {object} string "refreshed workbench | 刷新后的工作台"
// @Failure 409 {object} string "built-in dictionary | 内置字典"
// @Security BearerAuth
// @Router /mgr/dictionaries/{id}/delete [post]
func (c *Controller) DeleteDictionary(ctx *router.Ctx) {
	c.deleteDictionary(ctx, false)
}

// deleteDictionary removes one type in either scope. | deleteDictionary 删除任一范围的类型。
func (c *Controller) deleteDictionary(ctx *router.Ctx, system bool) {
	if !c.DictionariesAvailable() {
		c.dictionaryUnavailable(ctx)
		return
	}
	tenantID, basePath, scope, canManage, ok := c.dictionaryMutationTarget(ctx, system)
	if !ok {
		return
	}
	if err := c.dictionaries.DeleteType(ctx.Request.Context(), tenantID, ctx.Param("id")); err != nil {
		c.failService(ctx, err)
		return
	}
	c.log.Info("dictionary type deleted | 数据字典类型已删除",
		log.Str("id", ctx.Param("id")),
		log.Str("scope", string(scope)),
	)
	c.toast(ctx, "字典类型已删除 | dictionary type deleted")
	c.respondDictionaryPage(ctx, tenantID, "", basePath, scope, canManage)
}

// respondDictionaryPage refreshes the workbench after a mutation. Search and paging form fields are
// read when present; htmx pushes the canonical page URL so a refresh stays on the page. |
// respondDictionaryPage 在变更后刷新工作台。存在搜索与分页表单字段时会一并读取；htmx 会把规范页面 URL
// 压入历史，刷新后仍停留在该页。
func (c *Controller) respondDictionaryPage(ctx *router.Ctx, tenantID, selectedID, basePath string, scope dictionary.Scope, canManage bool) {
	keyword := field(ctx, FieldKeyword)
	itemKeyword := field(ctx, FieldItemQuery)
	page := formInt(ctx, "page")
	if page < 1 {
		page = 1
	}
	itemPage := formInt(ctx, "ipage")
	if itemPage < 1 {
		itemPage = 1
	}
	htmx.PushURL(ctx.Writer, dictionaryHref(basePath, selectedID, keyword, itemKeyword, page, itemPage))
	data, err := c.dictionaryPageData(ctx, tenantID, selectedID, keyword, itemKeyword, page, itemPage, basePath, scope, canManage)
	if err != nil {
		c.failService(ctx, err)
		return
	}
	c.render(ctx, http.StatusOK, TplDictionaries, data)
}

// dictionaryPageData loads the workbench, applying the type and item search keywords. |
// dictionaryPageData 加载工作台，并应用类型与字典项搜索关键字。
func (c *Controller) dictionaryPageData(ctx *router.Ctx, tenantID, selectedID, keyword, itemKeyword string, page, itemPage int, basePath string, scope dictionary.Scope, canManage bool) (map[string]any, error) {
	lang := c.lang(ctx)
	types, err := c.dictionaries.ListTypes(ctx.Request.Context(), tenantID, dictionary.Filter{
		Query:    keyword,
		Page:     page,
		PageSize: defaultPageSize,
	})
	if err != nil {
		return nil, err
	}
	typeViews := dictionaryTypeViews(types.Items, lang)
	if selectedID == "" && len(typeViews) > 0 {
		selectedID = typeViews[0].ID
	}
	for i := range typeViews {
		typeViews[i].Href = dictionaryHref(basePath, typeViews[i].ID, keyword, "", types.Page, 1)
		typeViews[i].Active = typeViews[i].ID == selectedID
	}
	var (
		selected     *dictionaryTypeView
		itemViews    []dictionaryItemView
		itemPageData dictionary.ItemPage
	)
	if selectedID != "" {
		current, getErr := c.dictionaries.GetType(ctx.Request.Context(), tenantID, selectedID)
		if getErr == nil {
			view := dictionaryTypeViews([]dictionary.Type{current}, lang)[0]
			selected = &view
			itemPageData, err = c.dictionaries.ListItems(ctx.Request.Context(), tenantID, current.ID, dictionary.ItemFilter{
				Query:    itemKeyword,
				Page:     itemPage,
				PageSize: defaultPageSize,
			})
			if err != nil {
				return nil, err
			}
			itemViews = dictionaryItemViews(itemPageData.Items, lang)
		} else if !errors.Is(getErr, dictionary.ErrNotFound) {
			return nil, getErr
		}
	}
	typePages, typePrev, typeNext := pageLinks(types.Total, types.Page, types.PageSize, func(n int) string {
		return dictionaryHref(basePath, selectedID, keyword, itemKeyword, n, itemPage)
	})
	itemPages, itemPrev, itemNext := pageLinks(itemPageData.Total, itemPageData.Page, itemPageData.PageSize, func(n int) string {
		return dictionaryHref(basePath, selectedID, keyword, itemKeyword, page, n)
	})
	_, typePageCount, _, _ := pageBounds(types.Total, types.Page, types.PageSize)
	_, itemPageCount, _, _ := pageBounds(itemPageData.Total, itemPageData.Page, itemPageData.PageSize)
	title := "数据字典 | Data dictionary"
	pageID := "dictionaries"
	if scope == dictionary.ScopeSystem {
		title = "系统数据字典 | System dictionaries"
		pageID = "system-dictionaries"
	}
	return c.pageView(ctx, title, map[string]any{
		"Types":           typeViews,
		"Selected":        selected,
		"Items":           itemViews,
		"Keyword":         keyword,
		"ItemKeyword":     itemKeyword,
		"CanManage":       canManage,
		"BasePath":        basePath,
		"Scope":           string(scope),
		"SystemScope":     scope == dictionary.ScopeSystem,
		"PageID":          pageID,
		"TypePage":        types.Page,
		"TypePageCount":   typePageCount,
		"TypePages":       typePages,
		"TypePrevHref":    typePrev,
		"TypeNextHref":    typeNext,
		"ItemPage":        itemPageData.Page,
		"ItemPageCount":   itemPageCount,
		"ItemPages":       itemPages,
		"ItemPrevHref":    itemPrev,
		"ItemNextHref":    itemNext,
		"StatusEnabled":   string(dictionary.StatusEnabled),
		"StatusDisabled":  string(dictionary.StatusDisabled),
	}), nil
}

