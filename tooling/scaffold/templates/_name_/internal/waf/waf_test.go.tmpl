// testLogger discards engine logs during tests. | testLogger 在测试中丢弃引擎日志。
func testLogger() *log.Logger { return log.New(log.Options{Writer: io.Discard}) }

// newTestManager builds a manager without the watcher and closes it at the end of the test. |
// newTestManager 构建不启动监视器的管理器，并在测试结束时关闭。
func newTestManager(t *testing.T, body string) *Manager {
	t.Helper()
	m, err := newManager(testConfig(t, body), testLogger(), false)
	if err != nil {
		t.Fatalf("newManager: %v", err)
	}
	t.Cleanup(func() { _ = m.Shutdown(context.Background()) })
	return m
}

// serve sends one request through a fresh router carrying the WAF middleware. | serve 通过携带
// WAF 中间件的新路由器发送一个请求。
func serve(t *testing.T, m *Manager, method, target, contentType, body string) int {
	t.Helper()
	r := router.New()
	r.Use(m.Middleware())
	r.GET("/login", func(c *router.Ctx) { _ = c.String(http.StatusOK, "ok") })
	r.GET("/static/*filepath", func(c *router.Ctx) { _ = c.String(http.StatusOK, "ok") })
	r.POST("/send", func(c *router.Ctx) { _ = c.String(http.StatusOK, "ok") })
	r.POST("/api/send", func(c *router.Ctx) { _ = c.String(http.StatusOK, "ok") })
	r.PUT("/api/send", func(c *router.Ctx) { _ = c.String(http.StatusOK, "ok") })
	r.PATCH("/api/send", func(c *router.Ctx) { _ = c.String(http.StatusOK, "ok") })
	r.DELETE("/api/send", func(c *router.Ctx) { _ = c.String(http.StatusOK, "ok") })

	req := httptest.NewRequest(method, target, strings.NewReader(body))
	if contentType != "" {
		req.Header.Set("Content-Type", contentType)
	}
	rec := httptest.NewRecorder()
	r.ServeHTTP(rec, req)
	return rec.Code
}

// TestMiddlewareBlocksSQLi proves a public query-string attack is blocked. | TestMiddlewareBlocksSQLi
// 证明公网查询串攻击会被拦截。
func TestMiddlewareBlocksSQLi(t *testing.T) {
	m := newTestManager(t, "")
	target := "/login?x=" + url.QueryEscape("1' OR '1'='1")
	if got := serve(t, m, http.MethodGet, target, "", ""); got != http.StatusForbidden {
		t.Fatalf("SQLi status = %d, want 403", got)
	}
}

// TestMiddlewareBlocksXSSAndTraversalAndRCE proves the Go/HTML/SQL/JavaScript profile covers the
// other attack families, not only SQLi. | TestMiddlewareBlocksXSSAndTraversalAndRCE 证明
// Go/HTML/SQL/JavaScript 画像覆盖 SQLi 之外的其它攻击族。
func TestMiddlewareBlocksXSSAndTraversalAndRCE(t *testing.T) {
	m := newTestManager(t, "")
	for _, payload := range []string{
		"<script>alert(1)</script>",
		"../../etc/passwd",
		";cat /etc/passwd",
		"$(id)",
	} {
		target := "/login?x=" + url.QueryEscape(payload)
		if got := serve(t, m, http.MethodGet, target, "", ""); got != http.StatusForbidden {
			t.Errorf("payload %q status = %d, want 403", payload, got)
		}
	}
}

// TestDetectionModeAllowsAttack proves detection mode records without interrupting. |
// TestDetectionModeAllowsAttack 证明仅检测模式会记录但不中断。
func TestDetectionModeAllowsAttack(t *testing.T) {
	m := newTestManager(t, "waf:\n  mode: detection\n")
	attack := "/login?x=" + url.QueryEscape("1' OR '1'='1")
	if got := serve(t, m, http.MethodGet, attack, "", ""); got != http.StatusOK {
		t.Fatalf("detection status = %d, want 200", got)
	}
}

// TestRequestBodyLimitRejectsOversizedBody proves the engine answers 413 instead of reading an
// unbounded body. | TestRequestBodyLimitRejectsOversizedBody 证明引擎对超限正文返回 413，而不是
// 无界读取。
func TestRequestBodyLimitRejectsOversizedBody(t *testing.T) {
	m := newTestManager(t, "waf:\n  request_body_limit: 1024\n")
	body := `{"title":"` + strings.Repeat("a", 2048) + `"}`
	if got := serve(t, m, http.MethodPost, "/api/send", "application/json", body); got != http.StatusRequestEntityTooLarge {
		t.Fatalf("oversized body status = %d, want 413", got)
	}
}

// TestEngineLoadsCRSProfile pins the compiled engine to the CRS rule profile. |
// TestEngineLoadsCRSProfile 把编译后的引擎钉在 CRS 规则画像上。
func TestEngineLoadsCRSProfile(t *testing.T) {
	m := newTestManager(t, "")
	e := m.current.Load()
	if e == nil {
		t.Fatal("engine is not enabled | 引擎未启用")
	}
	if got := e.engine.RulesCount(); got < 400 {
		t.Fatalf("rules = %d, want at least 400", got)
	}
	if got := e.engine.RuleVersion(); got != "local" {
		t.Fatalf("rule version = %q, want local", got)
	}
}

// TestMarkdownAndJSONExclusions proves rich-text payloads pass while a plain title stays
// protected. | TestMarkdownAndJSONExclusions 证明富文本载荷放行，普通标题仍然受保护。
func TestMarkdownAndJSONExclusions(t *testing.T) {
	m := newTestManager(t, "")
	form := url.Values{"body_markdown": {"<script>alert(1)</script>"}}.Encode()
	if got := serve(t, m, http.MethodPost, "/send", "application/x-www-form-urlencoded", form); got != http.StatusOK {
		t.Errorf("form Markdown status = %d, want 200", got)
	}
	for _, payload := range []string{
		`{"body_markdown":"<script>alert(1)</script>"}`,
		`{"design":{"script":"<script>alert(1)</script>"}}`,
	} {
		if got := serve(t, m, http.MethodPost, "/api/send", "application/json", payload); got != http.StatusOK {
			t.Errorf("%s status = %d, want 200", payload, got)
		}
	}
	if got := serve(t, m, http.MethodPost, "/api/send", "application/json", `{"title":"<script>alert(1)</script>"}`); got != http.StatusForbidden {
		t.Errorf("JSON title XSS status = %d, want 403", got)
	}
}

// TestLargeBodyIsAccepted proves a body above the old in-memory limit is buffered in memory and
// still served; the engine no longer spills to a temp file. | TestLargeBodyIsAccepted 证明超过
// 旧内存上限的正文仍会在内存中缓冲并正常服务；引擎不再落临时文件。
func TestLargeBodyIsAccepted(t *testing.T) {
	m := newTestManager(t, "")
	body := `{"body_markdown":"` + strings.Repeat("a", 256<<10) + `"}`
	if got := serve(t, m, http.MethodPost, "/api/send", "application/json", body); got != http.StatusOK {
		t.Fatalf("large body status = %d, want 200", got)
	}
}

// TestMethodWhitelistAllowsAPIMethods keeps the generated JSON API usable. |
// TestMethodWhitelistAllowsAPIMethods 保持生成项目 JSON API 可用。
func TestMethodWhitelistAllowsAPIMethods(t *testing.T) {
	m := newTestManager(t, "")
	for _, method := range []string{http.MethodPut, http.MethodPatch, http.MethodDelete} {
		if got := serve(t, m, method, "/api/send", "application/json", `{"title":"hello"}`); got != http.StatusOK {
			t.Errorf("%s status = %d, want 200", method, got)
		}
	}
}

