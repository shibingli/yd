// TestApplyTogglesEngine proves the configuration switch works without rebuilding the process. |
// TestApplyTogglesEngine 证明配置开关无需重建进程即可生效。
func TestApplyTogglesEngine(t *testing.T) {
	m := newTestManager(t, "waf:\n  enabled: false\n")
	attack := "/login?x=" + url.QueryEscape("1' OR '1'='1")
	if got := serve(t, m, http.MethodGet, attack, "", ""); got != http.StatusOK {
		t.Fatalf("disabled status = %d, want 200", got)
	}

	m.cfg.Set("waf.enabled", true)
	m.Apply()
	if got := serve(t, m, http.MethodGet, attack, "", ""); got != http.StatusForbidden {
		t.Fatalf("enabled status = %d, want 403", got)
	}

	m.cfg.Set("waf.enabled", false)
	m.Apply()
	if got := serve(t, m, http.MethodGet, attack, "", ""); got != http.StatusOK {
		t.Fatalf("re-disabled status = %d, want 200", got)
	}
}

// TestApplyKeepsOldEngineOnBadConfig proves a bad reload never drops protection. |
// TestApplyKeepsOldEngineOnBadConfig 证明错误重载不会丢失防护。
func TestApplyKeepsOldEngineOnBadConfig(t *testing.T) {
	m := newTestManager(t, "")
	attack := "/login?x=" + url.QueryEscape("1' OR '1'='1")
	m.cfg.Set("waf.mode", "bogus")
	m.Apply()
	if got := serve(t, m, http.MethodGet, attack, "", ""); got != http.StatusForbidden {
		t.Fatalf("status after bad reload = %d, want 403", got)
	}
}

// TestShutdownBypasses proves a closed manager stops inspecting. | TestShutdownBypasses 证明关闭后的
// 管理器不再检测。
func TestShutdownBypasses(t *testing.T) {
	m, err := newManager(testConfig(t, ""), testLogger(), false)
	if err != nil {
		t.Fatal(err)
	}
	if err := m.Shutdown(context.Background()); err != nil {
		t.Fatalf("Shutdown: %v", err)
	}
	attack := "/login?x=" + url.QueryEscape("1' OR '1'='1")
	if got := serve(t, m, http.MethodGet, attack, "", ""); got != http.StatusOK {
		t.Fatalf("status after shutdown = %d, want 200", got)
	}
}

// TestClientIPUsesTrustedProxies proves the router's trust model is reused. |
// TestClientIPUsesTrustedProxies 证明复用了路由器的可信代理模型。
func TestClientIPUsesTrustedProxies(t *testing.T) {
	s, err := settingsFrom(testConfig(t, "waf:\n  trusted_proxies: [\"10.0.0.0/8\"]\n"))
	if err != nil {
		t.Fatal(err)
	}
	req := httptest.NewRequest(http.MethodGet, "/", nil)
	req.RemoteAddr = "10.0.0.1:1234"
	req.Header.Set("X-Forwarded-For", "203.0.113.9")
	if got := clientIPFunc(s.trustedProxies)(req); got != "203.0.113.9" {
		t.Fatalf("client IP = %q, want 203.0.113.9", got)
	}
}

// TestWatchErrorLogsOnce keeps a repeated watch failure from flooding the log. |
// TestWatchErrorLogsOnce 避免重复的监视失败刷屏。
func TestWatchErrorLogsOnce(t *testing.T) {
	var buf bytes.Buffer
	m := &Manager{logger: log.New(log.Options{Writer: &buf})}
	last := ""
	m.logWatchError(errors.New("boom"), &last)
	m.logWatchError(errors.New("boom"), &last)
	if got := strings.Count(buf.String(), "boom"); got != 1 {
		t.Fatalf("watch error logged %d times, want 1:\n%s", got, buf.String())
	}
}

// TestShutdownStopsWatchLoop proves the error sampler exits on shutdown. |
// TestShutdownStopsWatchLoop 证明错误采样器在关停时退出。
func TestShutdownStopsWatchLoop(t *testing.T) {
	m, err := newManager(testConfig(t, ""), testLogger(), true)
	if err != nil {
		t.Fatal(err)
	}
	if err := m.Shutdown(context.Background()); err != nil {
		t.Fatal(err)
	}
	select {
	case <-m.stopWatch:
	default:
		t.Fatal("watch loop was not stopped")
	}
}

// TestNewRejectsNilAndInvalidConfig pins the startup failures. | TestNewRejectsNilAndInvalidConfig
// 钉住启动期失败。
func TestNewRejectsNilAndInvalidConfig(t *testing.T) {
	if _, err := newManager(nil, testLogger(), false); err == nil {
		t.Error("nil config must fail")
	}
	if _, err := newManager(testConfig(t, "waf:\n  mode: bogus\n"), testLogger(), false); err == nil {
		t.Error("invalid mode must fail")
	}
}
