// Package middleware 只放本项目特有的跨切面逻辑；通用中间件（Recover、RequestID、AccessLog、Compress、CORS、RateLimit）
// 一律直接使用框架的 {{ .YdModule }}/middleware，不在这里重复实现。
// Package middleware holds only the cross-cutting logic specific to this project; the general middleware (Recover,
// RequestID, AccessLog, Compress, CORS, RateLimit) comes straight from the framework's {{ .YdModule }}/middleware
// and is not reimplemented here.
package middleware

import (
	"strconv"

	"{{ .YdModule }}/http/router"
)

// 安全响应头的取值：集中声明一次，测试与运维核查都读这里。
// The security header values: declared once, read by tests and by operations checks alike.
const (
	// cspPolicy 是内容安全策略：默认只允许同源资源。
	// cspPolicy is the content security policy: same-origin resources only by default.
	//
	// 关键约束：script-src 不含 'unsafe-inline'，也不含任何外部主机，因此内联脚本与 CDN 脚本都会被浏览器拒绝
	// ——框架要求静态资源全部本地化（见 web/static/js/vendor/），这条策略是它的强制执行点。
	// The key constraint: script-src carries neither 'unsafe-inline' nor any external host, so inline and CDN scripts are
	// both refused by the browser — the framework requires every static asset to be local (see web/static/js/vendor/) and
	// this policy is where that requirement is enforced.
	//
	// style-src 保留 'unsafe-inline'：htmx 的局部交换与 Tailwind 的运行时样式都可能内联注入 style 属性，禁用它会让
	// 交互在交换后失效；样式注入的危害远低于脚本注入，因此这里按需放宽。
	// style-src keeps 'unsafe-inline': htmx swaps and Tailwind's runtime styles may inject a style attribute inline and
	// forbidding it would break interactions after a swap; style injection is far less dangerous than script injection,
	// so the relaxation is deliberate.
	//
	// connect-src 'self' 同时覆盖 SSE（/events）与 WebSocket（/ws）：CSP3 把 ws:// 与 wss:// 的同源连接计入 'self'。
	// connect-src 'self' also covers SSE (/events) and WebSocket (/ws): CSP3 counts same-origin ws:// and wss:// under 'self'.
	cspPolicy = "default-src 'self'; " +
		"base-uri 'self'; " +
		"form-action 'self'; " +
		"frame-ancestors 'none'; " +
		"object-src 'none'; " +
		"script-src 'self'; " +
		"style-src 'self' 'unsafe-inline'; " +
		"img-src 'self' data:; " +
		"font-src 'self'; " +
		"connect-src 'self'"

	// referrerPolicy exposes the origin only to cross-origin requests and leaks neither the path nor the query string. | referrerPolicy 只向跨源请求暴露来源，不泄漏路径与查询串。
	referrerPolicy = "strict-origin-when-cross-origin"
	// permissionsPolicy switches off the browser capabilities this project never uses. | permissionsPolicy 关闭本项目用不到的浏览器能力。
	permissionsPolicy = "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
	// hstsMaxAge is the HSTS lifetime in seconds (one year). | hstsMaxAge 是 HSTS 的生效秒数（一年）。
	hstsMaxAge = 31536000
)

// SecurityOptions 是 Security 的开关集合：默认（零值）即生产可用的严格取值，只有确实需要时才放宽。
// SecurityOptions is the switch set of Security: the zero value is the production-grade strict setting and is relaxed
// only where genuinely required.
type SecurityOptions struct {
	// ContentSecurityPolicy overrides the default CSP value; empty means cspPolicy. | ContentSecurityPolicy 覆盖默认 CSP 取值；为空时使用 cspPolicy。
	ContentSecurityPolicy string
	// DisableHSTS 关闭 HSTS：仅在本地用 HTTP 调试时使用，HTTPS 部署永远不要关闭它。
	// DisableHSTS switches HSTS off: meant for local HTTP debugging only, and never switched off in an HTTPS deployment.
	DisableHSTS bool
}

// Security 写入一组安全响应头；取值沿用保守默认，无需额外配置即可直接挂到中间件链上。
// Security writes a set of security response headers; the defaults are conservative, so it can be mounted on the
// middleware chain with no extra configuration.
//
// 选项可变参：装配期写 Security() 即得到默认严格取值，确需覆盖时才传入一个 SecurityOptions，
// 因此调用处不必为「保持默认」而写一个空结构体字面量。
// The options are variadic: Security() at assembly time yields the strict defaults and a SecurityOptions overrides only
// what genuinely needs overriding, so no call site writes an empty struct literal just to keep the defaults.
//
// 实现要点：所有头在 c.Next() 之前写入。响应头一旦随响应体写出就无法再修改，因此顺序不能颠倒。
// Implementation note: every header is written before c.Next(). Once the response body is written the headers are
// frozen, so the order cannot be swapped.
func Security(options ...SecurityOptions) router.Middleware {
	var o SecurityOptions
	if len(options) > 0 {
		o = options[0]
	}

	policy := o.ContentSecurityPolicy
	if policy == "" {
		policy = cspPolicy
	}

	return func(c *router.Ctx) {
		c.SetHeader("Content-Security-Policy", policy)
		// nosniff 阻止浏览器按内容猜测类型：占位图端点与静态资源目录都依赖正确的 Content-Type。
		// nosniff stops the browser from sniffing a content type: the placeholder endpoints and the static asset directory both rely on the declared type.
		c.SetHeader("X-Content-Type-Options", "nosniff")
		c.SetHeader("Referrer-Policy", referrerPolicy)
		// X-Frame-Options 与 CSP 的 frame-ancestors 双写：前者覆盖尚不支持 CSP3 的旧浏览器。
		// X-Frame-Options is written alongside the CSP frame-ancestors directive: the former covers older browsers without CSP3 support.
		c.SetHeader("X-Frame-Options", "DENY")
		c.SetHeader("Permissions-Policy", permissionsPolicy)
		c.SetHeader("Cross-Origin-Opener-Policy", "same-origin")

		// HSTS 只在 TLS 上写入：明文 HTTP 上声明 HSTS 会被浏览器忽略，还会误导运维以为已经生效。
		// HSTS is written on TLS only: over plain HTTP a browser ignores it and operations would wrongly believe it is in effect.
		if !o.DisableHSTS && c.IsTLS() {
			c.SetHeader("Strict-Transport-Security", "max-age="+strconv.Itoa(hstsMaxAge)+"; includeSubDomains")
		}

		c.Next()
	}
}
