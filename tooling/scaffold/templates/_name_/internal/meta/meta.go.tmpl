// Package meta 集中本项目的元信息：模板、控制器、路由与文档共用同一份取值。
// Package meta holds this project's metadata: templates, controllers, routers and docs all read one source.
package meta

import (
	"os"
	"strings"
)

// 元信息常量由 yd new 依据脚手架参数写入；需要改动请回到脚手架模板重新生成。
// The metadata constants below are written by yd new from the scaffold options; change them in the template and regenerate.
const (
	// Name is the project name (also the last segment of the default module path). | Name 是项目名（同时也是默认模块路径的最后一段）。
	Name = "{{ .Name }}"
	// Module is the Go module path, referenced by front-end scripts and docs instead of being hard-coded. | Module 是 Go 模块路径，前端脚本与文档引用它以免写死。
	Module = "{{ .Module }}"
	// Version is the application version, overridable with -ldflags at release time. | Version 是应用版本，发布时可用 -ldflags 覆盖。
	Version = "0.1.0"
	// Description 是应用简介，写入 OpenAPI 文档与页面 <meta name="description">。
	// Description is the application blurb, written into the OpenAPI document and the page's <meta name="description">.
	Description = "{{ .Name }} —— yd 框架生成的后台应用 | {{ .Name }} — an admin application scaffolded with the yd framework"

	// GoVersion、HtmxVersion、TailwindVersion 是脚手架锁定的技术栈版本，页面页脚与文档据此避免写死。
	// GoVersion, HtmxVersion and TailwindVersion are the stack versions locked by the scaffold, so pages and docs never hard-code them.
	GoVersion       = "{{ .GoVersion }}"
	HtmxVersion     = "{{ .HtmxVersion }}"
	TailwindVersion = "{{ .TailwindVersion }}"

	// AssetRoot is the front-end asset directory, matching assetRoot in .yd.json. | AssetRoot 是前端资产目录，与 .yd.json 的 assetRoot 保持一致。
	AssetRoot = "{{ .AssetRoot }}"
	// ConfigDir is the configuration directory handed to app.WithConfigDir. | ConfigDir 是配置文件目录，交给 app.WithConfigDir 使用。
	ConfigDir = "configs"
	// I18nDir is the asset subtree holding the message catalogues. | I18nDir 是语言目录所在的资子树名。
	I18nDir = "i18n"

	// DefaultLang 与 FallbackLang 是语言目录的默认值与回退值，与 configs/config.yaml 的 i18n 段一致。
	// DefaultLang and FallbackLang are the catalogue defaults, consistent with the i18n section of configs/config.yaml.
	DefaultLang  = "zh-CN"
	FallbackLang = "en"

	// EnvPrefix is the environment variable prefix. | EnvPrefix 是环境变量前缀。
	EnvPrefix = "YD_"
	// ConfigEnvKey is the configuration key holding the runtime environment. | ConfigEnvKey 是运行环境所在的配置键。
	ConfigEnvKey = "app.env"
	// EnvProduction and EnvDevelopment are the two runtime environment values. | EnvProduction 与 EnvDevelopment 是运行环境的两个取值。
	EnvProduction  = "production"
	EnvDevelopment = "development"

	// ToastEvent 是服务端下发提示的事件名，控制器通过 HX-Trigger 触发，页面在 body 上订阅。
	// ToastEvent is the event name of a server-sent toast: controllers fire it through HX-Trigger and pages subscribe on the body.
	ToastEvent = "yd:toast"
)

// 会话与多租户的对外契约常量：中间件、控制器、模板与文档引用同一份取值。
// Public contract constants of sessions and multi-tenancy: middleware, controllers, templates and docs all read one source.
const (
	// TenantHeader carries the tenant key; the subdomain and the token's tid claim are the other two sources. | TenantHeader 是承载租户标识的请求头；子域名与令牌 tid 声明是另外两条来源。
	TenantHeader = "X-Tenant"
	// AuthHeader carries the token and matches the framework's auth.DefaultTokenLookup. | AuthHeader 是承载令牌的请求头，与框架 auth.DefaultTokenLookup 一致。
	AuthHeader = "Authorization"
	// BearerPrefix is the authentication scheme prefix of Authorization. | BearerPrefix 是 Authorization 的认证方案前缀。
	BearerPrefix = "Bearer "
	// TokenCookie is the cookie name of the browser session; the token is written HttpOnly so no script can read it. | TokenCookie 是浏览器会话所用的 cookie 名；令牌以 HttpOnly 写入，脚本读不到它。
	TokenCookie = "yd_token"
	// TokenIssuerName is written into the iss claim of every token. | TokenIssuerName 写入令牌的 iss 声明。
	TokenIssuerName = "yd"

	// DevMasterKey 是内置的开发主密钥：仅在 auth.master_key 未配置且 app.env 为 development 时启用，非开发环境会拒绝启动。
	// 生产环境必须通过 YD_AUTH_MASTER_KEY 覆盖它，否则进程重启后内存中的 sec_key 仍可解开——路由层会为此告警。
	// DevMasterKey is the built-in development master key: it applies only while auth.master_key is unset in development;
	// other environments refuse to start. Production must inject YD_AUTH_MASTER_KEY, otherwise the in-memory
	// sec_keys stay readable across restarts — the router warns about exactly that.
	DevMasterKey = "yd-scaffold-development-master-key-please-replace"
)

// 种子数据：一条命令即得到可登录的默认环境，README 与登录页展示的凭据线索都取自这里。
// Seed data: one command yields a sign-in-ready default environment, and the credential pointers shown by the README and by
// the sign-in page are read from here.
//
// 口令**不在**这里，这是刻意的：种子口令来自配置键 seed.admin_password（环境变量 YD_SEED_ADMIN_PASSWORD 覆盖它）。
// 开发环境未配置时使用下面那个文档化的开发口令并每次启动告警；**非 development 环境**未配置时整个种子写入被拒绝——
// 一个口令公开可查的管理员账号不该在任何真实环境里被创建，而在此之前，它会在任何环境里被创建。
// The passwords are deliberately **not** here: the seed password comes from the configuration key seed.admin_password
// (which YD_SEED_ADMIN_PASSWORD overrides). Development falls back to the documented development password below and warns
// on every start, while an environment that does not call itself development refuses the seed entirely — an administrator
// account whose password is publicly documented must never be created in a real environment.
//
// 库里保存的永远是 SM3 + 盐 + 迭代的散列与逐用户 sec_key，明文只在内置开发口令这一处存在。
// What the store keeps is always an SM3 + salt + iterations hash plus a per-user sec_key; the only clear text that exists
// at all is the built-in development password below.
const (
	// SeedTenantSlug is the default tenant's key (the X-Tenant header and the subdomain both use it). | SeedTenantSlug 是默认租户的标识（X-Tenant 请求头与子域名都用它）。
	SeedTenantSlug = "default"
	// SeedTenantName is the default tenant's display name. | SeedTenantName 是默认租户的展示名。
	SeedTenantName = "默认租户 | Default tenant"
	// SeedAdminUsername is the default tenant's administrator sign-in name (sign-in uses the name, not the address). | SeedAdminUsername 是默认租户的管理员登录名（登录用登录名，不是邮箱）。
	SeedAdminUsername = "admin"
	// SeedAdminEmail is the default administrator's e-mail address. | SeedAdminEmail 是默认租户管理员的邮箱。
	SeedAdminEmail = "admin@example.com"

	// SeedTenantConfigKey 是默认租户标识的配置键；留空时回退到 SeedTenantSlug。环境变量 YD_SEED_TENANT 覆盖它。
	// SeedTenantConfigKey is the configuration key of the default tenant key; empty falls back to SeedTenantSlug.
	// The environment variable YD_SEED_TENANT overrides it.
	SeedTenantConfigKey = "seed.tenant"
	// SeedTenantEnvKey is the environment variable that overrides SeedTenantConfigKey. | SeedTenantEnvKey 是覆盖 SeedTenantConfigKey 的环境变量。
	SeedTenantEnvKey = EnvPrefix + "SEED_TENANT"
	// SeedUsernameConfigKey 是管理员登录名的配置键；留空时回退到 SeedAdminUsername。环境变量 YD_SEED_USERNAME 覆盖它。
	// SeedUsernameConfigKey is the configuration key of the administrator sign-in name; empty falls back to SeedAdminUsername.
	// The environment variable YD_SEED_USERNAME overrides it.
	SeedUsernameConfigKey = "seed.username"
	// SeedUsernameEnvKey is the environment variable that overrides SeedUsernameConfigKey. | SeedUsernameEnvKey 是覆盖 SeedUsernameConfigKey 的环境变量。
	SeedUsernameEnvKey = EnvPrefix + "SEED_USERNAME"

	// SeedPasswordConfigKey 是种子管理员口令的配置键；configs/config.yaml、README 与告警引用同一处。
	// SeedPasswordConfigKey is the configuration key of the seeded administrator's password, quoted by configs/config.yaml,
	// by the README and by the warnings.
	SeedPasswordConfigKey = "seed.admin_password"
	// SeedPasswordEnvKey 是覆盖它的环境变量名（环境变量始终胜过配置文件），告警与 README 引用同一处。
	// SeedPasswordEnvKey is the environment variable that overrides it (the environment always beats the file), quoted by
	// the warnings and by the README.
	SeedPasswordEnvKey = EnvPrefix + "SEED_ADMIN_PASSWORD"
	// DevSeedAdminPassword 是文档化的开发口令：仅在 seed.admin_password 未配置**且** app.env 为 development 时使用，
	// 且每次启动都会告警。它存在的意义是让刚生成的项目开箱即可登录；它被印在 README 与登录页上，
	// 而这正是它绝不允许出现在其它任何环境的原因。
	// DevSeedAdminPassword is the documented development password: it applies only while seed.admin_password is unset
	// **and** app.env is development, and every start warns about it. It exists so a freshly generated project is
	// sign-in-ready; it is printed in the README and on the sign-in page, which is exactly why it must never be used in any
	// other environment.
	DevSeedAdminPassword = "admin123"

	// SeedPasswordNotice 是首登必改口令的提示文案，登录页、首页横幅与 README 引用同一句。
	// SeedPasswordNotice is the mandatory password-change notice shown at first sign-in; the sign-in page, the home
	// banner and the README quote the same sentence.
	SeedPasswordNotice = "首次登录后请立即修改默认口令 | change the default password right after the first sign-in"
)

// Features 列出本项目启用的可选特性，供启动日志与运维自检读取（与脚手架参数同源）。
// Features lists the optional features enabled in this project, read by the startup log and by operations checks (same source as the scaffold options).
var Features = []string{
{{- range .Features }}
	"{{ . }}",
{{- end }}
}

// HtmxExtScripts 是所选 Htmx 扩展的本地脚本路径，base.html 依序装载，顺序与脚手架参数一致。
// HtmxExtScripts holds the local script paths of the selected Htmx extensions; base.html loads them in order, matching the scaffold options.
var HtmxExtScripts = []string{
{{- range .HtmxExtScripts }}
	"{{ . }}",
{{- end }}
}

// Env 返回运行环境名：优先取环境变量 YD_APP_ENV，未设置时按开发环境处理。
// Env returns the runtime environment: it prefers the YD_APP_ENV environment variable and falls back to development.
//
// 未知环境一律按开发处理，与框架 app 门面对 isDevelopment 的判定保持一致，
// 避免新项目因为漏配环境名而失去模板热重载。
// An unknown environment counts as development, matching isDevelopment in the framework's app facade, so a fresh
// project never loses template hot reloading just because the environment name is unset.
func Env() string {
	if v := strings.TrimSpace(os.Getenv(EnvPrefix + "APP_ENV")); v != "" {
		return v
	}
	return EnvDevelopment
}

// IsProduction reports whether the runtime environment is production. | IsProduction 报告当前是否为生产环境。
func IsProduction() bool { return strings.EqualFold(Env(), EnvProduction) }

// IsDevelopment reports whether the runtime environment is development. | IsDevelopment 报告当前是否为开发环境。
func IsDevelopment() bool { return !IsProduction() }
