// 本文件是 model 包的租户模型：多租户的硬边界在这里第一次显形。
// This file is the tenant model of package model: the hard boundary of multi-tenancy shows up here for the first time.

package model

import (
	"strings"
	"time"
	"unicode/utf8"

	"{{ .YdModule }}/security/auth"
)

// Status 是租户与用户共用的生命周期状态，与框架 auth.Status 同型。
// Status is the lifecycle state shared by tenants and users and is identical to auth.Status.
type Status = auth.Status

// Lifecycle values: only the active state passes token verification. | 生命周期状态取值：只有激活态能通过令牌校验。
const (
	// StatusActive means the entity is usable. | StatusActive 表示实体可用。
	StatusActive Status = auth.StatusActive
	// StatusDisabled means the entity has been disabled. | StatusDisabled 表示实体已被停用。
	StatusDisabled Status = auth.StatusDisabled
)

// Tenant 是租户领域模型；字段顺序按内存对齐排布（时间 → 切片 → 字符串 → 短字符串）。
// Tenant is the tenant domain model; its fields are ordered for memory alignment (times → slices → strings → short strings).
type Tenant struct {
	// CreatedAt is the creation time (UTC). | CreatedAt 是创建时间（UTC）。
	CreatedAt time.Time `json:"created_at" gorm:"column:created_at;autoCreateTime;index"`
	// ID is the primary key (tn_xxx), generated by auth.Service. | ID 是主键，形如 tn_xxx，由框架 auth.Service 生成。
	ID string `json:"id" gorm:"column:id;type:varchar(64);primaryKey"`
	// Slug is the readable key used by the X-Tenant header and by subdomains. | Slug 是租户的可读键：请求头 X-Tenant 与子域名都用它定位租户。
	Slug string `json:"slug" gorm:"column:slug;type:varchar(64);not null;uniqueIndex"`
	// Name is the display name. | Name 是展示名称。
	Name string `json:"name" gorm:"column:name;type:varchar(128);not null"`
	// Status is the lifecycle state. | Status 是生命周期状态。
	Status Status `json:"status" gorm:"column:status;type:varchar(16);not null;default:active;index"`
}

// TenantFromAuth 把框架的租户记录转成本项目模型；入参为 nil 时返回零值。
// TenantFromAuth converts a framework tenant into this project's model; a nil input yields the zero value.
func TenantFromAuth(t *auth.Tenant) Tenant {
	if t == nil {
		return Tenant{}
	}
	return Tenant{
		CreatedAt: t.CreatedAt,
		ID:        t.ID,
		Slug:      t.Slug,
		Name:      t.Name,
		Status:    t.Status,
	}
}

// TenantsFromAuth converts a batch of tenant records. | TenantsFromAuth 批量转换租户记录。
func TenantsFromAuth(list []*auth.Tenant) []Tenant {
	out := make([]Tenant, 0, len(list))
	for _, t := range list {
		out = append(out, TenantFromAuth(t))
	}
	return out
}

// ToAuth 把本项目的租户模型转回框架记录，供写入路径使用。
// ToAuth converts this project's model back into a framework record for the write path.
func (t Tenant) ToAuth() *auth.Tenant {
	return &auth.Tenant{CreatedAt: t.CreatedAt, ID: t.ID, Slug: t.Slug, Name: t.Name, Status: t.Status}
}

// Display 返回列表展示文本（片段渲染时直接拼接，务必保持纯文本）。
// Display returns the text shown in lists (it is concatenated straight into fragments, so keep it plain text).
func (t Tenant) Display() string {
	name := strings.TrimSpace(t.Name)
	if name == "" {
		name = t.Slug
	}
	return name + " (" + t.Slug + ")"
}

// Active reports whether the tenant is usable. | Active 报告租户是否可用。
func (t Tenant) Active() bool { return t.Status == StatusActive }

// Initial returns the first character (upper-cased) used by the badge placeholder. | Initial 返回徽标占位用的首字符（大写）。
func (t Tenant) Initial() string {
	trimmed := strings.TrimSpace(t.Name)
	if trimmed == "" {
		trimmed = strings.TrimSpace(t.Slug)
	}
	if trimmed == "" {
		return "?"
	}
	// 首字符必须按 rune 截取：租户名允许中文，按字节切会得到非法 UTF-8，徽标因此空白。
	// Cut the initial by rune: tenant names may be Chinese, and a byte slice yields invalid UTF-8 that leaves the badge blank.
	first, _ := utf8.DecodeRuneInString(trimmed)
	if first == utf8.RuneError {
		return "?"
	}
	return strings.ToUpper(string(first))
}
