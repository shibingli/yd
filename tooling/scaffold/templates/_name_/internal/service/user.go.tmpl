// 本文件是用户业务：校验、角色分配与状态切换；一切读写都带着租户 ID。
// This file is the user business layer: validation, role assignment and lifecycle switches; every read and write carries the tenant id.

package service

import (
	"context"
	"strings"

	"{{ .Module }}/internal/model"
	"{{ .Module }}/internal/repository"
	"{{ .YdModule }}/security/auth"
	"{{ .YdModule }}/core/errx"
)

// User business sentinels: the 422 branch of the controllers is decided by them. | 用户业务哨兵：控制器的 422 分支按它们判定。
var (
	// ErrUserNameRequired reports an empty sign-in name. | ErrUserNameRequired 表示登录名为空。
	ErrUserNameRequired = errx.New("user name is required | 用户名称不能为空")
	// ErrUserEmailInvalid reports a malformed e-mail address. | ErrUserEmailInvalid 表示邮箱格式不正确。
	ErrUserEmailInvalid = errx.New("invalid e-mail address | 邮箱格式不正确")
	// ErrUserPasswordWeak reports a password that is too weak. | ErrUserPasswordWeak 表示口令强度不足。
	ErrUserPasswordWeak = errx.New("the password must be at least 8 characters long | 口令至少需要 8 位")
	// ErrUserNotFound reports a user that this tenant does not hold (a user of another tenant reports the same, so nothing can be probed). | ErrUserNotFound 表示本租户内没有该用户（其它租户的用户同样报它，避免探测）。
	ErrUserNotFound = errx.New("user not found | 用户不存在")
	// ErrRoleUnknown reports an assignment of a role name that does not exist. | ErrRoleUnknown 表示分配了不存在的角色名。
	ErrRoleUnknown = errx.New("unknown role | 角色不存在")
	// ErrSelfOperation reports a dangerous operation on one's own account (disabling oneself, for instance). | ErrSelfOperation 表示对自己执行了危险操作（如停用自己）。
	ErrSelfOperation = errx.New("you cannot disable your own account | 不能停用自己的账号")
)

// Length bounds for the e-mail address and the password. | 邮箱与口令的长度边界。
const (
	maxEmailLen = 128
	maxNameLen  = 64
)

// CreateUserInput is the create form's input; Password is the SM2 ciphertext. | CreateUserInput 是新建用户的表单输入；Password 是 SM2 密文。
type CreateUserInput struct {
	// Username is the sign-in name, unique inside the tenant. | Username 是登录名，租户内唯一。
	Username string
	// Email is the optional contact address. | Email 是可选的联络邮箱。
	Email string
	// DisplayName is the optional human-readable name. | DisplayName 是可选的展示名称。
	DisplayName string
	// Password is the initial password as SM2 ciphertext. | Password 是 SM2 密文形态的初始口令。
	Password []byte
	// Scheme is the X-YD-Encrypted request header value. | Scheme 是 X-YD-Encrypted 请求头取值。
	Scheme string
	// Roles is the initial role name set; empty assigns member. | Roles 是初始角色名集合；为空时分配 member。
	Roles []string
}

// UpdateUserInput 是修改用户资料的表单输入（不含口令与角色，它们各有各的入口）。
// UpdateUserInput is the profile form's input (no password and no roles; each of those has an entry point of its own).
type UpdateUserInput struct {
	// UserID is the user being changed. | UserID 是被修改的用户。
	UserID string
	// Username is the sign-in name. | Username 是登录名。
	Username string
	// Email is the contact address. | Email 是联络邮箱。
	Email string
	// DisplayName is the human-readable name. | DisplayName 是展示名称。
	DisplayName string
}

// UserService orchestrates the user lifecycle. | UserService 编排用户生命周期。
type UserService struct {
	// users is the user repository. | users 是用户仓储。
	users *repository.UserRepo
	// roles is the role repository, used to validate role names and to render forms. | roles 是角色仓储，用于校验角色名与渲染表单。
	roles *repository.RoleRepo
	// auth supplies SM2 decryption: a password only enters this layer as ciphertext. | auth 提供 SM2 解密：口令只以密文进入本层。
	auth *AuthService
}

// NewUserService 基于 Store 构造用户业务；auth 提供口令解密，缺失时新建用户与改密都会以 ErrCipherKeyMissing 结束。
// NewUserService builds the user business layer over a Store; auth decrypts the password and a missing one makes user
// creation and password changes end in ErrCipherKeyMissing.
func NewUserService(store *repository.Store, auth *AuthService) *UserService {
	return &UserService{users: repository.NewUserRepo(store), roles: repository.NewRoleRepo(store), auth: auth}
}

// List 返回本租户的用户，keyword 非空时按登录名、邮箱与展示名做不区分大小写的过滤。
// List returns the users of this tenant, filtered case-insensitively by sign-in name, e-mail and display name when keyword is non-empty.
//
// 过滤放在这一层而不是仓储层：内存实现没有查询能力，换成 SQL 时把 keyword 下推成 WHERE 即可（此处留有注释）。
// The filter lives here rather than in the repository because the memory store cannot query; with SQL, push keyword
// down into the WHERE clause instead.
func (s *UserService) List(ctx context.Context, tenantID, keyword string) ([]model.User, error) {
	list, err := s.users.List(ctx, tenantID)
	if err != nil {
		return nil, err
	}

	needle := strings.ToLower(strings.TrimSpace(keyword))
	if needle == "" {
		return list, nil
	}
	matched := make([]model.User, 0, len(list))
	for _, u := range list {
		if strings.Contains(strings.ToLower(u.Username), needle) ||
			strings.Contains(strings.ToLower(u.Email), needle) ||
			strings.Contains(strings.ToLower(u.DisplayName), needle) {
			matched = append(matched, u)
		}
	}
	return matched, nil
}

// Get returns one user of this tenant. | Get 返回本租户内的一个用户。
func (s *UserService) Get(ctx context.Context, tenantID, userID string) (model.User, error) {
	return s.users.Get(ctx, tenantID, userID)
}

// Create 新建用户：先校验，再解密口令，最后由 auth 包散列口令并生成 sec_key。
// Create adds a user: validate first, decrypt the password second and let the auth package hash it and generate the sec_key last.
func (s *UserService) Create(ctx context.Context, tenantID string, in CreateUserInput) (model.User, error) {
	username := strings.TrimSpace(in.Username)
	if username == "" {
		return model.User{}, ErrUserNameRequired
	}
	if len(username) > maxNameLen {
		return model.User{}, ErrUserNameRequired
	}
	email := strings.TrimSpace(in.Email)
	if email != "" && !validEmail(email) {
		return model.User{}, ErrUserEmailInvalid
	}
	if s.auth == nil {
		return model.User{}, ErrCipherKeyMissing
	}
	password, err := s.auth.decrypt(in.Password, in.Scheme)
	if err != nil {
		return model.User{}, err
	}

	roles, err := s.normaliseRoles(ctx, tenantID, in.Roles)
	if err != nil {
		return model.User{}, err
	}
	return s.users.Create(ctx, tenantID, auth.CreateUserInput{
		Username:    username,
		Email:       email,
		DisplayName: strings.TrimSpace(in.DisplayName),
		Password:    password,
		Roles:       roles,
	})
}

// Update replaces the user's profile fields (roles and password excluded). | Update 覆盖用户的资料字段（不含角色与口令）。
func (s *UserService) Update(ctx context.Context, tenantID string, in UpdateUserInput) (model.User, error) {
	username := strings.TrimSpace(in.Username)
	if username == "" {
		return model.User{}, ErrUserNameRequired
	}
	email := strings.TrimSpace(in.Email)
	if email != "" && !validEmail(email) {
		return model.User{}, ErrUserEmailInvalid
	}

	record, err := s.users.Get(ctx, tenantID, in.UserID)
	if err != nil {
		return model.User{}, ErrUserNotFound
	}
	record.Username = username
	record.Email = email
	record.DisplayName = strings.TrimSpace(in.DisplayName)
	if err := s.users.Update(ctx, tenantID, record); err != nil {
		return model.User{}, err
	}
	return record, nil
}

// SetRoles replaces the user's role set and is the single entry point of role assignment. | SetRoles 覆盖用户的角色集合，是「角色分配」的唯一入口。
func (s *UserService) SetRoles(ctx context.Context, tenantID, userID string, names []string) error {
	roles, err := s.normaliseRoles(ctx, tenantID, names)
	if err != nil {
		return err
	}
	return s.users.SetRoles(ctx, tenantID, userID, roles)
}

// SetPassword 由管理员重置他人口令（同时轮换 sec_key，旧令牌立即失效）。
// SetPassword lets an administrator reset somebody else's password (the sec_key rotates too, so old tokens die at once).
func (s *UserService) SetPassword(ctx context.Context, tenantID, userID string, password []byte, scheme string) error {
	if s.auth == nil {
		return ErrCipherKeyMissing
	}
	plain, err := s.auth.decrypt(password, scheme)
	if err != nil {
		return err
	}
	return s.users.SetPassword(ctx, tenantID, userID, plain)
}

// Disable 停用用户；actorID 与目标相同时以 ErrSelfOperation 拒绝，避免管理员把自己锁在门外。
// Disable disables a user; when actorID equals the target it refuses with ErrSelfOperation, so an administrator can never lock themselves out.
func (s *UserService) Disable(ctx context.Context, tenantID, userID, actorID string) error {
	if userID == actorID {
		return ErrSelfOperation
	}
	return s.users.SetStatus(ctx, tenantID, userID, model.StatusDisabled)
}

// Enable enables a user. | Enable 启用用户。
func (s *UserService) Enable(ctx context.Context, tenantID, userID string) error {
	return s.users.SetStatus(ctx, tenantID, userID, model.StatusActive)
}

// RotateSecKey 轮换某一用户的 sec_key：旧令牌全部失效，口令不变。
// RotateSecKey rotates one user's sec_key: every old token dies and the password stays.
func (s *UserService) RotateSecKey(ctx context.Context, tenantID, userID string) error {
	return s.users.RotateSecKey(ctx, tenantID, userID)
}

// Roles returns this tenant's roles for the role checkboxes of the user form. | Roles 返回本租户的角色清单，供用户表单的角色多选渲染。
func (s *UserService) Roles(ctx context.Context, tenantID string) ([]model.Role, error) {
	return s.roles.List(ctx, tenantID)
}

// normaliseRoles 校验并去重角色名：空集合落到 member，未知名称以 ErrRoleUnknown 拒绝（失败即关闭）。
// normaliseRoles validates and de-duplicates role names: an empty set becomes member and an unknown name is refused with ErrRoleUnknown (fail closed).
func (s *UserService) normaliseRoles(ctx context.Context, tenantID string, names []string) ([]string, error) {
	catalogue, err := s.roles.List(ctx, tenantID)
	if err != nil {
		return nil, err
	}
	known := make(map[string]string, len(catalogue))
	for _, role := range catalogue {
		known[strings.ToLower(role.Name)] = role.Name
	}

	out := make([]string, 0, len(names))
	seen := make(map[string]struct{}, len(names))
	for _, name := range names {
		canonical, ok := known[strings.ToLower(strings.TrimSpace(name))]
		if !ok {
			return nil, ErrRoleUnknown
		}
		if _, dup := seen[canonical]; dup {
			continue
		}
		seen[canonical] = struct{}{}
		out = append(out, canonical)
	}
	if len(out) == 0 {
		if canonical, ok := known[model.RoleMember]; ok {
			out = append(out, canonical)
		}
	}
	return out, nil
}

// validEmail 做保守的邮箱校验：一个 @、两侧非空、域名里有点且不含空白。
// validEmail performs a conservative check: exactly one @, non-empty sides, a dotted domain and no whitespace.
//
// 刻意不用正则：邮箱的完整语法远比这里需要的复杂，而「发一封信验证」才是唯一的真判据，这里只挡住明显的手误。
// No regular expression on purpose: the full grammar of an address is far more complex than this layer needs, a
// confirmation mail is the only real proof and this only rejects obvious typos.
func validEmail(email string) bool {
	if len(email) > maxEmailLen || strings.ContainsAny(email, " \t\r\n") {
		return false
	}
	at := strings.IndexByte(email, '@')
	if at <= 0 || at != strings.LastIndexByte(email, '@') || at == len(email)-1 {
		return false
	}
	domain := email[at+1:]
	dot := strings.IndexByte(domain, '.')
	return dot > 0 && dot < len(domain)-1
}
