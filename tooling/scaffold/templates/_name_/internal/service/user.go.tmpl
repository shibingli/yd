// 本文件是用户业务：校验、角色分配与状态切换；一切读写都带着租户 ID。
// This file is the user business layer: validation, role assignment and lifecycle switches; every read and write carries the tenant id.

package service

import (
	"context"
	"strings"

	"{{ .Module }}/internal/model"
	"{{ .Module }}/internal/repository"
	"{{ .YdModule }}/security/auth"
	"{{ .YdxModule }}/errs"
)

// User business sentinels: the 422 branch of the controllers is decided by them. | 用户业务哨兵：控制器的 422 分支按它们判定。
var (
	// ErrUserNameRequired reports an empty sign-in name. | ErrUserNameRequired 表示登录名为空。
	ErrUserNameRequired = errs.New("user name is required | 用户名称不能为空")
	// ErrUserEmailInvalid reports a malformed e-mail address. | ErrUserEmailInvalid 表示邮箱格式不正确。
	ErrUserEmailInvalid = errs.New("invalid e-mail address | 邮箱格式不正确")
	// ErrUserPasswordWeak reports a password that is too weak. | ErrUserPasswordWeak 表示口令强度不足。
	ErrUserPasswordWeak = errs.New("the password must be at least 8 characters long | 口令至少需要 8 位")
	// ErrUserNotFound reports a user that this tenant does not hold (a user of another tenant reports the same, so nothing can be probed). | ErrUserNotFound 表示本租户内没有该用户（其它租户的用户同样报它，避免探测）。
	ErrUserNotFound = errs.New("user not found | 用户不存在")
	// ErrRoleUnknown reports an assignment of a role name that does not exist. | ErrRoleUnknown 表示分配了不存在的角色名。
	ErrRoleUnknown = errs.New("unknown role | 角色不存在")
	// ErrSelfOperation reports a dangerous operation on one's own account (disabling oneself, for instance). | ErrSelfOperation 表示对自己执行了危险操作（如停用自己）。
	ErrSelfOperation = errs.New("you cannot disable your own account | 不能停用自己的账号")
	// ErrTenantSelection reports an empty membership set or a default tenant outside it. | ErrTenantSelection 表示成员租户为空，或默认租户不在其中。
	ErrTenantSelection = errs.New("select at least one tenant and pick the default tenant among them | 至少选择一个租户，并把默认租户选在其中")
	// ErrUserGrantEscalation reports a role selection whose capabilities exceed the actor's own. | ErrUserGrantEscalation
	// 表示所选角色授予的能力超出了操作者自身持有的能力。
	ErrUserGrantEscalation = errs.New("the requested roles exceed your capabilities | 所选角色超出你的权限")
)

// Length bounds for the e-mail address and the password. | 邮箱与口令的长度边界。
const (
	maxEmailLen = 128
	maxNameLen  = 64
)

// CreateUserInput is the create form's input; Password is the SM2 ciphertext. | CreateUserInput 是新建用户的表单输入；Password 是 SM2 密文。
type CreateUserInput struct {
	// Username is the sign-in name, unique inside the tenant. | Username 是登录名，租户内唯一。
	Username string
	// Email is the optional contact address. | Email 是可选的联络邮箱。
	Email string
	// DisplayName is the optional human-readable name. | DisplayName 是可选的展示名称。
	DisplayName string
	// Password is the initial password as SM2 ciphertext. | Password 是 SM2 密文形态的初始口令。
	Password []byte
	// Scheme is the X-YD-Encrypted request header value. | Scheme 是 X-YD-Encrypted 请求头取值。
	Scheme string
	// Roles is the initial role name set; empty assigns member. | Roles 是初始角色名集合；为空时分配 member。
	Roles []string
	// Grantable is the capability set of the actor performing the creation. Every capability granted by an explicitly
	// requested role must be present here, so the controller's anti-escalation gate is repeated at the last possible
	// moment; a nil map holds no capability and therefore refuses every explicitly requested role. It is ignored when
	// Roles is empty, because the member fallback is the baseline role rather than a caller-selected grant. |
	// Grantable 是执行建号的操作者能力集合。显式申请的角色所授予的每项能力都必须在此集合内，因此控制器的防越权
	// 闸门在最后一刻再执行一次；nil map 不持有任何能力，因此会拒绝所有显式申请的角色。Roles 为空时忽略它，
	// 因为 member 回退是基线角色，而不是调用方选择的授权。
	Grantable map[model.Permission]struct{}
}

// UpdateUserInput 是修改用户资料的表单输入（不含口令与角色，它们各有各的入口）。
// UpdateUserInput is the profile form's input (no password and no roles; each of those has an entry point of its own).
type UpdateUserInput struct {
	// UserID is the user being changed. | UserID 是被修改的用户。
	UserID string
	// Username is the sign-in name. | Username 是登录名。
	Username string
	// Email is the contact address. | Email 是联络邮箱。
	Email string
	// DisplayName is the human-readable name. | DisplayName 是展示名称。
	DisplayName string
}

// UserService orchestrates the user lifecycle. | UserService 编排用户生命周期。
type UserService struct {
	// users is the user repository. | users 是用户仓储。
	users *repository.UserRepo
	// roles is the role repository, used to validate role names and to render forms. | roles 是角色仓储，用于校验角色名与渲染表单。
	roles *repository.RoleRepo
	// auth supplies SM2 decryption: a password only enters this layer as ciphertext. | auth 提供 SM2 解密：口令只以密文进入本层。
	auth *AuthService
}

// NewUserService 基于 Store 构造用户业务；auth 提供口令解密，缺失时新建用户与改密都会以 ErrCipherKeyMissing 结束。
// NewUserService builds the user business layer over a Store; auth decrypts the password and a missing one makes user
// creation and password changes end in ErrCipherKeyMissing.
func NewUserService(store *repository.Store, auth *AuthService) *UserService {
	return &UserService{users: repository.NewUserRepo(store), roles: repository.NewRoleRepo(store), auth: auth}
}

// List 返回本租户的用户，keyword 非空时按登录名、邮箱与展示名做不区分大小写的过滤。
// List returns the users of this tenant, filtered case-insensitively by sign-in name, e-mail and display name when keyword is non-empty.
//
// 过滤放在这一层而不是仓储层：内存实现没有查询能力，换成 SQL 时把 keyword 下推成 WHERE 即可（此处留有注释）。
// The filter lives here rather than in the repository because the memory store cannot query; with SQL, push keyword
// down into the WHERE clause instead.
func (s *UserService) List(ctx context.Context, tenantID, keyword string) ([]model.User, error) {
	list, err := s.users.List(ctx, tenantID)
	if err != nil {
		return nil, err
	}

	needle := strings.ToLower(strings.TrimSpace(keyword))
	if needle == "" {
		return list, nil
	}
	matched := make([]model.User, 0, len(list))
	for _, u := range list {
		if strings.Contains(strings.ToLower(u.Username), needle) ||
			strings.Contains(strings.ToLower(u.Email), needle) ||
			strings.Contains(strings.ToLower(u.DisplayName), needle) {
			matched = append(matched, u)
		}
	}
	return matched, nil
}

// ListPage returns one page of users and the filtered total. | ListPage 返回一页用户与过滤后的总数。
func (s *UserService) ListPage(ctx context.Context, tenantID, keyword string, limit, offset int) ([]model.User, int, error) {
	return s.users.ListPage(ctx, tenantID, keyword, limit, offset)
}

// Count returns the number of members of this tenant. | Count 返回本租户的成员数。
func (s *UserService) Count(ctx context.Context, tenantID string) (int, error) {
	return s.users.Count(ctx, tenantID)
}

// Recent returns the newest users of this tenant. | Recent 返回本租户最新的用户。
func (s *UserService) Recent(ctx context.Context, tenantID string, limit int) ([]model.User, error) {
	return s.users.Recent(ctx, tenantID, limit)
}

// Get returns one user of this tenant. | Get 返回本租户内的一个用户。
func (s *UserService) Get(ctx context.Context, tenantID, userID string) (model.User, error) {
	return s.users.Get(ctx, tenantID, userID)
}

// Create 新建用户：先校验，再解密口令，最后由 auth 包散列口令并生成 sec_key。
// Create adds a user: validate first, decrypt the password second and let the auth package hash it and generate the sec_key last.
func (s *UserService) Create(ctx context.Context, tenantID string, in CreateUserInput) (model.User, error) {
	username := strings.TrimSpace(in.Username)
	if username == "" {
		return model.User{}, ErrUserNameRequired
	}
	if len(username) > maxNameLen {
		return model.User{}, ErrUserNameRequired
	}
	email := strings.TrimSpace(in.Email)
	if email != "" && !validEmail(email) {
		return model.User{}, ErrUserEmailInvalid
	}
	if s.auth == nil {
		return model.User{}, ErrCipherKeyMissing
	}
	password, err := s.auth.decrypt(in.Password, in.Scheme)
	if err != nil {
		return model.User{}, err
	}

	roles, err := s.normaliseRoles(ctx, tenantID, in.Roles)
	if err != nil {
		return model.User{}, err
	}
	// Defence in depth: the controller already refused roles above the actor's capabilities, and this second check
	// makes the rule hold for every other caller as well. An empty request falls back to member and is not judged
	// against Grantable. | 纵深防御：控制器已经拒绝了超出操作者能力的角色，这道二次校验让规则对其余调用方同样成立。
	// 空请求回退到 member，不按 Grantable 判定。
	if hasExplicitRoles(in.Roles) {
		if err := s.ensureGrantable(ctx, tenantID, roles, in.Grantable); err != nil {
			return model.User{}, err
		}
	}
	return s.users.Create(ctx, tenantID, auth.CreateUserInput{
		Username:    username,
		Email:       email,
		DisplayName: strings.TrimSpace(in.DisplayName),
		Password:    password,
		Roles:       roles,
	})
}

// hasExplicitRoles reports whether the caller named at least one non-empty role. | hasExplicitRoles 报告调用方是否至少点名了一个非空角色。
func hasExplicitRoles(names []string) bool {
	for _, name := range names {
		if strings.TrimSpace(name) != "" {
			return true
		}
	}
	return false
}

// ensureGrantable refuses a role set whose capabilities are not a subset of grantable. | ensureGrantable 拒绝能力集合不是
// grantable 子集的角色集合。
//
// A nil grantable means "no capability": the service cannot tell a forgotten actor from an actor holding nothing, and
// granting from an unknown authority would be the more dangerous guess. | nil grantable 表示「没有任何能力」：服务层
// 无法区分「忘记传操作者」与「操作者没有任何能力」，而在权限未知时放行是更危险的猜测。
func (s *UserService) ensureGrantable(ctx context.Context, tenantID string, names []string, grantable map[model.Permission]struct{}) error {
	catalogue, err := s.roles.List(ctx, tenantID)
	if err != nil {
		return err
	}
	byName := make(map[string]model.Role, len(catalogue))
	for _, role := range catalogue {
		byName[strings.ToLower(role.Name)] = role
	}
	for _, name := range names {
		role, ok := byName[strings.ToLower(name)]
		if !ok {
			continue
		}
		for _, permission := range role.Permissions {
			if _, held := grantable[permission]; !held {
				return errs.Detail(ErrUserGrantEscalation, "role %[1]q grants %[2]q, which the actor does not hold | 角色 %[1]q 授予了操作者并不持有的 %[2]q",
					role.Name, permission)
			}
		}
	}
	return nil
}

// Update replaces the user's profile fields (roles and password excluded). | Update 覆盖用户的资料字段（不含角色与口令）。
func (s *UserService) Update(ctx context.Context, tenantID string, in UpdateUserInput) (model.User, error) {
	username := strings.TrimSpace(in.Username)
	if username == "" {
		return model.User{}, ErrUserNameRequired
	}
	email := strings.TrimSpace(in.Email)
	if email != "" && !validEmail(email) {
		return model.User{}, ErrUserEmailInvalid
	}

	record, err := s.users.Get(ctx, tenantID, in.UserID)
	if err != nil {
		return model.User{}, ErrUserNotFound
	}
	record.Username = username
	record.Email = email
	record.DisplayName = strings.TrimSpace(in.DisplayName)
	if err := s.users.Update(ctx, tenantID, record); err != nil {
		return model.User{}, err
	}
	return record, nil
}

// SetRoles replaces the user's role set and is the single entry point of role assignment. | SetRoles 覆盖用户的角色集合，是「角色分配」的唯一入口。
func (s *UserService) SetRoles(ctx context.Context, tenantID, userID string, names []string) error {
	roles, err := s.normaliseRoles(ctx, tenantID, names)
	if err != nil {
		return err
	}
	return s.users.SetRoles(ctx, tenantID, userID, roles)
}

// SetPassword 由管理员重置他人口令（同时轮换 sec_key，旧令牌立即失效）。
// SetPassword lets an administrator reset somebody else's password (the sec_key rotates too, so old tokens die at once).
func (s *UserService) SetPassword(ctx context.Context, tenantID, userID string, password []byte, scheme string) error {
	if s.auth == nil {
		return ErrCipherKeyMissing
	}
	plain, err := s.auth.decrypt(password, scheme)
	if err != nil {
		return err
	}
	return s.users.SetPassword(ctx, tenantID, userID, plain)
}

// Disable 停用用户；actorID 与目标相同时以 ErrSelfOperation 拒绝，避免管理员把自己锁在门外。
// Disable disables a user; when actorID equals the target it refuses with ErrSelfOperation, so an administrator can never lock themselves out.
func (s *UserService) Disable(ctx context.Context, tenantID, userID, actorID string) error {
	if userID == actorID {
		return ErrSelfOperation
	}
	return s.users.SetStatus(ctx, tenantID, userID, model.StatusDisabled)
}

// Enable enables a user. | Enable 启用用户。
func (s *UserService) Enable(ctx context.Context, tenantID, userID string) error {
	return s.users.SetStatus(ctx, tenantID, userID, model.StatusActive)
}

// RotateSecKey 轮换某一用户的 sec_key：旧令牌全部失效，口令不变。
// RotateSecKey rotates one user's sec_key: every old token dies and the password stays.
func (s *UserService) RotateSecKey(ctx context.Context, tenantID, userID string) error {
	return s.users.RotateSecKey(ctx, tenantID, userID)
}

// Roles returns this tenant's roles for the role checkboxes of the user form. | Roles 返回本租户的角色清单，供用户表单的角色多选渲染。
func (s *UserService) Roles(ctx context.Context, tenantID string) ([]model.Role, error) {
	return s.roles.List(ctx, tenantID)
}

// Tenants returns every tenant the user belongs to. | Tenants 返回用户隶属的全部租户。
func (s *UserService) Tenants(ctx context.Context, userID string) ([]model.Tenant, error) {
	return s.users.Tenants(ctx, userID)
}

// SetTenants replaces the user's memberships and default tenant. | SetTenants 覆盖用户的成员租户与默认租户。
//
// The whole target set is validated before anything is written, and the atomic TenantReplacer is used whenever the
// store offers it: the user row and every membership row are locked, all target tenants, roles and the default tenant
// are checked, and only then are rows inserted, updated or deleted. A store without that capability falls back to the
// sequential add → switch default → remove order with explicit compensation for the steps already performed. The
// sequential order is deliberate: the old default is no longer the default when it is removed, so a legitimate
// adjustment is not blocked by the "the default tenant cannot be removed" rule. | 整个目标集合在写入之前先完成校验，
// 并且只要存储层提供原子能力就使用 TenantReplacer：锁定用户行与全部成员关系行，校验所有目标租户、角色与默认租户，
// 然后才插入、更新或删除。没有该能力的存储回退到「新增 → 切换默认 → 移除」的顺序并显式补偿已完成的步骤。
// 顺序是刻意的：旧默认租户在被移除时已经不是默认，因此一次合法的调整不会被「默认租户不可移除」规则挡住。
func (s *UserService) SetTenants(ctx context.Context, actorTenantID, userID string, tenantIDs []string, defaultTenantID string) error {
	target, err := s.users.Get(ctx, actorTenantID, userID)
	if err != nil {
		return ErrUserNotFound
	}
	desired := make([]string, 0, len(tenantIDs))
	seen := make(map[string]struct{}, len(tenantIDs))
	for _, id := range tenantIDs {
		id = strings.TrimSpace(id)
		if id == "" {
			continue
		}
		if _, dup := seen[id]; dup {
			continue
		}
		seen[id] = struct{}{}
		desired = append(desired, id)
	}
	if len(desired) == 0 {
		return ErrTenantSelection
	}
	defaultTenantID = strings.TrimSpace(defaultTenantID)
	if defaultTenantID == "" {
		defaultTenantID = desired[0]
	}
	if _, ok := seen[defaultTenantID]; !ok {
		return ErrTenantSelection
	}
	// The identity tenant is immutable; removing it would orphan the sec_key sealed with it. | 身份租户不可变；
	// 移除它会让以它封装的 sec_key 失去归属。
	homeTenantID := strings.TrimSpace(target.HomeTenantID)
	if homeTenantID == "" {
		homeTenantID = target.TenantID
	}
	if _, ok := seen[homeTenantID]; !ok {
		return errs.Detail(auth.ErrConflict, "the home tenant cannot be removed | 身份租户不可移除")
	}

	current, err := s.users.Tenants(ctx, userID)
	if err != nil {
		return err
	}
	currentSet := make(map[string]struct{}, len(current))
	for _, t := range current {
		currentSet[t.ID] = struct{}{}
	}
	// Resolve every new tenant and its initial roles before the first write. A missing tenant or role therefore
	// cannot leave a half-adjusted membership set behind. | 第一次写入之前先解析每个新租户及其初始角色，因此缺少
	// 租户或角色都不会留下改到一半的成员关系。
	planned := make([]auth.TenantMembership, 0, len(desired))
	for _, id := range desired {
		if _, ok := currentSet[id]; ok {
			// nil roles keep the stored set of a membership the user already holds. | nil 角色保留用户已有成员关系的库中集合。
			planned = append(planned, auth.TenantMembership{TenantID: id})
			continue
		}
		roles, err := s.membershipRoles(ctx, id)
		if err != nil {
			return err
		}
		planned = append(planned, auth.TenantMembership{TenantID: id, Roles: roles})
	}
	if replacer := s.users.TenantReplacer(); replacer != nil {
		return replacer.ReplaceUserTenants(ctx, userID, planned, defaultTenantID)
	}

	// Sequential fallback for stores without the atomic capability. | 没有原子能力时的顺序回退。
	added := make([]string, 0, len(planned))
	for _, membership := range planned {
		if _, ok := currentSet[membership.TenantID]; ok {
			continue
		}
		if err := s.users.AddTenant(ctx, userID, membership.TenantID, membership.Roles); err != nil {
			s.rollbackAddedTenants(ctx, userID, added)
			return err
		}
		added = append(added, membership.TenantID)
	}
	if err := s.users.SetDefaultTenant(ctx, userID, defaultTenantID); err != nil {
		s.rollbackAddedTenants(ctx, userID, added)
		return err
	}
	for _, t := range current {
		if _, keep := seen[t.ID]; keep {
			continue
		}
		if err := s.users.RemoveTenant(ctx, userID, t.ID); err != nil {
			// Compensate the steps already taken. Restoring the old default may fail if it was removed earlier in
			// this loop; that is the residual, documented cost of the fallback and exactly why the atomic path
			// exists. | 补偿已完成的步骤。旧默认若已在本循环中被移除，恢复它可能失败；这是回退路径的已知残余
			// 代价，也正是原子路径存在的原因。
			_ = s.users.SetDefaultTenant(ctx, userID, target.DefaultTenant())
			s.rollbackAddedTenants(ctx, userID, added)
			return err
		}
	}
	return nil
}

// rollbackAddedTenants removes memberships added by the sequential fallback, newest first. | rollbackAddedTenants 按从新到旧
// 的顺序移除顺序回退中新增的成员关系。
//
// Compensation is best-effort by design: the original error is the one the caller must see, and a compensation
// failure means the store itself is failing, not that the caller may retry blindly. | 补偿按设计是尽力而为：调用方
// 必须看到的是最初的错误，而补偿失败意味着存储本身已经故障，而不是调用方可以盲目重试。
func (s *UserService) rollbackAddedTenants(ctx context.Context, userID string, tenantIDs []string) {
	for i := len(tenantIDs) - 1; i >= 0; i-- {
		_ = s.users.RemoveTenant(ctx, userID, tenantIDs[i])
	}
}

// SetDefaultTenant 管理员为用户指定默认租户；目标必须是该用户的成员租户。
// SetDefaultTenant lets an administrator pick a user's default tenant, which must be one of that user's memberships.
func (s *UserService) SetDefaultTenant(ctx context.Context, actorTenantID, userID, tenantID string) error {
	if _, err := s.users.Get(ctx, actorTenantID, userID); err != nil {
		return ErrUserNotFound
	}
	return s.users.SetDefaultTenant(ctx, userID, tenantID)
}

// SetOwnDefaultTenant 让用户修改自己的默认租户；成员关系由仓储层校验。
// SetOwnDefaultTenant lets a user change their own default tenant; the store verifies the membership.
func (s *UserService) SetOwnDefaultTenant(ctx context.Context, userID, tenantID string) error {
	return s.users.SetDefaultTenant(ctx, userID, tenantID)
}

// SwitchTenant 返回用户在目标租户中的视图；非成员与不存在的租户都报 ErrUserNotFound。
// SwitchTenant returns the user acting in the target tenant; a non-member and a missing tenant both report ErrUserNotFound.
func (s *UserService) SwitchTenant(ctx context.Context, userID, tenantID string) (model.User, error) {
	u, err := s.users.SwitchTenant(ctx, userID, tenantID)
	if err != nil {
		return model.User{}, ErrUserNotFound
	}
	return u, nil
}

// membershipRoles returns the initial roles of a new membership: member when the target tenant holds it, otherwise
// none. | membershipRoles 返回新成员关系的初始角色：目标租户持有 member 就用它，否则不授予任何角色。
//
// Unlike the old swallow-everything helper, an unknown or unreadable tenant is reported: the caller is about to write
// a membership and must not proceed on a role list it could not read. A freshly created tenant may not hold the
// member role yet, so a missing member is not an error. | 与旧版吞掉一切错误的辅助函数不同，租户未知或无法读取时
// 会如实上报：调用方即将写入成员关系，不能凭一份读不到的角色清单继续。新租户可能尚未写入 member 角色，因此缺少
// member 不是错误。
func (s *UserService) membershipRoles(ctx context.Context, tenantID string) ([]string, error) {
	catalogue, err := s.roles.List(ctx, tenantID)
	if err != nil {
		return nil, err
	}
	for _, role := range catalogue {
		if strings.EqualFold(role.Name, model.RoleMember) {
			return []string{role.Name}, nil
		}
	}
	return nil, nil
}

// normaliseRoles 校验并去重角色名：空集合落到 member，未知名称以 ErrRoleUnknown 拒绝（失败即关闭）。
// normaliseRoles validates and de-duplicates role names: an empty set becomes member and an unknown name is refused with ErrRoleUnknown (fail closed).
func (s *UserService) normaliseRoles(ctx context.Context, tenantID string, names []string) ([]string, error) {
	catalogue, err := s.roles.List(ctx, tenantID)
	if err != nil {
		return nil, err
	}
	known := make(map[string]string, len(catalogue))
	for _, role := range catalogue {
		known[strings.ToLower(role.Name)] = role.Name
	}

	out := make([]string, 0, len(names))
	seen := make(map[string]struct{}, len(names))
	for _, name := range names {
		canonical, ok := known[strings.ToLower(strings.TrimSpace(name))]
		if !ok {
			return nil, ErrRoleUnknown
		}
		if _, dup := seen[canonical]; dup {
			continue
		}
		seen[canonical] = struct{}{}
		out = append(out, canonical)
	}
	if len(out) == 0 {
		if canonical, ok := known[model.RoleMember]; ok {
			out = append(out, canonical)
		}
	}
	return out, nil
}

// validEmail 做保守的邮箱校验：一个 @、两侧非空、域名里有点且不含空白。
// validEmail performs a conservative check: exactly one @, non-empty sides, a dotted domain and no whitespace.
//
// 刻意不用正则：邮箱的完整语法远比这里需要的复杂，而「发一封信验证」才是唯一的真判据，这里只挡住明显的手误。
// No regular expression on purpose: the full grammar of an address is far more complex than this layer needs, a
// confirmation mail is the only real proof and this only rejects obvious typos.
func validEmail(email string) bool {
	if len(email) > maxEmailLen || strings.ContainsAny(email, " \t\r\n") {
		return false
	}
	at := strings.IndexByte(email, '@')
	if at <= 0 || at != strings.LastIndexByte(email, '@') || at == len(email)-1 {
		return false
	}
	domain := email[at+1:]
	dot := strings.IndexByte(domain, '.')
	return dot > 0 && dot < len(domain)-1
}
