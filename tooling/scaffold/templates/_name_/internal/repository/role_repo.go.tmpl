// 本文件是角色仓储：角色永远属于一个租户，同名角色在租户之间互不影响。
// This file is the role repository: a role always belongs to one tenant and a role name never collides across tenants.
//
// 换成 GORM 时本文件不需要修改；角色名与权限列表建议在数据库上建 `UNIQUE(tenant_id, name)` 索引，
// 与 internal/model.Role 的标签一致。
// Nothing here changes when GORM arrives; add a `UNIQUE(tenant_id, name)` index in the database, matching the tags of
// internal/model.Role.

package repository

import (
	"context"
	"strings"

	"{{ .Module }}/internal/model"
	"{{ .YdModule }}/security/auth"
	"{{ .YdModule }}/security/authz"
)

// RoleRepo reads, upserts and deletes roles. | RoleRepo 提供角色的读取、覆盖写入与删除。
type RoleRepo struct {
	// store owns the auth service. | store 是鉴权服务的持有者。
	store *Store
}

// NewRoleRepo builds a role repository over a Store. | NewRoleRepo 基于 Store 构造角色仓储。
func NewRoleRepo(store *Store) *RoleRepo { return &RoleRepo{store: store} }

// List returns every role of the tenant ordered by name. | List 按名称返回该租户的全部角色。
func (r *RoleRepo) List(ctx context.Context, tenantID string) ([]model.Role, error) {
	list, err := r.store.Auth().ListRoles(ctx, tenantID)
	if err != nil {
		return nil, err
	}
	return model.RolesFromAuth(list), nil
}

// ByName 按名称返回角色；不存在时返回 false，而不是错误（权限矩阵大量按名查找）。
// ByName returns the role of that name; a missing name reports false rather than an error (the permission matrix looks roles up by name all the time).
func (r *RoleRepo) ByName(ctx context.Context, tenantID, name string) (model.Role, bool, error) {
	list, err := r.List(ctx, tenantID)
	if err != nil {
		return model.Role{}, false, err
	}
	target := strings.TrimSpace(name)
	for _, role := range list {
		if strings.EqualFold(role.Name, target) {
			return role, true, nil
		}
	}
	return model.Role{}, false, nil
}

// Upsert 覆盖写入角色：同 ID 或同租户内同名都会被替换，返回落库后的记录（含生成的 ID）。
// Upsert writes a role: the same id or the same name inside the tenant is replaced, and the stored record (with its generated id) comes back.
func (r *RoleRepo) Upsert(ctx context.Context, tenantID, name, description string, perms []model.Permission) (model.Role, error) {
	payload := make([]string, 0, len(perms))
	for _, p := range perms {
		payload = append(payload, string(p))
	}

	saved, err := r.store.Auth().UpsertRole(ctx, tenantID, &auth.Role{
		TenantID:    tenantID,
		Name:        strings.TrimSpace(name),
		Description: strings.TrimSpace(description),
		Permissions: payload,
	})
	if err != nil {
		return model.Role{}, err
	}
	return model.RoleFromAuth(saved), nil
}

// Delete removes a role; the built-in guard lives in the business layer, not here. | Delete 删除角色；内置角色由业务层拦截，仓储层不做特例。
func (r *RoleRepo) Delete(ctx context.Context, tenantID, roleID string) error {
	return r.store.Auth().DeleteRole(ctx, tenantID, roleID)
}

// Ensure 幂等写入内置角色及其能力绑定（owner / admin / auditor / member）。
// Ensure writes the built-in roles and their capability bindings idempotently (owner, admin, auditor and member).
//
// 角色名、说明与「角色→能力」的绑定全部来自框架注册表（authz.BuiltinRoles 与 authz.BuiltinGrants），
// 本项目一个角色名、一个能力标识都不写：于是「守卫要求的能力」与「种子授予的能力」必然是同一套词汇。
// The names, the descriptions and the role-to-capability bindings all come from the framework registry
// (authz.BuiltinRoles and authz.BuiltinGrants) and this project spells out neither a role name nor a capability token, so
// what the guards require and what the seed grants is necessarily one vocabulary.
//
// 已有的同名角色不被覆盖：使用者改过的权限不该在下次启动时被悄悄改回去。
// An existing role of the same name is left alone: a permission set the user edited must not be silently reverted on the
// next start.
//
// 一次 List 换掉「每个角色查一次」：内置角色有四个，而权限矩阵页与建号流程都在同一秒内看过这一份列表。
// One List replaces a lookup per role: there are four built-in roles, and the permission matrix and the sign-up flow read
// the same list within the same second.
func (r *RoleRepo) Ensure(ctx context.Context, tenantID string) error {
	existing, err := r.List(ctx, tenantID)
	if err != nil {
		return err
	}
	have := make(map[string]bool, len(existing))
	for _, role := range existing {
		have[strings.ToLower(role.Name)] = true
	}

	// 授权表按角色名索引：注册表不认识的权限标识根本进不来，因为它们来自同一张表。
	// The grants are indexed by role name: an unknown capability token cannot get in here, because both sides come from
	// the same table.
	grants := make(map[string][]model.Permission, len(authz.BuiltinRoles()))
	for _, grant := range authz.BuiltinGrants() {
		perms := make([]model.Permission, 0, len(grant.Permissions))
		for _, token := range grant.Permissions {
			perms = append(perms, model.Permission(token))
		}
		grants[grant.Role] = perms
	}

	for _, tpl := range authz.BuiltinRoles() {
		if have[strings.ToLower(tpl.Name)] {
			continue
		}
		if _, err := r.Upsert(ctx, tenantID, tpl.Name, tpl.Description, grants[tpl.Name]); err != nil {
			return err
		}
	}
	return nil
}
