// openDictionaryStore migrates and opens the data-dictionary tables on the shared pool. |
// openDictionaryStore 在共享连接池上迁移并打开数据字典表。
func openDictionaryStore(db any, log *ydlog.Logger) (dictionary.Store, error) {
	if db == nil {
		return nil, errs.Detail(dictionary.ErrUnavailable, "no database | 没有数据库")
	}
	gdb, ok := db.(*gorm.DB)
	if !ok {
		return nil, errs.Detail(dictionary.ErrUnavailable, "unexpected database handle | 非预期的数据库句柄")
	}
	ctx, cancel := context.WithTimeout(context.Background(), migrateTimeout)
	defer cancel()
	if err := dictionarygorm.Migrate(ctx, gdb); err != nil {
		return nil, errs.Wrap(err, dictionary.ErrUnavailable)
	}
	store, err := dictionarygorm.New(gdb)
	if err != nil {
		return nil, errs.Wrap(err, dictionary.ErrUnavailable)
	}
	log.Info("dictionary tables are ready | 数据字典表已就绪",
		ydlog.Strs("tables", []string{"yd_dict_types", "yd_dict_items"}),
	)
	return store, nil
}
{{ else -}}
// openDictionaryStore reports the dictionary store as unavailable in a project generated without a
// database. | openDictionaryStore 在未选择数据库的生成项目里报告数据字典存储不可用。
func openDictionaryStore(_ any, _ *ydlog.Logger) (dictionary.Store, error) {
	return nil, errs.Detail(dictionary.ErrUnavailable, "the project was generated without a database | 项目生成时未选择数据库")
}
{{ end -}}

{{ if ne .DB "none" -}}
// openMessageStore migrates and opens the message-centre tables on the same pool the auth store uses. |
// openMessageStore 在鉴权存储所用的同一连接池上迁移并打开消息中心数据表。
//
// A failed migration only disables the message centre: sign-in, tenants, users and every other page must
// still work, so the error is logged and reported through MessageError instead of refusing to start. |
// 迁移失败只会禁用消息中心：登录、租户、用户与其它页面必须照常工作，因此错误只记录并通过
// MessageError 上报，绝不因此拒绝启动。
func openMessageStore(db any, log *ydlog.Logger) (messaging.Store, error) {
	if db == nil {
		return nil, errs.Detail(messaging.ErrUnavailable, "no database | 没有数据库")
	}
	gdb, ok := db.(*gorm.DB)
	if !ok {
		return nil, errs.Detail(messaging.ErrUnavailable, "unexpected database handle | 非预期的数据库句柄")
	}
	ctx, cancel := context.WithTimeout(context.Background(), migrateTimeout)
	defer cancel()
	if err := messaginggorm.Migrate(ctx, gdb); err != nil {
		return nil, errs.Wrap(err, messaging.ErrUnavailable)
	}
	store, err := messaginggorm.New(gdb)
	if err != nil {
		return nil, errs.Wrap(err, messaging.ErrUnavailable)
	}
	log.Info("message centre tables are ready | 消息中心数据表已就绪")
	return store, nil
}
{{ else -}}
// openMessageStore reports the message centre as unavailable in a project generated without a database. |
// openMessageStore 在未选择数据库的生成项目里报告消息中心不可用。
func openMessageStore(_ any, _ *ydlog.Logger) (messaging.Store, error) {
	return nil, errs.Detail(messaging.ErrUnavailable, "the project was generated without a database | 项目生成时未选择数据库")
}
{{ end -}}

// openRaw 选出持久化实现，并返回它的释放函数（内存实现返回 nil）。
// openRaw selects the persistence implementation and returns its release function (nil for the in-memory one).
//
// 降级绝不阻塞启动：没有数据库、连库失败或迁移失败时都退回内存实现，并明确告警「数据不持久」。
// Degradation never blocks startup: without a database, or when connecting or migrating fails, it falls back to the
// in-memory implementation and warns explicitly that the data is not persistent.
{{ if ne .DB "none" -}}
func openRaw(o Options, log *ydlog.Logger) (auth.Store, any, func() error) {
	if dsn := configuredDSN(o.Config); dsn == "" {
		// 没有数据库的项目（yd new --db none）走的就是这一条：不打开任何连接，只把后果说清楚。
		// A project generated with `yd new --db none` takes exactly this path: nothing is opened and the consequence is
		// spelled out instead.
		log.Warn("no database is configured, auth data lives in memory and dies with the process | 未配置数据库，鉴权数据仅存于内存，进程重启即丢失",
			ydlog.Str("key", configDSN),
		)
		return auth.NewMemoryStore(), nil, nil
	}

	// DSN 绝不写进日志：它可能带着数据库口令（mysql / postgres / dm 的 DSN 就是如此）。
	// The DSN never reaches the log: it may carry a database password, as it does for mysql, postgres and dm.
	opts := ydgorm.OptionsFromConfig(o.Config)
	db, err := ydgorm.Open(opts, log)
	if err != nil {
		return degradeToMemory(log, err), nil, nil
	}

	// 迁移用带超时的上下文：数据库不可达时启动要能落回内存实现，而不是一直等着连上。
	// The migration runs under a bounded context, so an unreachable database degrades instead of hanging the boot.
	ctx, cancel := context.WithTimeout(context.Background(), migrateTimeout)
	defer cancel()
	if err := gormstore.Migrate(ctx, db); err != nil {
		_ = ydgorm.Close(db)
		return degradeToMemory(log, err), nil, nil
	}

	store, err := gormstore.New(db, gormstore.OptionsFromConfig(o.Config))
	if err != nil {
		_ = ydgorm.Close(db)
		return degradeToMemory(log, err), nil, nil
	}

	log.Info("auth data is stored in the database | 鉴权数据已存入数据库",
		ydlog.Str("driver", driverName(opts.Driver)),
		ydlog.Strs("tables", authTables),
	)
	return store, db, func() error { return ydgorm.Close(db) }
}

// configuredDSN returns the trimmed data source name, or "" when no database is configured.
// | configuredDSN 返回去掉首尾空白的 DSN；未配置数据库时返回空串。
func configuredDSN(c *config.Config) string {
	if c == nil {
		return ""
	}
	return strings.TrimSpace(c.GetString(configDSN))
}

// driverName reports the driver actually in use: an empty name means the framework default, sqlite (the same rule
// ydx/gorm applies when it picks a dialect). | driverName 报告实际使用的驱动名：空值表示框架默认的 sqlite
// （与 ydx/gorm 挑选方言时的规则一致）。
func driverName(driver string) string {
	if trimmed := strings.TrimSpace(driver); trimmed != "" {
		return trimmed
	}
	return ydgorm.DriverSQLite
}

// degradeToMemory 把「数据库不可用」变成「内存实现 + 告警」：应用照常起来，鉴权照常可用，代价只是数据不持久。
// degradeToMemory turns an unusable database into the in-memory implementation plus a warning: the application starts,
// authentication works, and the only price is that the data does not persist.
func degradeToMemory(log *ydlog.Logger, err error) auth.Store {
	log.Warn("database unavailable, auth data falls back to memory and is NOT persistent | 数据库不可用，鉴权数据回退到内存且不持久",
		ydlog.Str("key", configDSN),
		ydlog.Err(err),
	)
	return auth.NewMemoryStore()
}

// authTables 列出迁移建出的表，供启动日志一眼看出鉴权数据落在哪里（只读，不要修改）。
// authTables lists the tables created by the migration, so one look at the startup log shows where auth data lives
// (read-only; never mutated).
var authTables = []string{"yd_auth_tenants", "yd_auth_users", "yd_auth_user_tenants", "yd_auth_roles", "yd_auth_role_permissions"}

{{ else -}}
func openRaw(_ Options, log *ydlog.Logger) (auth.Store, any, func() error) {
	// 本项目生成时就没有选择数据库，因此这里没有任何连接可开，也没有可释放的资源。
	// This project was generated without a database, so there is no connection to open and nothing to release.
	log.Warn("this project was generated without a database, auth data lives in memory and dies with the process | 本项目生成时未选择数据库，鉴权数据仅存于内存，进程重启即丢失")
	return auth.NewMemoryStore(), nil, nil
}

{{ end -}}
// closeRelease 在后续装配步骤失败时关掉已经打开的连接池：装配失败的 store 不得留着连接。
// closeRelease closes an already opened pool after a later assembly step failed: a store that failed to assemble must not
// keep a connection.
func closeRelease(release func() error) {
	if release != nil {
		_ = release()
	}
}

// Auth returns the framework auth service used by the middleware and by permission checks. | Auth 返回框架鉴权服务，供中间件与权限判定使用。
func (s *Store) Auth() *auth.Service { return s.svc }

// Raw 返回鉴权存储实现本身：auth.Service 只暴露了按 ID 的读取，按登录名查找要落到这一层。
// Raw returns the auth store implementation itself: auth.Service exposes reads by id only and the username lookup lands here.
//
// 换存储实现时这里自动指向新实现（Open 是唯一的装配点），业务代码与测试都不受影响。
// Swapping the implementation redirects this automatically (Open is the only assembly point) and no business code or test changes.
func (s *Store) Raw() auth.Store { return s.raw }

// Issuer returns the token issuer used by auth.Middleware and by the sign-in flow. | Issuer 返回令牌签发器，供 auth.Middleware 与登录流程使用。
func (s *Store) Issuer() *auth.TokenIssuer { return s.issuer }

// Persistent reports whether a database backs this store; false means every write dies with the process.
// | Persistent 报告当前是否由数据库支撑；为 false 时每次写入都随进程消失。
func (s *Store) Persistent() bool { return s.persistent }

// Close releases what the store holds: with a database this closes the connection pool, and the in-memory
// implementation has nothing to release. It runs in the shutdown chain registered by the router. | Close 释放 Store 持有的
// 资源：接数据库时在这里关闭连接池，内存实现无需释放。它由路由注册的退出链调用。
func (s *Store) Close() error {
	if s.release == nil {
		return nil
	}
	return s.release()
}

// seedSpec describes the seeded tenant together with its administrator account. | seedSpec 描述种子租户及其管理员账号。
type seedSpec struct {
	// Slug is the readable tenant key used by the X-Tenant header and subdomains. | Slug 是租户的可读标识，X-Tenant 请求头与子域名用它定位租户。
	Slug string
	// Name is the tenant display name. | Name 是租户展示名。
	Name string
	// Username is the administrator sign-in name. | Username 是管理员登录名。
	Username string
	// Email is the administrator contact address. | Email 是管理员联络邮箱。
	Email string
}

// SeedTenant 返回生效的默认租户标识：优先 seed.tenant 配置（含 YD_SEED_TENANT 环境变量），留空时回退到内置默认值。
// SeedTenant returns the effective default tenant key: seed.tenant wins (including YD_SEED_TENANT), and an empty value
// falls back to the built-in default.
func (s *Store) SeedTenant() string {
	if value := strings.TrimSpace(s.cfg.GetString(meta.SeedTenantConfigKey)); value != "" {
		return value
	}
	return meta.SeedTenantSlug
}

// SeedUsername 返回生效的管理员登录名：优先 seed.username 配置（含 YD_SEED_USERNAME 环境变量），留空时回退到内置默认值。
// SeedUsername returns the effective administrator sign-in name: seed.username wins (including YD_SEED_USERNAME), and an
// empty value falls back to the built-in default.
func (s *Store) SeedUsername() string {
	if value := strings.TrimSpace(s.cfg.GetString(meta.SeedUsernameConfigKey)); value != "" {
		return value
	}
	return meta.SeedAdminUsername
}

// seedSpecs 返回唯一的默认租户及其管理员；租户标识与登录名取自配置，留空时使用内置默认值。
// seedSpecs returns the single default tenant and its administrator; the tenant key and sign-in name come from the
// configuration and fall back to the built-in defaults when empty.
//
// 口令不在这份清单里，这是刻意的：清单只描述「数据长什么样」，不描述「怎么进去」。
// The password is deliberately absent from this list: the list describes what the data looks like and never how to get in.
func (s *Store) seedSpecs() []seedSpec {
	return []seedSpec{
		{
			Slug:     s.SeedTenant(),
			Name:     meta.SeedTenantName,
			Username: s.SeedUsername(),
			Email:    meta.SeedAdminEmail,
		},
	}
}

// Seed 幂等写入默认数据：默认租户、四个内置角色及其能力绑定，以及该租户的管理员。
// Seed writes the default data idempotently: the default tenant, the four built-in roles with their capability bindings,
// and that tenant's administrator.
//
// 创建数据由数据本身判定，而且只有一道总闸：**租户表为空**才创建。
// 首次启动因此写入一次，之后每次启动不再创建任何租户或账号；多副本同时启动时，唯一索引冲突被读作「另一个副本已先完成初始化」
// 而不是错误（auth.ErrConflict），于是两个副本也只会留下唯一一份数据。
// Creation is decided by the data itself, behind a single gate: nothing is created unless the **tenant table is
// empty**. The first start therefore writes everything, every later start creates no tenant and no account, and when
// several replicas start at the same moment a unique-index conflict is read as "another replica finished the very same
// initialisation first" rather than as an error (auth.ErrConflict) — so even then exactly one copy of the data lands.
//
// 既有库每次启动只做一次补齐：内置角色缺少的默认能力会被加回去（只增不减），使升级后新增的能力（如 message:*）立即可用；
// 自定义角色、额外授予的能力与口令都不受影响，被停用或删除的种子账号也不会被悄悄复活。
// An existing database is reconciled on every start: missing default capabilities of the built-in roles are added back
// (add-only), so capabilities introduced by an upgrade (message:*) become usable immediately; custom roles, extra grants
// and passwords are untouched, and a seeded account that was disabled or deleted is not silently resurrected either.
//
// 口令来自配置：未配置时开发环境回退到内置开发口令并每次启动告警，非 development 环境**拒绝创建**并告警
// （见 seedPassword），因此这里没有、也不允许有任何一个写在源码里的口令。补齐既有租户的内置能力不需要口令。
// The password comes from the configuration: when none is configured development falls back to the built-in development
// password with a warning on every start, while an environment that does not call itself development **refuses to
// create anything** and says so (see seedPassword) — which is why no password is written in the sources here, or
// anywhere else. Reconciling an existing tenant's built-in capabilities needs no password.
func (s *Store) Seed(ctx context.Context) error {
	// System dictionaries are global and seeded once per installation; tenant dictionaries keep
	// their own copy and therefore continue to override the system layer. |
	// 系统级字典是全局的，每个安装实例只写一次；租户字典仍保留自己的副本，因此继续覆盖系统层。
	s.ensureBuiltinDictionaries(ctx, dictionary.SystemTenantID)
	tenants, err := s.svc.ListTenants(ctx)
	if err != nil {
		return errs.Wrap(err, ErrSeed)
	}
	roles := NewRoleRepo(s)
	if len(tenants) > 0 {
		// 既有库不重建租户与账号，只把注册表新增、而库中尚未授予的内置能力补上；自定义角色与自定义授权不受影响。
		// An existing database recreates neither tenants nor accounts: it only adds built-in capabilities the registry
		// has introduced but the database has not granted yet; custom roles and custom grants are untouched.
		added := 0
		for _, tenant := range tenants {
			count, err := roles.Reconcile(ctx, tenant.ID)
			if err != nil {
				return errs.Wrap(err, ErrSeed)
			}
			added += count
			s.ensureBuiltinDictionaries(ctx, tenant.ID)
		}
		if added > 0 {
			s.log.Info("built-in role grants upgraded | 内置角色能力已升级",
				ydlog.Int("tenants", len(tenants)),
				ydlog.Int("permissions", added),
			)
		} else {
			s.log.Debug("default data is already present, nothing is seeded | 默认数据已存在，不写入种子数据",
				ydlog.Int("tenants", len(tenants)),
			)
		}
		return nil
	}

	password, ok := s.seedPassword()
	if !ok {
		// 拒绝写入种子数据。原因与后果已在 seedPassword 里说过一次，这里不再重复刷屏。
		// The seed is refused. Why and with what consequence was said once in seedPassword and is not repeated here.
		return nil
	}

	for _, spec := range s.seedSpecs() {
		if err := s.seedTenant(ctx, roles, spec, password); err != nil {
			if errors.Is(err, auth.ErrConflict) {
				// 另一个副本在同一瞬间完成了同一次初始化：这正是幂等被兑现的样子，不是故障。
				// Another replica finished the very same initialisation at the same instant: this is idempotence being
				// delivered rather than a fault.
				s.log.Info("another replica initialised the default data first, nothing more is written | 另一个副本已先完成默认数据初始化，不再写入",
					ydlog.Str("tenant", spec.Slug),
				)
				return nil
			}
			return errs.Wrap(err, ErrSeed)
		}
	}

	s.log.Info("default data seeded: the default tenant, built-in roles, their capability bindings and its owner | 默认数据已写入：默认租户、内置角色、其能力绑定与该租户的所有者账号",
		ydlog.Int("tenants", len(s.seedSpecs())),
		ydlog.Int("roles", len(authz.BuiltinRoles())),
		ydlog.Int("permissions", len(authz.BuiltinPermissions())),
	)
	return nil
}

// seedTenant 写入一个租户及其角色与管理员：先租户，再角色（含能力绑定），最后管理员（授予 owner）。
// seedTenant writes one tenant together with its roles and its administrator: the tenant first, then the roles (with
// their capability bindings), and last the administrator (granted the owner role).
//
// 顺序不是随意的：角色必须先于管理员存在，否则 auth.Service.CreateUser 会因为角色未知而返回 ErrNotFound。
// The order is not arbitrary: the roles have to exist before the administrator, otherwise auth.Service.CreateUser reports
// ErrNotFound for an unknown role.
func (s *Store) seedTenant(ctx context.Context, roles *RoleRepo, spec seedSpec, password string) error {
	tenant, err := s.ensureTenant(ctx, spec)
	if err != nil {
		return err
	}
	if err := roles.Ensure(ctx, tenant.ID); err != nil {
		return err
	}
	if err := s.ensureAdmin(ctx, tenant, spec, password); err != nil {
		return err
	}
	s.ensureBuiltinDictionaries(ctx, tenant.ID)
	return nil
}

// ensureBuiltinDictionaries adds the predefined dictionaries an owner (tenant or system layer) does
// not have yet. The seeder is optional (an in-memory store has none) and a failure only warns: a
// missing dictionary must never stop the application from starting. |
// ensureBuiltinDictionaries 为归属方（租户或系统层）补齐尚不存在的预置字典。种子器是可选的
// （内存存储没有），失败也只告警：缺少字典绝不能阻止应用启动。
func (s *Store) ensureBuiltinDictionaries(ctx context.Context, tenantID string) {
	if s.dict == nil {
		return
	}
	seeder, ok := s.dict.(interface {
		EnsureBuiltins(context.Context, string) (int, error)
	})
	if !ok {
		return
	}
	count, err := seeder.EnsureBuiltins(ctx, tenantID)
	if err != nil {
		s.log.Warn("builtin dictionaries could not be seeded | 内置数据字典写入失败", ydlog.Err(err))
		return
	}
	if count > 0 {
		s.log.Info("builtin dictionaries seeded | 内置数据字典已写入",
			ydlog.Int("types", count),
			ydlog.Str("scope", string(dictionary.ScopeOf(tenantID))),
			ydlog.Str("owner", tenantID),
		)
	}
}

// ensureTenant returns the tenant of that slug, creating it when absent. | ensureTenant 按标识取租户，不存在时创建；返回的是租户记录本身。
//
// 创建是唯一可能撞上唯一索引的一步（本地唯一）。并发创建的输者在这里得到 auth.ErrConflict，
// 而 Seed 把它读作「已初始化」：因此这个函数不需要额外的锁，锁在数据上。
// Creating the tenant is the one step that can hit a unique index (unique locally). The loser of a concurrent creation gets
// auth.ErrConflict here and Seed reads it as "already initialised": no extra lock is needed, because the lock is the data.
func (s *Store) ensureTenant(ctx context.Context, spec seedSpec) (*auth.Tenant, error) {
	tenants, err := s.svc.ListTenants(ctx)
	if err != nil {
		return nil, err
	}
	for _, t := range tenants {
		if t.Slug == spec.Slug {
			return t, nil
		}
	}
	return s.svc.CreateTenant(ctx, spec.Slug, spec.Name)
}

// ensureAdmin 按登录名取管理员，不存在时创建并授予 owner 角色。
// ensureAdmin returns the administrator of that username, creating it with the owner role when absent.
//
// 口令只以 guomi.HashPassword 的结果落库（auth.Service.CreateUser 内部调用的就是它），明文既不进日志也不进错误链：
// 这条路径上的每一行日志都只说「谁被创建了」，从不说「用什么进去」（口令尤其不进 ydlog 的字段）。
// The password reaches the store only as the result of guomi.HashPassword (which is what auth.Service.CreateUser calls),
// and the clear text enters neither a log nor an error chain: every line written along this path says who was created and
// never what lets them in — the password, in particular, never becomes a ydlog field.
func (s *Store) ensureAdmin(ctx context.Context, tenant *auth.Tenant, spec seedSpec, password string) error {
	if _, err := s.Raw().GetUserByUsername(ctx, tenant.ID, spec.Username); err == nil {
		return nil
	} else if !errors.Is(err, auth.ErrNotFound) {
		return err
	}

	if _, err := s.svc.CreateUser(ctx, tenant.ID, auth.CreateUserInput{
		Username:    spec.Username,
		Email:       spec.Email,
		DisplayName: spec.Username,
		Password:    password,
		// 管理员拿的是注册表里的所有者角色：它是 GrantOf(owner) 授予全部能力的那个角色，
		// 因此种子账号刚生成就能登录、能管理，而它到底能做什么由 authz 的授权表说了算，不在这里再抄一份。
		// The administrator holds the registry's owner role: the one GrantOf(owner) grants every capability to, so the
		// seeded account can sign in and administer from the first second, and what it may actually do is decided by the
		// grant table in authz rather than by a second copy of that decision here.
		Roles: []string{authz.RoleOwner},
	}); err != nil {
		return err
	}

	s.log.Info("seeded administrator created with the owner role, change its password in the account page | 已创建种子管理员并授予所有者角色，请在账号页修改口令",
		ydlog.Str("tenant", tenant.Slug),
		ydlog.Str("username", spec.Username),
		ydlog.Str("role", authz.RoleOwner),
	)
	return nil
}

// seedPassword 返回解析好的种子管理员口令；第二个返回值表示种子写入是否被允许。
// seedPassword returns the resolved password of the seeded administrators; the second value reports whether the seed is
// allowed to run at all.
//
// 解析在进程内只发生一次（sync.Once）：它的告警因此每次启动出现一次，而不是每次渲染首登横幅时出现一次。
// Resolution happens once per process (sync.Once), so its warning appears once per start rather than once per render of
// the first-sign-in banner.
//
// 返回值只用于建号：它绝不会被写进日志、页面或错误信息。
// The returned value is used to create the account and for nothing else: it never reaches a log, a page or an error.
func (s *Store) seedPassword() (string, bool) {
	s.seedPwOnce.Do(func() { s.seedPw = s.readSeedPassword() })
	return s.seedPw, s.seedPw != ""
}

// readSeedPassword 读取配置里的种子口令；未配置时按环境决定回退还是拒绝，并把后果说清楚。
// readSeedPassword reads the seed password from the configuration and, when none is configured, decides between the
// development fallback and a refusal while spelling the consequence out.
//
// 环境变量经框架的前缀映射自动生效（YD_SEED_ADMIN_PASSWORD → seed.admin_password），因此这里不读 os.Getenv，
// 优先级也与其他配置项完全一致（命令行 > 环境变量 > 配置文件 > 框架默认值）。
// The environment variable works through the framework's prefix mapping (YD_SEED_ADMIN_PASSWORD → seed.admin_password),
// so nothing is read from os.Getenv and the precedence is the one every other key follows (flags, environment, file,
// framework defaults).
func (s *Store) readSeedPassword() string {
	if pw := configuredSeedPassword(s.cfg); pw != "" {
		return pw
	}

	env := seedEnv(s.cfg)
	if env == meta.EnvDevelopment {
		// 开发环境的回退：刚生成的项目立刻就能登录。代价是这枚口令写在 README 与登录页上，
		// 因此告警必须每次启动都出现，而不是让人以为它默认就是安全的。
		// The development fallback: a freshly generated project can be signed into immediately. The price is that this
		// password is printed in the README and on the sign-in page, which is why the warning appears on every start
		// instead of letting anyone assume it is safe by default.
		s.log.Warn("seed.admin_password is unset, the documented development password is in use: set YD_SEED_ADMIN_PASSWORD before any real deployment | 未配置 seed.admin_password，正在使用文档化的开发口令：任何真实部署之前请先设置 YD_SEED_ADMIN_PASSWORD",
			ydlog.Str("key", meta.SeedPasswordConfigKey),
			ydlog.Str("env", meta.SeedPasswordEnvKey),
			ydlog.Str("app_env", env),
		)
		return meta.DevSeedAdminPassword
	}

	// 非 development：拒绝写入，而且这是刻意的不作为。「更安全一点」的默认口令不存在——
	// 一个创建在真实环境、口令印在文档上的管理员账号，比一个需要手工初始化的空库危险得多。
	// Outside development the seed is refused, and that refusal is deliberate inaction. There is no "a bit safer"
	// default password: an administrator account created in a real environment with a documented password is far more
	// dangerous than a database that has to be initialised by hand.
	s.log.Warn("seed.admin_password is unset outside development, so no default tenant and no administrator are created: set YD_SEED_ADMIN_PASSWORD and restart | 非开发环境未配置 seed.admin_password，因此不会创建默认租户与管理员：请设置 YD_SEED_ADMIN_PASSWORD 后重启",
		ydlog.Str("key", meta.SeedPasswordConfigKey),
		ydlog.Str("env", meta.SeedPasswordEnvKey),
		ydlog.Str("app_env", env),
	)
	return ""
}

// seedEnv 返回运行环境：取自配置键 app.env（YD_APP_ENV 覆盖，框架默认值为 development）。
// seedEnv returns the runtime environment: the configuration key app.env (overridden by YD_APP_ENV, defaulting to
// development in the framework).
//
// 判定走配置而不是 meta.Env：环境名写在配置文件里（app.env: production）时也必须拦住种子写入，
// 而 meta.Env 只看环境变量，漏掉这一种写法就等于在生产里开出一个文档口令的管理员账号。
// The decision reads the configuration rather than meta.Env: an environment name written into the configuration file
// (app.env: production) must stop the seed as well, and meta.Env looks at the environment variable only — missing that
// spelling is exactly how a documented-password administrator account would be created in production.
func seedEnv(c *config.Config) string {
	if c == nil {
		return meta.EnvDevelopment
	}
	env := envx.Normalize(c.GetString(meta.ConfigEnvKey))
	if env == "" {
		return meta.EnvDevelopment
	}
	return env
}

// configuredSeedPassword returns the seed password of the configuration layer, or "" when none is configured.
// | configuredSeedPassword 返回配置层给出的种子口令；未配置时返回空串。
func configuredSeedPassword(c *config.Config) string {
	if c == nil {
		return ""
	}
	return strings.TrimSpace(c.GetString(meta.SeedPasswordConfigKey))
}

// SeedPasswordUnchanged 报告该用户是否仍在使用种子下发的口令。
// SeedPasswordUnchanged reports whether the user still signs in with the password the seed handed out.
//
// 只在登录成功时调用一次：它多做一次 SM3-PBKDF2 校验（约一次口令校验的耗时），换来的是「首次登录必须改密」
// 这一提示既不需要额外的数据库字段，也不会在每次页面渲染时重复计算。
// It is called once per successful sign-in: it costs one extra SM3-PBKDF2 verification (about the price of a password
// check) and buys a "change the password after the first sign-in" hint that needs no extra column and no recomputation
// on every page render.
//
// 种子口令在开发环境可能就是内置的开发口令，此时提示同样成立：那枚口令写在 README 与登录页上，谁都能登进来。
// In development the seeded password may be the built-in one, and the hint is just as true: that password is printed in
// the README and on the sign-in page, so anyone can sign in with it.
//
// 种子写入被拒绝时（非 development 且未配置口令）恒为 false：没有种子口令，也就谈不上「还没改过的种子口令」。
// When the seed was refused (no configured password outside development) this is always false: without a seeded password
// there is no unchanged seeded password either.
func (s *Store) SeedPasswordUnchanged(u *auth.User) bool {
	if u == nil {
		return false
	}
	if cached, ok := s.seedChecks.Load(u.ID); ok {
		if entry, ok := cached.(seedCheck); ok && entry.hash == u.PasswordHash {
			return entry.unchanged
		}
	}
	unchanged := s.verifySeedPassword(u)
	s.seedChecks.Store(u.ID, seedCheck{hash: u.PasswordHash, unchanged: unchanged})
	return unchanged
}

// seedCheck is one cached seed-password result, reused while the hash matches. | seedCheck 是一条种子口令判定缓存：散列相同时复用结果。
type seedCheck struct {
	// hash is the password hash the result was computed from. | hash 是计算该结果时使用的口令散列。
	hash string
	// unchanged reports whether that hash still matches the seed password. | unchanged 报告该散列是否仍匹配种子口令。
	unchanged bool
}

// verifySeedPassword 执行一次真正的 SM3 口令校验；它只由 SeedPasswordUnchanged 的缓存未命中路径调用。
// verifySeedPassword performs the actual SM3 password verification; only the cache-miss path of
// SeedPasswordUnchanged reaches it.
func (s *Store) verifySeedPassword(u *auth.User) bool {
	password, ok := s.seedPassword()
	if !ok {
		return false
	}
	for _, spec := range s.seedSpecs() {
		if spec.Username != u.Username {
			continue
		}
		verified, err := guomi.VerifyPassword(u.PasswordHash, password)
		return err == nil && verified
	}
	return false
}
