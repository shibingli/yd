// Storage sentinels: assembly and seeding failures are both reachable through errors.Is. | 存储层哨兵错误：装配与种子数据失败都能用 errors.Is 判定。
var (
	// ErrOpen reports a failed auth service or token issuer assembly. | ErrOpen 表示鉴权服务或令牌签发器装配失败。
	ErrOpen = errs.New("repository: auth store assembly failed | repository：鉴权存储装配失败")
	// ErrSeed reports a failed default seed write. | ErrSeed 表示默认数据写入失败。
	ErrSeed = errs.New("repository: default seed failed | repository：默认数据写入失败")
)

{{ if ne .DB "none" -}}
// Configuration keys and startup constants: they match the db section of configs/config.yaml, and YD_DB_DSN overrides the
// data source the same way. | 配置键与启动期常量：与 configs/config.yaml 的 db 段一一对应（YD_DB_DSN 同样生效）。
const (
	// configDSN is the data source key; an empty value means "no database". | configDSN 是数据源配置键；为空表示「没有数据库」。
	configDSN = "db.dsn"
	// migrateTimeout bounds the startup migration, so an unreachable database degrades quickly instead of hanging the boot. | migrateTimeout 限制启动期迁移的耗时，使不可达的数据库快速降级而不是把启动挂住。
	migrateTimeout = 30 * time.Second
)
{{- end }}

// errTenantMissing reports a slug that matches no tenant; it roots in auth.ErrNotFound, so callers learn "not found" and
// nothing about whether some other tenant exists. | errTenantMissing 表示按标识找不到租户；它以 auth.ErrNotFound 为根因，
// 因此上层既能看到「没找到」，也拿不到「另一个租户是否存在」的额外信息。
var errTenantMissing = errs.Detail(auth.ErrNotFound, "no tenant matches that slug | 没有与该标识匹配的租户")

// Options configures a Store. | Options 配置 Store。
type Options struct {
	// Config supplies the db section (driver, DSN, pool sizes and the GORM log level) and the seed section
	// (seed.admin_password); an empty value or an empty db.dsn keeps the in-memory implementation, and an unset seed
	// password is resolved by the rules documented on Store.Seed. | Config 提供 db 段（驱动、DSN、连接池上限与 GORM 日志级别）
	// 与 seed 段（seed.admin_password）；为空或 db.dsn 为空时保持内存实现，而种子口令未配置时按 Store.Seed 上的规则处理。
	Config *config.Config
	// Log receives seed, migration and degradation warnings; empty selects ydlog.Default(). | Log 接收种子数据、迁移与降级告警；为空时使用 ydlog.Default()。
	Log *ydlog.Logger
	// Issuer is the token iss claim; empty selects the framework default. | Issuer 是令牌的 iss 声明；为空时取框架默认值。
	Issuer string
	// MasterKey seals every per-user sec_key and is refused below auth.MinMasterKeyLen. | MasterKey 是封装每用户 sec_key 的主密钥，短于 auth.MinMasterKeyLen 会被拒绝。
	MasterKey []byte
	// TTL is the token lifetime; <= 0 selects the framework default. | TTL 是令牌有效期；<= 0 时取框架默认值。
	TTL time.Duration
}

// Store 持有框架的鉴权服务、令牌签发器与持久化实现本身（本类型只做装配，不做业务判断）。
// Store owns the framework auth service, the token issuer and the persistence implementation itself (this type only
// assembles them; it makes no business decision).
type Store struct {
	// raw 是持久化实现本身，只用于 auth.Service 没有暴露的按登录名查找（登录与种子数据的幂等判定都要它）。
	// raw is the persistence implementation itself, used only for the username lookup auth.Service does not expose (both
	// the sign-in path and the idempotence check of the seed need it).
	raw auth.Store
	// svc is the single entry point to tenants, users, roles and the password lifecycle. | svc 是租户、用户、角色与口令生命周期的唯一入口。
	svc *auth.Service
	// issuer signs and verifies tokens with each user's own sec_key. | issuer 用每用户 sec_key 签发与校验令牌。
	issuer *auth.TokenIssuer
	// log records seeding, migration and development-time degradation. | log 记录种子数据、迁移与开发期降级。
	log *ydlog.Logger
	// db 是数据库句柄，由 yd gen 生成的仓储使用；内存降级时为 nil。
	// db is the database handle used by repositories generated by yd gen; nil in the in-memory fallback.
	db any
	// msg 是消息中心的持久化实现；数据库不可用或迁移失败时为 nil，MessageAvailable 报告该状态。
	// msg is the message-centre store; nil when the database is unavailable or its migration failed,
	// which MessageAvailable reports.
	msg messaging.Store
	// msgErr 记录消息中心不可用的原因，供控制器与运维日志读取。
	// msgErr records why the message centre is unavailable, read by the controller and by operations logs.
	msgErr error
	// attach 是通用附件元数据存储；数据库不可用或迁移失败时为 nil，AttachmentAvailable 报告该状态。
	// attach is the generic attachment metadata store; nil when the database is unavailable or its
	// migration failed, which AttachmentAvailable reports.
	attach attachments.Store
	// attachErr records why the attachment store is unavailable. | attachErr 记录附件存储不可用的原因。
	attachErr error
	// dict is the data-dictionary store; nil when the database is unavailable or its migration failed. |
	// dict 是数据字典存储；数据库不可用或迁移失败时为 nil。
	dict dictionary.Store
	// dictErr records why the dictionary store is unavailable. | dictErr 记录数据字典存储不可用的原因。
	dictErr error
	// cfg 是装配时的配置，种子口令从它的 seed 段读取（环境变量经前缀映射已在配置层生效）。
	// cfg is the configuration this store was assembled with, read for the seed password (the environment variable has
	// already taken effect inside the configuration layer).
	cfg *config.Config
	// release closes what the persistence implementation holds (the connection pool); the memory implementation has
	// nothing to release and leaves it empty. | release 关闭持久化实现持有的资源（连接池）；内存实现无需释放，留空即可。
	release func() error
	// seedPw 是解析好的种子口令；为空表示种子写入被拒绝（见 seedPassword）。
	// seedPw is the resolved seed password; empty means the seed was refused (see seedPassword).
	seedPw string
	// seedPwOnce 保证种子口令在一个进程里只解析一次：它的告警因此每次启动出现一次，
	// 而不是每次渲染那条「首登必改口令」横幅时都出现一次。
	// seedPwOnce resolves the seed password once per process, so its warning appears once per start rather than once per
	// render of the first-sign-in banner.
	seedPwOnce sync.Once
	// seedChecks caches whether a user still signs in with the seed password, keyed by user id and paired with
	// the password hash. That check is a salted multi-round SM3 verification, and running it on every render costs
	// the administrator milliseconds per fragment; a changed hash (a password change) invalidates the entry
	// naturally. | seedChecks 缓存「该用户是否仍在使用种子口令」的判定，键为用户 ID，值为口令散列与结果的配对。
	// 口令散列是 SM3 加盐多轮校验，每次渲染都执行会让管理员的每个片段请求多出数毫秒；散列变化（改密）
	// 时缓存自然失效。
	seedChecks sync.Map
	// persistent records whether a database backs this store, for logs and diagnostics. | persistent 记录当前是否由数据库支撑，供日志与诊断使用。
	persistent bool
}

// Open 装配 Store：由配置选出的持久化实现 + 框架鉴权服务 + 令牌签发器。
// Open assembles a Store: the persistence implementation selected from the configuration, the framework auth service and
// the token issuer.
//
// 主密钥为空时 auth.NewService 会生成临时主密钥并输出告警，仅限开发：进程重启后已入库的 sec_key 无法解密。
// With an empty master key, auth.NewService generates a temporary one and warns, which is development-only: stored
// sec_keys become unreadable after a restart.
func Open(o Options) (*Store, error) {
	log := o.Log
	if log == nil {
		log = ydlog.Default()
	}

	// 持久化实现缺失或不可用时 openRaw 自行降级并告警，因此这里的错误只可能来自后续两步。
	// When the persistence implementation is missing or unusable, openRaw degrades by itself and warns, so the errors
	// below can only come from the two assembly steps that follow.
	raw, db, release := openRaw(o, log)
	svc, err := auth.NewService(raw, auth.Options{MasterKey: o.MasterKey})
	if err != nil {
		closeRelease(release)
		return nil, errs.Wrap(err, ErrOpen)
	}

	issuer, err := auth.NewTokenIssuer(svc, auth.TokenOptions{Issuer: o.Issuer, TTL: o.TTL})
	if err != nil {
		closeRelease(release)
		return nil, errs.Wrap(err, ErrOpen)
	}
	attachmentStore, attachmentErr := openAttachmentStore(db, log)
	if attachmentErr != nil {
		log.Warn("attachment storage is unavailable | 附件存储不可用", ydlog.Err(attachmentErr))
	}
	msgStore, msgErr := openMessageStore(db, log)
	if msgErr != nil {
		log.Warn("message centre is unavailable | 消息中心不可用", ydlog.Err(msgErr))
	}
	dictStore, dictErr := openDictionaryStore(db, log)
	if dictErr != nil {
		log.Warn("data dictionary is unavailable | 数据字典不可用", ydlog.Err(dictErr))
	}
	return &Store{
		svc: svc, raw: raw, issuer: issuer, log: log, db: db, cfg: o.Config,
		msg: msgStore, msgErr: msgErr, attach: attachmentStore, attachErr: attachmentErr,
		dict: dictStore, dictErr: dictErr,
		release: release, persistent: release != nil,
	}, nil
}

// MessageStore returns the message-centre persistence, or nil when the centre is unavailable. |
// MessageStore 返回消息中心持久化；不可用时返回 nil。
func (s *Store) MessageStore() messaging.Store { return s.msg }

// MessageError reports why the message centre is unavailable. | MessageError 报告消息中心不可用的原因。
func (s *Store) MessageError() error { return s.msgErr }

// MessageAvailable reports whether the message centre has a usable store. | MessageAvailable 报告消息中心是否有可用存储。
func (s *Store) MessageAvailable() bool { return s.msg != nil }

// DB returns the database handle used by generated repositories, or nil when the project runs on
// the in-memory fallback. | DB 返回生成仓储使用的数据库句柄；项目运行在内存降级实现上时返回 nil。
func (s *Store) DB() any { return s.db }
{{ if ne .DB "none" -}}

// GormDB exposes the underlying *gorm.DB for plugins, or nil on the in-memory fallback.
// | GormDB 暴露底层 *gorm.DB 供插件使用；内存降级时返回 nil。
func (s *Store) GormDB() *gorm.DB {
	if s.db == nil {
		return nil
	}
	db, _ := s.db.(*gorm.DB)
	return db
}

// SetCacheInvalidator attaches a post-commit invalidator to the auth store when the
// backing implementation supports it. The GORM store defers write invalidation
// until after commit, so a concurrent read cannot cache stale auth rows under the
// new table generation. | SetCacheInvalidator 在底层实现支持时把提交后失效器绑定到鉴权
// 存储。GORM 存储把写入失效推迟到提交后，避免并发读把陈旧鉴权行缓存到新表代际下。
func (s *Store) SetCacheInvalidator(inv interface{ Invalidate(context.Context, ...string) error }) {
	setter, ok := s.raw.(interface{ SetInvalidator(gormstore.Invalidator) })
	if !ok {
		return
	}
	setter.SetInvalidator(inv)
}

// SetMessageCacheInvalidator attaches the post-commit invalidator to the message
// store when it supports it. Message writes use explicit transactions too, so they
// follow the same deferred-invalidation pattern. | SetMessageCacheInvalidator 在消息存储
// 支持时绑定提交后失效器。消息写入同样使用显式事务，因此遵循相同的延迟失效模式。
func (s *Store) SetMessageCacheInvalidator(inv interface{ Invalidate(context.Context, ...string) error }) {
	setter, ok := s.msg.(interface{ SetInvalidator(messaginggorm.Invalidator) })
	if !ok {
		return
	}
	setter.SetInvalidator(inv)
}
{{- end }}

{{ if ne .DB "none" -}}
// openAttachmentStore migrates the generic attachment tables, copies any legacy message attachments,
// drops the old table after the copy and opens the metadata store on the shared pool. |
// openAttachmentStore 迁移通用附件表、复制旧消息附件、复制完成后删除旧表，并在共享连接池上打开元数据存储。
func openAttachmentStore(db any, log *ydlog.Logger) (attachments.Store, error) {
	if db == nil {
		return nil, errs.Detail(attachments.ErrUnavailable, "no database | 没有数据库")
	}
	gdb, ok := db.(*gorm.DB)
	if !ok {
		return nil, errs.Detail(attachments.ErrUnavailable, "unexpected database handle | 非预期的数据库句柄")
	}
	ctx, cancel := context.WithTimeout(context.Background(), migrateTimeout)
	defer cancel()
	if err := attachmentsgorm.Migrate(ctx, gdb); err != nil {
		return nil, errs.Wrap(err, attachments.ErrUnavailable)
	}
	copied, err := attachmentsgorm.MigrateLegacy(ctx, gdb)
	if err != nil {
		return nil, errs.Wrap(err, attachments.ErrUnavailable)
	}
	if copied > 0 {
		log.Info("legacy message attachments migrated | 旧消息附件已迁移", ydlog.Int("count", copied))
	}
	if dropped, dropErr := attachmentsgorm.DropLegacy(ctx, gdb); dropErr != nil {
		// The copy already succeeded; a failed drop must not disable attachments. It stays visible
		// so an operator can remove the now-unused table manually. | 复制已经成功；删除失败不得禁用附件，
		// 但必须留下告警，供运维手工删除这张不再使用的表。
		log.Warn("legacy message attachment table could not be dropped | 旧消息附件表删除失败", ydlog.Err(dropErr))
	} else if dropped {
		log.Info("legacy message attachment table dropped | 旧消息附件表已删除")
	}
	store, err := attachmentsgorm.New(gdb)
	if err != nil {
		return nil, errs.Wrap(err, attachments.ErrUnavailable)
	}
	log.Info("attachment tables are ready | 附件数据表已就绪",
		ydlog.Strs("tables", []string{"yd_attachments", "yd_attachment_refs"}),
	)
	return store, nil
}
{{ else -}}
// openAttachmentStore reports the attachment store as unavailable in a project generated without a
// database. | openAttachmentStore 在未选择数据库的生成项目里报告附件存储不可用。
func openAttachmentStore(_ any, _ *ydlog.Logger) (attachments.Store, error) {
	return nil, errs.Detail(attachments.ErrUnavailable, "the project was generated without a database | 项目生成时未选择数据库")
}
