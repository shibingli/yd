/* {{ .Name }} 前端胶水层：只把 htmx 的生命周期事件翻译成页面状态，不引入任何框架。 | {{ .Name }} front-end glue: it only translates htmx lifecycle events into page state and pulls in no framework. */
(function () {
  "use strict";

  /* 全局命名空间：业务脚本一律挂在这里，避免污染 window。 | Global namespace: business scripts hang off it to keep window clean. */
  var yd = window.yd || {};
  window.yd = yd;

  /* 就绪标记：未完成初始化前为 false，模板与测试据此判断胶水层是否已加载。 | Ready flag: false until initialisation completes, which is how templates and tests tell that the glue has loaded. */
  yd.ready = false;

  /* 与模板共享的选择器与事件名，写在一处避免两侧漂移。 | Selectors and event names shared with the templates, kept in one place so the two sides cannot drift apart. */
  var SELECTORS = {
    /* 工作区：htmx 的导航与局部刷新都换入这里。 | Workspace: htmx navigations and partial refreshes swap into it. */
    workspace: "#yd-workspace",
    /* 通知容器：服务端事件与本地提示都追加到这里。 | Notice container: server events and local notices are appended here. */
    flash: "#yd-flash",
    /* 连接状态条：掉线时显示，恢复后隐藏。 | Connection banner: shown on a drop and hidden once reconnected. */
    connection: "#yd-connection",
    /* 连接状态标签：右侧的状态徽标。 | Connection badge: the state pill on the right. */
    badge: "[data-yd-connection-state]",
    /* 可关闭容器：错误片段与提示条都位于其中之一里。 | Dismissable container: both the error fragment and the notices sit inside one. */
    dismissable: "[data-yd-dismissable], [data-yd-errors-outlet]",
    /* 抽屉与确认对话框：两者都由 layouts/shell.html 渲染一次，脚本只负责开合。 | Drawer and confirmation dialog: both are rendered once by layouts/shell.html and the script only opens and closes them. */
    drawer: "#yd-drawer",
    drawerBody: "#yd-drawer-body",
    confirm: "#yd-confirm",
    confirmText: "[data-yd-confirm-text]"
  };

  /* 服务端事件名：与控制器的 meta.ToastEvent 一致。 | Server event names: they match meta.ToastEvent in the controller. */
  var EVENTS = {
    /* toast 由 HX-Trigger 下发，detail 形如 {level, text}。 | toast arrives through HX-Trigger with a detail shaped like {level, text}. */
    toast: "yd:toast",
    /* tick 与每帧推送同行，供只想计数而不想换内容的区域使用。 | tick travels with every pushed frame for regions that count instead of swapping. */
    tick: "yd:tick"
  };

  /* state 保存跨片段存活的状态：连接是长连接，而承载它的元素会随导航被替换，因此状态不能只存在 DOM 上。
     state holds the state that outlives a fragment: a connection is long-lived while the element carrying it is
     replaced on navigation, so the state cannot live in the DOM alone. */
  var state = {
    /* open 为真表示所有实时通道当前都是连着的。 | open is true while every realtime channel is connected. */
    open: false,
    /* hadDrop 记录是否发生过掉线，用于在恢复时只提示一次。 | hadDrop records whether a drop happened so recovery is announced once. */
    hadDrop: false,
    /* noticeTimer 是恢复提示的自动消失定时器，导航或页面隐藏时清空。 | noticeTimer auto-dismisses the recovery notice and is cleared on navigation or pagehide. */
    noticeTimer: null,
    /* noticeItem 是当前恢复提示节点，导航时必须一并移除。 | noticeItem is the current recovery notice and must be removed on navigation too. */
    noticeItem: null
  };

  /* bodyLabel reads one localized label the layout rendered onto <body>: the copy stays in the catalogue and the
     script only reads it, so a language switch needs no second dictionary here.
     bodyLabel 读取布局渲染在 <body> 上的本地化文案：文案留在语言目录里，脚本只读取，因此切换语言不需要在这里再放一份词典。 */
  function bodyLabel(name, fallback) {
    var value = document.body ? document.body.getAttribute(name) : "";
    return value || fallback || "";
  }

  /* appendNotice 追加一条通知；容器不存在时静默返回，绝不因为缺少装饰性元素而抛错。 | appendNotice appends one notice and returns quietly when the container is missing, so a decorative element can never break the page. */
  function appendNotice(text, level) {
    var flash = document.querySelector(SELECTORS.flash);
    if (!flash || !text) {
      return null;
    }

    /* 提示条插入到连接状态条之前：状态条始终位于列表末尾，视觉位置因此不会跳动。
       Notices are inserted before the connection banner, which always stays last so nothing shifts around visually. */
    var banner = document.getElementById("yd-connection");
    var item = document.createElement("div");
    item.className = "yd-flash__item" + (level ? " yd-flash__item--" + level : "");
    item.setAttribute("role", "status");

    var label = document.createElement("span");
    label.className = "yd-flash__text";
    /* textContent 而不是 innerHTML：服务端文案也可能包含尖括号，绝不能当标记解析。
       textContent rather than innerHTML: server copy may contain angle brackets and must never be parsed as markup. */
    label.textContent = text;
    item.appendChild(label);

    var close = document.createElement("button");
    close.type = "button";
    close.className = "yd-btn yd-btn--ghost yd-btn--sm";
    close.setAttribute("data-yd-dismiss", "");
    close.textContent = bodyLabel("data-yd-close", "Close");
    item.appendChild(close);

    flash.insertBefore(item, banner || null);
    return item;
  }

  /* 实时连接管理器：聚合 SSE 与 WebSocket 两条通道，只维护一个横幅。
     The realtime manager aggregates the SSE and WebSocket channels behind a single banner. */
  var RECOVERY_NOTICE_TIMEOUT = 3000;

  /* realtimeElements 返回当前页面所有承载实时流的元素；元素随导航被替换，状态因此随连接结束。
     realtimeElements returns every element that owns a stream; elements are replaced on navigation, so their
     state ends with the connection. */
  function realtimeElements() {
    return Array.prototype.slice.call(
      document.querySelectorAll("[hx-sse\\:connect], [hx-ws\\:connect]")
    );
  }

  /* realtimeChannel 把单通道状态挂在元素上，避免用 DOM 属性污染模板。 | realtimeChannel keeps per-channel
     state on the element instead of polluting the markup with extra attributes. */
  function realtimeChannel(element) {
    if (!element.__ydRealtime) {
      element.__ydRealtime = {
        kind: element.getAttribute("hx-sse:connect") !== null ? "sse" : "ws",
        state: "connecting",
        attempt: 0,
        wasDown: false,
        lastEventId: ""
      };
    }
    return element.__ydRealtime;
  }

  function realtimeOffline() {
    return !!(window.navigator && window.navigator.onLine === false);
  }

  /* setConnection 只画状态徽标；横幅由下方独立生命周期管理，两条通道不会产生两个横幅。
     setConnection paints the status badge only; the banner has its own lifecycle below so two channels cannot
     produce two banners. */
  function setConnection(status) {
    state.open = status === "open";
    var labels = {
      open: "data-yd-connected",
      connecting: "data-yd-connecting",
      closed: "data-yd-disconnected",
      idle: "data-yd-idle"
    };
    var badges = document.querySelectorAll(SELECTORS.badge);
    for (var i = 0; i < badges.length; i++) {
      badges[i].setAttribute("data-yd-connection-state", status);
      badges[i].textContent = bodyLabel(labels[status] || labels.idle, status);
    }
  }

  function connectionBanner() {
    return document.querySelector(SELECTORS.connection);
  }

  function hideConnectionBanner() {
    var banner = connectionBanner();
    if (banner) {
      banner.hidden = true;
    }
    var attempt = document.querySelector("[data-yd-connection-attempt]");
    if (attempt) {
      attempt.hidden = true;
      attempt.textContent = "";
    }
  }

  /* showConnectionBanner 就地更新唯一横幅；重试次数单独成节点，句子本身仍来自语言目录。
     showConnectionBanner updates the single banner in place; the attempt count is a separate node while the
     sentence stays in the catalogue. */
  function showConnectionBanner(status, attempt) {
    var banner = connectionBanner();
    if (!banner) {
      return;
    }
    banner.hidden = false;
    var text = banner.querySelector("[data-yd-connection-text]") || banner.querySelector(".yd-flash__text");
    if (text) {
      var key = status === "offline"
        ? "data-yd-offline"
        : (status === "closed" ? "data-yd-failed" : "data-yd-reconnecting");
      text.textContent = bodyLabel(key, text.textContent);
    }
    var badge = banner.querySelector("[data-yd-connection-attempt]");
    if (badge) {
      var numbered = attempt > 0 && status !== "offline" && status !== "closed";
      badge.hidden = !numbered;
      badge.textContent = numbered ? "#" + attempt : "";
    }
  }

  function clearConnectionNotice() {
    if (state.noticeTimer) {
      window.clearTimeout(state.noticeTimer);
      state.noticeTimer = null;
    }
    /* 同时移除节点才能覆盖导航场景：提示容器在外壳里，否则会在没有实时元素的页面上留下过期的「已恢复」。
       Removing the node as well matters on navigation: the flash container lives in the shell and would otherwise
       keep a stale "restored" notice on a page with no realtime elements. */
    if (state.noticeItem && state.noticeItem.parentNode) {
      state.noticeItem.parentNode.removeChild(state.noticeItem);
    }
    state.noticeItem = null;
  }

  function showRecoveredNotice() {
    var item = appendNotice(bodyLabel("data-yd-recovered", "Connection restored"), "success");
    if (!item) {
      return;
    }
    clearConnectionNotice();
    state.noticeItem = item;
    state.noticeTimer = window.setTimeout(function () {
      state.noticeTimer = null;
      state.noticeItem = null;
      if (item.parentNode) {
        item.parentNode.removeChild(item);
      }
    }, RECOVERY_NOTICE_TIMEOUT);
  }

  /* refreshConnection 聚合所有仍在文档中的通道。从未掉线的通道在首次握手期间保持横幅隐藏，
     快速首连因此不会闪一下警告；没有实时元素的页面完全重置管理器。
     refreshConnection aggregates every channel still in the document. A channel that never dropped keeps the
     banner hidden during the initial handshake, so a fast first connection never flashes a warning; a page
     without realtime elements resets the manager entirely. */
  function refreshConnection() {
    var elements = realtimeElements();
    var open = 0;
    var down = 0;
    var failed = 0;
    var attempt = 0;

    for (var i = 0; i < elements.length; i++) {
      var channel = realtimeChannel(elements[i]);
      if (channel.state === "open") {
        open++;
        continue;
      }
      down++;
      if (channel.state === "failed") {
        failed++;
      }
      if (channel.attempt > attempt) {
        attempt = channel.attempt;
      }
    }

    if (elements.length === 0) {
      setConnection("idle");
      hideConnectionBanner();
      state.hadDrop = false;
      clearConnectionNotice();
      return;
    }

    /* 浏览器报告离线时即使套接字看起来仍开着也显示离线；传输层可能还没察觉。 | A browser that reports
       itself offline shows that state even while the sockets look open; the transport may not have noticed yet. */
    if (realtimeOffline()) {
      /* 离线本身就是一次掉线；恢复时据此只提示一次。 | Being offline is itself a drop; this is what makes the
         online transition announce recovery exactly once. */
      state.hadDrop = true;
      clearConnectionNotice();
      setConnection("connecting");
      showConnectionBanner("offline", 0);
      return;
    }

    if (open === elements.length) {
      setConnection("open");
      hideConnectionBanner();
      if (state.hadDrop) {
        state.hadDrop = false;
        showRecoveredNotice();
      }
      return;
    }

    var status = failed > 0 ? "closed" : "connecting";
    setConnection(status);
    if (state.hadDrop || failed > 0 || attempt > 0) {
      showConnectionBanner(status, attempt);
    } else {
      hideConnectionBanner();
    }
  }

  /* resyncRealtime 执行声明式恢复请求：元素可以指定通道恢复后要重取的片段；默认目标不是承载
     数据流的元素本身，交换它会再次拆掉连接。 | resyncRealtime performs the declarative recovery fetch: an
     element may name a fragment to reload once its channel resumes. The default target is not the element
     that owns the stream, because swapping it would tear the connection down again. */
  function resyncRealtime(element) {
    var url = element.getAttribute("data-yd-resync");
    if (!url || !window.htmx || typeof window.htmx.ajax !== "function") {
      return false;
    }
    var target = element.getAttribute("data-yd-resync-target") || "#yd-workspace";
    var swap = element.getAttribute("data-yd-resync-swap") || "innerMorph";
    try {
      window.htmx.ajax("GET", url, { source: element, target: target, swap: swap });
      return true;
    } catch (error) {
      return false;
    }
  }

  function announceRecovered(element, channel, detail) {
    if (typeof window.CustomEvent !== "function" || typeof element.dispatchEvent !== "function") {
      return;
    }
    var connection = (detail && detail.connection) || {};
    element.dispatchEvent(new window.CustomEvent("yd:realtime:recovered", {
      bubbles: true,
      detail: {
        channel: channel.kind,
        element: element,
        attempt: connection.attempt || 0,
        lastEventId: connection.lastEventId || channel.lastEventId || "",
        resynced: resyncRealtime(element)
      }
    }));
  }

  function markChannelOpen(element, detail) {
    var channel = realtimeChannel(element);
    var connection = (detail && detail.connection) || {};
    var resumed = channel.wasDown;
    channel.state = "open";
    channel.attempt = 0;
    channel.lastEventId = connection.lastEventId || channel.lastEventId || "";
    if (resumed) {
      channel.wasDown = false;
      announceRecovered(element, channel, detail);
    }
    refreshConnection();
  }

  function markChannelDown(element, status, detail) {
    if (!element || element.nodeType !== 1 || !element.isConnected) {
      return;
    }
    var channel = realtimeChannel(element);
    var connection = (detail && detail.connection) || {};
    channel.state = status;
    channel.wasDown = true;
    state.hadDrop = true;
    /* 新的掉线立即作废「已恢复」提示。 | A newer drop invalidates the "restored" notice immediately. */
    clearConnectionNotice();
    if (connection.attempt > channel.attempt) {
      channel.attempt = connection.attempt;
    }
    refreshConnection();
  }

  function realtimeEventTarget(event) {
    var target = event && event.target;
    return target && target.nodeType === 1 ? target : null;
  }

  function realtimeEventDetail(event) {
    return (event && event.detail) || {};
  }

  function onSSEBefore(event) {
    var element = realtimeEventTarget(event);
    if (!element) {
      return;
    }
    var detail = realtimeEventDetail(event);
    var channel = realtimeChannel(element);
    channel.state = "connecting";
    channel.attempt = (detail.connection && detail.connection.attempt) || 0;
    if (channel.attempt > 0) {
      channel.wasDown = true;
      state.hadDrop = true;
    }
    refreshConnection();
  }

  function onSSEAfter(event) {
    var element = realtimeEventTarget(event);
    if (element) {
      markChannelOpen(element, realtimeEventDetail(event));
    }
  }

  function onSSEClose(event) {
    var element = realtimeEventTarget(event);
    if (!element) {
      return;
    }
    var detail = realtimeEventDetail(event);
    var reason = detail.reason || "";
    if (reason === "removed" || reason === "cleanup" || reason === "cancelled" || reason === "message" || !element.isConnected) {
      delete element.__ydRealtime;
      refreshConnection();
      return;
    }
    /* 服务端结束流会由扩展转成下一次尝试，因此保持「重连中」而不是报永久失败。
       The extension turns a server-side end into another attempt, so stay in reconnecting rather than
       reporting a permanent failure. */
    markChannelDown(element, "connecting", detail);
  }

  function onSSEError(event) {
    var element = realtimeEventTarget(event);
    if (!element) {
      return;
    }
    var detail = realtimeEventDetail(event);
    var status = detail.status || 0;
    /* 没有连接对象的错误是首次请求失败：扩展在该路径上没有重试循环，因此应报「重连已停止」而不是「重连中」。
       An error without a connection object is the initial request failing: the extension has no retry loop for that
       path, so the honest state is "reconnection stopped", not "retrying". */
    var terminal = !detail.connection || status === 401 || status === 403 || status === 404;
    if (terminal && detail.connection && detail.connection.config) {
      /* 否则扩展会对终止性状态码无限重试。 | The extension would otherwise keep retrying a terminal status forever. */
      detail.connection.config.reconnect = false;
    }
    markChannelDown(element, terminal ? "failed" : "connecting", detail);
  }

  function onWSBefore(event) {
    var element = realtimeEventTarget(event);
    if (!element) {
      return;
    }
    var detail = realtimeEventDetail(event);
    var channel = realtimeChannel(element);
    channel.state = "connecting";
    channel.attempt = (detail.connection && detail.connection.attempt) || 0;
    if (channel.attempt > 0) {
      channel.wasDown = true;
      state.hadDrop = true;
    }
    refreshConnection();
  }

  function onWSAfter(event) {
    var element = realtimeEventTarget(event);
    if (element) {
      markChannelOpen(element, realtimeEventDetail(event));
    }
  }

  function onWSClose(event) {
    var element = realtimeEventTarget(event);
    if (!element) {
      return;
    }
    var detail = realtimeEventDetail(event);
    var reason = detail.reason || "";
    if (reason === "removed" || reason === "cancelled" || !element.isConnected) {
      delete element.__ydRealtime;
      refreshConnection();
      return;
    }
    var code = detail.code;
    var retryable = code === null || code === undefined || [1001, 1005, 1006, 1011, 1012, 1013, 1014].indexOf(code) >= 0;
    if (!retryable && detail.connection && detail.connection.config) {
      detail.connection.config.reconnect = false;
    }
    markChannelDown(element, retryable ? "connecting" : "failed", detail);
  }

  /* 发送失败时套接字可能仍然开着，这不能报成断开。 | A failed send may leave the socket open, which must not
     be reported as a disconnect. */
  function onWebSocketError(event) {
    var detail = realtimeEventDetail(event);
    var connection = detail.connection || null;
    if (connection && connection.socket && connection.socket.readyState === 1) {
      return;
    }
    var element = realtimeEventTarget(event);
    if (element) {
      markChannelDown(element, "connecting", detail);
    }
  }

  /* retryRealtime 让扩展立刻重连，而不是等下一次退避；连接对象不存在时重载页面是唯一安全的重连方式。
     retryRealtime makes the extension reconnect now instead of waiting for the next backoff; when no connection
     object exists, a reload is the only safe recovery. */
  function retryRealtime() {
    var retried = false;
    var failed = false;
    var known = realtimeElements();
    for (var k = 0; k < known.length; k++) {
      if (known[k].__ydRealtime && known[k].__ydRealtime.state === "failed") {
        failed = true;
      }
    }
    var elements = document.querySelectorAll("[hx-sse\\:connect]");
    for (var i = 0; i < elements.length; i++) {
      var connection = elements[i]._htmx && elements[i]._htmx.sse;
      if (!connection) {
        continue;
      }
      retried = true;
      if (typeof connection.delayCanceller === "function") {
        connection.delayCanceller();
      }
      if (connection.abortController && typeof connection.abortController.abort === "function") {
        connection.abortController.abort();
      }
    }

    elements = document.querySelectorAll("[hx-ws\\:connect]");
    for (var j = 0; j < elements.length; j++) {
      var ws = elements[j]._htmx && elements[j]._htmx.ws && elements[j]._htmx.ws.connection;
      if (!ws || !ws.socket) {
        continue;
      }
      retried = true;
      try {
        /* 不传状态码：浏览器在这里只允许 1000 与 3000-4999，而无状态码的关闭会以 1005 上报，
           扩展正是据此重连。 | No status code: browsers only allow 1000 and 3000-4999 here, and a bare
           close surfaces as 1005, which the extension reconnects on. */
        ws.socket.close();
      } catch (error) {
        /* a socket already leaving has nothing left to retry | 已在关闭的套接字无需再重试 */
      }
    }

    if (!retried || failed) {
      window.location.reload();
      return;
    }
    state.hadDrop = true;
    refreshConnection();
  }

  function onRealtimeOnline() {
    var elements = realtimeElements();
    if (!elements.length) {
      return;
    }
    var down = false;
    for (var i = 0; i < elements.length; i++) {
      if (realtimeChannel(elements[i]).state !== "open") {
        down = true;
      }
    }
    if (!down) {
      refreshConnection();
      return;
    }
    state.hadDrop = true;
    retryRealtime();
    refreshConnection();
  }

  function onRealtimeOffline() {
    if (!realtimeElements().length) {
      return;
    }
    state.hadDrop = true;
    clearConnectionNotice();
    refreshConnection();
  }

  /* pruneRealtime 清掉已被交换移除的元素状态，再重绘聚合结果。 | pruneRealtime drops state for elements a swap
     removed, then repaints the aggregate. */
  function pruneRealtime() {
    var elements = realtimeElements();
    var replaced = false;
    for (var i = 0; i < elements.length; i++) {
      if (!elements[i].__ydRealtime) {
        replaced = true;
      }
      if (!elements[i].isConnected && elements[i].__ydRealtime) {
        delete elements[i].__ydRealtime;
      }
    }
    /* 交换后的新流元素属于新页面；旧页面的掉线不得在新页面上产生恢复提示。 | New stream elements after a swap
       belong to a new page; a drop on the old page must not produce a recovery notice on the new one. */
    if (replaced) {
      state.hadDrop = false;
    }
    refreshConnection();
  }

  /* dismiss 清空最近的可关闭容器：错误片段与提示条共用同一条退场路径。 | dismiss empties the nearest dismissable container so the error fragment and the notices share one exit path. */
  function dismiss(element) {
    var box = element && element.closest ? element.closest(SELECTORS.dismissable) : null;
    if (box) {
      box.innerHTML = "";
      return true;
    }
    return false;
  }

  /* 抽屉：点「新建/编辑」时立即打开，htmx 随后把片段换进 #yd-drawer-body。
     Drawer: opening happens on the click and htmx swaps the fragment into #yd-drawer-body afterwards. */
  function openDrawer() {
    var drawer = document.querySelector(SELECTORS.drawer);
    if (!drawer || typeof drawer.showModal !== "function" || drawer.open) {
      return;
    }
    drawer.showModal();
  }

  /* closeDrawer 关闭抽屉；未打开时是空操作。 | closeDrawer closes the drawer and is a no-op while it is closed. */
  function closeDrawer() {
    var drawer = document.querySelector(SELECTORS.drawer);
    if (drawer && drawer.open && typeof drawer.close === "function") {
      drawer.close();
    }
  }

  /* askConfirm 打开全局确认对话框，只有点「确认」才执行回调；文案来自模板的 tr，脚本里没有一句业务文案。
     askConfirm opens the global confirmation dialog and runs the callback only on "confirm"; the copy comes from
     the template's tr, so the script holds no business sentence. */
  function askConfirm(message, onConfirm) {
    var dialog = document.querySelector(SELECTORS.confirm);
    if (!dialog || typeof dialog.showModal !== "function") {
      /* 不支持 dialog 的浏览器退化为原生确认框：宁可多一次阻断，也不能跳过确认。 | Browsers without dialog fall back to the native prompt: an extra stop is better than skipping the confirmation. */
      if (window.confirm(message || "")) {
        onConfirm();
      }
      return;
    }
    var text = dialog.querySelector(SELECTORS.confirmText);
    if (text) {
      text.textContent = message || "";
    }
    function onClose() {
      dialog.removeEventListener("close", onClose);
      if (dialog.returnValue === "confirm") {
        onConfirm();
      }
    }
    dialog.returnValue = "";
    dialog.addEventListener("close", onClose);
    dialog.showModal();
  }

  /* 列表操作菜单：details 提供无脚本开合；打开后把面板改为 fixed 定位，避开表格容器的 overflow 裁切。
     List action menus: details provides the no-script toggle; once open the panel is lifted into fixed
     positioning so the table wrapper's overflow clipping cannot cut it off. */
  function closeMenus(except) {
    var menus = document.querySelectorAll("details[data-yd-menu][open]");
    for (var i = 0; i < menus.length; i++) {
      if (menus[i] !== except) {
        menus[i].open = false;
      }
    }
  }

  function positionMenu(menu) {
    var summary = menu.querySelector("summary");
    var panel = menu.querySelector(".yd-menu__panel");
    if (!summary || !panel) {
      return;
    }
    var rect = summary.getBoundingClientRect();
    panel.style.position = "fixed";
    panel.style.top = (rect.bottom + 4) + "px";
    /* The stylesheet anchors the panel with right:0; fixed positioning needs one horizontal side
       only, otherwise left+right stretch it across the viewport. | 样式表用 right:0 锚定面板；
       fixed 定位只能保留一个水平边，否则 left+right 会把它拉满整个视口。 */
    panel.style.right = "auto";
    panel.style.left = Math.max(8, rect.right - panel.offsetWidth) + "px";
  }

  document.addEventListener("toggle", function (event) {
    var menu = event.target;
    if (!menu || !menu.matches || !menu.matches("details[data-yd-menu]") || !menu.open) {
      return;
    }
    closeMenus(menu);
    positionMenu(menu);
  }, true);

  document.addEventListener("click", function (event) {
    if (event.target && event.target.closest && !event.target.closest("[data-yd-menu]")) {
      closeMenus(null);
    }
  }, true);

  window.addEventListener("resize", function () { closeMenus(null); });
  /* Reposition on scroll rather than closing: a scroll caused by the click itself (the row was just
     brought into view) must not close the menu the click had opened. | 滚动时重新定位而不是关闭：
     点击本身引发的滚动（刚把该行带入视口）不能关掉这次点击打开的面板。 */
  window.addEventListener("scroll", function () {
    var open = document.querySelector("details[data-yd-menu][open]");
    if (open) {
      positionMenu(open);
    }
  }, true);

  /* 回车发送 WebSocket 消息：htmx 的触发器过滤器（keyup[key=='Enter']）用 new Function 编译，
     会被 CSP 的 script-src 'self' 拦截；这里用普通监听器点击同一个发送按钮，发送路径与点击完全一致。
     Enter sends a WebSocket message: htmx trigger filters (keyup[key=='Enter']) compile with
     new Function, which CSP script-src 'self' blocks, so a plain listener clicks the same send
     button and takes the exact same send path. */
  document.addEventListener("keydown", function (event) {
    if (event.key !== "Enter" || event.isComposing || event.defaultPrevented) {
      return;
    }
    var input = event.target;
    if (!input || !input.closest || !input.closest("[data-yd-ws-enter]")) {
      return;
    }
    var composer = input.closest("[data-yd-ws-composer]");
    var send = composer && composer.querySelector("[hx-ws\\:send]");
    if (!send) {
      return;
    }
    event.preventDefault();
    send.click();
  });

  /* 事件委托：提示条是运行期生成的，逐个绑定会在每次换入后失效。 | Event delegation: notices are created at runtime, so per-element listeners would go stale after every swap. */
  document.addEventListener("click", function (event) {
    var target = event.target;
    if (!target || !target.closest) {
      return;
    }

    /* 抽屉入口：不阻止默认行为，htmx 的 hx-get 继续把片段取进 #yd-drawer-body。 | Drawer entry: the default is not prevented, so htmx's hx-get still fetches the fragment into #yd-drawer-body. */
    if (target.closest("[data-yd-drawer-open]")) {
      openDrawer();
      return;
    }

    if (target.closest("[data-yd-drawer-close]")) {
      event.preventDefault();
      closeDrawer();
      return;
    }

    /* 点击抽屉遮罩（dialog 自身）关闭它。 | Clicking the drawer backdrop (the dialog itself) closes it. */
    var drawer = target.closest(SELECTORS.drawer);
    if (drawer && target === drawer) {
      closeDrawer();
      return;
    }

    var dismisser = target.closest("[data-yd-dismiss]");
    if (dismisser && dismiss(dismisser)) {
      event.preventDefault();
      return;
    }

    /* 主题按钮：只切 <html data-theme>，页面一处都不重建。 | The theme button only flips <html data-theme> and rebuilds nothing. */
    if (target.closest("[data-yd-theme-toggle]")) {
      event.preventDefault();
      cycleTheme();
      return;
    }

    /* 语言链接：记下选择后直接放行——htmx 会把 ?lang= 请求的结果换进工作区，
       而没有 htmx 时同一个 href 就是一次普通导航，两条路径共用一份标记。
       A language link: the choice is recorded and the event is let through — htmx swaps the result of the ?lang=
       request into the workspace while the very same href is an ordinary navigation without htmx, so one set of markup
       serves both paths. */
    /* 单一语言按钮：记下目标语言后放行，htmx 或普通 href 都会重取整块外壳。
       The single language toggle: remember the target language and let the click through; htmx or the plain href
       refetches the whole shell either way. */
    var langToggle = target.closest("[data-yd-lang-toggle]");
    if (langToggle) {
      rememberLang(langToggle.getAttribute("data-yd-lang-next"));
      return;
    }
    var langLink = target.closest("[data-yd-lang]");
    if (langLink) {
      rememberLang(langLink.getAttribute("data-yd-lang"));
      return;
    }

    /* 重试按钮立即让扩展重连；只有连接对象已不存在时才退回整页重载。 | The retry button makes the extension
       reconnect immediately and falls back to a full reload only when no connection object is left. */
    if (target.closest("[data-yd-reconnect]")) {
      event.preventDefault();
      retryRealtime();
      return;
    }
  });

  /* 全局确认：表单提交与普通点击都必须在捕获阶段先过这一关，否则 htmx 会在冒泡阶段直接发出请求。
     Global confirmation: both form submissions and plain clicks pass through this capture-phase gate first,
     otherwise htmx would send the request during the bubble phase. */
  document.addEventListener("submit", function (event) {
    var form = event.target && event.target.closest ? event.target.closest("form[data-yd-confirm]") : null;
    if (!form || form.getAttribute("data-yd-confirmed") === "1") {
      return;
    }
    event.preventDefault();
    event.stopImmediatePropagation();
    /* requestSubmit 不带提交者时会丢掉提交按钮的 name/value（例如租户菜单里每个条目各带一个 tenant 值），
       因此先把 event.submitter 记下来并原样传回去。 | requestSubmit without a submitter drops the clicked
       button's name/value (the tenant menu carries one tenant per entry), so remember event.submitter and pass
       it back unchanged. */
    var submitter = event.submitter || null;
    askConfirm(form.getAttribute("data-yd-confirm"), function () {
      form.setAttribute("data-yd-confirmed", "1");
      try {
        if (submitter) {
          form.requestSubmit(submitter);
        } else {
          form.requestSubmit();
        }
      } finally {
        form.removeAttribute("data-yd-confirmed");
      }
    });
  }, true);

  document.addEventListener("click", function (event) {
    var el = event.target && event.target.closest ? event.target.closest("[data-yd-confirm]") : null;
    if (!el || el.tagName === "FORM" || el.getAttribute("data-yd-confirmed") === "1") {
      return;
    }
    event.preventDefault();
    event.stopImmediatePropagation();
    askConfirm(el.getAttribute("data-yd-confirm"), function () {
      el.setAttribute("data-yd-confirmed", "1");
      try {
        el.click();
      } finally {
        el.removeAttribute("data-yd-confirmed");
      }
    });
  }, true);

  /* 抽屉里的写操作成功即关闭抽屉：验证失败（4xx）保持打开，用户可以在原处修正。
     A successful write inside the drawer closes it; a validation failure (4xx) keeps it open so the user can
     correct the input in place. */
  /* htmx 4 names its lifecycle events with colons (htmx:after:request); the legacy spelling is kept
     as a fallback so the drawer still closes on an older core. | htmx 4 的生命周期事件用冒号命名
     （htmx:after:request）；同时保留旧拼写作为回退，使抽屉在较旧的 core 上也会关闭。 */
  ["htmx:after:request", "htmx:afterRequest"].forEach(function (name) {
    document.addEventListener(name, function (event) {
      var detail = event.detail || {};
      /* htmx 4 carries the request state in detail.ctx: sourceElement is the form and status is
         the response code. The legacy shape (detail.elt + detail.xhr) stays as a fallback. */
      /* htmx 4 把请求状态放在 detail.ctx 里：sourceElement 是发起请求的表单，status 是响应码；
         旧形态（detail.elt + detail.xhr）作为回退保留。 */
      var ctx = detail.ctx || {};
      var status = typeof ctx.status === "number" ? ctx.status : (ctx.response && ctx.response.status);
      if (typeof status !== "number") {
        status = detail.xhr && detail.xhr.status;
      }
      var elt = ctx.sourceElement || detail.elt || (detail.requestConfig && detail.requestConfig.elt);
      if (typeof status !== "number" || status < 200 || status >= 300 || !elt || !elt.closest) {
        return;
      }
      if (elt.closest(SELECTORS.drawerBody)) {
        closeDrawer();
      }
    });
  });

  /* 服务端提示：HX-Trigger 的 detail 直接就是事件负载，控制器不需要拼装任何提示 HTML。 | Server notices: the HX-Trigger detail is the payload itself, so controllers assemble no notice markup. */
  document.addEventListener(EVENTS.toast, function (event) {
    var detail = event.detail || {};
    appendNotice(detail.text, detail.level);
  });

  /* 连接生命周期：两条通道共用同一个聚合管理器与同一个横幅。 | Connection lifecycle: both channels share one
     aggregate manager and one banner. */
  document.addEventListener("htmx:sse:before:connection", onSSEBefore);
  document.addEventListener("htmx:sse:after:connection", onSSEAfter);
  document.addEventListener("htmx:sse:close", onSSEClose);
  document.addEventListener("htmx:sse:error", onSSEError);
  document.addEventListener("htmx:ws:before:connection", onWSBefore);
  document.addEventListener("htmx:ws:after:connection", onWSAfter);
  document.addEventListener("htmx:ws:close", onWSClose);
  document.addEventListener("htmx:ws:error", onWebSocketError);
  window.addEventListener("online", onRealtimeOnline);
  window.addEventListener("offline", onRealtimeOffline);
  /* 定时器与半开通道不得比文档活得更久。 | Timers and half-open channels must not outlive the document. */
  window.addEventListener("pagehide", clearConnectionNotice);

  /* 网络层失败与状态码失败是两件事：前者在这里提示，后者由表单的 hx-status 声明式处理。 | A transport failure and a status-code failure are two different things: the former is reported here while the latter is handled declaratively by the form's hx-status. */
  document.addEventListener("htmx:send:error", function () {
    appendNotice(bodyLabel("data-yd-network-error", "Network error, please retry"), "error");
  });

  /* 换入新内容后把状态徽标恢复成追踪到的连接状态：新片段只带 idle 初值，直接照它显示会让在线用户看到「已断开」。
     After new content is swapped in the badge is brought back in line with the tracked connection state: a fresh
     fragment only carries the idle default and showing that verbatim would tell a connected user they are offline. */
  document.addEventListener("htmx:after:swap", pruneRealtime);

  /* 抽屉式侧栏：64rem 以下由顶栏按钮打开，遮罩、Esc 与导航点击关闭。
     Off-canvas rail: opened by the topbar button below 64rem, closed by the scrim, Escape or a nav click. */
  function rail() {
    return document.querySelector("[data-yd-sidebar]");
  }

  function setRailOpen(open) {
    var aside = rail();
    if (aside) {
      aside.classList.toggle("is-open", !!open);
    }
    var backdrop = document.querySelector("[data-yd-sidebar-backdrop]");
    if (backdrop) {
      backdrop.classList.toggle("is-open", !!open);
    }
    var buttons = document.querySelectorAll("[data-yd-sidebar-open]");
    for (var i = 0; i < buttons.length; i++) {
      buttons[i].setAttribute("aria-expanded", open ? "true" : "false");
    }
    document.body.classList.toggle("yd-sidebar-open", !!open);
  }

  document.addEventListener("click", function (event) {
    var target = event.target;
    if (!target || !target.closest) {
      return;
    }
    if (target.closest("[data-yd-sidebar-open]")) {
      event.preventDefault();
      var aside = rail();
      setRailOpen(!(aside && aside.classList.contains("is-open")));
      return;
    }
    if (target.closest("[data-yd-sidebar-backdrop]")) {
      event.preventDefault();
      setRailOpen(false);
      return;
    }
    if (target.closest("[data-yd-sidebar] a")) {
      setRailOpen(false);
    }
  });

  document.addEventListener("keydown", function (event) {
    if (event.key === "Escape") {
      setRailOpen(false);
    }
  });

  window.addEventListener("resize", function () {
    if (window.matchMedia && window.matchMedia("(min-width: 64rem)").matches) {
      setRailOpen(false);
    }
  });

  /* 只有替换外壳的交换才需要收起侧栏：指标轮询只交换 #yd-workspace 内的节点，
     每次轮询都关一次会让用户刚打开的抽屉莫名其妙地消失。
     Only a swap that replaces the shell closes the rail: metrics polling swaps a node inside
     #yd-workspace, and closing on every poll would make a drawer the user just opened vanish. */
  function swapReplacedRail(root) {
    var aside = rail();
    if (!aside || !root || root.nodeType !== 1) {
      return true;
    }
    return root.contains(aside);
  }

  ["htmx:after:swap", "htmx:afterSwap"].forEach(function (name) {
    document.addEventListener(name, function (event) {
      var detail = (event && event.detail) || {};
      var ctx = detail.ctx || {};
      var target = ctx.target || detail.target || null;
      if (swapReplacedRail(target)) {
        setRailOpen(false);
      }
    });
  });

  /* 主题与语言：两者都是纯客户端选择，因此各自有一处存放，谁也不去打扰服务端。
     Theme and language: both are purely client-side choices, so each has exactly one place to live and neither bothers
     the server. */

  /* 三态主题的存储键与顺序（顺序即按钮循环的顺序）。 | The storage key and the order of the three theme states, which is the order the button cycles through. */
  var THEME_KEY = "yd_theme";
  var THEMES = ["light", "dark", "auto"];

  /* 语言 cookie 与 i18n 中间件的默认来源同名：不写这个 cookie，切换只对带查询参数的那一次请求有效。 */
  /* The language cookie carries the very name the i18n middleware reads by default: without it a switch would only last
     for the one request carrying the query parameter. */
  var LANG_COOKIE = "yd_lang";
  var LANG_MAX_AGE = 31536000;

  /* readTheme 读回用户上次的选择；localStorage 在隐私窗口里可能直接抛错，因此每次都夹一层 try。 | readTheme reads the user's last choice; localStorage may throw outright in a private window, so every access is wrapped. */
  function readTheme() {
    try {
      var value = window.localStorage.getItem(THEME_KEY);
      return THEMES.indexOf(value) >= 0 ? value : null;
    } catch (error) {
      return null;
    }
  }

  /* rememberTheme 同时写 localStorage 与 cookie：前者供本页循环，后者让服务端下次能预渲染首屏。
     rememberTheme writes both localStorage and the cookie: the former drives the cycle on this page, the latter
     lets the server pre-render the next page's first paint. */
  function rememberTheme(theme) {
    try {
      window.localStorage.setItem(THEME_KEY, theme);
    } catch (error) {
      /* 写不进去也不影响本次会话：状态已经落在 DOM 上了。 | A failed write does not affect this session: the state already sits in the DOM. */
    }
    try {
      document.cookie = THEME_KEY + "=" + encodeURIComponent(theme) + ";path=/;max-age=" + LANG_MAX_AGE + ";samesite=lax";
    } catch (error) {
      /* cookie 被禁用时只保留 localStorage。 | When cookies are disabled, localStorage alone remains. */
    }
  }

  /* applyTheme 只改 <html> 上的一个属性：三个标签谁可见由 app.css 决定，脚本里没有一句文案。 | applyTheme writes one attribute on <html> and nothing else: app.css decides which of the three labels shows, so the script holds no copy. */
  function applyTheme(theme) {
    document.documentElement.setAttribute("data-theme", theme);
  }

  /* cycleTheme 按固定顺序循环并记住结果，返回新状态供调用方使用。 | cycleTheme cycles in a fixed order and remembers the result, returning the new state to its caller. */
  function cycleTheme() {
    var current = document.documentElement.getAttribute("data-theme") || THEMES[0];
    var index = THEMES.indexOf(current);
    var next = THEMES[(index + 1) % THEMES.length];
    applyTheme(next);
    rememberTheme(next);
    return next;
  }

  /* rememberLang 把语言写进 cookie，后续的表单 POST 因此不需要任何额外参数。 | rememberLang writes the language into a cookie so that later form posts need no extra parameter. */
  function rememberLang(lang) {
    if (!lang) {
      return;
    }
    /* 语言切换只换 #yd-shell，不会重写 <html>；必须同步根元素的 lang，否则 CSS 状态标签与
       辅助技术仍停在旧语言。 | The switch swaps only #yd-shell and never rewrites <html>; sync the root lang
       or the CSS state labels and assistive technology stay in the old language. */
    if (document.documentElement) {
      document.documentElement.setAttribute("lang", lang);
    }
    document.cookie = LANG_COOKIE + "=" + encodeURIComponent(lang) + ";path=/;max-age=" + LANG_MAX_AGE + ";samesite=lax";
  }

  /* 首屏就应用已存的主题：defer 脚本在解析结束后、首次绘制之前运行，因此不会有可见的闪烁。 */
  /* The stored theme is applied at first paint: a deferred script runs after parsing and before the first paint, so no
     flash is visible. */
  applyTheme(readTheme() || "auto");

  /* 国密装配：加密由 yd-guomi-htmx 以声明式属性接管，这里只负责安装一次。 | Guomi assembly: encryption is taken over by yd-guomi-htmx through declarative attributes, so this only installs it once. */
  if (window.ydGuomiHtmx && typeof window.ydGuomiHtmx.install === "function") {
    window.ydGuomiHtmx.install();
  }

  /* 兜底再处理一次整页：htmx 的初始化是一个 setTimeout，可能早于扩展脚本注册（deferred 脚本之间允许定时器插入），
     那样首屏的 sse/ws 元素就永远拿不到连接。process 对已处理的元素是幂等的，重复调用不会建立第二条连接。
     Process the page once more as a safety net: htmx initializes from a timer that can run before the extension
     scripts register (timers may fire between deferred scripts), leaving the first-paint sse/ws elements without a
     connection. process is idempotent for processed elements, so a repeat call never opens a second connection. */
  if (window.htmx && typeof window.htmx.process === "function") {
    window.htmx.process(document.body);
  }

  /* 首屏重绘一次聚合状态：状态徽标显示连接中，横幅保持隐藏直到真的掉线。 | Repaint the aggregate once at first
     paint: the badge shows connecting while the banner stays hidden until a real drop. */
  refreshConnection();

  yd.ready = true;
})();
