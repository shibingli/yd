/* {{ .Name }} 样式入口：所有页面样式都从这里出发，禁止在 HTML 中写内联样式表。 | {{ .Name }} style entry: every page style starts here; inline style sheets in HTML are forbidden. */
{{- if .Tailwind }}
/* Tailwind v4 由 Go 脚手架静默编译（无 Node.js 管道），产物写入 {{ .AssetRoot }}/static/css/yd.css。 | Tailwind v4 is compiled silently by the Go toolchain (no Node.js pipeline) into {{ .AssetRoot }}/static/css/yd.css. */
@import "tailwindcss";

/* 框架管理端组件层：yd new 从框架资产逐字节复制而来，提供 .yd-shell、.yd-table 等全部组件；
   项目可以按需修改它，但修改后请同步更新项目的视觉基线。 | Framework admin component layer: copied verbatim from
   the framework assets by yd new; it provides every component (.yd-shell, .yd-table and friends) and may be adapted
   per project once the visual baseline is updated with it. */
@import "./components.css";

/* 扫描范围：模板与 Go 源码中的类名都会被裁剪保留。 | Scan scope: class names found in templates and Go sources are kept by the purger. */
@source "../../templates/**/*.html";
@source "../../../internal/**/*.go";

/* 语义化主题变量（蓝色系主色调）：页面只引用语义名，不写颜色字面量。 | Semantic theme variables (blue brand scale): pages reference semantic names, never raw colour literals. */
@theme {
  /* 品牌色阶 | brand scale */
  --color-brand-50: #eff6ff;
  --color-brand-100: #dbeafe;
  --color-brand-200: #bfdbfe;
  --color-brand-500: #3b82f6;
  --color-brand-600: #1d4ed8;
  --color-brand-700: #1e40af;

  /* 语义色 | semantic colours */
  --color-surface: #ffffff;
  --color-content: #0f172a;
  --color-content-muted: #64748b;
  --color-border-subtle: #e2e8f0;
}

/* 首屏骨架屏：片段到达前占位，避免白屏。 | First-paint skeleton: it holds the place until the fragment arrives and avoids a blank screen. */
.yd-skeleton {
  min-height: 4rem;
  border-radius: 0.5rem;
  background-image: linear-gradient(90deg, var(--color-border-subtle) 25%, var(--color-surface) 50%, var(--color-border-subtle) 75%);
  background-size: 200% 100%;
}

/* htmx 指示器默认隐藏，请求进行中显示。 | htmx indicators stay hidden and appear while a request is in flight. */
.htmx-indicator {
  opacity: 0;
  transition: opacity 150ms ease-in;
}

.htmx-request .htmx-indicator,
.htmx-request.htmx-indicator {
  opacity: 1;
}
{{- else }}
/* 未启用 Tailwind：保留最小基础样式，语义变量名与 Tailwind 模式保持一致，便于后续切换。 | Tailwind is disabled: a minimal base sheet keeps the semantic variable names identical to the Tailwind mode so switching later stays cheap. */
:root {
  /* 品牌色阶 | brand scale */
  --color-brand-50: #eff6ff;
  --color-brand-600: #1d4ed8;

  /* 语义色 | semantic colours */
  --color-surface: #ffffff;
  --color-content: #0f172a;
  --color-content-muted: #64748b;
  --color-border-subtle: #e2e8f0;
}

body {
  margin: 0;
  background: var(--color-surface);
  color: var(--color-content);
  font-family: system-ui, -apple-system, "Segoe UI", "Noto Sans SC", sans-serif;
}

.yd-skeleton {
  min-height: 4rem;
  border-radius: 0.5rem;
  background: var(--color-border-subtle);
}

.htmx-indicator {
  opacity: 0;
}

.htmx-request .htmx-indicator,
.htmx-request.htmx-indicator {
  opacity: 1;
}
{{- end }}

/* ============================================================================================
   主题：三态（浅色 / 深色 / 跟随系统）由 <html data-theme> 上的一个属性承载，页面结构完全不变。
   Theme: the three states (light, dark, system) ride on a single attribute on <html data-theme> and the page structure
   never changes with them.

   深色只重写语义变量，因此所有引用语义名的规则（含 Tailwind 编译出的 bg-surface、text-content）一起跟随；
   写死色值的地方会在这里暴露出来——那正是它们该被修掉的时候。
   Dark mode only redefines the semantic variables, so every rule that references a semantic name — Tailwind's compiled
   bg-surface and text-content included — follows along; a hard-coded colour shows up right here, which is exactly when
   it should be fixed.
   ============================================================================================ */
/* 语义色补充：危险色在两种主题下各有一个取值，因此页面里不出现任何色值字面量。 */
/* Additional semantic colours: the danger colour has one value per theme, which keeps every colour literal out of the
   pages. */
:root {
  --color-danger: #dc2626;
}

:root[data-theme="dark"] {
  --color-brand-50: #172554;
  --color-brand-100: #1e3a8a;
  --color-brand-200: #1e40af;
  --color-brand-500: #3b82f6;
  --color-brand-600: #2563eb;
  --color-brand-700: #60a5fa;

  --color-danger: #f87171;

  --color-surface: #0b1120;
  --color-content: #e2e8f0;
  --color-content-muted: #94a3b8;
  --color-border-subtle: #1e293b;
}

/* 跟随系统：同一个变量表，但只在系统偏好为深色时生效，且不能覆盖用户手选的 light/dark。 */
/* System: the same variable table, applied only while the operating system prefers dark, and never overriding an
   explicit light or dark choice. */
@media (prefers-color-scheme: dark) {
  :root[data-theme="auto"] {
    --color-brand-50: #172554;
    --color-brand-100: #1e3a8a;
    --color-brand-200: #1e40af;
    --color-brand-500: #3b82f6;
    --color-brand-600: #2563eb;
    --color-brand-700: #60a5fa;

    --color-danger: #f87171;

    --color-surface: #0b1120;
    --color-content: #e2e8f0;
    --color-content-muted: #94a3b8;
    --color-border-subtle: #1e293b;
  }
}

/* 主题按钮上的三个标签：哪一个是可见的完全由 <html data-theme> 决定，脚本因此不需要知道任何一句文案。 */
/* The three labels on the theme button: which one is visible is decided entirely by <html data-theme>, so the script
   never has to know a single sentence of copy. */
.yd-theme__state {
  display: none;
}

:root[data-theme="light"] [data-yd-theme-state="light"],
:root[data-theme="dark"] [data-yd-theme-state="dark"],
:root[data-theme="auto"] [data-yd-theme-state="auto"] {
  display: inline;
}

/* ============================================================================================
   本项目补充的语义组件：只写语义名与变量，不写色值字面量（与 yd.css 的约定一致）。
   Semantic components added by this project: semantic names and variables only, never colour literals (the same contract
   as yd.css).
   ============================================================================================ */
/* 语言切换 | language switch */
.yd-switch {
  display: inline-flex;
  gap: 0.25rem;
  align-items: center;
}

.yd-switch__item {
  padding: 0.125rem 0.5rem;
  border-radius: 9999px;
  color: var(--color-content-muted);
  text-decoration: none;
  font-size: 0.8125rem;
}

.yd-switch__item--on {
  background: var(--color-brand-600);
  color: var(--color-surface);
}

/* 身份区 | identity block */
.yd-user {
  display: inline-flex;
  gap: 0.375rem;
  align-items: center;
}

.yd-user__name {
  font-weight: 600;
}

/* 横幅：首登提示与登录失败共用同一条带 | banners: the first-sign-in notice and a failed sign-in share one strip */
.yd-banner {
  display: flex;
  gap: 0.75rem;
  align-items: center;
  justify-content: space-between;
  padding: 0.625rem 0.875rem;
  margin: 0 0 0.75rem;
  border: 1px solid var(--color-border-subtle);
  border-radius: 0.5rem;
}

.yd-banner--warn {
  border-color: var(--color-brand-500);
}

.yd-banner--error {
  border-color: var(--color-danger);
}

.yd-banner__text {
  font-size: 0.875rem;
}

/* 登录页：整页只有一张卡片，因此不需要栅格 | sign-in page: one card is all there is, so no grid is involved */
.yd-page--centered {
  display: flex;
  justify-content: center;
}

.yd-login-card {
  width: 100%;
  max-width: 26rem;
}

/* 定义列表：身份、账号页与登录页的信息对 | definition lists: the key/value pairs of the identity, account and sign-in pages */
.yd-meta {
  display: grid;
  grid-template-columns: max-content 1fr;
  gap: 0.375rem 0.75rem;
  margin: 0.75rem 0;
}

.yd-meta__key {
  color: var(--color-content-muted);
  font-size: 0.8125rem;
}

.yd-meta__value {
  margin: 0;
}

/* 角色卡片 | role cards */
.yd-cards {
  display: grid;
  gap: 0.75rem;
  grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
}

.yd-role__permissions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.25rem;
}

/* 勾选项：角色与权限都用它，因此标签、说明与输入框的相对位置只定义一次 */
/* Check rows: roles and capabilities both use them, so the relative position of label, hint and input is defined once */
.yd-check {
  display: flex;
  gap: 0.5rem;
  align-items: baseline;
  padding: 0.125rem 0;
}

.yd-check__label {
  font-weight: 500;
}

.yd-divider {
  border: 0;
  border-top: 1px solid var(--color-border-subtle);
  margin: 0.75rem 0;
}

/* 表单字段：标签在输入框上方，提示在下方 | form fields: the label sits above the input and the hint below it */
.yd-form__field {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  margin-bottom: 0.5rem;
}

.yd-form__label {
  font-size: 0.8125rem;
  font-weight: 600;
}

.yd-form__fieldset {
  border: 1px solid var(--color-border-subtle);
  border-radius: 0.5rem;
  padding: 0.5rem 0.75rem;
  margin: 0.5rem 0;
}

/* ============================================================================================
   本项目的页面组件：只写语义名与变量，不写色值字面量。
   Page components of this project: semantic names and variables only, never colour literals.
   ============================================================================================ */

/* 角色卡片：权限列表展开时仍保持较宽的下限。 | Role cards: a wider floor keeps a card readable while its permissions expand. */
.yd-cards--roles {
  grid-template-columns: repeat(auto-fill, minmax(22rem, 1fr));
}

/* 勾选项：复选框与文字基线对齐，且不参与拉伸。 | Check row: the checkbox aligns with the text baseline and never stretches. */
.yd-check__input {
  flex: 0 0 auto;
  width: 1rem;
  height: 1rem;
  margin-top: 0.125rem;
  accent-color: var(--color-brand-600);
}

/* 服务器时钟：数字等宽，刷新时不会左右跳动。 | Server clock: tabular digits keep the value from shifting as it refreshes. */
.yd-clock {
  display: flex;
  align-items: baseline;
  gap: 0.5rem;
  font-variant-numeric: tabular-nums;
}

/* 可折叠表单分组。 | Collapsible form group. */
.yd-details {
  margin-top: 0.75rem;
  border: 1px solid var(--color-border-subtle);
  border-radius: 0.5rem;
  background: var(--color-surface-muted);
}

.yd-details__summary {
  padding: 0.5rem 0.75rem;
  cursor: pointer;
  color: var(--color-content);
  font-size: 0.8125rem;
  font-weight: 600;
}

/* 全局错误槽位：空槽不占空间，有内容时才画出一块错误区域。 | Global error slot: it takes no space while empty and only draws an error area once it has content. */
.yd-errors {
  margin: 0 1rem;
}

.yd-errors:empty {
  display: none;
}

.yd-errors__body {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  padding: 0.75rem 0.875rem;
  border: 1px solid color-mix(in oklab, var(--color-danger) 35%, transparent);
  border-radius: 0.5rem;
  background: color-mix(in oklab, var(--color-danger) 10%, transparent);
  color: var(--color-content);
}

.yd-errors__title {
  margin: 0;
  color: var(--color-danger);
  font-weight: 600;
}

.yd-errors__list {
  margin: 0;
  padding-left: 1.25rem;
  font-size: 0.875rem;
}

.yd-errors__item {
  line-height: 1.5;
}

/* 页脚：与工作区同宽，只作为版本与模块信息的落款。 | Footer: aligned with the workspace and used only for the version and module sign-off. */
.yd-footer {
  padding: 0 1.5rem 1.5rem;
  color: var(--color-content-muted);
  font-size: 0.75rem;
}

/* 登录表单：在登录卡片内部占满宽度，字段之间保持统一间距。 | Sign-in form: fill the card and keep one rhythm between fields. */
.yd-form--login {
  width: 100%;
}

/* 三列栅格：窄屏沿用基础栅格，宽屏才真正并排三列。 | Three-column grid: narrow screens keep the base grid and only wide ones go to three columns. */
@media (min-width: 64rem) {
  .yd-grid--3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

/* 列表：去掉浏览器默认项目符号，并给每项一条分隔线。 | List: drop the browser bullets and separate items with a rule. */
.yd-list {
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
  margin: 0.75rem 0;
  padding: 0;
  list-style: none;
}

.yd-list--ordered {
  counter-reset: yd-list;
}

.yd-list--ordered .yd-list__item {
  counter-increment: yd-list;
}

.yd-list--ordered .yd-list__item::before {
  content: counter(yd-list) ".";
  color: var(--color-content-muted);
  font-variant-numeric: tabular-nums;
}

.yd-list__item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.25rem 0;
  border-bottom: 1px solid var(--color-border-subtle);
  font-size: 0.875rem;
}

.yd-list__item:last-child {
  border-bottom: 0;
}

.yd-list__primary {
  font-weight: 600;
}

/* 角色卡片：权限徽标在卡片内部换行，不改变卡片自身的布局。 | Role card: the permission badges wrap inside the card without changing its layout. */
.yd-role {
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
}

/* 计数数值：等宽数字，并靠向列表右侧。 | Counter value: tabular digits pushed to the right of the row. */
.yd-stat {
  margin-left: auto;
  font-variant-numeric: tabular-nums;
  font-weight: 700;
}

/* WebSocket 日志：在通用消息流上再加一层等宽与换行约束。 | WebSocket log: the shared message stream with monospace and wrapping constraints. */
.yd-stream--log {
  max-height: 22rem;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}

/* 次要单元格：时间戳等元信息使用弱化色。 | Secondary cell: metadata such as timestamps uses the muted colour. */
.yd-table__td--muted {
  color: var(--color-content-muted);
  font-size: 0.8125rem;
}

/* 顶栏：左侧标题块可收缩，右侧操作区靠右。 | Topbar: the title block shrinks and the actions sit on the right. */
.yd-topbar__left {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.yd-topbar__right {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-left: auto;
}

.yd-topbar__title {
  margin: 0;
  font-weight: 600;
  line-height: 1.25rem;
}

.yd-topbar__subtitle {
  margin: 0;
  overflow: hidden;
  color: var(--color-content-muted);
  font-size: 0.75rem;
  line-height: 1rem;
  text-overflow: ellipsis;
  white-space: nowrap;
}

