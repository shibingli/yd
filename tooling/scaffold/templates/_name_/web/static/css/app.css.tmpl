/* {{ .Name }} 样式入口：所有页面样式都从这里出发，禁止在 HTML 中写内联样式表。 | {{ .Name }} style entry: every page style starts here; inline style sheets in HTML are forbidden. */
{{- if .Tailwind }}
/* Tailwind v4 由 Go 脚手架静默编译（无 Node.js 管道），产物写入 {{ .AssetRoot }}/static/css/yd.css。 | Tailwind v4 is compiled silently by the Go toolchain (no Node.js pipeline) into {{ .AssetRoot }}/static/css/yd.css. */
@import "tailwindcss" source(none);
/* 关闭自动源探测：下面的 @source 是唯一扫描范围，项目依赖与图标数据不会污染产物。
   Disable automatic source detection: the @source lines below are the only scan roots, so project
   dependencies and icon data cannot pollute the generated stylesheet. */

/* 框架管理端组件层：yd new 从框架资产逐字节复制而来，提供 .yd-shell、.yd-table 等全部组件；
   项目可以按需修改它，但修改后请同步更新项目的视觉基线。 | Framework admin component layer: copied verbatim from
   the framework assets by yd new; it provides every component (.yd-shell, .yd-table and friends) and may be adapted
   per project once the visual baseline is updated with it. */
@import "./components.css";

/* 扫描范围：模板与 Go 源码中的类名都会被裁剪保留。 | Scan scope: class names found in templates and Go sources are kept by the purger. */
@source "../../templates/**/*.html";
@source "../../../internal/**/*.go";
/* 脚本也会在运行期添加类名（例如编辑器的 yd-editor--dark、侧栏的 yd-sidebar-open）；
   不扫描脚本，Tailwind 会把这些只在 JS 里出现的类裁掉。 | Scripts also add class names at runtime
   (the editor's yd-editor--dark, the rail's yd-sidebar-open); without scanning them Tailwind would drop
   every class that only appears in JavaScript. */
@source "../../static/js/yd-*.js";

/* 语义化主题变量（蓝色系主色调）：页面只引用语义名，不写颜色字面量。 | Semantic theme variables (blue brand scale): pages reference semantic names, never raw colour literals. */
@theme {
  /* 品牌色阶 | brand scale */
  --color-brand-50: #eff6ff;
  --color-brand-100: #dbeafe;
  --color-brand-200: #bfdbfe;
  --color-brand-500: #3b82f6;
  --color-brand-600: #1d4ed8;
  --color-brand-700: #1e40af;

  /* 语义色 | semantic colours */
  --color-surface: #ffffff;
  --color-content: #0f172a;
  --color-content-muted: #64748b;
  --color-border-subtle: #e2e8f0;
}

@layer components {

/* 首屏骨架屏：片段到达前占位，避免白屏。 | First-paint skeleton: it holds the place until the fragment arrives and avoids a blank screen. */
.yd-skeleton {
  min-height: 4rem;
  border-radius: 0.5rem;
  background-image: linear-gradient(90deg, var(--color-border-subtle) 25%, var(--color-surface) 50%, var(--color-border-subtle) 75%);
  background-size: 200% 100%;
}

/* htmx 指示器默认隐藏，请求进行中显示。 | htmx indicators stay hidden and appear while a request is in flight. */
.htmx-indicator {
  opacity: 0;
  transition: opacity 150ms ease-in;
}

.htmx-request .htmx-indicator,
.htmx-request.htmx-indicator {
  opacity: 1;
}

} /* @layer components（首屏与指示器） | first paint and indicators */
{{- else }}
/* 未启用 Tailwind：保留最小基础样式，语义变量名与 Tailwind 模式保持一致，便于后续切换。 | Tailwind is disabled: a minimal base sheet keeps the semantic variable names identical to the Tailwind mode so switching later stays cheap. */
:root {
  /* 品牌色阶 | brand scale */
  --color-brand-50: #eff6ff;
  --color-brand-600: #1d4ed8;

  /* 语义色 | semantic colours */
  --color-surface: #ffffff;
  --color-content: #0f172a;
  --color-content-muted: #64748b;
  --color-border-subtle: #e2e8f0;
}

body {
  margin: 0;
  background: var(--color-surface);
  color: var(--color-content);
  font-family: system-ui, -apple-system, "Segoe UI", "Noto Sans SC", sans-serif;
}

.yd-skeleton {
  min-height: 4rem;
  border-radius: 0.5rem;
  background: var(--color-border-subtle);
}

.htmx-indicator {
  opacity: 0;
}

.htmx-request .htmx-indicator,
.htmx-request.htmx-indicator {
  opacity: 1;
}
{{- end }}

/* ============================================================================================
   主题：三态（浅色 / 深色 / 跟随系统）由 <html data-theme> 上的一个属性承载，页面结构完全不变。
   Theme: the three states (light, dark, system) ride on a single attribute on <html data-theme> and the page structure
   never changes with them.

   深色只重写语义变量，因此所有引用语义名的规则（含 Tailwind 编译出的 bg-surface、text-content）一起跟随；
   写死色值的地方会在这里暴露出来——那正是它们该被修掉的时候。
   Dark mode only redefines the semantic variables, so every rule that references a semantic name — Tailwind's compiled
   bg-surface and text-content included — follows along; a hard-coded colour shows up right here, which is exactly when
   it should be fixed.
   ============================================================================================ */
/* 语义色补充：危险色在两种主题下各有一个取值，因此页面里不出现任何色值字面量。 */
/* Additional semantic colours: the danger colour has one value per theme, which keeps every colour literal out of the
   pages. */
:root {
  --color-danger: #dc2626;
}

:root[data-theme="dark"] {
  --color-brand-50: #172554;
  --color-brand-100: #1e3a8a;
  --color-brand-200: #1e40af;
  --color-brand-500: #3b82f6;
  --color-brand-600: #2563eb;
  --color-brand-700: #60a5fa;

  --color-danger: #f87171;

  --color-surface: #0b1120;
  --color-content: #e2e8f0;
  --color-content-muted: #94a3b8;
  --color-border-subtle: #1e293b;
}

/* 跟随系统：同一个变量表，但只在系统偏好为深色时生效，且不能覆盖用户手选的 light/dark。 */
/* System: the same variable table, applied only while the operating system prefers dark, and never overriding an
   explicit light or dark choice. */
@media (prefers-color-scheme: dark) {
  :root[data-theme="auto"] {
    --color-brand-50: #172554;
    --color-brand-100: #1e3a8a;
    --color-brand-200: #1e40af;
    --color-brand-500: #3b82f6;
    --color-brand-600: #2563eb;
    --color-brand-700: #60a5fa;

    --color-danger: #f87171;
    --color-success: #4ade80;
    --color-warning: #fbbf24;
    --color-info: #38bdf8;
    --color-accent: #60a5fa;

    --color-surface: #0b1120;
    --color-surface-muted: #111c2f;
    --color-content: #e2e8f0;
    --color-content-muted: #94a3b8;
    --color-border-subtle: #1e293b;
  }
}

/* 项目组件（登录卡片、身份信息、角色卡等）定义在 components.css 的组件层里：它随框架兜底样式一起分发，
   因此尚未运行 Tailwind 的新项目也有完整样式。这里只保留主题令牌与本项目的覆盖规则。
   Project components (sign-in card, identity blocks, role cards and friends) live in the component layer of
   components.css: they ship with the framework fallback stylesheet, so a fresh project has complete styling before
   Tailwind ever runs. This file keeps the theme tokens and project-specific overrides only. */
