// Package web 把本项目的前端资产（模板、样式、脚本与语言目录）内嵌进二进制，并提供给 app 门面。
// Package web embeds this project's front-end assets (templates, styles, scripts and message catalogues) into the
// binary and hands them to the app facade.
//
// Directory contract (matching assetRoot in .yd.json): | 目录契约（与 .yd.json 的 assetRoot 一致）：
//
//	the html/template tree, rendered at runtime (its actions run per request and survive generation untouched) | templates/  html/template 模板树，运行时渲染（模板动作在请求期执行，生成期原样保留）
//	static assets served under /static | static/     静态资源，经 /static 提供
//	message catalogues, one file per language (zh-CN.yaml, en.yaml) | i18n/       i18n 文案目录，每语言一个文件（zh-CN.yaml、en.yaml）
//
// How the two asset sources merge: | 两类资产合并策略：
//   - project assets (this package's embedded copy, or the on-disk copy in development) always win; | 项目资产（本包内嵌副本 / 开发期磁盘副本）始终优先；
//   - framework assets ({{ .YdModule }}/web) fill the gaps: vendored scripts, the compiled yd.css and the guomi/i18n scripts. | 框架资产（{{ .YdModule }}/web）兜底提供 vendor 脚本、编译好的 yd.css 与国密/i18n 脚本。
//
// 框架的 templates/ 子树刻意不参与合并：它属于框架自带示例布局，与本项目的模板树混在一起会污染模板集。
// The framework's templates/ subtree is deliberately left out of the merge: it belongs to the framework's own sample
// layout, and mixing it into this project's tree would pollute the template set.
//
// 全部资产路径都是 "/" 分隔且满足 fs.ValidPath，因此在 Windows 与 Linux 上行为一致。
// Every asset path is "/"-separated and satisfies fs.ValidPath, so behaviour is identical on Windows and Linux.
package web

import (
	"bytes"
	"crypto/sha256"
	"embed"
	"encoding/hex"
	"os"
	"path/filepath"
	"strconv"
	"strings"
	"sync"

	"github.com/spf13/afero"

	"{{ .Module }}/internal/meta"
	"{{ .YdxModule }}/afs"
	frameworkweb "{{ .YdModule }}/web"
)

// Asset subtree names and the development directory name. | 资产子树与开发期目录名。
const (
	// templatesDir is the template subtree. | templatesDir 是模板子树。
	templatesDir = "templates"
	// staticDir is the static asset subtree. | staticDir 是静态资源子树。
	staticDir = "static"
	// i18nDir is the message catalogue subtree. | i18nDir 是语言目录子树。
	i18nDir = meta.I18nDir
)

// embedded 承载本项目的全部前端资产；all: 前缀确保下划线/点号开头的文件同样被打包。
// embedded carries every front-end asset of this project; the all: prefix keeps dot- and underscore-prefixed files in.
//
//go:embed all:templates all:static all:i18n
var embedded embed.FS

// Assets 返回交给 app.WithFS 的资产文件系统，templates/、static/ 与 i18n/ 位于其根下。
// Assets returns the asset filesystem handed to app.WithFS, with templates/, static/ and i18n/ at its root.
//
// 开发期（app.env 非 production）以磁盘上的资产目录覆盖内嵌副本：静态资源即时生效，模板由 `yd dev`
// 在文件变化时重启进程后生效，渲染器因此可以缓存模板树而不必每个请求重新编译；生产期直接使用内嵌副本，
// 二进制可脱离源码树运行（scratch 镜像里没有 web/ 目录）。
// In development (app.env is not production) the on-disk asset directory shadows the embedded copy: static assets
// apply immediately, while templates apply after `yd dev` restarts the process on a file change, which lets the
// renderer cache the template tree instead of recompiling it on every request. In production the embedded copy is
// used, letting the binary run without its source tree (a scratch image ships no web/ directory).
func Assets() afs.FS {
	if !meta.IsDevelopment() {
		return afs.NewEmbed(embedded)
	}
	root, ok := developmentRoot()
	if !ok {
		// No on-disk assets: fall back to the embedded copy instead of failing to boot. | 找不到磁盘资产：退回内嵌副本，绝不因为开发期布局差异而启动失败。
		return afs.NewEmbed(embedded)
	}
	return afs.Overlay(afs.NewEmbed(embedded), afs.NewOS(root))
}

// Static 返回 /static 的合并文件系统：本项目 static/ 覆盖框架 static/，再由开发期磁盘副本覆盖两者。
// Static returns the merged filesystem served under /static: this project's static/ shadows the framework's, and the
// on-disk copy shadows both during development.
//
// 框架子树缺失说明框架资产布局被改动，属于装配错误，调用方应拒绝启动而不是发出 404 的空页面。
// A missing framework subtree means the framework asset layout changed: that is an assembly error, so the caller
// should refuse to start rather than serve empty 404 pages.
func Static() (afs.FS, error) {
	framework, err := frameworkStatic()
	if err != nil {
		return nil, err
	}

	project, err := afs.Sub(embedded, staticDir)
	if err != nil {
		return nil, err
	}
	// 框架的 .min 同族文件不得遮蔽项目自己的同名源码：项目提供 yd-app.js 但没有
	// yd-app.min.js 时，必须回退到项目源码，而不是框架示例脚本。
	// A framework .min sibling must never shadow the project's own source of the same name: when the
	// project ships yd-app.js without yd-app.min.js, it must fall back to that source rather than the
	// framework's sample script.
	merged := afs.HideShadowedMin(afs.Overlay(framework, project), project)

	if !meta.IsDevelopment() {
		return merged, nil
	}
	root, ok := developmentRoot()
	if !ok {
		return merged, nil
	}
	dev := afs.NewOS(filepath.Join(root, staticDir))
	return afs.HideShadowedMin(afs.Overlay(merged, dev), dev), nil
}

// Bundle chunk limits. | bundle 分块限制。
const (
	// DefaultBundleMaxBytes is the 128 KiB ceiling per production bundle file. | DefaultBundleMaxBytes
	// 是单个生产 bundle 文件 128 KiB 的上限。
	DefaultBundleMaxBytes = 128 << 10
	// MinBundleMaxBytes keeps a configured value from producing a flood of tiny requests. | MinBundleMaxBytes
	// 防止配置值过小导致请求数量爆炸。
	MinBundleMaxBytes = 16 << 10
	// MaxBundleMaxBytes caps a configured value so one chunk still behaves like a static asset. | MaxBundleMaxBytes
	// 限制配置上限，避免单块退化成不可缓存的大文件。
	MaxBundleMaxBytes = 8 << 20
)

// bundlePath is the single same-origin route; the part query selects one chunk. | bundlePath 是同源路由，
// part 查询参数选择具体分块。
const bundlePath = "/static/js/yd-bundle.js"

// BundlePart is one production script bundle file. | BundlePart 是一个生产脚本 bundle 文件。
type BundlePart struct {
	// Index is the 1-based part number used by the part query. | Index 是 part 查询使用的从 1 开始的分块序号。
	Index int
	// URL carries the part number and the content hash. | URL 携带分块序号与内容哈希。
	URL string
	// Data is the concatenated body written by the handler. | Data 是处理器写出的拼接正文。
	Data []byte
	// Oversized reports a single source file larger than the configured limit; it is served alone
	// because splitting a minified script at an arbitrary byte would break its syntax. | Oversized
	// 表示单个源文件超过配置上限；它单独成块，因为按任意字节切分压缩脚本会破坏语法。
	Oversized bool
}

// bundleOnce and bundleParts hold the one-time assembly result. | bundleOnce 与 bundleParts 保存一次组装结果。
var (
	// bundleOnce makes the assembly run once per process. | bundleOnce 保证每个进程只组装一次。
	bundleOnce sync.Once
	// bundleParts is the ordered chunk list. | bundleParts 是分块后的有序清单。
	bundleParts []BundlePart
)

// InitBundles assembles the shared scripts once, splitting the ordered list at script boundaries so
// no chunk exceeds maxBytes. maxBytes <= 0 selects 128 KiB; values outside the supported range are
// clamped. The shell calls this before registering the routes, and the controller reads the same
// cached result through BundleURLs. | InitBundles 组装一次共享脚本，在脚本边界切分，使每个块不超过
// maxBytes。maxBytes <= 0 时取 128 KiB；超出区间的取值会被收敛。外壳在登记路由前调用它，控制器经
// BundleURLs 读取同一份缓存结果。
func InitBundles(maxBytes int) []BundlePart {
	bundleOnce.Do(func() { bundleParts = loadBundles(clampBundleMaxBytes(maxBytes)) })
	return bundleParts
}

// Bundles returns the assembled chunks; it is empty when InitBundles has not run or assembly failed. |
// Bundles 返回已组装的分块；未调用 InitBundles 或组装失败时为空。
func Bundles() []BundlePart { return bundleParts }

// BundleURLs returns the chunk URLs in load order, or nil when the shell must fall back to the
// individual script tags. Development deliberately keeps the individual files for debugging and
// immediate static edits; production reaps the smaller, cacheable chunks. | BundleURLs 按装载顺序返回
// 分块地址；返回 nil 时外壳必须回退到逐脚本标签。开发期刻意保留逐文件，便于调试与静态资源即时生效；
// 生产期获得更小、可缓存的分块。
func BundleURLs() []string {
	if !meta.IsProduction() || len(bundleParts) == 0 {
		return nil
	}
	urls := make([]string, 0, len(bundleParts))
	for _, part := range bundleParts {
		urls = append(urls, part.URL)
	}
	return urls
}

// clampBundleMaxBytes normalises the configured chunk ceiling. | clampBundleMaxBytes 归一化配置的分块上限。
func clampBundleMaxBytes(maxBytes int) int {
	switch {
	case maxBytes <= 0:
		return DefaultBundleMaxBytes
	case maxBytes < MinBundleMaxBytes:
		return MinBundleMaxBytes
	case maxBytes > MaxBundleMaxBytes:
		return MaxBundleMaxBytes
	default:
		return maxBytes
	}
}

// loadBundles assembles bundleScripts from the merged static tree and splits them at script
// boundaries. Any missing or unsafe entry leaves the result empty, so the shell falls back to the
// individual scripts rather than serving a half bundle. | loadBundles 从合并静态树组装 bundleScripts，
// 并在脚本边界切分。任一缺失或不安全条目都会让结果为空，使外壳回退到逐脚本，而不是发出半份 bundle。
func loadBundles(maxBytes int) []BundlePart {
	if len(bundleScripts) == 0 {
		return nil
	}
	static, err := Static()
	if err != nil {
		return nil
	}
	production := meta.IsProduction()
	parts := make([]BundlePart, 0, len(bundleScripts))
	var current bytes.Buffer
	// separator keeps two minified files from meeting at an ASI boundary. | separator 防止两个压缩文件在 ASI 边界粘连。
	separator := []byte("\n;\n")
	flush := func() {
		if current.Len() == 0 {
			return
		}
		data := append([]byte(nil), current.Bytes()...)
		current.Reset()
		parts = append(parts, newBundlePart(len(parts)+1, data, false))
	}
	for _, script := range bundleScripts {
		if !strings.HasPrefix(script, "/static/") {
			return nil
		}
		rel := strings.TrimPrefix(script, "/static/")
		if strings.Contains(rel, "..") {
			return nil
		}
		data, readErr := readBundleAsset(static, rel, production)
		if readErr != nil {
			return nil
		}
		if current.Len() > 0 && current.Len()+len(separator)+len(data) > maxBytes {
			flush()
		}
		if len(data) > maxBytes {
			// 单个源文件无法在任意字节处安全切分：单独成块并标记，外壳会在启动日志中告警。 |
			// A single source file cannot be split safely at an arbitrary byte: keep it alone and mark it so the
			// shell can warn at startup.
			flush()
			parts = append(parts, newBundlePart(len(parts)+1, append([]byte(nil), data...), true))
			continue
		}
		if current.Len() > 0 {
			current.Write(separator)
		}
		current.Write(data)
	}
	flush()
	return parts
}

// newBundlePart numbers one chunk and hashes its content. | newBundlePart 给分块编号并计算内容哈希。
func newBundlePart(index int, data []byte, oversized bool) BundlePart {
	sum := sha256.Sum256(data)
	return BundlePart{
		Index:     index,
		URL:       bundlePath + "?part=" + strconv.Itoa(index) + "&v=" + hex.EncodeToString(sum[:4]),
		Data:      data,
		Oversized: oversized,
	}
}

// readBundleAsset reads one script, preferring its .min.js sibling in production. |
// readBundleAsset 读取一个脚本；生产环境优先使用 .min.js 同族文件。
func readBundleAsset(static afs.FS, rel string, production bool) ([]byte, error) {
	if production && strings.HasSuffix(rel, ".js") && !strings.HasSuffix(rel, ".min.js") {
		if data, err := afero.ReadFile(static, strings.TrimSuffix(rel, ".js")+".min.js"); err == nil {
			return data, nil
		}
	}
	return afero.ReadFile(static, rel)
}

// I18n 返回语言目录子树，供 i18n.New 直接以该子树的根为目录根加载文案。
// I18n returns the message catalogue subtree, which i18n.New loads with the subtree root as its catalogue root.
//
// 文案只在启动期读取一次，因此这里始终使用内嵌副本，不受开发期覆盖影响。
// Catalogues are read once at startup, so this always uses the embedded copy and ignores the development overlay.
func I18n() afs.FS {
	sub, err := afs.Sub(embedded, i18nDir)
	if err != nil {
		// 语言目录缺失时降级为空树：i18n.New 会据此报告 ErrNoCatalogs，由调用方决定如何处置。
		// A missing catalogue tree degrades to an empty tree: i18n.New then reports ErrNoCatalogs and the caller decides.
		return afs.NewMem()
	}
	return sub
}

// frameworkStatic 返回框架 static/ 子树（vendor 脚本、yd.css 与国密/i18n 脚本的来源）。
// frameworkStatic returns the framework's static/ subtree (the source of the vendored scripts, yd.css and the guomi/i18n scripts).
func frameworkStatic() (afs.FS, error) {
	from, ok := afs.IOFSTree(frameworkweb.FS())
	if !ok {
		// 框架资产不再是 io/fs 后端：返回内存空树，由调用方决定是否继续。（框架当前实现必然是 io/fs 后端。）
		// The framework assets are no longer an io/fs backend: return an empty in-memory tree and let the caller decide.
		return afs.NewMem(), nil
	}
	return afs.Sub(from, staticDir)
}

// developmentRoot 定位开发期的资产根目录（默认 {{ .AssetRoot }}）。
// developmentRoot locates the development asset root ({{ .AssetRoot }} by default).
//
// 候选顺序：当前工作目录下的资产根、可执行文件所在目录下的资产根；两者都不存在时返回 false。
// Candidates in order: the asset root under the current working directory, then under the executable's directory;
// false means neither exists.
func developmentRoot() (string, bool) {
	candidates := make([]string, 0, 2)
	candidates = append(candidates, meta.AssetRoot)
	if exe, err := os.Executable(); err == nil {
		candidates = append(candidates, filepath.Join(filepath.Dir(exe), meta.AssetRoot))
	}
	for _, dir := range candidates {
		if info, err := os.Stat(dir); err == nil && info.IsDir() {
			return dir, true
		}
	}
	return "", false
}
