# {{ .Name }} 生产镜像：多阶段构建 + scratch 运行时（约十几 MB）
# {{ .Name }} production image: multi-stage build with a scratch runtime (roughly a dozen MB)
#
# 由 `yd docker` 自动调用；也可直接 `docker build -t {{ .Name }}:latest .`
# Invoked by `yd docker`; you can also run `docker build -t {{ .Name }}:latest .` directly.

FROM golang:{{ .GoMajorMinor }}-alpine AS builder

WORKDIR /src

# 依赖层缓存：先只复制模块描述文件（go.sum 由 `go mod tidy` 生成）
# Dependency layer cache: copy only the module descriptor files first (go.sum is produced by `go mod tidy`)
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# 静态资源（Htmx/Tailwind 产物）已由 `yd build` 通过 go:embed 嵌入二进制，
# 此处只需产出静态链接的单文件可执行程序。
# Static assets (Htmx/Tailwind output) are already embedded into the binary by `yd build` via go:embed,
# so this stage only has to produce a statically linked single-file executable.
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags "-s -w" -o /out/app ./cmd/app

# Configuration is packaged by default: only the baseline config.yaml is copied, never a config.local.yaml
# that may hold secrets. Mount over it at runtime when needed; YD_* environment variables still win.
# --no-config / --build-arg YD_INCLUDE_CONFIG=false produces an image driven purely by the environment.
# 配置文件默认打进镜像：只复制基线 config.yaml，不复制可能含密钥的 config.local.yaml；
# 运行时可用 -v 挂载覆盖，YD_* 环境变量仍具有最高优先级；--no-config 可生成完全由环境变量驱动的镜像。
ARG YD_INCLUDE_CONFIG=true
RUN mkdir -p /out/configs /out/data && \
    if [ "$YD_INCLUDE_CONFIG" = "true" ] && [ -f configs/config.yaml ]; then \
        cp configs/config.yaml /out/configs/config.yaml; \
    fi

FROM scratch

# 生产镜像默认以 production 运行：asset 助手才会选用压缩产物、静态资源才能获得不可变缓存，
# 种子口令也才不会回退到文档化的开发口令。运行时仍可用 -e YD_APP_ENV=development 覆盖。
# The production image runs as production by default: only then does the asset helper select minified files,
# static assets earn the immutable cache, and the seed password never falls back to the documented development
# password. It can still be overridden at runtime with -e YD_APP_ENV=development.
ENV YD_APP_ENV=production

# RFC 8441: yd docker passes this build arg when server.http2.extended_connect is true.
# RFC 8441：server.http2.extended_connect 为 true 时由 yd docker 传入该构建参数。
ARG YD_GODEBUG=""
ENV GODEBUG=${YD_GODEBUG}

# 时区与根证书：scratch 镜像不含任何运行时依赖，需要显式复制。
# Time zone data and root certificates: the scratch image ships no runtime dependency, so they are copied explicitly.
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo

# 配置与运行期数据目录：/configs 可挂载覆盖，/data 供 SQLite、节点身份与附件落盘。
# Configuration and runtime data: /configs can be mounted over; /data holds SQLite, node identity and attachments.
ENV YD_CONFIG_DIR=/configs
COPY --from=builder /out/configs /configs
COPY --from=builder /out/data /data

COPY --from=builder /out/app /app

EXPOSE 8080

ENTRYPOINT ["/app"]
