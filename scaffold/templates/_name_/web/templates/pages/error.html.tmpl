<!-- 错误片段：校验失败返回 422，由 hx-status:422 声明式接管。 | Error fragment: validation failures return 422, taken over declaratively by hx-status:422. -->
<section id="yd-errors" class="rounded border border-red-300 bg-red-50 p-4 text-red-800" role="alert">
  <p class="font-semibold">请求未通过校验 | The request failed validation</p>
  <ul class="mt-2 list-disc pl-5 text-sm">
    <li data-yd-i18n="error.required">必填项不能为空 | Required fields must not be empty</li>
    <li data-yd-i18n="error.format">格式不正确 | The format is invalid</li>
  </ul>
</section>
