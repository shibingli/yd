// Package meta 集中本项目的元信息：模板、控制器、路由与文档共用同一份取值。
// Package meta holds this project's metadata: templates, controllers, routers and docs all read one source.
package meta

import (
	"os"
	"strings"
)

// 元信息常量由 yd new 依据脚手架参数写入；需要改动请回到脚手架模板重新生成。
// The metadata constants below are written by yd new from the scaffold options; change them in the template and regenerate.
const (
	// Name 是项目名（同时也是默认模块路径的最后一段）。 | Name is the project name (also the last segment of the default module path).
	Name = "{{ .Name }}"
	// Module 是 Go 模块路径，前端脚本与文档引用它以免写死。 | Module is the Go module path, referenced by front-end scripts and docs instead of being hard-coded.
	Module = "{{ .Module }}"
	// Version 是应用版本，发布时可用 -ldflags 覆盖。 | Version is the application version, overridable with -ldflags at release time.
	Version = "0.1.0"
	// Description 是应用简介，写入 OpenAPI 文档与页面 <meta name="description">。
	// Description is the application blurb, written into the OpenAPI document and the page's <meta name="description">.
	Description = "{{ .Name }} —— yd 框架生成的后台应用 | {{ .Name }} — an admin application scaffolded with the yd framework"

	// GoVersion、HtmxVersion、TailwindVersion 是脚手架锁定的技术栈版本，页面页脚与文档据此避免写死。
	// GoVersion, HtmxVersion and TailwindVersion are the stack versions locked by the scaffold, so pages and docs never hard-code them.
	GoVersion       = "{{ .GoVersion }}"
	HtmxVersion     = "{{ .HtmxVersion }}"
	TailwindVersion = "{{ .TailwindVersion }}"

	// AssetRoot 是前端资产目录，与 .yd.json 的 assetRoot 保持一致。 | AssetRoot is the front-end asset directory, matching assetRoot in .yd.json.
	AssetRoot = "{{ .AssetRoot }}"
	// ConfigDir 是配置文件目录，交给 app.WithConfigDir 使用。 | ConfigDir is the configuration directory handed to app.WithConfigDir.
	ConfigDir = "configs"
	// I18nDir 是语言目录所在的资子树名。 | I18nDir is the asset subtree holding the message catalogues.
	I18nDir = "i18n"

	// DefaultLang 与 FallbackLang 是语言目录的默认值与回退值，与 configs/config.yaml 的 i18n 段一致。
	// DefaultLang and FallbackLang are the catalogue defaults, consistent with the i18n section of configs/config.yaml.
	DefaultLang  = "zh-CN"
	FallbackLang = "en"

	// EnvPrefix 是环境变量前缀。 | EnvPrefix is the environment variable prefix.
	EnvPrefix = "YD_"
	// ConfigEnvKey 是运行环境所在的配置键。 | ConfigEnvKey is the configuration key holding the runtime environment.
	ConfigEnvKey = "app.env"
	// EnvProduction 与 EnvDevelopment 是运行环境的两个取值。 | EnvProduction and EnvDevelopment are the two runtime environment values.
	EnvProduction  = "production"
	EnvDevelopment = "development"

	// ToastEvent 是服务端下发提示的事件名，控制器通过 HX-Trigger 触发，页面在 body 上订阅。
	// ToastEvent is the event name of a server-sent toast: controllers fire it through HX-Trigger and pages subscribe on the body.
	ToastEvent = "yd:toast"
)

// 会话与多租户的对外契约常量：中间件、控制器、模板与文档引用同一份取值。
// Public contract constants of sessions and multi-tenancy: middleware, controllers, templates and docs all read one source.
const (
	// TenantHeader 是承载租户标识的请求头；子域名与令牌 tid 声明是另外两条来源。 | TenantHeader carries the tenant key; the subdomain and the token's tid claim are the other two sources.
	TenantHeader = "X-Tenant"
	// AuthHeader 是承载令牌的请求头，与框架 auth.DefaultTokenLookup 一致。 | AuthHeader carries the token and matches the framework's auth.DefaultTokenLookup.
	AuthHeader = "Authorization"
	// BearerPrefix 是 Authorization 的认证方案前缀。 | BearerPrefix is the authentication scheme prefix of Authorization.
	BearerPrefix = "Bearer "
	// TokenCookie 是浏览器会话所用的 cookie 名；令牌以 HttpOnly 写入，脚本读不到它。 | TokenCookie is the cookie name of the browser session; the token is written HttpOnly so no script can read it.
	TokenCookie = "yd_token"
	// TokenIssuerName 写入令牌的 iss 声明。 | TokenIssuerName is written into the iss claim of every token.
	TokenIssuerName = "yd"

	// DevMasterKey 是内置的开发主密钥：仅在 auth.master_key 未配置时启用，目的是让种子账号开箱即可登录。
	// 生产环境必须通过 YD_AUTH_MASTER_KEY 覆盖它，否则进程重启后内存中的 sec_key 仍可解开——路由层会为此告警。
	// DevMasterKey is the built-in development master key: it applies only while auth.master_key is unset and exists so the
	// seeded account works out of the box. Production must override it through YD_AUTH_MASTER_KEY, otherwise the in-memory
	// sec_keys stay readable across restarts — the router warns about exactly that.
	DevMasterKey = "yd-scaffold-development-master-key-please-replace"
)

// 种子数据：一条命令即得到可登录的演示环境，README 与登录页展示的默认凭据都取自这里。
// Seed data: one command yields a sign-in-ready demo environment, and the default credentials shown by the README and by
// the sign-in page are read from here.
//
// 口令明文只出现在这一处，且仅在首次种子写入时使用；数据库里保存的永远是 SM2/SM3 散列过的口令与逐用户 sec_key。
// The clear-text passwords appear here and nowhere else, are used only by the very first seed write, and what the store
// keeps is always a hashed password plus a per-user sec_key.
const (
	// SeedTenantSlug 是演示租户的标识（X-Tenant 请求头与子域名都用它）。 | SeedTenantSlug is the demo tenant's key (the X-Tenant header and the subdomain both use it).
	SeedTenantSlug = "demo"
	// SeedTenantName 是演示租户的展示名。 | SeedTenantName is the demo tenant's display name.
	SeedTenantName = "演示租户 | Demo tenant"
	// SeedAdminUsername 是演示租户的管理员登录名（登录用登录名，不是邮箱）。 | SeedAdminUsername is the demo tenant's administrator sign-in name (sign-in uses the name, not the address).
	SeedAdminUsername = "admin"
	// SeedAdminEmail 是演示租户管理员的邮箱。 | SeedAdminEmail is the demo administrator's e-mail address.
	SeedAdminEmail = "admin@example.com"
	// SeedAdminPassword 是演示租户管理员的初始口令。 | SeedAdminPassword is the demo administrator's initial password.
	SeedAdminPassword = "Admin@123456"

	// SeedOpsSlug 是第二个租户的标识：它让「跨租户不可见」成为一条可被自动化验证的硬边界，而不是一句承诺。
	// SeedOpsSlug is the second tenant's key: it turns "tenants cannot see each other" into an automation-verifiable hard
	// boundary instead of a promise.
	SeedOpsSlug = "acme"
	// SeedOpsName 是第二个租户的展示名。 | SeedOpsName is the second tenant's display name.
	SeedOpsName = "示例租户 ACME | Sample tenant ACME"
	// SeedOpsAdminUsername 是第二个租户的管理员登录名。 | SeedOpsAdminUsername is the second tenant's administrator sign-in name.
	SeedOpsAdminUsername = "acme-admin"
	// SeedOpsAdminEmail 是第二个租户管理员的邮箱。 | SeedOpsAdminEmail is the second tenant administrator's e-mail address.
	SeedOpsAdminEmail = "acme-admin@example.com"
	// SeedOpsAdminPassword 是第二个租户管理员的初始口令。 | SeedOpsAdminPassword is the second tenant administrator's initial password.
	SeedOpsAdminPassword = "Acme@123456"

	// SeedPasswordNotice 是首登必改口令的提示文案，登录页、首页横幅与 README 引用同一句。
	// SeedPasswordNotice is the mandatory password-change notice shown at first sign-in; the sign-in page, the home
	// banner and the README quote the same sentence.
	SeedPasswordNotice = "首次登录后请立即修改默认口令 | change the default password right after the first sign-in"
)

// Features 列出本项目启用的可选特性，供启动日志与运维自检读取（与脚手架参数同源）。
// Features lists the optional features enabled in this project, read by the startup log and by operations checks (same source as the scaffold options).
var Features = []string{
{{- range .Features }}
	"{{ . }}",
{{- end }}
}

// HtmxExtScripts 是所选 Htmx 扩展的本地脚本路径，base.html 依序装载，顺序与脚手架参数一致。
// HtmxExtScripts holds the local script paths of the selected Htmx extensions; base.html loads them in order, matching the scaffold options.
var HtmxExtScripts = []string{
{{- range .HtmxExtScripts }}
	"{{ . }}",
{{- end }}
}

// Env 返回运行环境名：优先取环境变量 YD_APP_ENV，未设置时按开发环境处理。
// Env returns the runtime environment: it prefers the YD_APP_ENV environment variable and falls back to development.
//
// 未知环境一律按开发处理，与框架 app 门面对 isDevelopment 的判定保持一致，
// 避免新项目因为漏配环境名而失去模板热重载。
// An unknown environment counts as development, matching isDevelopment in the framework's app facade, so a fresh
// project never loses template hot reloading just because the environment name is unset.
func Env() string {
	if v := strings.TrimSpace(os.Getenv(EnvPrefix + "APP_ENV")); v != "" {
		return v
	}
	return EnvDevelopment
}

// IsProduction 报告当前是否为生产环境。 | IsProduction reports whether the runtime environment is production.
func IsProduction() bool { return strings.EqualFold(Env(), EnvProduction) }

// IsDevelopment 报告当前是否为开发环境。 | IsDevelopment reports whether the runtime environment is development.
func IsDevelopment() bool { return !IsProduction() }
