// 本文件是 model 包的角色模型：角色是权限的集合，且永远属于某一个租户。
// This file is the role model of package model: a role is a set of permissions and always belongs to exactly one tenant.

package model

import (
	"strings"

	"{{ .YdModule }}/auth"
)

// Role 是租户内的权限集合；字段顺序按内存对齐排布（切片 → 短字符串）。
// Role is a permission set inside a tenant; its fields are ordered for memory alignment (slice → short strings).
//
// 用户按名称引用角色（User.Roles），因此改名会让既有分配失效；改名请走「新建 + 重新分配 + 删除」。
// Users reference roles by name (User.Roles), so renaming a role orphans every existing assignment: rename through
// "create + reassign + delete" instead.
type Role struct {
	// Permissions 列出被授予的能力标识。 | Permissions lists the granted capability tokens.
	Permissions []Permission `json:"permissions" gorm:"column:permissions;serializer:json;type:text"`
	// ID 是主键，形如 rl_xxx；未指定时由 auth.Service 生成。 | ID is the primary key (rl_xxx), generated by auth.Service when left empty.
	ID string `json:"id" gorm:"column:id;type:varchar(64);primaryKey"`
	// TenantID 是所属租户。 | TenantID is the owning tenant.
	TenantID string `json:"tenant_id" gorm:"column:tenant_id;type:varchar(64);not null;index:idx_roles_tenant_name,unique,priority:1"`
	// Name 是租户内唯一的角色名。 | Name is the role name, unique inside the tenant.
	Name string `json:"name" gorm:"column:name;type:varchar(64);not null;uniqueIndex:idx_roles_tenant_name,priority:2"`
	// Description 是说明文字。 | Description is the human-readable note.
	Description string `json:"description" gorm:"column:description;type:varchar(255)"`
}

// RoleFromAuth 把框架角色转成本项目模型。 | RoleFromAuth converts a framework role into this project's model.
func RoleFromAuth(r *auth.Role) Role {
	if r == nil {
		return Role{}
	}
	perms := make([]Permission, 0, len(r.Permissions))
	for _, p := range r.Permissions {
		perms = append(perms, Permission(p))
	}
	return Role{ID: r.ID, TenantID: r.TenantID, Name: r.Name, Description: r.Description, Permissions: perms}
}

// RolesFromAuth 批量转换角色记录。 | RolesFromAuth converts a batch of role records.
func RolesFromAuth(list []*auth.Role) []Role {
	out := make([]Role, 0, len(list))
	for _, r := range list {
		out = append(out, RoleFromAuth(r))
	}
	return out
}

// ToAuth 把模型转回框架角色。 | ToAuth converts the model back into a framework role.
func (r Role) ToAuth() *auth.Role {
	perms := make([]string, 0, len(r.Permissions))
	for _, p := range r.Permissions {
		perms = append(perms, string(p))
	}
	return &auth.Role{ID: r.ID, TenantID: r.TenantID, Name: r.Name, Description: r.Description, Permissions: perms}
}

// Granted 报告角色是否已授予该能力。 | Granted reports whether the role grants that capability.
func (r Role) Granted(p Permission) bool {
	for _, granted := range r.Permissions {
		if granted == p {
			return true
		}
	}
	return false
}

// PermissionList 返回逗号分隔的能力标识，供列表片段的一行展示。 | PermissionList returns the comma-joined capability tokens shown on one line of a list fragment.
func (r Role) PermissionList() string {
	if len(r.Permissions) == 0 {
		return ""
	}
	parts := make([]string, 0, len(r.Permissions))
	for _, p := range r.Permissions {
		parts = append(parts, string(p))
	}
	return strings.Join(parts, ", ")
}

// Builtin 报告角色是否为内置角色（内置角色不允许删除）。 | Builtin reports whether the role is built-in (built-in roles cannot be deleted).
func (r Role) Builtin() bool { return IsBuiltinRole(r.Name) }

// RoleOption 是权限矩阵与用户表单共用的一项角色选项：名称、是否内置、以及它是否已勾选。
// RoleOption is one role choice shared by the permission matrix and the user form: its name, whether it is built-in and whether it is ticked.
type RoleOption struct {
	// Name 是角色名。 | Name is the role name.
	Name string
	// Description 是说明文字。 | Description is the human-readable note.
	Description string
	// Selected 表示本次渲染里它是否已被勾选。 | Selected reports whether this render has it ticked.
	Selected bool
	// Builtin 表示它是内置角色。 | Builtin reports that it is a built-in role.
	Builtin bool
}

// RoleOptions 依据角色清单与已选名称构造选项列表，顺序沿用清单顺序。
// RoleOptions builds the option list from the role catalogue and the selected names, keeping the catalogue order.
func RoleOptions(roles []Role, selected []string) []RoleOption {
	picked := make(map[string]struct{}, len(selected))
	for _, name := range selected {
		picked[strings.ToLower(strings.TrimSpace(name))] = struct{}{}
	}

	out := make([]RoleOption, 0, len(roles))
	for _, role := range roles {
		_, ok := picked[strings.ToLower(role.Name)]
		out = append(out, RoleOption{
			Name:        role.Name,
			Description: role.Description,
			Selected:    ok,
			Builtin:     role.Builtin(),
		})
	}
	return out
}
