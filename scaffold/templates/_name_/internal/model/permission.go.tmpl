// 本文件是 model 包的权限目录：能力标识、说明文案与内置角色模板。
// This file is the permission catalogue of package model: capability tokens, display copy and the built-in role templates.
//
// 权限标识形如 "resource:action"，与框架 auth 包的 Permission 是同一个类型（类型别名），
// 因此这里的常量可以直接喂给 auth.RequirePermission，不需要任何转换。
// A capability token looks like "resource:action" and is the very type of auth.Permission (a type alias), so the
// constants below feed auth.RequirePermission directly and need no conversion.

package model

import (
	"strings"

	"{{ .YdModule }}/auth"
)

// Permission 是能力标识，与框架 auth.Permission 同型。 | Permission is a capability token, identical to auth.Permission.
type Permission = auth.Permission

// 本项目的能力标识：一处声明，路由、模板与权限矩阵三处引用。 | This project's capability tokens: declared once, referenced by the router, the templates and the permission matrix.
const (
	// PermTenantRead 允许查看租户列表与详情。 | PermTenantRead admits reading the tenant list and one tenant.
	PermTenantRead Permission = "tenant:read"
	// PermTenantWrite 允许新建与修改租户。 | PermTenantWrite admits creating and updating tenants.
	PermTenantWrite Permission = "tenant:write"
	// PermUserRead 允许查看本租户的用户。 | PermUserRead admits reading the users of the current tenant.
	PermUserRead Permission = "user:read"
	// PermUserWrite 允许新建、修改与禁用用户。 | PermUserWrite admits creating, updating and disabling users.
	PermUserWrite Permission = "user:write"
	// PermRoleRead 允许查看角色。 | PermRoleRead admits reading roles.
	PermRoleRead Permission = "role:read"
	// PermRoleWrite 允许新建、修改与删除角色。 | PermRoleWrite admits creating, updating and deleting roles.
	PermRoleWrite Permission = "role:write"
	// PermPermissionRead 允许查看权限矩阵。 | PermPermissionRead admits reading the permission matrix.
	PermPermissionRead Permission = "permission:read"
)

// PermissionInfo 是一条权限的展示元数据，供权限矩阵页分组渲染。
// PermissionInfo is the display metadata of one capability, used by the permission matrix page to group rows.
type PermissionInfo struct {
	// Key 是能力标识本身。 | Key is the capability token itself.
	Key Permission
	// Module 是所属模块，权限矩阵按它分组。 | Module is the owning module; the matrix groups rows by it.
	Module string
	// Label 是中英对照的说明。 | Label is the bilingual description.
	Label string
}

// permissionCatalogue 是全部权限的固定顺序清单（顺序即权限矩阵的展示顺序）。
// permissionCatalogue lists every capability in a fixed order, which is the order the matrix renders them in.
var permissionCatalogue = []PermissionInfo{
	{Key: PermTenantRead, Module: "tenant", Label: "查看租户 | read tenants"},
	{Key: PermTenantWrite, Module: "tenant", Label: "维护租户 | manage tenants"},
	{Key: PermUserRead, Module: "user", Label: "查看用户 | read users"},
	{Key: PermUserWrite, Module: "user", Label: "维护用户 | manage users"},
	{Key: PermRoleRead, Module: "role", Label: "查看角色 | read roles"},
	{Key: PermRoleWrite, Module: "role", Label: "维护角色 | manage roles"},
	{Key: PermPermissionRead, Module: "permission", Label: "查看权限矩阵 | read the permission matrix"},
}

// Permissions 返回权限目录的副本：调用方可以随意改写，库内状态不受影响。
// Permissions returns a copy of the catalogue so callers may alter it without touching stored state.
func Permissions() []PermissionInfo {
	out := make([]PermissionInfo, len(permissionCatalogue))
	copy(out, permissionCatalogue)
	return out
}

// PermissionKeys 返回全部能力标识，顺序与 Permissions 一致。 | PermissionKeys returns every capability token in the same order as Permissions.
func PermissionKeys() []Permission {
	out := make([]Permission, 0, len(permissionCatalogue))
	for _, p := range permissionCatalogue {
		out = append(out, p.Key)
	}
	return out
}

// ValidPermission 报告标识是否落在本项目的权限目录内。 | ValidPermission reports whether the token exists in this project's catalogue.
func ValidPermission(p Permission) bool {
	for _, item := range permissionCatalogue {
		if item.Key == p {
			return true
		}
	}
	return false
}

// PermissionLabel 返回标识的说明文案，未登记的标识原样回显标识本身。
// PermissionLabel returns the description of a token and echoes the token itself when it is unregistered.
func PermissionLabel(p Permission) string {
	for _, item := range permissionCatalogue {
		if item.Key == p {
			return item.Label
		}
	}
	return string(p)
}

// 内置角色名：种子数据与租户初始化都按这四个名字建角色，因此它们同时是「不可删除」的保护名单。
// Built-in role names: the seed data and every new tenant create roles under these four names, which is also the list
// protected from deletion.
const (
	// RoleOwner 是租户所有者，拥有全部权限。 | RoleOwner is the tenant owner and holds every capability.
	RoleOwner = "owner"
	// RoleAdmin 是管理员，能管理用户与角色，但看不到租户侧写操作。 | RoleAdmin manages users and roles without tenant write access.
	RoleAdmin = "admin"
	// RoleAuditor 是审计员，只有读权限。 | RoleAuditor is the auditor and only holds read capabilities.
	RoleAuditor = "auditor"
	// RoleMember 是普通成员，没有任何管理权限。 | RoleMember is an ordinary member and holds no administrative capability.
	RoleMember = "member"
)

// RoleTemplate 描述一个内置角色：名称、说明与它授予的权限。
// RoleTemplate describes one built-in role: its name, its description and the capabilities it grants.
type RoleTemplate struct {
	// Name 是角色名，租户内唯一。 | Name is the role name, unique inside a tenant.
	Name string
	// Description 是中英对照的说明。 | Description is the bilingual note.
	Description string
	// Permissions 是被授予的能力。 | Permissions are the granted capabilities.
	Permissions []Permission
}

// BuiltinRoles 返回内置角色模板，顺序即角色页的展示顺序与种子的创建顺序。
// BuiltinRoles returns the built-in role templates in the order both the role page and the seed data use.
func BuiltinRoles() []RoleTemplate {
	return []RoleTemplate{
		{
			Name:        RoleOwner,
			Description: "租户所有者，拥有全部权限 | tenant owner, holds every capability",
			Permissions: PermissionKeys(),
		},
		{
			Name:        RoleAdmin,
			Description: "管理员，维护用户与角色 | administrator, maintains users and roles",
			Permissions: []Permission{PermTenantRead, PermUserRead, PermUserWrite, PermRoleRead, PermRoleWrite, PermPermissionRead},
		},
		{
			Name:        RoleAuditor,
			Description: "审计员，只读 | auditor, read only",
			Permissions: []Permission{PermTenantRead, PermUserRead, PermRoleRead, PermPermissionRead},
		},
		{
			Name:        RoleMember,
			Description: "普通成员，无管理权限 | ordinary member, no administrative capability",
			Permissions: []Permission{},
		},
	}
}

// IsBuiltinRole 报告角色名是否为内置角色（内置角色不允许删除）。 | IsBuiltinRole reports whether the name is built-in (built-in roles cannot be deleted).
func IsBuiltinRole(name string) bool {
	for _, tpl := range BuiltinRoles() {
		if strings.EqualFold(tpl.Name, strings.TrimSpace(name)) {
			return true
		}
	}
	return false
}

// rolePermissions 返回内置角色授予的能力；非内置角色返回 nil 与 false。
// rolePermissions returns the capabilities granted by a built-in role; a non-built-in name yields nil and false.
func rolePermissions(name string) ([]Permission, bool) {
	trimmed := strings.TrimSpace(name)
	for _, tpl := range BuiltinRoles() {
		if strings.EqualFold(tpl.Name, trimmed) {
			return tpl.Permissions, true
		}
	}
	return nil, false
}
