// 本文件是 controller 包的用户管理端点：列表与创建都以 HTML 片段应答，供 htmx 就地换入。
// This file is the user management part of package controller: both the list and the create endpoint answer with HTML
// fragments for htmx to swap in place.

package controller

import (
	"errors"
	"net/http"

	"{{ .Module }}/internal/meta"
	"{{ .Module }}/internal/service"
	"{{ .YdModule }}/htmx"
	"{{ .YdModule }}/logx"
	"{{ .YdModule }}/router"
)

// List 列出用户（GET /users），可用 q 做关键字筛选。
// List returns the users (GET /users), optionally filtered by the q keyword.
//
// 关键字无匹配时返回 200 + 空状态片段，而不是 404：片段端点的状态码一旦不是 2xx，htmx 默认就不做交换，
// 用户会看到「点了没反应」。因此「没有匹配」在这里是内容问题，不是协议错误。
// A keyword with no match answers 200 plus the empty-state fragment rather than 404: a fragment endpoint that does not
// answer 2xx makes htmx skip the swap by default and the user sees "nothing happened". "No match" is therefore a content
// concern here, not a protocol error.
//
// @Summary List users | 用户列表
// @Description Renders pages/users.html. A full-page request gets the layout-wrapped page, an htmx request gets only the
// @Description fragment; a keyword without matches yields the empty-state fragment with status 200.
// @Description 渲染 pages/users.html：整页请求返回布局包裹的页面，htmx 请求只返回片段；关键字无匹配时以 200 返回空状态片段。
// @Tags users
// @Accept html
// @Produce html
// @Param q query string false "case-insensitive name or e-mail filter | 名称或邮箱的模糊匹配关键字（大小写不敏感）"
// @Param HX-Request header string false "htmx partial request | htmx 局部请求标记"
// @Success 200 {object} string "user list page or fragment | 用户列表整页或片段"
// @Failure 500 {object} string "internal error fragment | 内部错误片段"
// @Router /users [get]
func (c *Controller) List(ctx *router.Ctx) {
	keyword := ctx.Query("q")

	data := map[string]any{"Keyword": keyword, "Empty": false}
	users, err := service.List(ctx, keyword)
	switch {
	case errors.Is(err, service.ErrUserNotFound):
		// 筛选没有命中：仍然是成功响应，只是内容为空状态。 | A filter with no hit is still a success response, only the content is the empty state.
		data["Empty"] = true
	case err != nil:
		c.failService(ctx, err)
		return
	default:
		data["Users"] = users
		data["Total"] = len(users)
	}

	c.render(ctx, http.StatusOK, TplUsers, c.view(ctx, "用户管理 | Users", data))
}

// Create 创建用户（POST /users）。
// Create creates a user (POST /users).
//
// 校验失败返回 422 + 错误片段，由表单上的 hx-status:422="target:#yd-errors swap:outerHTML" 声明式换入；
// 控制器不返回任何 JSON 错误体，也不用 302 重定向。
// A failed validation answers 422 plus the error fragment swapped in declaratively by the form's
// hx-status:422="target:#yd-errors swap:outerHTML"; the controller returns no JSON error body and does not redirect.
//
// @Summary Create user | 创建用户
// @Description Validates the submitted name and e-mail address in internal/service; on success the refreshed list
// @Description fragment is returned together with a yd:toast event, on a validation failure the 422 error fragment is returned.
// @Description 由 internal/service 校验提交的名称与邮箱：成功时返回刷新后的列表片段并附带 yd:toast 事件，校验失败时返回 422 错误片段。
// @Tags users
// @Accept form
// @Produce html
// @Param name formData string true "display name | 显示名"
// @Param email formData string true "login e-mail address | 登录邮箱"
// @Param HX-Request header string false "htmx partial request | htmx 局部请求标记"
// @Success 200 {object} string "refreshed user list fragment | 刷新后的用户列表片段"
// @Failure 422 {object} string "validation error fragment | 校验错误片段"
// @Failure 500 {object} string "internal error fragment | 内部错误片段"
// @Router /users [post]
func (c *Controller) Create(ctx *router.Ctx) {
	created, err := service.Create(ctx, service.CreateInput{
		Name:  ctx.FormValue("name"),
		Email: ctx.FormValue("email"),
	})
	if err != nil {
		c.failService(ctx, err)
		return
	}

	// 事件必须在响应头写出之前触发：htmx 通过 HX-Trigger 把它派发到页面，由页面自行决定提示与刷新。
	// The event must fire before the response headers are written: htmx dispatches it through HX-Trigger and the page
	// decides for itself how to toast and refresh.
	htmx.TriggerFromCtx(ctx, htmx.Event{
		Name: meta.ToastEvent,
		Detail: map[string]any{
			"level": "success",
			"text":  "已创建用户 " + created.Display() + " | user " + created.Display() + " created",
		},
	})
	c.app.Logger().Info("user created | 用户已创建",
		logx.Int64("id", created.ID),
		logx.Str("email", created.Email),
	)

	// 直接复用列表渲染：htmx 不需要重定向，列表就地更新，且刷新后仍保留当前筛选关键字。
	// Reuse the list rendering: htmx needs no redirect, the list updates in place and keeps the current filter keyword.
	c.List(ctx)
}
