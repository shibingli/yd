// Package repository 是数据访问层：只负责读写数据，不承载业务规则。
// Package repository is the data access layer: it only reads and writes data and holds no business rule.
//
// 当前实现是进程内存储，用于让分层结构立即可运行；接入数据库时把 store 换成 GORM 查询，
// 保持函数签名与错误语义不变，上层无需改动。
// The current implementation is in-process storage so the layering runs from the first minute; to move to a database,
// swap store for GORM queries while keeping the signatures and the error semantics, and no layer above changes.
package repository

import (
	"context"
	"sort"
	"strings"
	"sync"
	"time"

	"{{ .Module }}/internal/model"
	"{{ .YdModule }}/errx"
	"{{ .YdModule }}/guomi"
	"{{ .YdModule }}/logx"
)

// 演练数据常量与错误。 | Demo data constants and errors.
const (
	// SeedPassword 是演练管理员账号的口令，仅在本地开发环境使用。
	// SeedPassword is the demo administrator's password; it is meant for local development only.
	SeedPassword = "admin"
	// AdminEmail 是演练管理员账号的邮箱。 | AdminEmail is the demo administrator's e-mail address.
	AdminEmail = "admin@example.com"
)

// ErrSeed 表示演练账号的口令散列无法生成。 | ErrSeed reports a demo account whose password hash could not be produced.
var ErrSeed = errx.New("repository: failed to hash the seed password | repository：演练账号口令散列失败")

// 进程内存储：mu 保护 store 与 nextID，seedOnce 保证演练数据只装载一次。
// In-process storage: mu guards store and nextID, and seedOnce loads the demo data exactly once.
var (
	// mu 保护 store 与 nextID。 | mu guards store and nextID.
	mu sync.RWMutex
	// store 是按 ID 索引的内存表，首次访问时装载。 | store is the in-memory table indexed by ID, loaded on first access.
	store map[int64]model.User
	// nextID 是下一个自增主键。 | nextID is the next auto-increment key.
	nextID int64
	// seedOnce 让演练数据与口令散列只计算一次。 | seedOnce keeps the demo data and the password hash computed once.
	seedOnce sync.Once
)

// seed 装载演练数据；由每个访问器在持写锁后触发。
// seed loads the demo data; every accessor triggers it after taking the write lock.
//
// 口令散列（PBKDF2-HMAC-SM3，十万轮）刻意不放在包初始化：命令行子命令与测试不应为它付出启动代价。
// The password hash (PBKDF2-HMAC-SM3, 100k rounds) is deliberately kept out of package initialisation: command-line
// subcommands and tests must not pay for it at startup.
func seed() {
	seedOnce.Do(func() {
		now := time.Now().UTC()
		store = map[int64]model.User{
			1: {
				ID:           1,
				Name:         "admin | 管理员",
				Email:        AdminEmail,
				PasswordHash: hashSeedPassword(),
				Roles:        []string{"admin"},
				CreatedAt:    now,
			},
			2: {
				ID:        2,
				Name:      "guest | 访客",
				Email:     "guest@example.com",
				Roles:     []string{"guest"},
				CreatedAt: now,
			},
		}
		nextID = 3
	})
}

// hashSeedPassword 计算演练账号的口令散列；失败时返回空串并告警。
// hashSeedPassword hashes the demo account's password; on failure it returns an empty string and warns.
//
// 返回空串会让登录接口以「凭据无效」回应，绝不会退化成明文比较。
// An empty string makes the login endpoint answer "invalid credentials" instead of degrading to a plain-text comparison.
func hashSeedPassword() string {
	hash, err := guomi.HashPassword(SeedPassword, guomi.PasswordOptions{})
	if err != nil {
		logx.Default().Warn("seed password hash failed | 演练口令散列失败", logx.Err(errx.Wrap(err, ErrSeed)))
		return ""
	}
	return hash
}

// List 返回全部用户，按 ID 升序排列。 | List returns every user ordered by ascending ID.
func List(_ context.Context) ([]model.User, error) {
	mu.Lock()
	seed()
	users := make([]model.User, 0, len(store))
	for _, u := range store {
		users = append(users, u)
	}
	mu.Unlock()

	sort.Slice(users, func(i, j int) bool { return users[i].ID < users[j].ID })
	return users, nil
}

// Get 按 ID 返回单个用户，不存在时 ok 为 false。 | Get returns one user by ID; ok is false when it is absent.
func Get(_ context.Context, id int64) (model.User, bool) {
	mu.Lock()
	defer mu.Unlock()

	seed()
	u, ok := store[id]
	return u, ok
}

// FindByEmail 按邮箱返回单个用户（大小写不敏感），不存在时 ok 为 false。
// FindByEmail returns the user with that e-mail address (case-insensitively); ok is false when it is absent.
func FindByEmail(_ context.Context, email string) (model.User, bool) {
	mu.Lock()
	defer mu.Unlock()

	seed()
	normalized := strings.ToLower(strings.TrimSpace(email))
	for _, u := range store {
		if strings.ToLower(u.Email) == normalized {
			return u, true
		}
	}
	return model.User{}, false
}

// Exists 报告邮箱是否已被占用（大小写不敏感）。 | Exists reports whether the e-mail address is already taken (case-insensitively).
func Exists(ctx context.Context, email string) (bool, error) {
	_, ok := FindByEmail(ctx, email)
	return ok, nil
}

// Create 写入一个新用户并返回带自增 ID 的记录。 | Create inserts a new user and returns the record with its auto-increment ID.
func Create(_ context.Context, u model.User) (model.User, error) {
	mu.Lock()
	defer mu.Unlock()

	seed()
	u.ID = nextID
	nextID++
	if u.CreatedAt.IsZero() {
		u.CreatedAt = time.Now().UTC()
	}
	store[u.ID] = u
	return u, nil
}
