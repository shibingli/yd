// Package middleware 收集跨切面中间件：恢复、访问日志、限流、CORS 等。
// Package middleware collects cross-cutting middleware: recovery, access logs, rate limiting, CORS and friends.
package middleware

import (
	"net/http"
	"runtime/debug"

	"github.com/yun-dev/yd/logx"
)

// Recover 捕获下游处理器的 panic：记录堆栈日志后返回 500 错误片段，保证进程不被打挂。
// Recover catches panics from downstream handlers: it logs the stack and returns a 500 fragment so the process survives.
func Recover(log *logx.Logger) func(http.Handler) http.Handler {
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			defer func() {
				if rec := recover(); rec != nil {
					log.Error("panic recovered | 已恢复 panic",
						logx.Any("panic", rec),
						logx.Str("path", r.URL.Path),
						logx.Bytes("stack", debug.Stack()),
					)
					http.Error(w, "internal error | 服务器内部错误", http.StatusInternalServerError)
				}
			}()
			next.ServeHTTP(w, r)
		})
	}
}
