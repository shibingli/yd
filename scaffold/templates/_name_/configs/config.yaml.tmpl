# {{ .Name }} 配置基线（分层配置的最低优先级：框架默认值之上、本地文件之下）
# {{ .Name }} baseline configuration (lowest precedence: above framework defaults, below the local file)
#
# 优先级：命令行参数 > 环境变量(.env) > 配置文件 > 框架默认值
# Precedence: command-line flags > environment variables (.env) > config files > framework defaults
# 环境变量前缀 YD_，下划线映射多级嵌套：YD_SERVER_PORT -> server.port
# Environment variables use the YD_ prefix, underscores map onto nested keys: YD_SERVER_PORT -> server.port

server:
  port: 8080          # 监听端口 | listening port
  h2c: true           # 开启 HTTP/2 Cleartext | enable HTTP/2 Cleartext
  http3: false        # 开启 HTTP/3 (QUIC) | enable HTTP/3 (QUIC)
  read_timeout: 15s   # 读超时 | read timeout
  write_timeout: 30s  # 写超时 | write timeout

log:
  level: info         # debug | info | warn | error
  format: json        # json | console
  caller: true        # 记录调用位置 | record the call site

# 鉴权与会话：主密钥封装每个用户的 sec_key，改动它等于让此前签发的全部令牌失效。
# Authentication and sessions: the master key seals every user's sec_key, and changing it invalidates every token issued so far.
auth:
  master_key: ""      # 生产环境必须通过 YD_AUTH_MASTER_KEY 注入；留空时使用内置开发密钥并告警 | production must inject it through YD_AUTH_MASTER_KEY; empty selects the built-in development key with a warning
  token_ttl: 2h       # 令牌有效期，登录 cookie 的 MaxAge 与它同源 | token lifetime, shared with the MaxAge of the sign-in cookie
{{- if ne .DB "none" }}

db:
  driver: {{ .DB }}   # mysql | postgres | sqlite
  dsn: "{{ .DBDSN }}"
  max_conn: 100       # 连接池上限 | connection pool ceiling
  slow_threshold: 200ms   # 慢查询阈值 | slow query threshold
{{- end }}
{{- if .Redis }}

redis:
  mode: single        # single | sentinel | cluster
  addr: 127.0.0.1:6379
  db: 0
  pool_size: 100
{{- end }}
{{- if .Asynq }}

asynq:
  queues: "critical:3,default:2,low:1"   # 队列与权重 | queues and weights
  concurrency: 10                        # 并发消费者数 | concurrent consumers
{{- end }}
{{- if .GRPC }}

grpc:
  enabled: true
  port: 9090
  max_recv_bytes: 4194304   # 单条消息上限 4MiB | per-message ceiling 4MiB
{{- end }}
{{- if .I18n }}

i18n:
  default: zh-CN
  fallback: en
  dir: configs/i18n
{{- end }}
{{- if .Tailwind }}

tailwind:
  input: {{ .AssetRoot }}/static/css/app.css
  output: {{ .AssetRoot }}/static/css/yd.css
  minify: true
{{- end }}

# 系统服务：yd service <install|uninstall|start|stop|restart|status> 与入口的 -service <动作> 都读这一段。
# 服务名缺省回退到 app.name，显示名回退到服务名，描述回退到显示名；全部键都可由 YD_SERVICE_* 覆盖。
# 改动这一段之后要重新安装服务（yd service install）才会写进服务管理器。
# System service: both `yd service <install|uninstall|start|stop|restart|status>` and the -service <action> argument
# of the entry point read this section. The service name falls back to app.name, the display name to the service name
# and the description to the display name; every key is overridable through YD_SERVICE_*. A change here only reaches
# the service manager after the service is installed again (yd service install).
service:
  name: {{ .Name }}          # 服务名（建议不含空格） | service name (spaces are best avoided)
  display_name: {{ .Name }}  # 服务管理器展示的显示名 | display name shown by the service manager
  description: 由 yd 脚手架生成的 {{ .Name }} 常驻服务 | the {{ .Name }} daemon generated by the yd scaffold
  arguments:                 # 服务启动参数；-service run 让入口显式进入服务模式 | start arguments; -service run enters service mode explicitly
    - -service
    - run
  working_directory: ""      # 初始工作目录（Windows 忽略）；建议留空，路径经 YD_ 环境变量传入 | initial working directory (ignored on Windows); prefer leaving it empty and passing paths through YD_ variables
  user_name: ""              # 运行账号；留空表示服务管理器缺省账号 | run-as account; empty means the service manager default
  restart_on_exit: true      # 异常退出后自动重启（Windows OnFailure=restart，POSIX Restart=always） | restart after an unexpected exit (Windows OnFailure=restart, POSIX Restart=always)
  env:                       # 服务的额外环境变量；列表形式保留键名大小写，映射形式会被配置引擎转为小写 | extra environment variables; the list form keeps the name case, the mapping form is lower-cased
    - YD_SERVER_PORT=8080

# Image packaging without a Dockerfile | 无 Dockerfile 打包
# `yd ko` builds the image straight from the Go sources by driving the external ko CLI, which is NOT a Go dependency of this project | `yd ko` 驱动 ko 外部 CLI 从 Go 源码直出容器镜像，ko 不是本项目的 Go 依赖
# It stands next to `yd docker` (a multi-stage Dockerfile build), and both paths must yield the same artifact: a CGO_ENABLED=0 statically linked binary | 它与 yd docker（多阶段 Dockerfile 构建）并列，两条路径都必须产出 CGO_ENABLED=0 静态链接的二进制
# Binary resolution order: --binary -> YD_KO_BIN -> <project>/.yd/tools/ko[.exe] -> PATH | 二进制解析顺序：--binary -> YD_KO_BIN -> <项目>/.yd/tools/ko[.exe] -> PATH
# A missing ko only fails `yd ko` with an install hint (go install github.com/google/ko@latest); it never blocks build, dev or test | ko 缺失只让 yd ko 报错并给出安装提示（go install github.com/google/ko@latest），不阻塞 build/dev/test
# Every key below is overridable through the YD_KO_* prefix: YD_KO_REPOSITORY -> ko.repository, and so on | 下面每个键都可由 YD_KO_* 前缀覆盖：YD_KO_REPOSITORY -> ko.repository，其余同理
ko:
  binary: ""            # path to the ko binary; empty follows the resolution order above | ko 可执行文件路径；留空按上面的顺序解析
  repository: ""        # image repository handed to ko as KO_DOCKER_REPO; empty without --repo refuses to build unless --local is set | 镜像仓库，作为 KO_DOCKER_REPO 传给 ko；留空且未给 --repo 时拒绝构建，改用 --local 除外
  tags: []              # image tags such as [latest, v1.0.0]; empty keeps ko's default latest | 镜像标签，如 [latest, v1.0.0]；留空沿用 ko 缺省的 latest
  platforms: []         # target platforms such as [linux/amd64, linux/arm64]; empty takes every platform the base image supports | 目标平台，如 [linux/amd64, linux/arm64]；留空取基础镜像支持的全部平台
  base_image: ""        # base image override (KO_DEFAULTBASEIMAGE); on an intranet point it at a locally cached image | 覆盖基础镜像（KO_DEFAULTBASEIMAGE）；内网填本地缓存的基础镜像地址
  packages: []          # Go packages to build such as [./cmd/app]; empty uses the project entry point | 要打包的 Go 包，如 [./cmd/app]；留空用项目入口
  local: false          # true equals ko's --local: load into the local docker daemon instead of pushing | true 等价于 ko 的 --local：装进本地 docker 守护进程而不推送
  push: false           # true equals ko's --push: push to the repository once the build succeeds | true 等价于 ko 的 --push：构建成功后推送到 repository
